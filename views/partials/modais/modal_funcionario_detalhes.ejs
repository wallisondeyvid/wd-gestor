          <!-- Anexos -->
          <div class="fd-section">
            <button class="fd-toggle collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#fd-anexos"
                    aria-expanded="false" aria-controls="fd-anexos">
              <i class="bi bi-chevron-right fd-caret"></i>
              <span>Anexos</span>
            </button>
            <div id="fd-anexos" class="collapse" data-bs-parent="#fd-accordion">
              <div class="mt-2">
                <ul id="detalheAnexosList" class="list-group small"></ul>
                <div class="text-muted small mt-2" id="detalheAnexosVazio" style="display:none;">Nenhum anexo cadastrado.</div>
              </div>
            </div>
          </div>

                </div><!-- /fd-accordion -->

                <div class="text-muted small mt-3">Última atualização: <span data-field="updatedAt"></span></div>
              </div><!-- /.func-dados -->
            </div>
          </section>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>

  <!-- estilos locais do modal -->
  <style>
    /* Layout e altura como no modal de Unidades */
  #modalFuncionarioDetalhes .modal-content{ height:62.5vh !important; max-height:62.5vh !important; display:flex; flex-direction:column; overflow:hidden; }
  #modalFuncionarioDetalhes .modal-body{ flex:1 1 auto; display:flex; flex-direction:column; min-height:0 !important; overflow:hidden !important; }
  #modalFuncionarioDetalhes .modal-body > .func-layout-row{ flex:1 1 auto; min-height:0 !important; }
  #modalFuncionarioDetalhes .func-layout-row{ align-items:stretch !important; height:100%; min-height:0; }
  #modalFuncionarioDetalhes aside{ align-self:start; }
  #modalFuncionarioDetalhes .func-layout-row .col-md-8{ display:flex !important; flex:1 1 auto !important; min-height:0 !important; height:100% !important; overflow:hidden; }
  /* Card da direita é contêiner flex, sem rolagem; quem rola é .func-dados */
  #modalFuncionarioDetalhes .func-layout-row .col-md-8 > .card{ display:flex !important; flex-direction:column !important; flex:1 1 auto !important; min-height:0 !important; overflow:visible !important; }
  /* .func-dados ocupa o espaço e rola */
  #modalFuncionarioDetalhes .func-dados{ flex:1 1 auto !important; min-height:0 !important; overflow-y:scroll !important; overflow-x:hidden !important; scrollbar-gutter:stable both-edges; -webkit-overflow-scrolling: touch; }
  #modalFuncionarioDetalhes .func-dados{ max-height:100% !important; overscroll-behavior:contain; }
  /* Scrollbar visível dentro da área de dados */
  #modalFuncionarioDetalhes .func-dados{ scrollbar-width: thin; scrollbar-color:#cbd5e1 #f1f5f9; }
  #modalFuncionarioDetalhes .func-dados::-webkit-scrollbar{ width: 10px; }
