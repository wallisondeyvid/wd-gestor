  <script>
    (function(){
      const modal = document.getElementById('modalFuncionarioDetalhes');
      function getScrollBox(){
        // Prioriza a área de dados rolável; fallback para o card
        return modal?.querySelector('.func-dados') || modal?.querySelector('.func-layout-row .col-md-8 > .card');
      }
      function wheelHandler(e){
        const box = getScrollBox(); if(!box) return;
        const rightCol = modal?.querySelector('.func-layout-row .col-md-8');
        // Se o ponteiro está dentro do contêiner de rolagem OU em qualquer área da coluna direita, rola o box
        if (box.contains(e.target) || (rightCol && rightCol.contains(e.target))){
          const before = box.scrollTop;
          const unit = (e.deltaMode === 1 ? 16 : (e.deltaMode === 2 ? box.clientHeight : 1));
          box.scrollTop += e.deltaY * unit;
          if (box.scrollTop !== before){ e.preventDefault(); e.stopPropagation(); }
        }
      }
      function keyHandler(e){
        const box = getScrollBox(); if(!box) return;
        // Só trata teclas quando o foco está dentro do modal
        if (!modal.contains(document.activeElement)) return;
        const keys = ['PageDown','PageUp','Home','End','ArrowDown','ArrowUp'];
        if (!keys.includes(e.key)) return;
        let delta = 0;
        const view = box.clientHeight;
        switch(e.key){
          case 'PageDown': delta = view * 0.9; break;
          case 'PageUp':   delta = -view * 0.9; break;
          case 'Home':     box.scrollTop = 0; e.preventDefault(); return;
          case 'End':      box.scrollTop = box.scrollHeight; e.preventDefault(); return;
          case 'ArrowDown': delta = 40; break;
          case 'ArrowUp':   delta = -40; break;
        }
        const before = box.scrollTop;
        box.scrollTop = Math.max(0, Math.min(box.scrollTop + delta, box.scrollHeight));
        if (box.scrollTop !== before){ e.preventDefault(); e.stopPropagation(); }
      }
      if (modal){
        modal.addEventListener('wheel', wheelHandler, { passive:false });
        modal.addEventListener('keydown', keyHandler, { passive:false });
      }
    })();
  </script>
