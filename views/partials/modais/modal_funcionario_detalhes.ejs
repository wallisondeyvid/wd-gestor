              <i class="bi bi-chevron-right fd-caret"></i>
              <span>Dependentes</span>
            </button>
            <div id="fd-dependentes" class="collapse" data-bs-parent="#fd-accordion">
              <div class="table-responsive">
                <table class="table table-sm">
                  <thead class="table-light">
                    <tr><th>Nome</th><th>CPF</th><th>Parentesco</th><th>Nasc.</th></tr>
                  </thead>
                  <tbody id="listaDependentes">
                    <tr><td colspan="4" class="text-muted">—</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Benefícios -->
          <div class="fd-section">
            <button class="fd-toggle collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#fd-beneficios"
                    aria-expanded="false" aria-controls="fd-beneficios">
              <i class="bi bi-chevron-right fd-caret"></i>
              <span>Benefícios</span>
            </button>
            <div id="fd-beneficios" class="collapse" data-bs-parent="#fd-accordion">
              <div class="table-responsive">
                <table class="table table-sm">
                  <thead class="table-light">
                    <tr><th>Tipo</th><th>Descrição</th><th>Valor</th><th>Início</th><th>Data Início</th></tr>
                  </thead>
                  <tbody id="listaBeneficios">
                    <tr><td colspan="5" class="text-muted">—</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Observações -->
          <div class="fd-section">
            <button class="fd-toggle collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#fd-observacoes"
                    aria-expanded="false" aria-controls="fd-observacoes">
              <i class="bi bi-chevron-right fd-caret"></i>
              <span>Observações</span>
            </button>
            <div id="fd-observacoes" class="collapse" data-bs-parent="#fd-accordion">
              <div id="campoObservacoes" class="form-control-plaintext ps-0" style="white-space:pre-wrap" data-field="observacoes">—</div>
