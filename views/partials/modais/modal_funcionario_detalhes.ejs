<!-- Modal Detalhes do Funcionário (accordion, tudo recolhido ao abrir) -->
<div class="modal fade modal-func-detalhes modal-detalhes modal-sheet theme-blue"
     id="modalFuncionarioDetalhes"
     tabindex="-1"
     aria-labelledby="tituloDetalhesFuncionario"
  aria-hidden="true"
  data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="tituloDetalhesFuncionario">Detalhes do Funcionário</h5>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-primary fs-6" data-field="codigo">—</span>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
      </div>

      <div class="modal-body">

        <div class="row g-4 func-layout-row">
          <!-- LADO ESQUERDO: foto fixa -->
          <aside class="col-12 col-md-4">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body text-center">
                <div class="profile-avatar-wrap mb-3">
                  <img id="detalheFoto" class="avatar-xxl rounded" alt="Foto"
                       src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='150' viewBox='0 0 96 96'><rect width='96' height='96' rx='12' fill='%23f1f5f9'/><circle cx='48' cy='36' r='18' fill='%23cbd5e1'/><rect x='20' y='60' width='56' height='20' rx='10' fill='%23cbd5e1'/></svg>"
                  />
                </div>
                <!-- Dados básicos abaixo da foto -->
                <div class="mb-2">
                  <div class="fw-semibold" data-field="nome">—</div>
                  <div class="text-muted small">
                    <span data-field="funcao_id.nome">—</span>
                    <span class="mx-1">•</span>
                    <span data-field="unidade_id.nome">—</span>
                  </div>
                  <div class="text-muted small">CPF: <span data-field="cpf">—</span></div>
                </div>
                <div id="detalheFotoStatus" class="mt-1 small"></div>
                <!-- Input hidden para upload de foto -->
                <input type="file" id="fdFileInput" accept="image/*" style="display: none;" />
              </div>
            </div>
          </aside>

          <!-- LADO DIREITO: info + acordeão com rolagem -->
          <section class="col-12 col-md-8">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body func-dados">
                <!-- ACCORDION -->
                <div id="fd-accordion" class="fd-accordion">

          <!-- Identificação -->
          <div class="fd-section">
            <button class="fd-toggle collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#fd-identificacao"
                    aria-expanded="false" aria-controls="fd-identificacao">
              <i class="bi bi-chevron-right fd-caret"></i>
              <span>Identificação</span>
            </button>
            <div id="fd-identificacao" class="collapse" data-bs-parent="#fd-accordion">
              <div class="table-responsive">
                <table class="table table-sm">
                  <tbody>
                    <tr><th>Nome Social</th><td data-field="nome_social"></td></tr>
                    <tr><th>Mãe</th><td data-field="nome_mae"></td></tr>
                    <tr><th>Pai</th><td data-field="nome_pai"></td></tr>
                    <tr class="fld-main" data-fld="rg">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-rg" aria-expanded="false" aria-controls="fld-rg" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        RG
                      </th>
                      <td><span data-field="rg"></span><span class="text-muted ms-2" data-field="rg_orgao"></span></td>
                    </tr>
                    <tr id="fld-rg" class="collapse fld-sub" data-parent-field="rg" data-bs-parent="#fd-identificacao">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Número:</strong> <span data-field="rg"></span></div>
                          <div><strong>Órgão expedidor:</strong> <span data-field="rg_orgao"></span></div>
                          <div><strong>UF:</strong> <span data-field="rg_uf"></span></div>
                          <div><strong>Expedição:</strong> <span data-field="rg_data_expedicao"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr><th>PIS/PASEP</th><td data-field="pis"></td></tr>
                    <tr><th>Data Nasc.</th><td data-field="data_nascimento"></td></tr>
                    <tr><th>Sexo</th><td data-field="sexo"></td></tr>
                    <tr><th>Estado Civil</th><td data-field="estado_civil"></td></tr>
                    <tr><th>Raça/Cor</th><td data-field="raca_cor"></td></tr>
                    <tr><th>Escolaridade</th><td data-field="escolaridade"></td></tr>
                    <tr><th>Nacionalidade</th><td data-field="nacionalidade"></td></tr>
                    <tr><th>País de Nasc.</th><td data-field="pais_nascimento"></td></tr>
                    <tr><th>Chegada ao Brasil</th><td data-field="data_chegada_brasil"></td></tr>
                    <tr><th>Naturalidade</th><td data-field="naturalidade"></td></tr>
                    <tr class="fld-main" data-fld="endereco">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-endereco" aria-expanded="false" aria-controls="fld-endereco" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        Endereço
                      </th>
                      <td id="det_endereco">—</td>
                    </tr>
                    <tr id="fld-endereco" class="collapse fld-sub" data-parent-field="endereco" data-bs-parent="#fd-identificacao">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Tipo Logradouro:</strong> <span data-field="endereco.tipo_logradouro"></span></div>
                          <div><strong>Logradouro:</strong> <span data-field="endereco.logradouro"></span></div>
                          <div><strong>Número:</strong> <span data-field="endereco.numero"></span></div>
                          <div><strong>Complemento:</strong> <span data-field="endereco.complemento"></span></div>
                          <div><strong>Bairro:</strong> <span data-field="endereco.bairro"></span></div>
                          <div><strong>Cidade:</strong> <span data-field="endereco.cidade"></span></div>
                          <div><strong>UF:</strong> <span data-field="endereco.estado"></span></div>
                          <div><strong>CEP:</strong> <span data-field="endereco.cep"></span></div>
                          <div><strong>Código IBGE:</strong> <span data-field="endereco.codigo_ibge"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <th>Telefone</th>
                      <td><span data-field="telefone"></span> <span class="text-muted">|</span> <span data-field="telefone2"></span></td>
                    </tr>
                    <tr><th>E-mail</th><td data-field="email"></td></tr>
                    <tr class="fld-main" data-fld="ctps">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-ctps" aria-expanded="false" aria-controls="fld-ctps" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        CTPS
                      </th>
                      <td><span data-field="ctps_numero"></span> <span class="text-muted" data-field="ctps_serie"></span></td>
                    </tr>
                    <tr id="fld-ctps" class="collapse fld-sub" data-parent-field="ctps" data-bs-parent="#fd-identificacao">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Tipo:</strong> <span data-field="tipo_ctps"></span></div>
                          <div><strong>Número:</strong> <span data-field="ctps_numero"></span></div>
                          <div><strong>Série:</strong> <span data-field="ctps_serie"></span></div>
                          <div><strong>UF:</strong> <span data-field="ctps_uf"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr class="fld-main" data-fld="pcd">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-pcd" aria-expanded="false" aria-controls="fld-pcd" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        PCD
                      </th>
                      <td><span data-field="pcd"></span></td>
                    </tr>
                    <tr id="fld-pcd" class="collapse fld-sub" data-parent-field="pcd" data-bs-parent="#fd-identificacao">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Tipo Deficiência:</strong> <span data-field="tipo_deficiencia"></span></div>
                          <div><strong>CID:</strong> <span data-field="cid"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Dados Contratuais -->
          <div class="fd-section">
            <button class="fd-toggle collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#fd-contratuais"
                    aria-expanded="false" aria-controls="fd-contratuais">
              <i class="bi bi-chevron-right fd-caret"></i>
              <span>Dados Contratuais</span>
            </button>
            <div id="fd-contratuais" class="collapse" data-bs-parent="#fd-accordion">
              <div class="table-responsive">
                <table class="table table-sm">
                  <tbody>
                    <tr><th>Admissão</th><td data-field="data_admissao"></td></tr>
                    <tr><th>Tipo de Admissão</th><td data-field="tipo_admissao"></td></tr>
                    <tr><th>Categoria do Trab.</th><td data-field="categoria_trabalhador"></td></tr>
                    <tr><th>Tipo de Contrato</th><td data-field="tipo_contrato"></td></tr>
                    <tr><th>Término</th><td data-field="data_termino"></td></tr>
                    <tr><th>Objeto determinante</th><td data-field="objeto_determinante"></td></tr>
                    <tr><th>Cláusula assecuratória</th><td data-field="clausula_assecuratoria"></td></tr>
                    <tr><th>Cargo</th><td data-field="cargo"></td></tr>
                    <tr><th>CBO</th><td data-field="cbo"></td></tr>
                    <tr><th>Departamento/Setor</th><td><span data-field="departamento.nome"></span></td></tr>
                    <tr><th>Reg. Contratação</th><td data-field="regime_contratacao"></td></tr>
                    <tr><th>Reg. Jornada</th><td data-field="regime_jornada"></td></tr>
                    <tr><th>Carga Semanal</th><td data-field="carga_semanal"></td></tr>
                    <tr><th>Salário Base</th><td data-field="salario_base"></td></tr>
                    <tr><th>Tipo de Salário</th><td data-field="tipo_salario"></td></tr>
                    <tr><th>Forma de Pagamento</th><td data-field="forma_pagamento"></td></tr>
                    <tr><th>Descrição pagamento</th><td data-field="forma_pagamento_desc"></td></tr>
                    <tr class="fld-main" data-fld="banco">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-banco" aria-expanded="false" aria-controls="fld-banco" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        Banco
                      </th>
                      <td><span data-field="banco"></span></td>
                    </tr>
                    <tr id="fld-banco" class="collapse fld-sub" data-parent-field="banco" data-bs-parent="#fd-contratuais">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Agência:</strong> <span data-field="agencia_num"></span>-<span data-field="agencia_dv"></span></div>
                          <div><strong>Conta:</strong> <span data-field="conta_num"></span>-<span data-field="conta_dv"></span></div>
                          <div><strong>Tipo Conta:</strong> <span data-field="tipo_conta"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr><th>Sindicato</th><td data-field="sindicato"></td></tr>
                    <tr class="fld-main" data-fld="fgts">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-fgts" aria-expanded="false" aria-controls="fld-fgts" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        FGTS Optante
                      </th>
                      <td><span data-field="fgts_optante"></span></td>
                    </tr>
                    <tr id="fld-fgts" class="collapse fld-sub" data-parent-field="fgts" data-bs-parent="#fd-contratuais">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Data Opção:</strong> <span data-field="fgts_data"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr><th>Regime Previdenciário</th><td data-field="regime_previdenciario"></td></tr>
                    <tr><th>Tipo Especial</th><td data-field="tipo_especial"></td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Documentos -->
          <div class="fd-section">
            <button class="fd-toggle collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#fd-documentos"
                    aria-expanded="false" aria-controls="fd-documentos">
              <i class="bi bi-chevron-right fd-caret"></i>
              <span>Documentos</span>
            </button>
            <div id="fd-documentos" class="collapse" data-bs-parent="#fd-accordion">
              <div class="table-responsive">
                <table class="table table-sm">
                  <tbody>
                    <tr class="fld-main" data-fld="cert_militar">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-certmil" aria-expanded="false" aria-controls="fld-certmil" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        Certificado Militar
                      </th>
                      <td><span data-field="cert_militar"></span></td>
                    </tr>
                    <tr id="fld-certmil" class="collapse fld-sub" data-parent-field="cert_militar" data-bs-parent="#fd-documentos">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Número:</strong> <span data-field="cert_militar"></span></div>
                          <div><strong>Órgão:</strong> <span data-field="cert_militar_orgao"></span></div>
                          <div><strong>UF:</strong> <span data-field="cert_militar_uf"></span></div>
                          <div><strong>Data:</strong> <span data-field="cert_militar_data"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr class="fld-main" data-fld="titulo">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-titulo" aria-expanded="false" aria-controls="fld-titulo" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        Título de Eleitor
                      </th>
                      <td><span data-field="titulo"></span></td>
                    </tr>
                    <tr id="fld-titulo" class="collapse fld-sub" data-parent-field="titulo" data-bs-parent="#fd-documentos">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Número:</strong> <span data-field="titulo"></span></div>
                          <div><strong>Zona:</strong> <span data-field="titulo_zona"></span></div>
                          <div><strong>Seção:</strong> <span data-field="titulo_secao"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr class="fld-main" data-fld="cnh">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-cnh" aria-expanded="false" aria-controls="fld-cnh" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        CNH
                      </th>
                      <td><span data-field="cnh"></span></td>
                    </tr>
                    <tr id="fld-cnh" class="collapse fld-sub" data-parent-field="cnh" data-bs-parent="#fd-documentos">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Número:</strong> <span data-field="cnh"></span></div>
                          <div><strong>Categoria:</strong> <span data-field="cnh_categoria"></span></div>
                          <div><strong>Validade:</strong> <span data-field="cnh_validade"></span></div>
                          <div><strong>UF:</strong> <span data-field="cnh_uf"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                    <tr class="fld-main" data-fld="orgao_prof">
                      <th>
                        <button type="button" class="fld-toggle" data-bs-toggle="collapse" data-bs-target="#fld-orgprof" aria-expanded="false" aria-controls="fld-orgprof" title="Expandir / Recolher">
                          <i class="bi bi-plus-lg"></i>
                        </button>
                        Órgão Prof.
                      </th>
                      <td><span data-field="orgao_prof"></span></td>
                    </tr>
                    <tr id="fld-orgprof" class="collapse fld-sub" data-parent-field="orgao_prof" data-bs-parent="#fd-documentos">
                      <td colspan="2">
                        <div class="fld-indent">
                        <div class="small d-flex flex-column gap-1">
                          <div><strong>Órgão:</strong> <span data-field="orgao_prof"></span></div>
                          <div><strong>UF:</strong> <span data-field="orgao_prof_uf"></span></div>
                          <div><strong>Número Registro:</strong> <span data-field="orgao_prof_numero"></span></div>
                        </div>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Dependentes -->
          <div class="fd-section">
