<div class="modal fade" id="modalTipoContrato" tabindex="-1" aria-labelledby="modalTipoContratoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content modal-sheet theme-blue">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTipoContratoLabel">Selecionar Tipo de Contrato</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <!-- Busca -->
        <div class="search-wrap has-icon-left mb-2">
          <img src="<%= (typeof _basePath !== 'undefined'? _basePath : '/gestor') %>/images/pesquisar.png" alt="Pesquisar" class="icon icon-sm search-icon" onerror="this.outerHTML='\x3ci class=\'bi bi-search text-secondary\' style=\'font-size:16px;\'\x3e\x3c/i\x3e'" />
          <input type="text" id="tipoContratoPesquisa" class="form-control ps-4" placeholder="Pesquisar tipo de contrato...">
        </div>

        <!-- Cabeçalho das colunas -->
        <div class="list-header mb-0 wdg-flex-head">
          <div class="col-sel">Seleção</div>
          <div class="col-cod">Código</div>
          <div class="col-desc">Tipo de Contrato</div>
        </div>

        <!-- Lista -->
        <div class="list-scroll mb-3 wdg-flex-body">
          <ul class="list-group" id="listaTipoContrato">
            <li class="list-group-item list-empty">Carregando…</li>
          </ul>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" id="btnFecharTipoContrato" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-outline-warning" id="btnLimparTipoContrato">Limpar</button>
        <button type="button" class="btn btn-outline-primary" id="btnConfirmarTipoContrato">Selecionar</button>
      </div>
    </div>
  </div>
</div>