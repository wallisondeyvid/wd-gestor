<div class="modal fade modal-sheet theme-blue modal-cnae" id="modalCnaeSecundario" tabindex="-1" aria-labelledby="modalCnaeSecundarioLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalCnaeSecundarioLabel">Selecionar CNAEs Secundários</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <div class="search-wrap has-icon-left mb-2">
          <img src="<%= (typeof _basePath !== 'undefined'? _basePath : '/gestor') %>/images/pesquisar.png" alt="Pesquisar" class="icon icon-sm search-icon" onerror="this.outerHTML='\x3ci class=\'bi bi-search text-secondary\' style=\'font-size:16px;\'\x3e\x3c/i\x3e'" />
          <input type="text" class="form-control ps-4" id="filtroCnaeSecundario" placeholder="Pesquisar CNAE por código ou descrição...">
        </div>
        <div class="list-scroll" id="listaCnaesSecundarios">
          <div class="sheet-head three-cols">
            <div class="col-sel">Seleção</div>
            <div class="col-cod">Código</div>
            <div class="col-desc">Descrição do CNAE</div>
          </div>
          <ul class="cnae-list" id="listaCnaesSecundariosUL"></ul>
        </div>
        <small id="limiteCnaesSecundarios" class="form-text text-muted d-block mt-2"></small>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-outline-warning" id="btnDesmarcarTodosCnaeSecundario">Limpar</button>
        <button type="button" class="btn btn-outline-primary" id="btnInserirCnaeSecundario">Selecionar</button>
      </div>
    </div>
  </div>
</div>