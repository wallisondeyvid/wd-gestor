<div class="modal fade modal-sheet theme-blue" id="modalBanco" tabindex="-1" aria-labelledby="modalBancoLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="modalBancoLabel">Selecionar Banco</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <!-- Busca -->
        <div class="search-wrap has-icon-left mb-2">
          <img src="<%= (typeof _basePath !== 'undefined'? _basePath : '/gestor') %>/images/pesquisar.png" alt="" class="search-icon" onerror="this.outerHTML='\x3ci class=\'bi bi-search text-secondary\' style=\'font-size:16px;\'\x3e\x3c/i\x3e'" />
          <input type="text" id="modalBancoPesquisa" class="form-control" placeholder="Pesquisar banco por nome ou código..." autocomplete="off">
        </div>

        <!-- Tabela -->
        <div class="table-responsive" style="max-height:340px; overflow:auto; border:1px solid #dbe1ea; border-radius:.75rem;">
          <table class="table table-hover mb-0" id="modalBancoTabela" style="min-width:520px;">
            <thead class="table-light" style="position:sticky; top:0; z-index:2;">
              <tr>
                <th class="text-center" style="width:72px;">Seleção</th>
                <th class="text-center" style="width:110px;">Código</th>
                <th>Banco</th>
              </tr>
            </thead>
            <tbody id="modalBancoTbody">
              <!-- preenchido via JS -->
            </tbody>
          </table>
        </div>

        <!-- Outro banco -->
  <div class="form-check mt-3">
          <input class="form-check-input" type="checkbox" id="modalBancoOutroCheck">
          <label class="form-check-label" for="modalBancoOutroCheck">Outro banco (informar manualmente)</label>
        </div>

  <div id="modalBancoOutro" class="d-none mt-2 banco-outro-box">
          <div class="row g-2">
            <div class="col-4">
              <label class="form-label mb-1" for="modalBancoOutroCodigo">Código</label>
              <input type="text" class="form-control" id="modalBancoOutroCodigo" maxlength="3" placeholder="ex.: 001">
            </div>
            <div class="col-8">
              <label class="form-label mb-1" for="modalBancoOutroNome">Banco</label>
              <input type="text" class="form-control" id="modalBancoOutroNome" placeholder="Nome do banco">
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar">Cancelar</button>
        <button type="button" class="btn btn-outline-warning" id="modalBancoLimpar" title="Limpar" aria-label="Limpar">Limpar</button>
        <button type="button" class="btn btn-outline-primary" id="modalBancoConfirmar" title="Selecionar" aria-label="Selecionar">Selecionar</button>
  <!-- Botão de recarregar removido conforme solicitação (antes era id="modalBancoReload") -->
      </div>

    </div>
  </div>
</div>