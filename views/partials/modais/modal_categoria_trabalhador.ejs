<!-- Modal Categoria do Trabalhador -->

<div class="modal fade modal-sheet theme-blue" id="modalCategoriaTrabalhador" tabindex="-1"
     aria-labelledby="modalCategoriaTrabalhadorLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content categoria-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="modalCategoriaTrabalhadorLabel">Selecionar Categoria do Trabalhador</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <!-- Busca -->
        <div class="search-wrap has-icon-left mb-2">
          <img src="<%= (typeof _basePath !== 'undefined'? _basePath : '/gestor') %>/images/pesquisar.png" alt="" class="search-icon" onerror="this.outerHTML='\x3ci class=\'bi bi-search text-secondary\' style=\'font-size:16px;\'\x3e\x3c/i\x3e'" />
          <input type="text" id="categoriaTrabalhadorPesquisa" class="form-control" placeholder="Pesquisar categoria..." autocomplete="off">
        </div>

        <!-- Cabeçalho / Lista -->
        <div class="list-header wdg-flex-head">
          <div class="col-sel">Sel.</div>
          <div class="col-cod">Código</div>
          <div class="col-desc">Categoria</div>
        </div>
        <div class="list-scroll wdg-flex-body">
          <ul class="list-group" id="listaCategoriaTrabalhador" aria-live="polite">
            <li class="list-group-item list-empty">Carregando…</li>
          </ul>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="btnFecharCategoriaTrabalhador">Cancelar</button>
        <button type="button" class="btn btn-outline-warning" id="btnLimparCategoriaTrabalhador">Limpar</button>
        <button type="button" class="btn btn-outline-primary" id="btnConfirmarCategoriaTrabalhador">Selecionar</button>
      </div>
    </div>
  </div>
</div>