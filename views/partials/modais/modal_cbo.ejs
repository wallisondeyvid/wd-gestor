<!-- Modal CBO -->
<div class="modal fade modal-sheet theme-blue" id="modalCBO" tabindex="-1" aria-labelledby="modalCBOLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalCBOLabel">Selecionar CBO</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <!-- Busca -->
        <div class="search-wrap has-icon-left mb-2">
          <img src="<%= (typeof _basePath !== 'undefined'? _basePath : '/gestor') %>/images/pesquisar.png" alt="" class="search-icon" onerror="this.outerHTML='\x3ci class=\'bi bi-search text-secondary\' style=\'font-size:16px;\'\x3e\x3c/i\x3e'" />
          <input type="text" id="cboPesquisa" class="form-control" placeholder="Pesquisar CBO..." autocomplete="off">
        </div>

        <!-- Cabeçalho / Lista -->
        <div class="list-header">
          <div class="col-sel">Sel.</div>
          <div class="col-cod">Código</div>
          <div class="col-desc">CBO</div>
        </div>
        <ul class="list-group" id="listaCBO">
          <!-- itens via JS -->
        </ul>

        <!-- Outro (mesma aparência do Órgão Expedidor) -->
  <div class="form-check mt-3">
          <input class="form-check-input" type="checkbox" id="cboOutroCheck">
          <label class="form-check-label" for="cboOutroCheck">Outro (CBO não encontrada)</label>
        </div>

        <div id="cboOutroWrap" class="d-none">
          <div class="outro-grid">
            <div>
              <label for="cboOutroCodigo" class="form-label">Código</label>
              <input type="text" id="cboOutroCodigo" class="form-control" placeholder="Ex.: 4110-05">
            </div>
            <div>
              <label for="cboOutroTitulo" class="form-label">CBO</label>
              <input type="text" id="cboOutroTitulo" class="form-control" placeholder="Título da ocupação">
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" id="btnFecharCBO" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-outline-warning" id="btnLimparCBO">Limpar</button>
        <button type="button" class="btn btn-outline-primary" id="btnConfirmarCBO">Selecionar</button>
      </div>
    </div>
  </div>
</div>