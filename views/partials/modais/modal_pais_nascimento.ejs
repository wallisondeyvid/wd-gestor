<!-- Modal País de Nascimento -->
<div class="modal fade modal-sheet theme-blue modal-pais" id="modalPaisNascimento" tabindex="-1" aria-labelledby="modalPaisNascimentoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalPaisNascimentoLabel">Selecionar País de Nascimento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <!-- busca com ícone -->
        <div class="search-wrap has-icon-left mb-2">
          <img src="<%= (typeof _basePath !== 'undefined'? _basePath : '/gestor') %>/images/pesquisar.png" alt="Pesquisar" class="icon icon-sm search-icon" onerror="this.outerHTML='\x3ci class=\'bi bi-search text-secondary\' style=\'font-size:16px;\'\x3e\x3c/i\x3e'" />
          <input type="text" id="paisPesquisa" class="form-control ps-4" placeholder="Pesquisar país...">
        </div>

        <!-- área rolável com cabeçalho fixo -->
        <div id="wrapPaises" class="mb-2">
          <div class="sheet-head three-cols">
            <div class="col-sel">Seleção</div>
            <div class="col-cod">Código</div>
            <div class="col-nom">País</div>
          </div>
          <ul class="list-group" id="listaPaises"></ul>
        </div>

        <!-- “Outro” fora da lista -->
        <div class="form-check mt-2" id="paisOutroRow">
          <input class="form-check-input" type="checkbox" id="paisCheckOutro">
          <label class="form-check-label" for="paisCheckOutro">Outro</label>
        </div>

        <!-- Campos manuais (Código + País) -->
        <div id="campoOutroPais" class="row g-2 mt-2 d-none">
          <div class="col-sm-4">
            <label for="outroPaisCodigo" class="form-label mb-1">Código</label>
            <input type="text" id="outroPaisCodigo" class="form-control" placeholder="Ex.: 076" inputmode="numeric" autocomplete="off">
          </div>
          <div class="col-sm-8">
            <label for="outroPaisNome" class="form-label mb-1">País</label>
            <input type="text" id="outroPaisNome" class="form-control" placeholder="Nome do país" autocomplete="off">
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-outline-warning" id="btnLimparPais">Limpar</button>
        <button type="button" class="btn btn-outline-primary" id="btnConfirmarPais">Selecionar</button>
      </div>
    </div>
  </div>
</div>