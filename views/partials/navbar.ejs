<script>
  // Dropdown por CLIQUE (remove comportamento de abrir por hover para melhorar navegação)
  document.addEventListener('DOMContentLoaded', () => {
    try {
      // Remove quaisquer listeners antigos de hover (se existirem) e confia no comportamento padrão do Bootstrap (click para abrir/fechar)
      document.querySelectorAll('.navbar .dropdown [data-bs-toggle="dropdown"]').forEach((toggle) => {
        // Garante instância
        bootstrap.Dropdown.getOrCreateInstance(toggle);
        // Evita que cliques no link '#' rolem a página
        toggle.addEventListener('click', (ev) => { ev.preventDefault(); });
      });
      // Fecha dropdowns ao clicar fora (Bootstrap já faz, mas reforçamos para casos de customizações futuras)
      document.addEventListener('click', (ev) => {
        if (!ev.target.closest('.navbar .dropdown-menu') && !ev.target.closest('.navbar .dropdown-toggle')) {
          document.querySelectorAll('.navbar .dropdown .show').forEach(el => {
            if (el.classList.contains('dropdown-menu')) {
              // Fecha via API para manter aria-* consistentes
              const toggle = el.parentElement?.querySelector('[data-bs-toggle="dropdown"]');
              if (toggle) { const inst = bootstrap.Dropdown.getOrCreateInstance(toggle); inst.hide(); }
            }
          });
        }
      });
    } catch(_) { /* no-op */ }

    // Garantir favicon em todas as páginas (força atualização e bust de cache)
    try {
      const setFaviconAll = (href) => {
        // Remove ícones existentes para forçar o navegador a pegar o novo
        document.querySelectorAll('link[rel="icon"], link[rel="shortcut icon"], link[rel="mask-icon"]').forEach(el => el.parentNode.removeChild(el));

        const link1 = document.createElement('link');
        link1.setAttribute('rel', 'icon');
        link1.setAttribute('type', 'image/png');
        link1.setAttribute('href', href);
        document.head.appendChild(link1);

        const link2 = document.createElement('link');
        link2.setAttribute('rel', 'shortcut icon');
        link2.setAttribute('type', 'image/png');
        link2.setAttribute('href', href);
        document.head.appendChild(link2);
      };
      // usa a logo colorida; bust de cache com versão
  // Detecta basePath (ex: /gestor) se fornecido via atributo body ou variável global
  let bp = '';
  try { bp = document.body?.getAttribute('data-base-path') || window.__APP_BASE_PATH__ || ''; } catch(_){}
  if (!bp || bp === '/') bp = '/gestor';
  setFaviconAll(bp + '/images/logoWDGestor.png?v=5');
    } catch (e) { /* noop */ }
  });

  // Atualização dinâmica da foto após alteração confirmada no modal de perfil
  window.addEventListener('perfil:fotoAtualizada', async () => {
    try {
      // Reconsulta usuário para obter caminho definitivo (caso backend trate renomeação)
      var __bp = '';
      try {
        __bp = (window.WDG_CONTEXT && window.WDG_CONTEXT.basePath)
          ? window.WDG_CONTEXT.basePath
          : (document.body && document.body.getAttribute
              ? (document.body.getAttribute('data-base-path') || '')
              : '');
      } catch(_) {}

      __bp = String(__bp || '/gestor').replace(/\/$/, '');

      const resp = await fetch(__bp + '/api/usuario', {
        credentials: 'same-origin',
        cache: 'no-store'
      });
      if (!resp.ok) return;
      const raw = await resp.json();
      const user = raw?.data || raw?.usuario || raw;
      if (!user || !user.foto) return;
      // Resolver src similar ao template EJS
      let f = String(user.foto).trim();
      let src = '';
      if (/^https?:\/\//i.test(f) || f.startsWith('/')) src = f; else if (f.startsWith('uploads/')) src='/' + f; else if (f.startsWith('users/')) src='/uploads/' + f; else src='/' + f;
      // Cache-buster
      if (src) {
        if (/^data:/i.test(src)) {
          document.querySelectorAll('.navbar .avatar-img, .offcanvas-wd .avatar-img').forEach(img => { img.src = src; });
        } else {
          const sep = src.includes('?') ? '&' : '?';
          const bust = src + sep + 'v=' + Date.now();
          document.querySelectorAll('.navbar .avatar-img, .offcanvas-wd .avatar-img').forEach(img => { img.src = bust; });
        }
      }
    } catch (e) { console.warn('[navbar] falha atualizar avatar pós alteração de foto', e); }
  });

  // Ajuste inicial: se existir buildUserFotoUrl no global, reconstroi URLs para garantir consistência de basePath
  document.addEventListener('DOMContentLoaded', () => {
    try {
      if (typeof window.buildUserFotoUrl === 'function') {
        ['navbarAvatar','offcanvasAvatar'].forEach(id => {
          const el = document.getElementById(id);
          if (!el) return;
            const f = el.getAttribute('data-user-foto');
            if (f) {
              let url = window.buildUserFotoUrl(f);
              if (/^data:/i.test(url)) {
                el.src = url;
              } else {
                const sep = url.includes('?') ? '&' : '?';
                el.src = url + sep + 'v=' + Date.now();
              }
            }
        });
      }
    } catch(e){ console.warn('[navbar] falha ajuste inicial avatar', e); }
  });

  // Cronômetro de inatividade (30min) com reset a cada atividade
  document.addEventListener('DOMContentLoaded', function(){
    try{
      var nav = document.querySelector('.navbar.navbar-wd');
      var HAS_USER = !!(nav && nav.getAttribute('data-has-user')==='1');
      if(!HAS_USER) return;
      var LIMIT_MS = 30 * 60 * 1000;
      var LS_KEY = 'wdgIdleLastActivity';
      var LS_LOGOUT_KEY = 'wdgIdleLogoutAt';
      var el = document.getElementById('nbIdleTimer');
      if(!el) return;
      el.style.display = '';
      var now0 = Date.now();
      // Sempre marque atividade ao entrar em uma página autenticada.
      // Isso evita logout instantâneo após login quando sobrou um timestamp antigo no localStorage.
      try{ localStorage.setItem(LS_KEY, String(now0)); }catch(_){ }
      var last = now0;
      var lastWrite = 0;
      function bump(ts){ var now = ts || Date.now(); last = now; if(now - lastWrite > 1000){ lastWrite = now; try{ localStorage.setItem(LS_KEY, String(now)); }catch(_){ } } }
  ['click','keydown','mousemove','scroll','touchstart','wheel'].forEach(function(ev){ document.addEventListener(ev, function(){ bump(); }, { passive:true }); });
      window.addEventListener('storage', function(e){
        if(e && e.key===LS_KEY && e.newValue){ last = Number(e.newValue) || last; }
        if(e && e.key===LS_LOGOUT_KEY && e.newValue){ try{ if(location.pathname!=='/login') location.href = '/logout'; }catch(_){ } }
      });
      function fmt(t){ t = Math.max(0, t|0); var m=Math.floor(t/60), s=t%60; return String(m).padStart(2,'0')+':'+String(s).padStart(2,'0'); }
      // Atualiza imediatamente
      (function initialPaint(){
        var rem = Math.ceil((LIMIT_MS - (Date.now() - last))/1000);
        el.textContent = fmt(rem);
      })();
      var tick = setInterval(function(){
        try{
          var now = Date.now();
          var remMs = LIMIT_MS - (now - last);
          var rem = Math.ceil(remMs/1000);
          if(rem<=0){ clearInterval(tick); try{ localStorage.setItem(LS_LOGOUT_KEY, String(Date.now())); }catch(_){ } location.href = '/logout'; return; }
          el.textContent = fmt(rem);
        }catch(_){ }
      }, 1000);
    }catch(e){ console.warn('[navbar] idle timer error', e); }
  });
</script>