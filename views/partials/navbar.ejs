<link rel="stylesheet" href="/gestor/css/icons.css">
<style>
  /* ===== Navbar WD (gradiente azul + sticky) ===== */
  .navbar-wd{
    position: sticky; top: 0; z-index: 1030;
    background-image:
      radial-gradient(120% 180% at 0% 0%, rgba(255,255,255,.14) 0%, rgba(255,255,255,0) 60%),
      linear-gradient(135deg, #0a2a6b 0%, #0e51a7 45%, #1aa0ff 100%);
    box-shadow: 0 6px 28px rgba(26,160,255,.12);
    border: 0;
  }
  .navbar-wd .navbar-brand{ color:#fff; font-weight:700; letter-spacing:.2px; }
  .navbar-wd .navbar-logo{
    height:44px; /* maior para dar presença */
    width:auto; display:block;
    filter: drop-shadow(0 1px 1px rgba(0,0,0,.25));
  }
  /* Logo no offcanvas (mobile): tamanho controlado */
  .offcanvas-wd .navbar-logo{
    height:36px; width:auto; display:block;
    filter: drop-shadow(0 1px 1px rgba(0,0,0,.25));
  }
  @media (max-width: 575.98px){
    .navbar-wd .navbar-logo{ height:36px; }
  }
  .navbar-wd .logo-dot{
    width:10px;height:10px;border-radius:999px;display:inline-block;margin-right:.35rem;
    background:#a0d8ff; box-shadow:0 0 0 6px rgba(160,216,255,.18), 0 0 18px rgba(26,160,255,.45);
  }
  .navbar-wd .nav-link{
    color:rgba(255,255,255,.9);
    border-radius:.7rem; padding:.6rem .9rem; transition:all .2s ease;
  }
  .navbar-wd .nav-link:hover,
  .navbar-wd .nav-link.show{ color:#fff; background:rgba(255,255,255,.10); }
  .navbar-wd .nav-link:focus{ outline:none; }
  .navbar-wd .nav-link:focus-visible{ box-shadow:0 0 0 .25rem rgba(26,160,255,.35); }
  .navbar-wd .nav-link i{ margin-right:.35rem; opacity:.9; }
  .navbar-wd .menu-icon{ width:18px; height:18px; object-fit:contain; margin-right:.35rem; vertical-align:middle; }
  /* Avatar levemente maior (navbar e offcanvas) */
  .navbar-wd .avatar-img,
  .offcanvas-wd .avatar-img{
    width:32px; height:32px; border-radius:50%; object-fit:cover; margin-right:.35rem; background:rgba(255,255,255,.2);
  }

  .btn-light-ghost{
    background:transparent; color:#fff;
    border:1px solid rgba(255,255,255,.38);
    padding:.45rem .8rem; border-radius:.8rem; transition:all .25s ease;
  }
  .btn-light-ghost:hover{ background:rgba(255,255,255,.14); border-color:rgba(255,255,255,.55); color:#fff; }

  .dropdown-menu-wd{
    border-radius:1rem; padding:.35rem;
    border:1px solid rgba(9,103,210,.25);
    backdrop-filter: blur(6px) saturate(120%);
  }
  .dropdown-menu-wd .dropdown-item{ border-radius:.6rem; padding:.55rem .9rem; }
  .dropdown-menu-wd .dropdown-item i{ width:1.1rem; }
  .dropdown-menu-wd .dropdown-item:hover{ background:rgba(13,110,253,.12); }

  /* Ícone sair maior (consistência com navbar compartilhada) */
  .menu-icon { width: 22px; height: 22px; }
  @media (max-width: 575.98px){ .menu-icon { width: 18px; height: 18px; } }

  /* Chip central “Módulo Gestor” */
  .center-chip{
    display:inline-flex; align-items:center; justify-content:center;
    color:#fff; font-weight:700; letter-spacing:.1px;
    padding:.38rem .9rem; border-radius:999px;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.22);
    backdrop-filter: blur(4px);
    white-space:nowrap;
  }
  .center-chip .dot{
    width:8px;height:8px;border-radius:999px;display:inline-block;margin-right:.5rem;
    background:#1aa0ff; box-shadow:0 0 0 4px rgba(26,160,255,.18);
  }
  @media (max-width:575.98px){ .center-chip{ display:none; } }

  /* Cronômetro de inatividade (badge ao lado do módulo) */
  .idle-timer{ font-weight:700; letter-spacing:.3px; }
  @media (max-width:575.98px){ #nbIdleTimer{ display:none !important; } }

  /* Offcanvas (mobile) no mesmo tema */
  .offcanvas-wd{
    background: linear-gradient(135deg, #0a2a6b 0%, #0e51a7 45%, #1aa0ff 100%);
    color:#fff;
  }
  .offcanvas-wd .offcanvas-body{
    display:flex; flex-direction:column; min-height:100%; gap:.25rem;
    padding-bottom: max(12px, env(safe-area-inset-bottom));
  }
  .offcanvas-wd .list-group-nav{
    flex:1 1 auto; overflow:auto;
  }
  .offcanvas-wd .offcanvas-footer{
    margin-top:auto; padding-top:.5rem; border-top:1px solid rgba(255,255,255,.12);
    /* eleva bem o rodapé para longe da borda inferior */
    padding-bottom: max(56px, env(safe-area-inset-bottom));
  }
  .offcanvas-wd .list-group-item{
    background:transparent; color:#fff; border-color: rgba(255,255,255,.12);
  }
  .offcanvas-wd .list-group-item:hover{ background: rgba(255,255,255,.10); }

  /* Normaliza altura/alinhamento: perfil (nav-link) e sair (btn) com mesma altura */
  .navbar-wd .navbar-nav > .nav-item > .nav-link { display:inline-flex; align-items:center; height:44px; padding-top:0; padding-bottom:0; }
  .navbar-wd .btn-light-ghost { display:inline-flex; align-items:center; height:44px; padding-top:0; padding-bottom:0; }
  @media (max-width: 575.98px){
    .navbar-wd .navbar-nav > .nav-item > .nav-link { height:36px; }
    .navbar-wd .btn-light-ghost { height:36px; }
  }
</style>

