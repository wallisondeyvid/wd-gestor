<div class="modal fade" id="modalEditarRefeicao" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title">Intervalos de Refeição</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body p-3">
        <style>
          /* Remover ícone de relógio e spinners, mantendo tipo time */
          #modalEditarRefeicao input[type=time].input-time-simples::-webkit-calendar-picker-indicator { display: none; }
          #modalEditarRefeicao input[type=time].input-time-simples::-webkit-inner-spin-button,
          #modalEditarRefeicao input[type=time].input-time-simples::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
          #modalEditarRefeicao input[type=time].input-time-simples { appearance: textfield; -moz-appearance: textfield; text-align: center; }
          /* Centralizar tabela */
          #modalEditarRefeicao #tabelaIntervalosEditar th,
          #modalEditarRefeicao #tabelaIntervalosEditar td { text-align: center; vertical-align: middle; }
          /* Campos hora 1/3 do tamanho anterior aprox. */
          #modalEditarRefeicao .campo-hora { width: 90px !important; max-width: 90px; min-width: 80px; }
          /* Botão adicionar mais compacto e fixado à direita */
          #modalEditarRefeicao .btn-add-compact { padding: .2rem .5rem; font-size: .72rem; line-height: 1.1; }
          @media (max-width: 576px){
            #modalEditarRefeicao .campo-hora { width: 100% !important; max-width: 100%; }
          }
        </style>
        <form id="formRefeicao" autocomplete="off">
          <div class="row gx-3 gy-2 align-items-end mb-2">
            <div class="col-12">
              <div class="small text-muted" id="infoTurnoEditarRefeicao" style="min-height:18px;"></div>
            </div>
            <div class="col-auto">
              <label class="form-label">Computável</label>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="refeicaoComputavel" checked>
              </div>
            </div>
            <div class="col-auto">
              <label class="form-label">Início</label>
              <input type="time" class="form-control form-control-sm input-time-simples campo-hora" id="refeicaoInicio" step="60">
            </div>
            <div class="col-auto">
              <label class="form-label">Término</label>
              <input type="time" class="form-control form-control-sm input-time-simples campo-hora" id="refeicaoFim" step="60">
            </div>
            <div class="col d-flex justify-content-end align-items-end">
              <button type="button" class="btn btn-primary btn-sm btn-add-compact ms-auto" id="btnAddIntervaloEditar"><i class="bi bi-plus"></i> Adicionar</button>
            </div>
          </div>
          <div class="table-responsive border rounded" style="max-height:240px;">
            <table class="table table-sm table-hover mb-0" id="tabelaIntervalosEditar">
              <thead class="table-light">
                <tr><th style="width:110px;">Computável?</th><th style="width:110px;">Início</th><th style="width:110px;">Término</th><th style="width:120px;">Duração</th><th style="width:80px;">Ações</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="mt-3 small border rounded p-2">
            <div class="fw-semibold mb-1">Aplicar intervalos a outras alocações:</div>
            <div class="d-flex flex-wrap gap-3">
              <div class="form-check form-check-inline m-0">
                <input class="form-check-input" type="radio" name="escopoIntervaloEditar" id="escopoInt_atual" value="atual" checked>
                <label class="form-check-label" for="escopoInt_atual">Somente atual</label>
              </div>
              <div class="form-check form-check-inline m-0">
                <input class="form-check-input" type="radio" name="escopoIntervaloEditar" id="escopoInt_seg" value="seguintes">
                <label class="form-check-label" for="escopoInt_seg">Atuais + seguintes (mesmo turno)</label>
              </div>
              <div class="form-check form-check-inline m-0">
                <input class="form-check-input" type="radio" name="escopoIntervaloEditar" id="escopoInt_todas" value="todas">
                <label class="form-check-label" for="escopoInt_todas">Todas (mesmo turno)</label>
              </div>
            </div>
          </div>
          <div class="d-flex gap-2 justify-content-end mt-3">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
