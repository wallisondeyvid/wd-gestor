<% /* View leve para retorno via /popup/grupo-turnos */ %><!DOCTYPE html>

<div class="p-2"><html lang="pt-BR">

  <form id="formPopupGrupoTurnos" class="row g-2 mb-2"><head>

    <div class="col-12 col-md-3">  <meta charset="utf-8" />

      <label class="form-label req" for="popupNomeGrupo">Nome</label>  <title><%= edit ? 'Editar' : 'Novo' %> Grupo de Turnos</title>

      <input type="text" id="popupNomeGrupo" class="form-control" maxlength="20" value="<%= (initData && initData.id) ? (initData.id) : '' %>" placeholder="Grupo" />  <meta name="viewport" content="width=device-width,initial-scale=1" />

    </div>  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <div class="col-12 col-md-9">  <style>

      <label class="form-label">Adicionar Turno</label>    body{font-family:system-ui,Arial,sans-serif;background:#f5f5f5;margin:0;padding:0;}

      <div class="d-flex gap-2 flex-wrap align-items-end">    header{background:linear-gradient(#0e6fb1,#0a4f80);color:#fff;padding:8px 14px;font-weight:600;}

        <input type="time" id="popupHoraIni" class="form-control" style="max-width:130px" />    .content{padding:10px;}

        <span class="text-muted">às</span>    label{font-size:.75rem;margin-right:6px;}

        <input type="time" id="popupHoraFim" class="form-control" style="max-width:130px" />    input[type=time]{padding:3px 4px;font-family:monospace;width:90px;text-align:center;}

        <input type="text" id="popupChamada" class="form-control" style="max-width:120px" placeholder="Chamada" />    input[type=time].sem-picker::-webkit-calendar-picker-indicator{opacity:0;display:none;}

        <button type="button" class="btn btn-outline-primary btn-sm" id="popupBtnAddTurno"><i class="bi bi-plus-circle"></i></button>    input[type=time].sem-picker{appearance:none;-moz-appearance:textfield;}

      </div>    table{width:100%;border-collapse:collapse;font-size:.78rem;margin:8px 0;}

    </div>    th,td{border:1px solid #b5b5b5;padding:6px;text-align:center;}

  </form>    thead th{background:linear-gradient(#0e6fb1,#0a4f80);color:#fff;}

  <div class="table-responsive border rounded">    tbody tr:nth-child(odd){background:#e2e2e2;}

    <table class="table table-sm table-striped mb-0" id="popupTabelaTurnos">    tbody tr:nth-child(even){background:#d6d6d6;}

      <thead class="table-light">    .grp{display:flex;flex-wrap:wrap;gap:10px;align-items:center;}

        <tr><th style="width:120px">Início</th><th style="width:120px">Término</th><th>Chamada</th><th style="width:70px" class="text-center">Ação</th></tr>    .btn{cursor:pointer;}

      </thead>    .mini{font-size:.6rem;color:#444;margin-left:4px;}

      <tbody>    .footer-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px;}

        <% if(!(initData && initData.turnos && initData.turnos.length)){ %>    .btn-core{border:1px solid #0a4f80;background:#0e6fb1;color:#fff;padding:4px 12px;border-radius:4px;font-size:.7rem;}

          <tr class="text-muted"><td colspan="4" class="text-center small">Nenhum turno.</td></tr>    .btn-sec{background:#fff;color:#0e6fb1;}

        <% } else { initData.turnos.forEach(function(t,i){ %>    .btn-danger{background:#c53030;border-color:#9f1f1f;}

          <tr><td><%= t.ini %></td><td><%= t.fim %></td><td><%= t.overnight ? '•' : '' %></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" data-idx="<%= i %>"><i class="bi bi-x"></i></button></td></tr>    .btn-small{padding:2px 6px;font-size:.65rem;}

        <% }); } %>  </style>

      </tbody></head>

    </table><body>

  </div>  <header><%= edit ? 'Edição' : 'Novo' %> Grupo de Turnos</header>

</div>  <div class="content">

    <form id="formTurnos" class="mb-2">
      <div class="grp">
        <label>Início:* <input type="time" id="horaIni" class="sem-picker" step="60"></label>
        <label>Término:* <input type="time" id="horaFim" class="sem-picker" step="60"></label>
        <button type="button" id="btnAdd" class="btn btn-core btn-small">ADICIONAR</button>
        <span class="mini">Formato 24h HH:MM. Se término &lt; início = passa para o dia seguinte.</span>
      </div>
    </form>
    <table id="tabelaTurnos">
      <thead><tr><th style="width:240px">Turno</th><th style="width:90px">Ação</th></tr></thead>
      <tbody><tr><td colspan="2" class="text-muted">Nenhum turno ainda</td></tr></tbody>
    </table>
    <div class="footer-actions">
      <button class="btn btn-core btn-sec" id="btnCancelar" type="button">CANCELAR</button>
      <button class="btn btn-core" id="btnSalvar" type="button">SALVAR</button>
    </div>
  </div>
  <script id="initData" type="application/json"><%- JSON.stringify(initData||{}) %></script>
  <script src="/escalas/js/escalas/popup_grupo_turnos.js"></script>
</body>
</html>
