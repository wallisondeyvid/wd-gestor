<div class="modal fade" id="modalNotasEquipe" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title" id="modalNotasTitulo">Editar notas da equipe</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <textarea id="esNotasTxt" class="form-control" rows="8" maxlength="4000" style="resize:vertical;"></textarea>
        <div class="d-flex justify-content-between align-items-center mt-2">
          <small class="text-muted" id="esNotasCnt">0/4000</small>
          <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary" id="esNotasLimpar">Limpar</button>
            <button type="button" class="btn btn-primary" id="esNotasSalvar">Salvar</button>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="esNotasCancelar">Cancelar</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
