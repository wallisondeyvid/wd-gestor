<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal do Morador - Caixa de Mensagem</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/portal-morador'; %>
  <% const _headerLogo = (typeof headerLogoUrl === 'string' && headerLogoUrl.trim().length) ? headerLogoUrl : (_bp + '/images/logoWDGestor.png'); %>

  <link rel="icon" type="image/png" href="<%= _headerLogo %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <link rel="stylesheet" href="<%= _bp %>/css/portal-morador/home.css?v=<%= (typeof assetVersion !== 'undefined' && assetVersion) ? assetVersion : Date.now() %>">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=<%= (typeof assetVersion !== 'undefined' && assetVersion) ? assetVersion : Date.now() %>">
  <link rel="stylesheet" href="<%= _bp %>/css/portal-morador/mensagens.css?v=<%= (typeof assetVersion !== 'undefined' && assetVersion) ? assetVersion : Date.now() %>">

  <meta name="wdg-portal-ui-rev" content="pm-msg-ui-2026-01-12-01">

  <script>
    // Portal do Morador: regra de refresh (F5)
    // - Se estiver em "Nova mensagem" e atualizar, vai para Caixa de entrada.
    // - Se estiver em Entrada/Saída/Arquivo/Lixeira, permanece.
    // - Se estiver em Editar grupos / Configuração (Caixas), permanece.
    // - Qualquer outra tela dentro de /mensagens no refresh cai para Entrada.
    (function(){
      try {
        var navType = '';
        try {
          var entries = (window.performance && typeof window.performance.getEntriesByType === 'function')
            ? window.performance.getEntriesByType('navigation')
            : [];
          if (entries && entries[0] && entries[0].type) navType = String(entries[0].type);
        } catch(_){ }
        // Fallback legado
        try {
          if (!navType && window.performance && window.performance.navigation) {
            if (window.performance.navigation.type === 1) navType = 'reload';
          }
        } catch(_2){ }

        if (navType !== 'reload') return;

        var bp = '<%= _bp %>';
        bp = String(bp || '').trim();
        if (bp.endsWith('/')) bp = bp.slice(0, -1);

        var path = String(window.location && window.location.pathname ? window.location.pathname : '');
        var search = String(window.location && window.location.search ? window.location.search : '');

        // Normaliza para compat com /portal_morador
        var candidates = [bp];
        if (bp.indexOf('portal-morador') >= 0) candidates.push(bp.replace('portal-morador', 'portal_morador'));
        if (bp.indexOf('portal_morador') >= 0) candidates.push(bp.replace('portal_morador', 'portal-morador'));

        var baseMatched = '';
        for (var i=0;i<candidates.length;i++){
          var c = String(candidates[i] || '');
          if (!c) continue;
          if (path === c || path.indexOf(c + '/') === 0) { baseMatched = c; break; }
        }
        if (!baseMatched) baseMatched = bp || '';

        var rel = path;
        if (baseMatched && rel.indexOf(baseMatched) === 0) rel = rel.slice(baseMatched.length) || '/';
        // rel esperado: /mensagens/<view>
        if (rel.indexOf('/mensagens') !== 0) return;

        var view = '';
        var m = rel.match(/^\/mensagens(?:\/([^\/\?]+))?/i);
        if (m && m[1]) view = String(m[1] || '').trim().toLowerCase();

        // Mantém essas telas no refresh
        var keep = { entrada:1, saida:1, arquivo:1, lixeira:1, grupos:1, caixas:1, cfg_caixas:1 };

        // "Nova mensagem" no refresh sempre cai para entrada
        if (view === 'nova') {
          window.location.replace((baseMatched || '') + '/mensagens/entrada');
          return;
        }

        if (keep[view]) return;

        // Qualquer outra tela dentro de /mensagens no refresh cai para entrada
        window.location.replace((baseMatched || '') + '/mensagens/entrada');
      } catch(_e){ /* noop */ }
    })();
  </script>
</head>
<body class="pm-home-body wdg-layout wdg-msg"
  data-base-path="<%= _bp %>"
  data-header-logo-url="<%= _headerLogo %>"
  data-initial-view="<%= typeof msgInitialView === 'string' ? msgInitialView : 'entrada' %>"
  data-hab-id="<%= habitacaoId || '' %>"
  data-hab-label="<%= habitacaoLabel || '' %>"
  data-unidade-id="<%= unidadeId || '' %>"
  data-unidade-name="<%= typeof unidadeNome === 'string' ? unidadeNome : '' %>">

  <div class="pm-shell">
    <aside class="pm-sidebar" id="pmSidebar">
      <div class="pm-sidebar-brand">
        <div class="pm-sidebar-brand-logo">
          <img src="<%= _bp %>/images/logoWDGestorprata.png" alt="Portal do Morador">
        </div>
        <strong>Portal do Morador</strong>
      </div>

      <nav class="pm-nav" aria-label="Menu principal">
        <a class="pm-nav-item" href="<%= _bp %>/home"><img class="pm-nav-ico" src="<%= _bp %>/images/home.png" alt="" aria-hidden="true">Início</a>

        <details class="pm-nav-details pm-nav-details--mensagens" open>
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= _bp %>/images/mensagem.png" alt="" aria-hidden="true">Caixa de Mensagem</summary>
          <div class="pm-nav-sub" role="group" aria-label="Caixa de Mensagem">
            <a class="pm-nav-sub-item" href="<%= _bp %>/mensagens/nova"><img class="pm-nav-ico" src="<%= _bp %>/images/nova-mensagem.png" alt="" aria-hidden="true">Nova mensagem</a>
            <a class="pm-nav-sub-item" href="<%= _bp %>/mensagens/entrada"><img class="pm-nav-ico" src="<%= _bp %>/images/caixa-de-entrada.png" alt="" aria-hidden="true">Caixa de entrada <span class="pm-nav-count" data-msg-inbox-count style="display:none;" aria-hidden="true"></span></a>
            <a class="pm-nav-sub-item" href="<%= _bp %>/mensagens/saida"><img class="pm-nav-ico" src="<%= _bp %>/images/caixa-de-saida.png" alt="" aria-hidden="true">Caixa de saída</a>
            <a class="pm-nav-sub-item" href="<%= _bp %>/mensagens/arquivo"><img class="pm-nav-ico" src="<%= _bp %>/images/arquivomensagem.png" alt="" aria-hidden="true">Arquivo</a>
            <a class="pm-nav-sub-item" href="<%= _bp %>/mensagens/lixeira"><img class="pm-nav-ico" src="<%= _bp %>/images/lixeira.png" alt="" aria-hidden="true">Lixeira</a>
            <details class="pm-nav-sub-details pm-nav-sub-details--grupos">
              <summary class="pm-nav-sub-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= _bp %>/images/grupo.png" alt="" aria-hidden="true">Grupos</summary>
              <div class="pm-nav-sub" role="group" aria-label="Grupos">
                <a class="pm-nav-sub-item" href="<%= _bp %>/mensagens/grupos"><img class="pm-nav-ico" src="<%= _bp %>/images/editar.png" alt="" aria-hidden="true">Editar</a>
              </div>
            </details>
            <details class="pm-nav-sub-details">
              <summary class="pm-nav-sub-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= _bp %>/images/configuracao.png" alt="" aria-hidden="true">Configuração</summary>
              <div class="pm-nav-sub" role="group" aria-label="Configuração">
                <a class="pm-nav-sub-item" href="<%= _bp %>/mensagens/caixas"><img class="pm-nav-ico" src="<%= _bp %>/images/caixas.png" alt="" aria-hidden="true">Caixas</a>
              </div>
            </details>
          </div>
        </details>

        <a class="pm-nav-item" href="<%= _bp %>/comunicados"><img class="pm-nav-ico" src="<%= _bp %>/images/comunicacao.png" alt="" aria-hidden="true">Comunicados</a>
        <a class="pm-nav-item" href="<%= _bp %>/enquetes"><img class="pm-nav-ico" src="<%= _bp %>/images/enquete.png" alt="" aria-hidden="true">Enquetes</a>

        <details class="pm-nav-details">
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= _bp %>/images/solicitacao.png" alt="" aria-hidden="true">Solicitações</summary>
          <div class="pm-nav-sub" role="group" aria-label="Solicitações">
            <a class="pm-nav-sub-item" href="<%= _bp %>/solicitacoes/servico"><img class="pm-nav-ico" src="<%= _bp %>/images/servicos.png" alt="" aria-hidden="true">Serviço</a>
          </div>
        </details>

        <details class="pm-nav-details">
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= _bp %>/images/visita.png" alt="" aria-hidden="true">Visitante</summary>
          <div class="pm-nav-sub" role="group" aria-label="Visitante">
            <a class="pm-nav-sub-item" href="<%= _bp %>/visitante/comunicar"><img class="pm-nav-ico" src="<%= _bp %>/images/comunicar_visita.png" alt="" aria-hidden="true">Comunicar visita</a>
            <a class="pm-nav-sub-item" href="<%= _bp %>/visitante/historico"><img class="pm-nav-ico" src="<%= _bp %>/images/historico.png" alt="" aria-hidden="true">Histórico de acessos</a>
          </div>
        </details>

        <details class="pm-nav-details">
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= _bp %>/images/financeiro.png" alt="" aria-hidden="true">Financeiro</summary>
          <div class="pm-nav-sub" role="group" aria-label="Financeiro">
            <a class="pm-nav-sub-item" href="<%= _bp %>/financeiro/boletos"><img class="pm-nav-ico" src="<%= _bp %>/images/boleto.png" alt="" aria-hidden="true">Meus boletos</a>
          </div>
        </details>
      </nav>

      <div class="pm-sidebar-footer">Portal do Morador · WD Gestor</div>
    </aside>

    <div class="pm-main">
      <header class="pm-topbar">
        <div class="pm-topbar-row pm-topbar-row--top">
          <div class="pm-topbar-left">
            <button class="pm-nav-toggle" id="pmNavToggle" aria-label="Alternar menu" aria-expanded="false">
              <span></span><span></span><span></span>
            </button>
          </div>
          <div class="pm-topbar-logo">
            <img src="<%= _headerLogo %>" alt="Logo do condomínio">
          </div>
          <div class="pm-topbar-spacer" aria-hidden="true"></div>
        </div>

        <div class="pm-topbar-row pm-topbar-row--bottom">
          <div class="pm-topbar-actions pm-topbar-actions--main">
            <div class="pm-bell-wrap">
              <button class="pm-icon-btn pm-bell-btn" type="button" title="Notificações" data-bell-btn>
                <img src="<%= _bp %>/images/notificacao.png" alt="Notificações">
                <span class="pm-bell-badge" aria-hidden="true" data-bell-badge>0</span>
              </button>
              <div class="pm-bell-menu" hidden data-bell-menu>
                <div class="pm-bell-head">
                  <strong>Notificações</strong>
                  <button class="pm-bell-close" type="button" aria-label="Fechar" data-bell-close>×</button>
                </div>
                <div class="pm-bell-list" data-bell-list role="list"></div>
              </div>
            </div>

            <a class="pm-icon-btn pm-msg-btn" href="<%= _bp %>/mensagens/entrada" title="Caixa de Mensagem" aria-label="Caixa de Mensagem" data-msg-link>
              <img src="<%= _bp %>/images/mensagem.png" alt="Mensagens">
              <span class="pm-bell-badge" aria-hidden="true" data-msg-badge style="display:none;"></span>
            </a>

            <div class="pm-user-menu-wrap" data-user-name="<%= typeof userName === 'string' ? userName : '' %>">
              <button class="pm-user-chip pm-user-chip--btn" type="button" title="Perfil do usuário" aria-haspopup="menu" aria-expanded="false">
                <% if (avatarUrl) { %>
                  <img src="<%= avatarUrl %>" alt="Avatar">
                <% } else { %>
                  <span class="pm-user-initials"><%= (typeof userName === 'string' && userName) ? userName.slice(0,2).toUpperCase() : 'ME' %></span>
                <% } %>
              </button>

              <div class="pm-user-menu" role="menu" aria-label="Menu do usuário">
                <h4>Conta</h4>
                <div class="pm-user-menu-row">
                  <label for="pmNameModeMensagens">Exibir nome</label>
                </div>
                <select id="pmNameModeMensagens" data-action="name-mode">
                  <option value="initials">Somente iniciais</option>
                  <option value="first">Primeiro nome</option>
                  <option value="full">Nome completo</option>
                </select>

                <div class="pm-user-menu-actions" style="margin-top:10px">
                  <button class="pm-user-menu-btn" type="button" data-action="avatar-pick">Alterar foto</button>
                  <button class="pm-user-menu-btn" type="button" data-action="toggle-password">Alterar senha</button>
                </div>

                <input type="file" accept="image/*" hidden data-action="avatar-file">

                <form hidden data-action="password-form" style="margin-top:10px">
                  <input type="text" name="username" autocomplete="username" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
                  <input type="password" name="currentPassword" placeholder="Senha atual" autocomplete="current-password" style="margin-bottom:8px">
                  <input type="password" name="newPassword" placeholder="Nova senha" autocomplete="new-password" style="margin-bottom:8px">
                  <input type="password" name="confirmPassword" placeholder="Confirmar nova senha" autocomplete="new-password" style="margin-bottom:10px">
                  <button class="pm-user-menu-btn" type="submit">Salvar</button>
                </form>

                <div class="pm-user-menu-status" aria-live="polite"></div>
              </div>
            </div>

            <a class="pm-logout-btn pm-logout-btn--icon" href="<%= _bp %>/logout" title="Sair">
              <img src="<%= _bp %>/images/sair.png" alt="Sair">
            </a>
          </div>
        </div>
      </header>

      <section class="pm-toolbar" id="pmToolbar">
        <div class="pm-toolbar-body" id="pmToolbarBody">
          <div class="pm-condo-center">
            <small>Condomínio</small>
            <strong><%= typeof unidadeNome === 'string' ? unidadeNome : 'Seu Condomínio' %></strong>
            <button class="pm-hab-switch" id="pmHabSwitcher" type="button" aria-haspopup="dialog" aria-expanded="false">
              <span class="pm-hab-switch__icon"><img src="<%= _bp %>/images/home.png" alt=""></span>
              <span class="pm-hab-switch__label" id="pmHabSwitcherLabel"><%= habitacaoLabel || 'Habitação selecionada' %></span>
              <i class="bi bi-chevron-down"></i>
            </button>
          </div>
          <div class="pm-search" role="search" aria-label="Pesquisar no portal">
            <i class="bi bi-search"></i>
            <input type="search" placeholder="Procure aqui o que você precisa..." aria-label="Pesquisar">
          </div>
        </div>
        <button class="pm-toolbar-toggle" id="pmToolbarToggle" type="button" aria-expanded="true" aria-label="Recolher barra">
          <span class="pm-toolbar-toggle__chevron" aria-hidden="true"></span>
        </button>
      </section>

      <div class="pm-hab-menu-portal" id="pmHabSwitcherMenu" hidden>
        <div class="pm-hab-menu" role="dialog" aria-modal="true" aria-label="Selecionar habitação">
          <div class="pm-hab-menu-head">
            <div>
              <small>Habitações</small>
              <strong>Selecione para operar</strong>
            </div>
            <button type="button" class="pm-hab-menu-close" id="pmHabMenuClose" aria-label="Fechar">×</button>
          </div>
          <div class="pm-hab-menu-grid" id="pmHabMenuGrid" role="listbox" aria-label="Habitações disponíveis"></div>
          <div class="pm-hab-menu-pager" id="pmHabMenuPager"></div>
        </div>
      </div>

      <main class="pm-content">
        <div class="pm-content-inner">
          <section class="pm-panel pm-msg-mailbox-panel">
            <div class="row g-2 align-items-center">
              <div class="col-12 col-lg-4">
                <label class="form-label mb-1" for="msgMailboxSelect">Selecionar caixa</label>
                <select id="msgMailboxSelect" class="form-select form-select-sm" aria-label="Selecionar caixa de mensagem"></select>
              </div>
            </div>
          </section>

          <section class="pm-msg-main">
            <div class="wdg-card wdg-card-hover wdg-msg-panel">
              <div class="wdg-msg-panel-head">
                <div>
                  <h2 id="msgTitle">Caixa de entrada</h2>
                  <p class="lead" id="msgSubtitle" style="display:none;"></p>
                </div>
                <div class="wdg-msg-chip" id="msgChip"><i class="bi bi-envelope" aria-hidden="true"></i><span class="fw-normal">Mensagens</span></div>
              </div>

              <div class="wdg-msg-body" id="msgBody"></div>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>

  <script src="<%= _bp %>/js/portal_morador_nav_active.js?v=<%= Date.now() %>"></script>
  <script src="<%= _bp %>/js/portal_morador_groups_menu.js?v=<%= Date.now() %>"></script>
  <script src="<%= _bp %>/js/portal_morador_hab_switcher.js?v=<%= Date.now() %>"></script>
  <script src="<%= _bp %>/js/portal_morador_user_menu.js?v=<%= Date.now() %>"></script>
  <script src="<%= _bp %>/js/condominios/caixa_de_mensagem.js?v=<%= assetVersion || Date.now() %>"></script>
</body>
</html>
