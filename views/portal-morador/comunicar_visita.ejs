<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal do Morador - Comunicar visita</title>
  <% const BP = '/portal-morador'; %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= BP %>/css/portal-morador/home.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="<%= BP %>/css/portal-morador/servico.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="<%= BP %>/css/portal-morador/visitante.css?v=<%= Date.now() %>">
  <%- include('./partials/feedback-assets') %>
</head>
<body class="pm-home-body" data-base-path="<%= BP %>" data-hab-id="<%= habitacaoId || '' %>" data-hab-label="<%= habitacaoLabel || '' %>" data-unidade-id="<%= unidadeId || '' %>">
  <div class="pm-shell">
    <aside class="pm-sidebar" id="pmSidebar">
      <div class="pm-sidebar-brand">
        <div class="pm-sidebar-brand-logo">
          <img src="<%= BP %>/images/logoWDGestorprata.png" alt="Portal do Morador">
        </div>
        <strong>Portal do Morador</strong>
      </div>
      <nav class="pm-nav" aria-label="Menu principal">
        <a class="pm-nav-item" href="<%= BP %>/home"><img class="pm-nav-ico" src="<%= BP %>/images/home.png" alt="" aria-hidden="true">InÃ­cio</a>

        <details class="pm-nav-details pm-nav-details--mensagens">
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= BP %>/images/mensagem.png" alt="" aria-hidden="true">Caixa de Mensagem</summary>
          <div class="pm-nav-sub" role="group" aria-label="Caixa de Mensagem">
            <a class="pm-nav-sub-item" href="<%= BP %>/mensagens/nova"><img class="pm-nav-ico" src="<%= BP %>/images/nova-mensagem.png" alt="" aria-hidden="true">Nova mensagem</a>
            <a class="pm-nav-sub-item" href="<%= BP %>/mensagens/entrada"><img class="pm-nav-ico" src="<%= BP %>/images/caixa-de-entrada.png" alt="" aria-hidden="true">Caixa de entrada <span class="pm-nav-count" data-msg-inbox-count style="display:none;" aria-hidden="true"></span></a>
            <a class="pm-nav-sub-item" href="<%= BP %>/mensagens/saida"><img class="pm-nav-ico" src="<%= BP %>/images/caixa-de-saida.png" alt="" aria-hidden="true">Caixa de saÃ­da</a>
            <a class="pm-nav-sub-item" href="<%= BP %>/mensagens/arquivo"><img class="pm-nav-ico" src="<%= BP %>/images/arquivomensagem.png" alt="" aria-hidden="true">Arquivo</a>
            <a class="pm-nav-sub-item" href="<%= BP %>/mensagens/lixeira"><img class="pm-nav-ico" src="<%= BP %>/images/lixeira.png" alt="" aria-hidden="true">Lixeira</a>
            <details class="pm-nav-sub-details pm-nav-sub-details--grupos">
              <summary class="pm-nav-sub-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= BP %>/images/grupo.png" alt="" aria-hidden="true">Grupos</summary>
              <div class="pm-nav-sub" role="group" aria-label="Grupos">
                <a class="pm-nav-sub-item" href="<%= BP %>/mensagens/grupos"><img class="pm-nav-ico" src="<%= BP %>/images/editar.png" alt="" aria-hidden="true">Editar</a>
              </div>
            </details>
            <details class="pm-nav-sub-details">
              <summary class="pm-nav-sub-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= BP %>/images/configuracao.png" alt="" aria-hidden="true">ConfiguraÃ§Ã£o</summary>
              <div class="pm-nav-sub" role="group" aria-label="ConfiguraÃ§Ã£o">
                <a class="pm-nav-sub-item" href="<%= BP %>/mensagens/caixas"><img class="pm-nav-ico" src="<%= BP %>/images/caixas.png" alt="" aria-hidden="true">Caixas</a>
              </div>
            </details>
          </div>
        </details>

        <a class="pm-nav-item" href="<%= BP %>/comunicados"><img class="pm-nav-ico" src="<%= BP %>/images/comunicacao.png" alt="" aria-hidden="true">Comunicados</a>
        <a class="pm-nav-item" href="<%= BP %>/enquetes"><img class="pm-nav-ico" src="<%= BP %>/images/enquete.png" alt="" aria-hidden="true">Enquetes</a>
        <a class="pm-nav-item" href="<%= BP %>/assembleias"><img class="pm-nav-ico" src="<%= BP %>/images/assembleia_sessao.png" alt="" aria-hidden="true">Assembleias</a>
        <a class="pm-nav-item" href="<%= BP %>/home#reservas"><img class="pm-nav-ico" src="<%= BP %>/images/reservado.png" alt="" aria-hidden="true">Reservas</a>
        <a class="pm-nav-item" href="<%= BP %>/home#transparencia"><img class="pm-nav-ico" src="<%= BP %>/images/transparencia.png" alt="" aria-hidden="true">TransparÃªncia</a>

        <details class="pm-nav-details">
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= BP %>/images/solicitacao.png" alt="" aria-hidden="true">SolicitaÃ§Ãµes</summary>
          <div class="pm-nav-sub" role="group" aria-label="SolicitaÃ§Ãµes">
            <a class="pm-nav-sub-item" href="<%= BP %>/solicitacoes/servico"><img class="pm-nav-ico" src="<%= BP %>/images/servicos.png" alt="" aria-hidden="true">ServiÃ§o</a>
          </div>
        </details>

        <details class="pm-nav-details" open>
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= BP %>/images/visita.png" alt="" aria-hidden="true">Visitante</summary>
          <div class="pm-nav-sub" role="group" aria-label="Visitante">
            <a class="pm-nav-sub-item active" href="<%= BP %>/visitante/comunicar"><img class="pm-nav-ico" src="<%= BP %>/images/comunicar_visita.png" alt="" aria-hidden="true">Comunicar visita</a>
            <a class="pm-nav-sub-item" href="<%= BP %>/visitante/historico"><img class="pm-nav-ico" src="<%= BP %>/images/historico.png" alt="" aria-hidden="true">HistÃ³rico de acessos</a>
          </div>
        </details>

        <details class="pm-nav-details">
          <summary class="pm-nav-item pm-nav-item--summary"><img class="pm-nav-ico" src="<%= BP %>/images/financeiro.png" alt="" aria-hidden="true">Financeiro</summary>
          <div class="pm-nav-sub" role="group" aria-label="Financeiro">
            <a class="pm-nav-sub-item" href="<%= BP %>/financeiro/boletos"><img class="pm-nav-ico" src="<%= BP %>/images/boleto.png" alt="" aria-hidden="true">Meus boletos</a>
          </div>
        </details>
      </nav>
      <div class="pm-sidebar-footer">Portal do Morador Â· WD Gestor</div>
    </aside>

    <div class="pm-main">
      <%- include('./partials/topbar-shared', { nameModeId: 'pmNameModeVisita' }) %>

      <section class="pm-toolbar" id="pmToolbar">
        <div class="pm-toolbar-body" id="pmToolbarBody">
          <div class="pm-condo-center">
            <small>CondomÃ­nio</small>
            <strong><%= typeof unidadeNome === 'string' ? unidadeNome : 'Seu CondomÃ­nio' %></strong>
            <button class="pm-hab-switch" id="pmHabSwitcher" type="button" aria-haspopup="dialog" aria-expanded="false">
              <span class="pm-hab-switch__icon"><img src="<%= BP %>/images/home.png" alt=""></span>
              <span class="pm-hab-switch__label" id="pmHabSwitcherLabel"><%= habitacaoLabel || 'HabitaÃ§Ã£o selecionada' %></span>
              <i class="bi bi-chevron-down"></i>
            </button>
          </div>
          <div class="pm-search" role="search" aria-label="Pesquisar no portal">
            <i class="bi bi-search"></i>
            <input type="search" placeholder="Procure aqui o que vocÃª precisa..." aria-label="Pesquisar">
          </div>
        </div>
        <button class="pm-toolbar-toggle" id="pmToolbarToggle" type="button" aria-expanded="true" aria-label="Recolher barra">
          <span class="pm-toolbar-toggle__chevron" aria-hidden="true"></span>
        </button>
      </section>

      <div class="pm-hab-menu-portal" id="pmHabSwitcherMenu" hidden>
        <div class="pm-hab-menu" role="dialog" aria-modal="true" aria-label="Selecionar habitaÃ§Ã£o">
          <div class="pm-hab-menu-head">
            <div>
              <small>HabitaÃ§Ãµes</small>
              <strong>Selecione para operar</strong>
            </div>
            <button type="button" class="pm-hab-menu-close" id="pmHabMenuClose" aria-label="Fechar">Ã—</button>
          </div>
          <div class="pm-hab-menu-grid" id="pmHabMenuGrid" role="listbox" aria-label="HabitaÃ§Ãµes disponÃ­veis"></div>
          <div class="pm-hab-menu-pager" id="pmHabMenuPager"></div>
        </div>
      </div>

      <main class="pm-content">
        <div class="pm-visitante-shell">
          <section class="pm-panel pm-visitante-form">
            <div class="pm-page-title pm-page-title--center" style="margin-bottom: 0.6rem">
              <small>Visitante</small>
              <strong>Comunicar visita</strong>
            </div>
            <form id="pmVisitaForm" novalidate>
              <fieldset class="pm-fieldset pm-visitante-context">
                <legend>InformaÃ§Ãµes da visita</legend>
                <div class="pm-visitante-grid pm-visitante-grid--context">
                  <div class="pm-field">
                    <label for="pmVisitaHab">HabitaÃ§Ã£o</label>
                    <div class="pm-hab-chip" id="pmVisitaHabLabel"><%= habitacaoLabel || 'HabitaÃ§Ã£o selecionada' %></div>
                    <input type="hidden" id="pmVisitaHab" value="<%= habitacaoId || '' %>">
                  </div>
                  <div class="pm-field">
                    <label for="pmVisitaFinalidade">Finalidade da visita</label>
                    <select id="pmVisitaFinalidade" required>
                      <option value="" disabled selected>Selecione</option>
                      <option value="obras">Obras</option>
                      <option value="prestacao">PrestaÃ§Ã£o de serviÃ§o</option>
                      <option value="visita">Visita comum</option>
                      <option value="entrega">Entrega ou retirada</option>
                      <option value="outros">Outros</option>
                    </select>
                  </div>
                </div>
              </fieldset>

              <fieldset class="pm-fieldset">
                <legend>Dados pessoais</legend>
                <div class="pm-field pm-field--full">
                  <label for="pmVisitaNome">Nome completo</label>
                  <input id="pmVisitaNome" type="text" maxlength="120" required>
                </div>
                <div class="pm-visitante-row pm-visitante-row--identity">
                  <div class="pm-field pm-field--compact">
                    <label for="pmVisitaRg">RG</label>
                    <input id="pmVisitaRg" type="text" maxlength="20" inputmode="numeric">
                  </div>
                  <div class="pm-field pm-field--compact">
                    <label for="pmVisitaCpf">CPF</label>
                    <input id="pmVisitaCpf" type="text" maxlength="14" inputmode="numeric">
                  </div>
                  <div class="pm-field pm-field--medium">
                    <label for="pmVisitaTel">Tel.</label>
                    <input id="pmVisitaTel" type="tel" maxlength="20" inputmode="tel">
                  </div>
                </div>
              </fieldset>

              <fieldset class="pm-fieldset">
                <legend>PerÃ­odo autorizado</legend>
                <div class="pm-visitante-row pm-visitante-row--period">
                  <div class="pm-field pm-field--compact">
                    <label for="pmVisitaInicio">Data inicial</label>
                    <input id="pmVisitaInicio" type="date" required>
                  </div>
                  <div class="pm-field pm-field--compact">
                    <label for="pmVisitaFim">Data final</label>
                    <input id="pmVisitaFim" type="date" required>
                  </div>
                </div>
              </fieldset>

              <div class="pm-visitante-vehicle-toggle">
                <label class="pm-switch">
                  <input type="checkbox" id="pmVisitaVeiculoToggle">
                  <span>O visitante chegarÃ¡ de veÃ­culo</span>
                </label>
              </div>

              <fieldset class="pm-fieldset" id="pmVisitaVeiculoFields">
                <legend>Dados do veÃ­culo</legend>
                <div class="pm-visitante-vehicle-plate pm-field pm-field--full">
                  <label for="pmVisitaPlaca">Placa</label>
                  <input id="pmVisitaPlaca" type="text" maxlength="7" placeholder="ABC1D23" data-vehicle-field>
                </div>
                <div class="pm-visitante-grid pm-visitante-grid--vehicle-triple">
                  <div class="pm-field">
                    <label for="pmVisitaVeiculoTipo">Tipo do veÃ­culo</label>
                    <select id="pmVisitaVeiculoTipo" data-vehicle-field>
                      <option value="" selected disabled>Selecione</option>
                    </select>
                  </div>
                  <div class="pm-field">
                    <label for="pmVisitaMarca">Marca</label>
                    <select id="pmVisitaMarca" data-vehicle-field disabled>
                      <option value="">Selecione o tipo do veÃ­culo</option>
                    </select>
                  </div>
                  <div class="pm-field">
                    <label for="pmVisitaModelo">Modelo</label>
                    <input id="pmVisitaModelo" type="text" maxlength="50" data-vehicle-field>
                  </div>
                </div>
                <div class="pm-visitante-grid pm-visitante-grid--vehicle">
                  <div class="pm-field">
                    <label for="pmVisitaCor">Cor</label>
                    <input id="pmVisitaCor" type="text" maxlength="30" data-vehicle-field>
                  </div>
                  <div class="pm-field">
                    <label for="pmVisitaAno">Ano</label>
                    <input id="pmVisitaAno" type="number" min="1950" max="2100" step="1" data-vehicle-field>
                  </div>
                </div>
              </fieldset>

              <div class="pm-field pm-field--full">
                <label for="pmVisitaObs">ObservaÃ§Ãµes</label>
                <textarea id="pmVisitaObs" rows="3" maxlength="600"></textarea>
              </div>

              <div class="pm-form-actions">
                <button class="pm-btn pm-btn--ghost" type="reset">Limpar</button>
                <button class="pm-btn" type="submit">Comunicar visita</button>
              </div>
            </form>
          </section>

          <section class="pm-panel pm-visitante-historico" id="pmHistoricoVisitas">
            <div class="pm-visitante-historico-head">
              <div>
                <h3>HistÃ³rico recente</h3>
              </div>
              <button class="pm-btn pm-btn--ghost" id="pmVisitaRefresh" type="button"><i class="bi bi-arrow-repeat"></i>Atualizar</button>
            </div>
            <div class="pm-visitante-empty" id="pmVisitasEmpty" hidden>
              Nenhuma visita registrada ainda.
            </div>
            <div class="pm-visitante-cards" id="pmVisitasLista" aria-live="polite"></div>
          </section>
        </div>
      </main>
    </div>
  </div>

  <script src="<%= BP %>/js/portal_morador_nav_active.js?v=<%= Date.now() %>"></script>
  <script src="<%= BP %>/js/portal_morador_groups_menu.js?v=<%= Date.now() %>"></script>
  <script src="<%= BP %>/js/portal_morador_hab_switcher.js?v=<%= Date.now() %>"></script>

  <div class="pm-modal-overlay" id="pmDeleteVisitaConfirm" hidden>
    <div class="pm-modal" role="dialog" aria-modal="true" aria-labelledby="pmDeleteVisitaConfirmTitle">
      <div class="pm-modal-body">
        <div class="pm-modal-title">
          <strong id="pmDeleteVisitaConfirmTitle">Tem certeza que deseja excluir essa visita?</strong>
        </div>
        <div class="pm-modal-actions">
          <button class="pm-btn" id="pmDeleteVisitaConfirmYes" type="button">Sim</button>
          <button class="pm-btn pm-btn--ghost" id="pmDeleteVisitaConfirmNo" type="button">NÃ£o</button>
        </div>
      </div>
    </div>
  </div>

  <script src="<%= BP %>/js/portal_morador_comunicar_visita.js?v=<%= Date.now() %>"></script>
  <script src="<%= BP %>/js/portal_morador_user_menu.js?v=<%= Date.now() %>"></script>
</body>
</html>
