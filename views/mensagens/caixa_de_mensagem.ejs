      transition: transform .16s var(--wdg-msg-ease), box-shadow .16s var(--wdg-msg-ease);
    }
    .wdg-msg-panel:hover{ transform: none; box-shadow: var(--wdg-msg-shadow-hover); }

    /* vidro moderno quando suportado */
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      .wdg-msg-panel{
        background: var(--wdg-msg-glass-bg);
        -webkit-backdrop-filter: blur(14px) saturate(130%);
        backdrop-filter: blur(14px) saturate(130%);
        border-color: var(--wdg-msg-glass-border);
        box-shadow: var(--wdg-msg-glow);
      }
      .wdg-msg-panel:hover{ box-shadow: 0 0 0 1px rgba(255,255,255,.65), 0 28px 70px rgba(2,6,23,.14); }
    }

    /* Anti-flash: remove overlay radial em hover */
    .wdg-msg-panel::after{ content: none; }
    .wdg-msg-panel-head { display:flex; align-items:flex-start; justify-content:space-between; gap: .75rem; flex-wrap: wrap; }
    .wdg-msg-chip { display:inline-flex; align-items:center; gap:.45rem; border:1px solid rgba(15,23,42,.12); background: rgba(var(--wdg-accent-rgb), .06); color: var(--wdg-text); border-radius: 999px; padding: .35rem .65rem; font-weight: 800; font-size: .82rem; }
    .wdg-msg-panel h2 { margin: 0; font-size: 1.15rem; font-weight: 900; letter-spacing: -.01em; color: var(--wdg-text); }
    .wdg-msg-panel p.lead { margin: .35rem 0 0; font-size: .95rem; color: var(--wdg-text-light); font-weight: 650; }

    .wdg-msg-body { margin-top: 1rem; }
    /* Rótulos do formulário (Para/Cópia/Assunto/etc): sem negrito */
    .wdg-msg-body .form-label { font-weight: 600; }
    /* Botões na Caixa de Mensagem: evitar negrito (pedido UX) */
    .wdg-msg-body .btn { border-radius: 14px; font-weight: 500; }
    /* Garante que os botões de ação do composer (Responder/Encaminhar/Anexar/Limpar/Enviar) fiquem sem negrito */
    body.wdg-msg #msgBody [data-inline-top-left="1"] .btn,
    body.wdg-msg #msgBody [data-compose-attach-header="1"] .btn,
    body.wdg-msg #msgBody form[id$="msgCompose"] .d-flex.justify-content-end .btn {
      font-weight: 500 !important;
    }
    .wdg-msg-body .btn.wdg-btn-regular { font-weight: 400 !important; }

    /* Ícones em PNG nos botões (ações/toolbar) */
    body.wdg-layout.wdg-msg img.msg-action-ico {
      width: 20px;
      height: 20px;
      display: block;
      object-fit: contain;
      filter: drop-shadow(0 1px 0 rgba(255,255,255,.55));
    }

    body.wdg-layout.wdg-msg .btn-sm img.msg-action-ico {
      width: 20px;
      height: 20px;
    }

    /* Botões somente-ícone: SEM círculo ao redor (clique direto no ícone) */
    body.wdg-layout.wdg-msg .msg-icon-btn {
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
      border-radius: 0 !important;
      width: auto;
      height: auto;
      min-width: 0;
      min-height: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform .14s var(--wdg-msg-ease), filter .14s var(--wdg-msg-ease), opacity .14s var(--wdg-msg-ease);
    }

    body.wdg-layout.wdg-msg .msg-icon-btn:hover {
      transform: translateY(-1px);
      filter: drop-shadow(0 14px 22px rgba(2,6,23,.14));
    }

    body.wdg-layout.wdg-msg .msg-icon-btn:active{ transform: translateY(0); opacity: .88; }

    body.wdg-layout.wdg-msg .msg-icon-btn:focus-visible {
      outline: none;
      box-shadow: var(--wdg-focus-ring) !important;
    }

    /* Estado ativo (Somente não lidas): destaca sem círculo */
    body.wdg-layout.wdg-msg .msg-icon-btn.msg-icon-btn-active {
      filter: drop-shadow(0 0 0 rgba(0,0,0,0)) drop-shadow(0 12px 22px rgba(var(--wdg-primary-rgb), .22));
    }

    /* Alguns PNGs (arquivar/fixar) tinham mais “respiro” interno.
       Como o tamanho agora é ajustado via JS, não aplicamos escala extra aqui. */
    body.wdg-layout.wdg-msg :is(#msgActArchive, #msgActPin) img.msg-action-ico {
      transform: none;
    }

    /* Opcional: remove a seta padrão do dropdown para ficar mais clean */
    body.wdg-layout.wdg-msg .msg-icon-btn.dropdown-toggle::after {
      display: none;
    }

    /* Configurações > Caixas: ações + edição inline */
    .wdg-cfg-namecell{ display:flex; align-items:center; gap:.55rem; }
    .wdg-cfg-iconbtn{ border:0; background:transparent; box-shadow:none; outline:none; width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center; padding:0; }
    .wdg-cfg-iconbtn[disabled]{ opacity:.45; cursor:not-allowed; }
    .wdg-cfg-icon{ width:22px; height:22px; object-fit:contain; display:block; }
    .wdg-cfg-nameinput{ max-width: 360px; }

    /* Polimento moderno (sem alterar UX) */
    body.wdg-msg .wdg-msg-panel-head{ align-items: center; }
    body.wdg-msg .wdg-msg-panel h2{ font-size: 1.2rem; }
    body.wdg-msg .wdg-msg-panel p.lead{ font-size: .9rem; margin-top: .25rem; }

    /* Cards */
    body.wdg-msg .wdg-card{ border: 1px solid rgba(15,23,42,.08); }
    body.wdg-msg .wdg-card.wdg-card-hover{ transition: transform .12s ease, box-shadow .12s ease; }
    body.wdg-msg .wdg-card.wdg-card-hover:hover{ transform: translateY(-1px); box-shadow: 0 18px 50px rgba(2,6,23,.12); }

    /* Inputs */
    body.wdg-msg .form-control,
    body.wdg-msg .form-select{
      border-radius: var(--wdg-msg-radius-sm);
      border-color: rgba(15,23,42,.10);
      box-shadow: 0 1px 2px rgba(2,6,23,.06);
    }
    body.wdg-msg .form-control::placeholder{ color: rgba(15,23,42,.45); font-weight: 600; }
    body.wdg-msg .form-control:focus,
    body.wdg-msg .form-select:focus{
      border-color: rgba(var(--wdg-primary-rgb), .40);
      box-shadow: 0 0 0 3px rgba(var(--wdg-primary-rgb), .12);
    }

    /* Botões */
    body.wdg-msg .btn{ border-radius: 14px; }
    body.wdg-msg .btn-primary{
      border: 0;
      background-image: linear-gradient(135deg, rgba(var(--wdg-primary-rgb), .98), rgba(var(--wdg-accent-rgb), .88));
      box-shadow: 0 12px 28px rgba(var(--wdg-primary-rgb), .22);
    }
    body.wdg-msg .btn-primary:hover{ box-shadow: 0 18px 38px rgba(var(--wdg-primary-rgb), .26); filter: saturate(1.03); }
    body.wdg-msg .btn-primary:active{ transform: translateY(1px); box-shadow: 0 10px 24px rgba(var(--wdg-primary-rgb), .20); }
    body.wdg-msg .btn-outline-secondary{
      border-color: rgba(15,23,42,.16);
      background: rgba(255,255,255,.60);
      box-shadow: 0 10px 22px rgba(2,6,23,.10);
    }
    body.wdg-msg .btn-outline-secondary:hover{
      border-color: rgba(var(--wdg-primary-rgb), .22);
      background: rgba(255,255,255,.84);
      box-shadow: 0 14px 30px rgba(2,6,23,.14);
      transform: translateY(-1px);
    }

    /* Topbar da lista (Entrada/Saída/Arquivo/Lixeira) */
    #msgListTop{
      padding: .65rem .75rem;
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.86);
      box-shadow: 0 14px 34px rgba(2,6,23,.10);
    }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      #msgListTop{
        background: rgba(255,255,255,.52);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        backdrop-filter: blur(12px) saturate(140%);
      }
    }
    #msgListTop .input-group{ border-radius: 999px; overflow: hidden; box-shadow: 0 14px 30px rgba(2,6,23,.12); }
    #msgListTop .input-group-text{
      border: 0;
      background: rgba(255,255,255,.70);
      color: rgba(15,23,42,.70);
      padding-left: .85rem;
      padding-right: .7rem;
    }
    #msgListTop #msgSearch{
      border: 0;
      background: rgba(255,255,255,.70);
      font-weight: 650;
    }
    #msgListTop #msgSearch:focus{ box-shadow: none; }
    #msgListTop #msgActionsWrap .text-muted.small{ font-weight: 800; }

    /* Container da lista: vira um “card glass” */
    .table-responsive:has(#msgListBody){
      border-radius: 20px;
      padding: .65rem;
      background: rgba(255,255,255,.70);
      border: 1px solid rgba(15,23,42,.10);
      box-shadow: 0 18px 46px rgba(2,6,23,.10);
    }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      .table-responsive:has(#msgListBody){
        background: rgba(255,255,255,.46);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        backdrop-filter: blur(12px) saturate(140%);
      }
    }

    /* Fallback (sem :has): lista dentro do painel atual tende a ser a única table-responsive mt-2 com esse layout */
    @supports not selector(.x:has(.y)) {
      body.wdg-msg .wdg-msg-panel .table-responsive.mt-2{
        border-radius: 20px;
        padding: .65rem;
        background: rgba(255,255,255,.70);
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: 0 18px 46px rgba(2,6,23,.10);
      }
      @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
        body.wdg-msg .wdg-msg-panel .table-responsive.mt-2{
          background: rgba(255,255,255,.46);
          -webkit-backdrop-filter: blur(12px) saturate(140%);
          backdrop-filter: blur(12px) saturate(140%);
        }
      }
      body.wdg-msg .wdg-msg-panel .table-responsive.mt-2 table.table{
        border-collapse: separate !important;
        border-spacing: 0 .60rem !important;
        --bs-table-bg: transparent;
        --bs-table-hover-bg: transparent;
        --bs-table-striped-bg: transparent;
      }
    }

    /* Painel de filtros */
    #msgFilterPanel.card{
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.86);
      box-shadow: 0 16px 40px rgba(2,6,23,.10);
    }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      #msgFilterPanel.card{
        background: rgba(255,255,255,.56);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        backdrop-filter: blur(12px) saturate(140%);
      }
    }
    #msgFilterPanel .form-check{ user-select: none; }

    /* Dropdowns (Selecionar / Marcador) com look moderno
       IMPORTANTE: escopa em #msgBody para NÃO afetar dropdowns do navbar */
    body.wdg-msg #msgBody .dropdown-menu{
      border-radius: 16px;
      border: 1px solid rgba(15,23,42,.12);
      box-shadow: 0 22px 60px rgba(2,6,23,.18);
      padding: .35rem;
    }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-msg #msgBody .dropdown-menu{
        background: rgba(255,255,255,.72);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        backdrop-filter: blur(12px) saturate(140%);
      }
    }
    body.wdg-msg #msgBody .dropdown-item{
      border-radius: 12px;
      font-weight: 500;
    }
    body.wdg-msg #msgBody .dropdown-item:hover{ background: rgba(var(--wdg-primary-rgb), .10); }

    /* Dropdowns no detalhe devem extrapolar o bloco (sem clipping) */
    body.wdg-msg :is(.wdg-msg-panel, .wdg-msg-body, #msgBody){ overflow: visible !important; }
    body.wdg-msg #msgBody .dropdown-menu{ z-index: 4000; }

    /* Lista de mensagens (tabela sem thead) */
    body.wdg-msg input[type="checkbox"],
    body.wdg-msg .form-check-input{ accent-color: var(--wdg-primary); }

    @supports selector(table:has(#msgListBody)) {
      table:has(#msgListBody){
        border-collapse: separate !important;
        border-spacing: 0 .60rem !important;
        --bs-table-bg: transparent;
        --bs-table-hover-bg: transparent;
        --bs-table-striped-bg: transparent;
      }
    }
    #msgListBody tr.table-light td{
      background: transparent !important;
      border: 0 !important;
      padding: .45rem .5rem;
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: .72rem;
      font-weight: 950;
      color: rgba(15,23,42,.55) !important;
    }
    #msgListBody tr[data-msg-row="1"]{
      transition: transform .12s var(--wdg-msg-ease);
    }
    #msgListBody tr[data-msg-row="1"] td{
      background: rgba(255,255,255,.92);
      border-top: 1px solid rgba(15,23,42,.08);
      border-bottom: 1px solid rgba(15,23,42,.08);
      padding-top: .7rem;
      padding-bottom: .7rem;
      font-weight: 520;
      color: rgba(15,23,42,.88);
    }
    #msgListBody tr[data-msg-row="1"] td:nth-child(2){
      font-weight: 560;
      letter-spacing: -.01em;
    }
    #msgListBody tr[data-msg-row="1"] td:nth-child(3){
      font-weight: 520;
    }
    #msgListBody tr[data-msg-row="1"] td:nth-child(4){
      font-feature-settings: "tnum" 1, "lnum" 1;
      opacity: .72;
    }
    #msgListBody tr[data-msg-row="1"] td:first-child{
      border-left: 1px solid rgba(15,23,42,.08);
      border-top-left-radius: 16px;
      border-bottom-left-radius: 16px;
    }
    #msgListBody tr[data-msg-row="1"] td:last-child{
      border-right: 1px solid rgba(15,23,42,.08);
      border-top-right-radius: 16px;
      border-bottom-right-radius: 16px;
    }
    #msgListBody tr[data-msg-row="1"]:hover{ transform: translateY(-1px); }
    /* Hover: cor ÚNICA na linha inteira */
    #msgListBody tr[data-msg-row="1"]:hover td{
      background: rgba(var(--wdg-primary-rgb), .12) !important;
      border-color: rgba(var(--wdg-primary-rgb), .32) !important;
      box-shadow: 0 12px 26px rgba(2,6,23,.10);
    }
    /* Não lidas: cor ÚNICA na linha inteira (sem camadas/gradientes/indicadores por coluna) */
    #msgListBody tr.wdg-msg-row--unread td{
      background: rgba(var(--wdg-primary-rgb), .08) !important;
    }

    /* Não lidas: mais contraste no texto (sem alterar o fundo por coluna) */
    #msgListBody tr.wdg-msg-row--unread td:nth-child(2){
      font-weight: 950;
      color: rgba(15,23,42,.98);
    }
    #msgListBody tr.wdg-msg-row--unread td:nth-child(3){
      font-weight: 800;
    }
    #msgListBody tr.wdg-msg-row--unread td:nth-child(4){
      opacity: .92;
    }

    /* Badges (marcadores / cópia) com mais “acabamento” */
    #msgListBody .badge{
      box-shadow: 0 10px 22px rgba(2,6,23,.10);
      border: 1px solid rgba(15,23,42,.12);
      letter-spacing: .08em;
    }

    /* Negrito somente para não lidas (JS aplica `.fw-bold` só nelas) */
    #msgListBody td.fw-bold{ font-weight: 900 !important; color: rgba(15,23,42,.98) !important; }
    @supports selector(tr:has(input:checked)) {
      #msgListBody tr[data-msg-row="1"]:has(input[data-msg-check="1"]:checked) td{
        background: rgba(var(--wdg-primary-rgb), .10);
        border-color: rgba(var(--wdg-primary-rgb), .24);
      }
    }

    /* Compose (Nova mensagem) */
    [data-compose-attach-header="1"] .btn{
      border-radius: 999px;
      border-color: rgba(15,23,42,.14);
      background: rgba(255,255,255,.65);
      box-shadow: 0 10px 24px rgba(2,6,23,.10);
    }
    [data-compose-attach-header="1"] .btn:hover{ transform: translateY(-1px); box-shadow: 0 14px 28px rgba(2,6,23,.14); }
    body.wdg-msg [contenteditable].form-control{
      border-radius: 18px;
      border-color: rgba(15,23,42,.12);
      background: rgba(255,255,255,.80);
      box-shadow: 0 12px 28px rgba(2,6,23,.08);
      line-height: 1.5;
      padding: .85rem .95rem;
    }
    body.wdg-msg [contenteditable].form-control:focus{
      border-color: rgba(var(--wdg-primary-rgb), .45);
      box-shadow: 0 0 0 3px rgba(var(--wdg-primary-rgb), .12), 0 18px 44px rgba(2,6,23,.10);
      background: rgba(255,255,255,.92);
    }

    /* Leitura (detalhe da mensagem) */
    body.wdg-msg #msgBody #msgDetailBack{
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
      border-radius: 0 !important;
      width: auto;
      height: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform .14s var(--wdg-msg-ease), filter .14s var(--wdg-msg-ease), opacity .14s var(--wdg-msg-ease);
    }
    body.wdg-msg #msgBody #msgDetailBack:hover{
      transform: translateY(-1px);
      filter: drop-shadow(0 12px 18px rgba(2,6,23,.14));
    }
    body.wdg-msg #msgBody #msgDetailBack:active{ transform: translateY(0); opacity: .88; }

    /* Cabeçalho do detalhe: deixa com cara de “reader” e reduz o inline font-size do JS */
    body.wdg-msg #msgBody #msgDetailBack + div.fw-bold{
      font-size: 1.65rem !important;
      line-height: 1.12 !important;
      letter-spacing: -.02em;
      color: rgba(15,23,42,.96) !important;
    }
    @media (max-width: 576px){
      body.wdg-msg #msgBody #msgDetailBack + div.fw-bold{ font-size: 1.25rem !important; }
    }

    /* Sticky do header do detalhe (quando suportado), sem afetar outras views */
    @supports selector(div:has(#msgDetailBack)) {
      body.wdg-msg #msgBody > div:has(#msgDetailBack){
        position: sticky;
        top: 0;
        z-index: 5;
        padding: .55rem .55rem .75rem;
        margin: -.35rem -.35rem .85rem;
        border-radius: 18px;
        border: 1px solid rgba(15,23,42,.10);
        background: rgba(255,255,255,.74);
        box-shadow: 0 14px 34px rgba(2,6,23,.10);
      }
      @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
        body.wdg-msg #msgBody > div:has(#msgDetailBack){
          background: rgba(255,255,255,.48);
          -webkit-backdrop-filter: blur(12px) saturate(140%);
          backdrop-filter: blur(12px) saturate(140%);
        }
      }
    }

    /* Prompt “clique aqui para responder” */
    body.wdg-msg #msgBody [data-inline-prompt="1"]{
      cursor: text;
      border-radius: 18px;
      border: 1px dashed rgba(var(--wdg-primary-rgb), .26);
      background: rgba(var(--wdg-primary-rgb), .05);
      transition: transform .14s var(--wdg-msg-ease), box-shadow .14s var(--wdg-msg-ease), background .14s var(--wdg-msg-ease);
    }
    body.wdg-msg #msgBody [data-inline-prompt="1"]:hover{
      transform: translateY(-1px);
      background: rgba(var(--wdg-primary-rgb), .07);
      box-shadow: 0 14px 30px rgba(2,6,23,.10);
    }
    body.wdg-msg #msgBody [data-inline-prompt="1"] .text-muted{ font-weight: 500; }

    /* Thread (cards do detalhe) */
    body.wdg-msg #msgBody #msgThreadHost .card{
      border-radius: 22px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.74);
      box-shadow: 0 18px 46px rgba(2,6,23,.10);
      overflow: visible;
      transition: transform .14s var(--wdg-msg-ease), box-shadow .14s var(--wdg-msg-ease);
    }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-msg #msgBody #msgThreadHost .card{
        background: rgba(255,255,255,.46);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        backdrop-filter: blur(12px) saturate(140%);
      }
    }
    body.wdg-msg #msgBody #msgThreadHost .card:hover{
      transform: translateY(-1px);
      box-shadow: 0 26px 70px rgba(2,6,23,.12);
    }
    body.wdg-msg #msgBody #msgThreadHost .card .card-body{ padding: 1.05rem 1.15rem; }
    body.wdg-msg #msgBody #msgThreadHost .card hr{ opacity: .10; }

    /* Avatar e cabeçalho por mensagem */
    body.wdg-msg #msgBody #msgThreadHost img{
      box-shadow: 0 10px 22px rgba(2,6,23,.12);
    }
    body.wdg-msg #msgBody #msgThreadHost .fw-semibold{ font-weight: 900 !important; letter-spacing: -.01em; }

    /* Corpo HTML renderizado */
    body.wdg-msg #msgBody #msgThreadHost .msg-body{
      font-size: 1rem;
      line-height: 1.65;
      color: rgba(15,23,42,.92);
    }
    body.wdg-msg #msgBody #msgThreadHost .msg-body p{ margin-bottom: .85rem; }
    body.wdg-msg #msgBody #msgThreadHost .msg-body :is(h1,h2,h3){ letter-spacing: -.02em; }
    body.wdg-msg #msgBody #msgThreadHost .msg-body a{ color: rgba(var(--wdg-primary-rgb), 1); font-weight: 800; text-decoration: none; }
    body.wdg-msg #msgBody #msgThreadHost .msg-body a:hover{ text-decoration: underline; }
    body.wdg-msg #msgBody #msgThreadHost .msg-body :is(img,video){ max-width: 100%; height: auto; border-radius: 14px; }
    body.wdg-msg #msgBody #msgThreadHost .msg-body blockquote{
      margin: .85rem 0;
      padding: .75rem .9rem;
      border-left: 4px solid rgba(var(--wdg-primary-rgb), .40);
      border-radius: 14px;
      background: rgba(var(--wdg-primary-rgb), .06);
      color: rgba(15,23,42,.78);
    }
    body.wdg-msg #msgBody #msgThreadHost .msg-body code{
      border-radius: 10px;
      padding: .12rem .35rem;
      background: rgba(15,23,42,.06);
    }
    body.wdg-msg #msgBody #msgThreadHost .msg-body pre{
      border-radius: 16px;
      padding: .9rem;
      background: rgba(15,23,42,.06);
      overflow: auto;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.55);
    }

    /* Destinatários (Para/Cópia) estavam pequenos por causa do `.small` */
    body.wdg-msg #msgBody #msgThreadHost .card-body > .mt-2 .small{
      font-size: .98rem;
      line-height: 1.45;
      font-weight: 520;
      color: rgba(15,23,42,.88);
    }
    body.wdg-msg #msgBody #msgThreadHost .card-body > .mt-2 .small .text-muted{
      font-size: .92rem;
      font-weight: 650;
      color: rgba(15,23,42,.62) !important;
    }
    body.wdg-msg #msgBody #msgThreadHost .card-body > .mt-2 .badge{
      font-size: .88rem;
      padding: .25rem .5rem;
      border-radius: 999px;
    }

    /* Bloco de anexos (detalhe) */
    body.wdg-msg #msgBody [data-att-root="1"]{
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.10) !important;
      background: rgba(255,255,255,.70);
      box-shadow: 0 16px 40px rgba(2,6,23,.10);
      overflow: hidden;
    }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-msg #msgBody [data-att-root="1"]{
        background: rgba(255,255,255,.46);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        backdrop-filter: blur(12px) saturate(140%);
      }
    }
    body.wdg-msg #msgBody [data-att-root="1"] .list-group-item{
      border-color: rgba(15,23,42,.10);
      background: transparent;
    }
    body.wdg-msg #msgBody [data-att-root="1"] .list-group-item:hover{ background: rgba(var(--wdg-primary-rgb), .05); }
    body.wdg-msg #msgBody [data-att-root="1"] [data-att-access-row="1"] img{ box-shadow: none; }

    /* Menus/painéis flutuantes do detalhe (histórico) */
    body.wdg-msg #msgHistoryMenu.dropdown-menu{
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.12);
      box-shadow: 0 30px 80px rgba(2,6,23,.22);
      overflow: hidden;
    }
    body.wdg-msg .wdg-grp-members{
      border-radius: 18px;
      background: rgba(255,255,255,.66);
      border: 1px solid rgba(15,23,42,.10);
      box-shadow: 0 10px 26px rgba(2,6,23,.08);
    }
    body.wdg-msg .wdg-grp-members:focus-within{
      border-color: rgba(var(--wdg-primary-rgb), .30);
      box-shadow: 0 0 0 3px rgba(var(--wdg-primary-rgb), .10), 0 14px 30px rgba(2,6,23,.10);
      background: rgba(255,255,255,.82);
    }
    body.wdg-msg .wdg-grp-member{ box-shadow: 0 6px 14px rgba(2,6,23,.08); }
    body.wdg-msg .wdg-grp-member-remove:hover{ background: rgba(239,68,68,.12); }

    /* Anexos (lista) */
    body.wdg-msg [id$="msgAttachList"].list-group .list-group-item{
      border-radius: 14px;
      border: 1px solid rgba(15,23,42,.10);
      box-shadow: 0 10px 22px rgba(2,6,23,.08);
      margin-bottom: .45rem;
    }

    /* Scrollbars (áreas com overflow) */
    :is(.wdg-cfg-ops-tablewrap .table-responsive, .wdg-msg-menu)::-webkit-scrollbar{ width: 10px; height: 10px; }
    :is(.wdg-cfg-ops-tablewrap .table-responsive, .wdg-msg-menu)::-webkit-scrollbar-track{ background: transparent; }
    :is(.wdg-cfg-ops-tablewrap .table-responsive, .wdg-msg-menu)::-webkit-scrollbar-thumb{
      background: rgba(15,23,42,.22);
      border-radius: 999px;
      border: 3px solid transparent;
      background-clip: content-box;
    }
    :is(.wdg-cfg-ops-tablewrap .table-responsive, .wdg-msg-menu)::-webkit-scrollbar-thumb:hover{ background: rgba(15,23,42,.30); border: 3px solid transparent; background-clip: content-box; }

    /* Tabelas (especialmente em Configurações > Caixas) */
    body.wdg-msg .wdg-cfg-layout .table-responsive{
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(15,23,42,.08);
    }
    body.wdg-msg .wdg-cfg-layout .table{ --bs-table-bg: transparent; margin-bottom: 0; }
    body.wdg-msg .wdg-cfg-layout .table thead th{
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--wdg-text-light);
      font-weight: 900;
      border-bottom: 1px solid rgba(15,23,42,.10);
      background: rgba(var(--wdg-primary-rgb), .04);
      white-space: nowrap;
      text-align: center;
    }
    body.wdg-msg .wdg-cfg-layout .table tbody td{
      border-top: 1px solid rgba(15,23,42,.06);
      vertical-align: middle;
      text-align: center;
    }
    body.wdg-msg .wdg-cfg-layout .table tbody tr:hover{ background: rgba(var(--wdg-primary-rgb), .04); }

    /* Tabela de operadores: checkbox maior */
    #cfgOpsTable .form-check-input{
      transform: scale(1.6);
      transform-origin: center;
    }
    #cfgOpsTable td{ padding-top: .65rem; padding-bottom: .65rem; }

    /* Permissões em 2 colunas (responsivo) */
    body.wdg-msg .wdg-cfg-permscols{
      display: grid;
      grid-template-columns: repeat(3, minmax(0, max-content));
      gap: .35rem 2rem;
      align-items: start;
      justify-content: start;
    }
    @media (max-width: 991.98px){
      body.wdg-msg .wdg-cfg-permscols{ grid-template-columns: repeat(2, minmax(0, max-content)); }
    }
    @media (max-width: 767.98px){
      body.wdg-msg .wdg-cfg-permscols{ grid-template-columns: 1fr; }
    }
    body.wdg-msg .wdg-cfg-permscol{ display:flex; flex-direction: column; gap: .35rem; }
    body.wdg-msg .wdg-cfg-permitem{ display:flex; align-items: center; gap: .55rem; min-height: 28px; }
    body.wdg-msg .wdg-cfg-permlabel{ white-space: normal; word-break: break-word; }

    /* Cabeçalho do editor (Pesquisar usuário) */
    body.wdg-msg .wdg-cfg-ops-head{ display:flex; align-items:end; justify-content:flex-start; gap:.75rem; }
    body.wdg-msg .wdg-cfg-ops-search{ width: 720px; max-width: 100%; }
    body.wdg-msg #cfgOpsSearch.form-control{
      min-height: 38px;
      border-radius: 999px;
      padding-left: .9rem;
    }

    /* Wrapper da tabela paginada */
    body.wdg-msg .wdg-cfg-ops-tablewrap{
      margin-top: .6rem;
      border: 1px solid rgba(15,23,42,.10);
      border-radius: 16px;
      overflow: hidden;
      max-height: 320px;
      background: rgba(255,255,255,.7);
    }
    body.wdg-msg .wdg-cfg-ops-tablewrap .table-responsive{ max-height: 320px; overflow-y:auto; overflow-x:auto; }

    /* Cabeçalho fixo na lista (Usuários e Permissões) */
    #cfgOpsTable{ border-collapse: separate; border-spacing: 0; }
    #cfgOpsTable{ width: 100%; table-layout: fixed; }
    #cfgOpsTable th, #cfgOpsTable td{ overflow: hidden; }
    #cfgOpsTable thead th{
      position: sticky;
      top: 0;
      z-index: 3;
      background: rgba(var(--wdg-primary-rgb), .08);
      backdrop-filter: blur(6px);
    }

    /* Tabela (visual): uniforme em todas as colunas */
    #cfgOpsTable tbody tr{ transition: transform .12s ease, box-shadow .12s ease; }
    #cfgOpsTable tbody td{
      background: rgba(255,255,255,.92);
      border-top: 1px solid rgba(15,23,42,.06);
    }
    #cfgOpsTable tbody tr:hover{ transform: translateY(-1px); }
    #cfgOpsTable tbody tr:hover td{ background: rgba(var(--wdg-primary-rgb), .035); }

    /* Coluna Usuário: suaviza o brilho para combinar com a tabela */
    #cfgOpsTable .wdg-userpick-field{
      background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,1));
      box-shadow: 0 1px 2px rgba(2,6,23,.06), 0 10px 24px rgba(2,6,23,.08);
    }
    #cfgOpsTable .wdg-userpick-field:hover{
      box-shadow: 0 2px 4px rgba(2,6,23,.07), 0 14px 34px rgba(2,6,23,.10);
    }

    /* Paginação centralizada */
    body.wdg-msg .wdg-cfg-ops-pager{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:.6rem;
      padding-top:.75rem;
      flex-wrap:wrap;
      flex-direction:column;
    }
    body.wdg-msg .wdg-cfg-ops-pager-left{ text-align:center; }
    body.wdg-msg .wdg-cfg-ops-pager-right{ display:inline-flex; align-items:center; justify-content:center; gap:.35rem; flex-wrap:wrap; }
    body.wdg-msg .wdg-cfg-ops-pager-right .btn.btn-sm{ border-radius: 999px; padding: .25rem .55rem; }

    /* UserPick PRO (avatar + nome + badge dentro do mesmo campo) */
    .wdg-userpick.wdg-userpick-pro{ width: 520px; max-width: 100%; }

    /* No editor de operadores, a tabela pode comprimir a célula; force o campo a ocupar a coluna. */
    #cfgOpsTable td.wdg-cfg-td-user{ text-align: left; }
    #cfgOpsTable td.wdg-cfg-td-user .wdg-userpick{ display: block; }
    #cfgOpsTable td.wdg-cfg-td-user .wdg-userpick.wdg-userpick-pro{ width: 100% !important; max-width: 100% !important; }

    /* Permissões mais largas e alinhadas à esquerda */
    #cfgOpsTable td.wdg-cfg-td-perms{ text-align: left; }

    /* Centraliza o bloco de colunas dentro da área de permissões (sem mudar alinhamento interno) */
    #cfgOpsTable td.wdg-cfg-td-perms .wdg-cfg-permscols{
      width: max-content;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    /* Bloco de permissões com cara de "card" (para não ficar diferente do Usuário) */
    #cfgOpsTable td.wdg-cfg-td-perms .wdg-cfg-permscols{
      padding: .55rem .8rem;
      border-radius: 18px;
      border: 1px solid rgba(15,23,42,.08);
      background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,1));
      box-shadow: 0 1px 2px rgba(2,6,23,.05);
    }

    /* Coluna Ação: botão com background para ficar mais "clicável" */
    #cfgOpsTable td.wdg-cfg-td-action{ text-align: center; }
    #cfgOpsTable td.wdg-cfg-td-action [data-op-remove]{
      border-radius: 999px;
      width: 44px;
      height: 44px;
      background: rgba(239,68,68,.08);
      box-shadow: 0 1px 2px rgba(2,6,23,.05);
      transition: transform .12s ease, background .12s ease, box-shadow .12s ease;
    }
    #cfgOpsTable td.wdg-cfg-td-action [data-op-remove]:hover{
      background: rgba(239,68,68,.12);
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(239,68,68,.18);
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-field{
      position: relative;
      border-radius: 999px;
      padding: 0;
      background:
        linear-gradient(180deg, rgba(255,255,255,.95), rgba(255,255,255,1));
      box-shadow:
        0 1px 2px rgba(2,6,23,.06),
        0 14px 34px rgba(2,6,23,.10);
      border: 1px solid rgba(15,23,42,.10);
      transition: box-shadow .18s ease, transform .18s ease, border-color .18s ease;
      overflow: hidden;
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-field:hover{
      box-shadow:
        0 2px 4px rgba(2,6,23,.07),
        0 22px 56px rgba(2,6,23,.12);
      transform: translateY(-1px);
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-input.form-control{
      min-height: 96px;
      height: auto;
      border: 0;
      box-shadow: none;
      border-radius: 999px;
      padding-left: 108px;
      padding-right: 70px;
      background: transparent;
      font-weight: 650;
      position: relative;
      z-index: 1;
      transition: opacity .12s ease;
    }

    /* Garante altura mesmo com regras do Bootstrap/tabela */
    #cfgOpsTable .wdg-userpick.wdg-userpick-pro .wdg-userpick-input.form-control{ min-height: 96px !important; height: auto !important; }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-input.form-control:focus{
      outline: none;
      box-shadow: 0 0 0 4px rgba(var(--wdg-primary-rgb), .12);
    }
    .wdg-userpick.wdg-userpick-pro.wdg-userpick-has .wdg-userpick-input{
      color: transparent;
      caret-color: var(--wdg-text);
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-selected{
      position: absolute;
      inset: 10px 52px 10px 12px;
      display: flex;
      align-items: center;
      gap: .6rem;
      pointer-events: none;
      z-index: 2;
      transition: opacity .12s ease;
    }

    /* Quando já existe um usuário selecionado, o input serve só para editar.
       Fora do foco, esconda o input (inclui placeholder) e mostre só o overlay. */
    .wdg-userpick.wdg-userpick-pro.wdg-userpick-has .wdg-userpick-input{ opacity: 0; }
    .wdg-userpick.wdg-userpick-pro.wdg-userpick-has .wdg-userpick-field:focus-within .wdg-userpick-input{ opacity: 1; }
    .wdg-userpick.wdg-userpick-pro.wdg-userpick-has .wdg-userpick-field:focus-within .wdg-userpick-selected{ opacity: 0; }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-sel-avatar{
      width: 64px;
      height: 64px;
      border-radius: 999px;
      object-fit: cover;
      border: 1px solid rgba(15,23,42,.10);
      box-shadow: 0 1px 2px rgba(2,6,23,.08);
      background: rgba(15,23,42,.04);
      flex: 0 0 auto;
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-sel-text{ min-width: 0; display:flex; flex-direction: column; gap: .15rem; }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-sel-name{
      font-weight: 900;
      color: var(--wdg-text);
      line-height: 1.05;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-sel-meta{
      font-size: .78rem;
      font-weight: 650;
      color: var(--wdg-text-light);
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-clear{
      position: absolute;
      top: 50%;
      right: 34px;
      transform: translateY(-50%);
      width: 26px;
      height: 26px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.85);
      color: rgba(15,23,42,.7);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      line-height: 1;
      box-shadow: 0 1px 2px rgba(2,6,23,.06);
      cursor: pointer;
      transition: background .12s ease, transform .12s ease;
      z-index: 3;
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-clear:hover{
      background: rgba(255,255,255,1);
      transform: translateY(-50%) scale(1.04);
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-chevron{
      position: absolute;
      top: 50%;
      right: 12px;
      width: 10px;
      height: 10px;
      border-right: 2px solid rgba(15,23,42,.55);
      border-bottom: 2px solid rgba(15,23,42,.55);
      transform: translateY(-55%) rotate(45deg);
      opacity: .75;
      pointer-events: none;
      z-index: 3;
    }
    .wdg-userpick.wdg-userpick-pro.wdg-userpick-has .wdg-userpick-chevron{
      opacity: .55;
    }
    .wdg-userpick-menu{
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      max-height: 320px;
      overflow: auto;
      background: var(--wdg-surface);
      border: 1px solid rgba(15,23,42,.12);
      border-radius: 14px;
      box-shadow: 0 18px 50px rgba(2,6,23,.14);
      z-index: 80;
      padding: .25rem;
    }

    /* Editor de operadores: manter rolagem da tabela (dropdown é portalado, então não precisa overflow:visible) */
    #cfgOpsEditor{ position: relative; z-index: 5; }
    #cfgOpsEditor .wdg-cfg-ops-tablewrap .table-responsive{ overflow: auto !important; }
    .wdg-userpick-item{
      width: 100%;
      border: 0;
      background: transparent;
      display: flex;
      align-items: center;
      gap: .65rem;
      padding: .45rem .55rem;
      border-radius: 12px;
      text-align: left;
    }
    .wdg-userpick-item:hover{ background: rgba(var(--wdg-primary-rgb), .06); }
    .wdg-userpick-avatar{
      /* Igual ao Portal do Morador (evita avatares gigantes no picker de destinatários) */
      width: 38px;
      height: 38px;
      border-radius: 999px;
      object-fit: cover;
      border: 1px solid var(--wdg-border);
      background: var(--wdg-surface-alt);
      flex: 0 0 auto;
    }
    .wdg-userpick-meta{ display:flex; flex-direction: column; min-width: 0; }
    .wdg-userpick-name{ font-weight: 900; color: var(--wdg-text); line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wdg-userpick-email{ font-weight: 650; color: var(--wdg-text-light); font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* UserPick compacto (usado em Grupos) */
    .wdg-userpick.wdg-userpick-compact{ display: inline-block; }
    .wdg-userpick.wdg-userpick-compact input.form-control{
      min-height: 38px;
      width: 100% !important;
      max-width: 100%;
      padding: .25rem .75rem;
    }
    .wdg-userpick.wdg-userpick-compact .wdg-userpick-menu{ min-width: 320px; }

    /* Grupos (Editar) */
    .wdg-grp-toolbar{
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .wdg-grp-toolbar > .form-control{ flex: 1 1 260px; min-width: 220px; }
    .wdg-grp-btnplus{
      width: 44px;
      height: 44px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 950;
      font-size: 1.25rem;
      line-height: 1;
    }
    .wdg-grp-create{
      border: 1px solid rgba(15,23,42,.10);
      background: var(--wdg-surface);
      border-radius: 18px;
      padding: .95rem;
      margin-bottom: 1rem;
    }
    .wdg-grp-card{
      border: 1px solid rgba(15,23,42,.10);
      background: var(--wdg-surface);
      border-radius: 18px;
      padding: .95rem;
      margin-bottom: .9rem;
    }
    .wdg-grp-card-title{ font-weight: 950; color: var(--wdg-text); margin-bottom: .65rem; }
    .wdg-grp-members{
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      padding: .65rem;
      border-radius: 16px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(var(--wdg-primary-rgb), .03);
    }
    .wdg-grp-member{
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .32rem .45rem;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: var(--wdg-surface);
      max-width: 100%;
    }
    .wdg-grp-member img{
      width: 28px;
      height: 28px;
      border-radius: 999px;
      object-fit: cover;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(15,23,42,.04);
      flex: 0 0 auto;
    }
    /* Destinatários (chips) em Para/Cópia: sem negrito */
    .wdg-grp-member-name{
      font-weight: 500;
      font-size: .92rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 260px;
    }

    /* Destinatários (badges) em Para/Cópia na mensagem já enviada (thread): sem negrito */
    body.wdg-msg #msgBody #msgThreadHost .badge.text-bg-light.border.text-dark {
      font-weight: 500;
    }
    .wdg-grp-member-remove{
      border: 0;
      background: transparent;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 950;
      line-height: 1;
      color: var(--wdg-text);
      padding: 0;
      flex: 0 0 auto;
    }
    .wdg-grp-member-remove:hover{ background: rgba(var(--wdg-primary-rgb), .08); }

    .wdg-grp-members .wdg-grp-adder{ flex: 0 0 auto; min-width: 0; }
    .wdg-grp-members .wdg-userpick input.form-control{ min-height: 42px; }
    .wdg-grp-members .wdg-userpick.wdg-userpick-compact input.form-control{ min-height: 34px; }

    .wdg-grp-import{ position: relative; }
    .wdg-grp-import-menu{
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      min-width: 300px;
      max-width: min(92vw, 420px);
      max-height: 360px;
      overflow: auto;
      background: var(--wdg-surface);
      border: 1px solid rgba(15,23,42,.12);
      border-radius: 14px;
      box-shadow: 0 18px 50px rgba(2,6,23,.14);
      z-index: 90;
      padding: .25rem;
    }
    .wdg-grp-import-item{
      width: 100%;
      border: 0;
      background: transparent;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: .1rem;
      padding: .55rem .65rem;
      border-radius: 12px;
    }
    .wdg-grp-import-item:hover{ background: rgba(var(--wdg-primary-rgb), .06); }
    .wdg-grp-import-title{ font-weight: 950; color: var(--wdg-text); }
    .wdg-grp-import-sub{ font-weight: 700; font-size: .85rem; color: var(--wdg-text-light); }
    .wdg-grp-import-empty{ padding: .85rem; color: var(--wdg-text-light); font-weight: 800; }

    /* Permite quebrar cabeçalhos longos na tabela de permissões */
    #cfgOpsTable thead th{ white-space: normal !important; }

    /* Centraliza tabelas das demais views (ex.: entrada/saída) */
    .wdg-msg-table thead th { text-align: center; }
    .wdg-msg-table tbody td { text-align: center; }

    .wdg-cfg-row.active{
      background: rgba(var(--wdg-primary-rgb), .10);
      box-shadow: inset 3px 0 0 var(--wdg-primary);
    }

    .wdg-msg-empty { padding: 1.4rem; border: 1px dashed rgba(15,23,42,.22); border-radius: 16px; text-align: center; color: var(--wdg-text-light); font-weight: 800; background: var(--wdg-surface); }
    .wdg-msg-table thead th { font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; color: var(--wdg-text-light); font-weight: 900; }
    .wdg-msg-table tbody td { font-weight: 650; }


  </style>
</head>
<body class="wdg-layout wdg-msg"
  data-base-path="<%= _bp %>"
  data-api-base-path="<%= _apiBp %>"
  data-user-name="<%= user && user.nome ? user.nome : '' %>"
  data-user-email="<%= user && user.email ? user.email : '' %>"
  data-user-role="<%= user && user.role ? user.role : '' %>"
  data-user-unit-id="<%= user && user.unidade_id ? (user.unidade_id._id || user.unidade_id || user.unidadeId || '') : '' %>"
  data-user-unit-name="<%= user && (user.unidade_nome || user.unidadeNome || (user.unidade_id && user.unidade_id.nome)) ? (user.unidade_nome || user.unidadeNome || user.unidade_id.nome) : '' %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: _moduleLabel, user }) %>
  <%- include('../shared/partials/navbar-shared', {
      moduleBasePath: _moduleHomePath,
      moduleLabel: _moduleLabel,
      user,
      menuLabel: 'Menu',
      prefixMenuPaths: false,
      menuTree: [
        { label: 'Caixa de entrada', path: '/mensagens/dashboard' },
        { label: 'Nova mensagem', path: '/mensagens/dashboard#nova' },
        { label: 'Caixa de saída', path: '/mensagens/dashboard#saida' },
        { label: 'Arquivo', path: '/mensagens/dashboard#arquivo' },
        { label: 'Lixeira', path: '/mensagens/dashboard#lixeira' },
        { label: 'Grupos', path: '/mensagens/dashboard#grupos' },
        { label: 'Configuração', path: '/mensagens/dashboard#configuracao' }
      ]
    }) %>

<%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: _moduleLabel, user }) %>

<script>
  (function hydrateMensagensNavbarProfile(){
    try {
      var base = '<%= _bp %>';
      var avatar = document.getElementById('navbarAvatarShared');
      var offcanvasAvatar = document.getElementById('offcanvasAvatarShared');
      var navbarName = document.querySelector('.navbar-wd .nav-wd-profile-name');

      function pickUser(payload) {
        return (payload && (payload.usuario || payload.user || payload.data)) || payload || {};
      }

      function pickName(u) {
        return String(
          u.nome ||
          u.name ||
          u.displayName ||
          u.nome_completo ||
          u.nomeCompleto ||
          u.email ||
          ''
        ).trim();
      }

      function pickFoto(u) {
        return String(
          u.foto ||
          u.photo ||
          u.avatar ||
          u.fotoUrl ||
          u.foto_url ||
          ''
        ).trim();
      }

      function applyName(nome) {
        if (!nome || !navbarName) return;
        navbarName.textContent = nome;
      }

      function applyFoto(foto) {
        if (!foto) return;

        var url = '';
        if (typeof window.buildUserFotoUrl === 'function') {
          try { url = window.buildUserFotoUrl(foto); } catch (_) {}
        }

        if (!url) {
          url = base + '/api/usuario/foto';
        }

        var sep = url.indexOf('?') >= 0 ? '&' : '?';
        url = url + sep + 'v=' + Date.now();

        [avatar, offcanvasAvatar].filter(Boolean).forEach(function(img) {
          img.setAttribute('data-user-foto', foto);
          img.dataset.avatarLoaded = '';
          img.src = url;
        });
      }

      fetch(base + '/api/usuario', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'fetch' }
      })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(payload) {
          var u = pickUser(payload);
          applyName(pickName(u));
          applyFoto(pickFoto(u));
        })
        .catch(function(){});
    } catch (_) {}
  })();
</script>

  <main class="container-fluid py-1" style="padding-bottom:.5rem;">
    <div class="wdg-msg-wrap">
      <aside class="wdg-msg-aside">
        <div class="wdg-card wdg-card-hover">
          <div class="mb-2 wdg-msg-head">
            <h1 class="wdg-msg-title">CAIXA DE MENSAGENS</h1>
            <div class="wdg-msg-sub">Comunicação interna</div>
          </div>

          <div class="wdg-msg-mailbox">
            <label class="form-label wdg-msg-mailbox-label" for="msgMailboxSelect">Selecionar caixa</label>
            <select id="msgMailboxSelect" class="form-select form-select-sm wdg-msg-mailbox-select" aria-label="Selecionar caixa de mensagem"></select>
          </div>

          <div class="list-group wdg-msg-menu" id="msgMenu" role="navigation" aria-label="Menu de mensagens">
            <button type="button" class="list-group-item list-group-item-action" data-view="nova" aria-current="false">
              <span class="wdg-msg-item">
                <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/nova-mensagem.png" alt=""></span>
                <span class="wdg-msg-label">Nova mensagem</span>
              </span>
              <span class="wdg-msg-caret" aria-hidden="true"></span>
            </button>
            <button type="button" class="list-group-item list-group-item-action active" data-view="entrada" aria-current="page">
              <span class="wdg-msg-item">
                <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/caixa-de-entrada.png" alt=""></span>
                <span class="wdg-msg-label">Caixa de entrada <span class="badge rounded-pill bg-danger ms-2" data-msg-inbox-count style="display:none; font-size:.72rem; line-height:1; min-width:1.6em;" aria-hidden="true"></span></span>
              </span>
              <span class="wdg-msg-caret" aria-hidden="true"></span>
            </button>
            <button type="button" class="list-group-item list-group-item-action" data-view="saida" aria-current="false">
              <span class="wdg-msg-item">
                <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/caixa-de-saida.png" alt=""></span>
                <span class="wdg-msg-label">Caixa de saída</span>
              </span>
              <span class="wdg-msg-caret" aria-hidden="true"></span>
            </button>
            <button type="button" class="list-group-item list-group-item-action" data-view="arquivo" aria-current="false">
              <span class="wdg-msg-item">
                <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/arquivomensagem.png" alt=""></span>
                <span class="wdg-msg-label">Arquivo</span>
              </span>
              <span class="wdg-msg-caret" aria-hidden="true"></span>
            </button>
            <button type="button" class="list-group-item list-group-item-action" data-view="lixeira" aria-current="false">
              <span class="wdg-msg-item">
                <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/lixeira.png" alt=""></span>
                <span class="wdg-msg-label">Lixeira</span>
              </span>
              <span class="wdg-msg-caret" aria-hidden="true"></span>
            </button>
            <button type="button" class="list-group-item list-group-item-action" aria-current="false">
              <span class="wdg-msg-item">
                <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/grupo.png" alt=""></span>
                <span class="wdg-msg-label">Grupos</span>
              </span>
              <span class="wdg-msg-caret" aria-hidden="true"></span>
            </button>
            <div class="wdg-msg-submenu" id="msgGroupsSubmenu" role="group" aria-label="Grupos" hidden>
              <button type="button" class="list-group-item list-group-item-action" data-view="grupos" data-groups-edit="1" aria-current="false">
                <span class="wdg-msg-item">
                  <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/editar.png" alt=""></span>
                  <span class="wdg-msg-label">Editar</span>
                </span>
                <span class="wdg-msg-caret" aria-hidden="true"></span>
              </button>
            </div>
            <button type="button" class="list-group-item list-group-item-action" data-view="configuracao" aria-current="false">
              <span class="wdg-msg-item">
                <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/configuracao.png" alt=""></span>
                <span class="wdg-msg-label">Configuração</span>
              </span>
              <span class="wdg-msg-caret" aria-hidden="true"></span>
            </button>
            <div class="wdg-msg-submenu" id="msgConfigSubmenu" role="group" aria-label="Configuração" hidden>
              <% if (user && (user.isMaster || user.role === 'master' || user.role === 'admin' || user.role === 'diretor')) { %>
                <button type="button" class="list-group-item list-group-item-action" data-view="cfg_geral" aria-current="false">
                  <span class="wdg-msg-item">
                    <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/servicos.png" alt=""></span>
                    <span class="wdg-msg-label">Geral</span>
                  </span>
                  <span class="wdg-msg-caret" aria-hidden="true"></span>
                </button>
              <% } %>
              <button type="button" class="list-group-item list-group-item-action" data-view="cfg_caixas" aria-current="false">
                <span class="wdg-msg-item">
                  <span class="wdg-msg-ico-wrap"><img class="wdg-msg-ico" src="<%= _assetBp %>/images/caixas.png" alt=""></span>
                  <span class="wdg-msg-label">Caixas</span>
                </span>
                <span class="wdg-msg-caret" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>
      </aside>

      <section>
        <div class="wdg-card wdg-card-hover wdg-msg-panel">
          <div class="wdg-msg-panel-head">
            <div>
              <h2 id="msgTitle">Caixa de entrada</h2>
              <p class="lead" id="msgSubtitle" style="display:none;"></p>
            </div>
            <div class="wdg-msg-chip" id="msgChip"><i class="bi bi-envelope" aria-hidden="true"></i><span class="fw-normal">Mensagens</span></div>
          </div>

          <div class="wdg-msg-body" id="msgBody"></div>
        </div>
      </section>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <%
    // IMPORTANTE (Vercel/CDN): use uma versão estável por deploy (commit/deployment id)
    // para cache-busting consistente. Em dev, cai para Date.now().
    const __av = (typeof assetVersion !== 'undefined' && assetVersion) ? String(assetVersion) : '';
    const __isDevAsset = (!__av || __av === 'dev');
    const __assetV = __isDevAsset ? String(Date.now()) : __av;
    const __assetCfgV = __assetV;
    const __assetMsgV = __assetV;
  %>
  <script src="<%= _assetBp %>/js/configuracoes_geral.js?v=<%= __assetCfgV %>"></script>
  <script src="<%= _assetBp %>/js/caixa_de_mensagem.js?v=<%= __assetMsgV %>"></script>
</body>
</html>
