<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Caixa de Mensagem - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
<% const _moduleLabel = (typeof moduleLabel === 'string' && moduleLabel) ? moduleLabel : 'Caixa de Mensagens'; %>
<% const _moduleHomePath = (typeof moduleHomePath === 'string' && moduleHomePath) ? moduleHomePath : '/mensagens'; %>
<% const _assetBp = (typeof assetBasePath === 'string' && assetBasePath) ? assetBasePath : _moduleHomePath; %>
<% const _apiBp = (typeof apiBasePath === 'string' && apiBasePath) ? apiBasePath : _bp; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _assetBp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _assetBp %>/images/logoWDGestor.png?v=4">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _assetBp %>/css/condominios-modern.css?v=<%= (typeof assetVersion !== 'undefined' && assetVersion) ? assetVersion : Date.now() %>">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    :root{
      /* Ajuste de offset para sticky abaixo do header+navbar */
      --wdg-msg-top-offset: 106px;

      /* Polimento global (tema) */
      --wdg-msg-radius: 22px;
      --wdg-msg-radius-sm: 14px;
      --wdg-msg-shadow-sm: 0 1px 2px rgba(2,6,23,.06);
      --wdg-msg-shadow: 0 18px 46px rgba(2,6,23,.10);
      --wdg-msg-shadow-hover: 0 26px 70px rgba(2,6,23,.12);
      --wdg-msg-ease: cubic-bezier(.2,.8,.2,1);

      /* “NeoGlass” (leve, sem quebrar legados) */
      --wdg-msg-glass-bg: rgba(255,255,255,.72);
      --wdg-msg-glass-bg-strong: rgba(255,255,255,.88);
      --wdg-msg-glass-border: rgba(15,23,42,.10);
      --wdg-msg-glow: 0 0 0 1px rgba(255,255,255,.55), 0 18px 40px rgba(2,6,23,.12);

      /* Gradientes (accent) */
      --wdg-msg-grad-a: rgba(var(--wdg-primary-rgb), .95);
      --wdg-msg-grad-b: rgba(var(--wdg-accent-rgb), .85);
      --wdg-msg-grad-c: rgba(56,189,248,.75);
    }
    body.wdg-msg {
      background:
        radial-gradient(1000px 520px at 12% 0%, rgba(var(--wdg-accent-rgb), .10), transparent 60%),
        radial-gradient(900px 520px at 92% 12%, rgba(var(--wdg-primary-rgb), .08), transparent 58%),
        var(--wdg-bg);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      color-scheme: light;
      position: relative;
      isolation: isolate;
    }

    /* textura bem sutil (premium) */
    body.wdg-msg::before{
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -1;
      opacity: .22;
      background:
        repeating-linear-gradient(135deg, rgba(15,23,42,.06) 0 1px, transparent 1px 7px),
        radial-gradient(800px 420px at 18% 10%, rgba(var(--wdg-primary-rgb), .10), transparent 60%),
        radial-gradient(800px 420px at 90% 0%, rgba(var(--wdg-accent-rgb), .10), transparent 62%);
      mix-blend-mode: multiply;
    }

    /* Motion & focus (acessibilidade) */
    @media (prefers-reduced-motion: reduce){
      *{ animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
    }
    :where(a, button, input, select, textarea, [role="button"], .btn):focus-visible{
      outline: none;
      box-shadow: var(--wdg-focus-ring) !important;
    }

    /* Efeito de entrada suave nos painéis */
    @keyframes wdgFadeUp{ from{ opacity: 0; transform: translateY(6px); } to{ opacity: 1; transform: translateY(0); } }
    .wdg-msg-panel, .wdg-cfg-top, .wdg-cfg-box{ animation: wdgFadeUp .18s var(--wdg-msg-ease) both; }

    /* Sheen (brilho passando) em hovers de elementos “premium” */
    @keyframes wdgSheen{ from{ transform: translateX(-120%) rotate(10deg); opacity: 0; } 20%{ opacity: .85; } to{ transform: translateX(120%) rotate(10deg); opacity: 0; } }
    .wdg-msg-panel, #msgListTop, #msgFilterPanel{ position: relative; }
    /* Garante que dropdowns do topo (menu à direita) fiquem acima da tabela */
    #msgListTop{ z-index: 120; }
    #msgFilterPanel{ z-index: 110; }
    :is(.wdg-msg-panel, #msgListTop, #msgFilterPanel)::before{
      content:'';
      position:absolute;
      inset:-1px;
      border-radius: inherit;
      pointer-events:none;
      padding: 1px;
      background: linear-gradient(135deg, rgba(var(--wdg-primary-rgb), .28), rgba(var(--wdg-accent-rgb), .22), rgba(56,189,248,.16));
      -webkit-mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: .85;
    }
    /* Anti-flash: desativa o "sheen" (vulto branco) ao passar o mouse */
    :is(.wdg-msg-panel, #msgListTop, #msgFilterPanel)::after{ content: none; }

    .wdg-msg-wrap {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 1rem;
      align-items: start;
    }
    @media (max-width: 992px){ .wdg-msg-wrap{ grid-template-columns: 1fr; } }

    .wdg-msg-aside {
      position: sticky;
      top: var(--wdg-msg-top-offset);
      max-height: calc(100vh - var(--wdg-msg-top-offset) - 2.25rem);
      max-height: calc(100dvh - var(--wdg-msg-top-offset) - 2.25rem);
    }
    @media (max-width: 992px){ .wdg-msg-aside{ position: static; top: auto; } }

    body.wdg-layout.wdg-msg .wdg-msg-aside .wdg-card{
      height: calc(100vh - var(--wdg-msg-top-offset) - 2.25rem);
      height: calc(100dvh - var(--wdg-msg-top-offset) - 2.25rem);
      display: flex;
      flex-direction: column;
      border-radius: 18px;
      padding: .85rem .9rem .75rem !important;
      background:
        linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0)) ,
        linear-gradient(135deg, #0b2a6b 0%, #0b5ed7 45%, #1aa0ff 100%) !important;
      border: 1px solid rgba(255,255,255,.20) !important;
      box-shadow:
        0 26px 70px rgba(2,6,23,.28),
        0 14px 30px rgba(2,6,23,.18),
        inset 0 1px 0 rgba(255,255,255,.22),
        inset 0 -18px 40px rgba(0,0,0,.18);
      overflow: hidden;
      position: relative;
      transform: translateZ(0);
    }

    /* garante que textos/itens fiquem acima dos efeitos */
    body.wdg-layout.wdg-msg .wdg-msg-aside .wdg-card > *{ position: relative; z-index: 1; }

    body.wdg-layout.wdg-msg .wdg-msg-aside .wdg-card::before{
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(520px 240px at 18% 8%, rgba(255,255,255,.30), transparent 62%),
        radial-gradient(520px 320px at 92% 20%, rgba(56,189,248,.22), transparent 58%),
        radial-gradient(820px 520px at 30% 115%, rgba(2,132,199,.18), transparent 62%),
        linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 35%);
      pointer-events: none;
    }

    /* Removido: linha branca acima do título */
    body.wdg-layout.wdg-msg .wdg-msg-aside .wdg-card::after{ content: none; }

    body.wdg-layout.wdg-msg .wdg-msg-title {
      font-weight: 900;
      letter-spacing: -.01em;
      margin: 0;
      color: rgba(255,255,255,.95) !important;
      white-space: nowrap;
      font-size: 1.6rem;
      line-height: 1.15;
    }
    body.wdg-layout.wdg-msg .wdg-msg-sub { color: rgba(255,255,255,.78) !important; font-weight: 700; font-size: .85rem; margin-top: .25rem; margin-bottom: .55rem; }

    body.wdg-layout.wdg-msg .wdg-msg-head{
      text-align: center;
      margin-bottom: 0;
    }

    body.wdg-layout.wdg-msg .wdg-msg-mailbox{ margin: 0 .1rem 1.85rem; }
    body.wdg-layout.wdg-msg .wdg-msg-mailbox-label{ color: rgba(255,255,255,.92) !important; font-weight: 850; margin-bottom: .35rem; }
    body.wdg-layout.wdg-msg .wdg-msg-mailbox-select{
      background: rgba(255,255,255,.14) !important;
      border: 1px solid rgba(255,255,255,.24) !important;
      color: rgba(255,255,255,.96) !important;
      border-radius: 14px;
      font-weight: 500;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 10px 22px rgba(2,6,23,.16);
    }
    body.wdg-layout.wdg-msg .wdg-msg-mailbox-select:focus{ box-shadow: 0 0 0 3px rgba(255,255,255,.22), 0 12px 26px rgba(2,6,23,.18); border-color: rgba(255,255,255,.38) !important; }
    body.wdg-layout.wdg-msg .wdg-msg-mailbox-select option{ color: #0f172a; }

    /* Layout da tela Configurações > Caixas (moderno) */
    .wdg-cfg-top,
    .wdg-cfg-box{
      border-radius: 24px;
      background:
        radial-gradient(900px 380px at 12% 8%, rgba(var(--wdg-accent-rgb), .08), transparent 60%),
        radial-gradient(700px 420px at 92% 22%, rgba(26,160,255,.07), transparent 55%),
        linear-gradient(180deg, rgba(255,255,255,.94), rgba(255,255,255,1));
      border: 1px solid rgba(217,224,231,.95) !important;
      box-shadow:
        0 1px 2px rgba(2,6,23,.04),
        0 18px 46px rgba(2,6,23,.08);
    }
    .wdg-cfg-top:hover,
    .wdg-cfg-box:hover{
      box-shadow:
        0 2px 4px rgba(2,6,23,.05),
        0 26px 70px rgba(2,6,23,.10);
    }
    .wdg-cfg-top-title,
    .wdg-cfg-title,
    .wdg-cfg-title-big{
      text-align:center;
      font-weight: 900;
      font-size: 1.35rem;
      letter-spacing: -.01em;
      line-height: 1.2;
      margin-bottom: .35rem;
    }

    /* Espaço de uma linha entre título do bloco e o primeiro conteúdo */
    .wdg-cfg-top-title + .table-responsive{ margin-top: 1rem; }
    .wdg-cfg-title-big + form{ margin-top: 1rem; }
    .wdg-cfg-title + form{ margin-top: 1rem; }

    .wdg-cfg-row{ cursor: pointer; }
    .wdg-cfg-row:hover{ background: rgba(var(--wdg-primary-rgb), .045); }
    .wdg-cfg-row.active{
      background: rgba(var(--wdg-primary-rgb), .08);
      box-shadow: inset 3px 0 0 rgba(var(--wdg-primary-rgb), .55);
    }

    /* Layout da tela Configuração > Geral (evoluído) */
    :root{
      --wdg-cfg-radius: 20px;
      --wdg-cfg-radius-sm: 14px;
      --wdg-cfg-border: rgba(15,23,42,.10);
      --wdg-cfg-border-strong: rgba(15,23,42,.16);
      --wdg-cfg-shadow: 0 16px 44px rgba(2,6,23,.08);
      --wdg-cfg-shadow-hover: 0 26px 70px rgba(2,6,23,.12);
      --wdg-cfg-surface: rgba(255,255,255,.88);
      --wdg-cfg-surface-2: rgba(248,250,252,.92);
      --wdg-cfg-muted: rgba(15,23,42,.64);
      --wdg-cfg-accent: rgba(var(--wdg-primary-rgb), .12);
    }

    /* “framework” visual interno (sem depender de markup extra) */
    #wdgMsgCfgGeralRoot{
      --bs-border-color: rgba(15,23,42,.10);
    }

    /* Tabela: Usuários (caixa pessoal) */
    #wdgMsgCfgGeralRoot .wdg-users-table-wrap{
      border: 1px solid rgba(15,23,42,.10);
      border-radius: 16px;
      overflow: hidden;
      background: rgba(255,255,255,.92);
      box-shadow: 0 1px 2px rgba(2,6,23,.04);
    }
    #wdgMsgCfgGeralRoot .wdg-users-table{
      margin: 0;
      width: 100%;
      table-layout: fixed;
    }
    #wdgMsgCfgGeralRoot .wdg-users-table thead th{
      background:
        radial-gradient(700px 180px at 20% 0%, rgba(var(--wdg-primary-rgb), .06), transparent 55%),
        linear-gradient(180deg, rgba(248,250,252,.96), rgba(255,255,255,.96));
      border-bottom: 1px solid rgba(15,23,42,.10);
      color: rgba(15,23,42,.66);
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .09em;
      font-weight: 400;
      text-align: center;
      padding: .70rem .75rem;
      white-space: nowrap;
      vertical-align: middle;
    }

    /* Compactação para caber sem rolagem horizontal */
    #wdgMsgCfgGeralRoot .wdg-users-table thead th,
    #wdgMsgCfgGeralRoot .wdg-users-table tbody td{
      padding: .55rem .50rem;
    }
    #wdgMsgCfgGeralRoot .wdg-users-table tbody td{
      font-size: .90rem;
    }
    #wdgMsgCfgGeralRoot .wdg-users-table thead th .form-check-input{ margin: 0; }

    #wdgMsgCfgGeralRoot .wdg-users-controls{
      width: 100%;
      display: grid;
      grid-template-columns: 20ch 1fr auto;
      align-items: center;
      gap: .75rem;
    }

    /* Títulos centralizados (Configurações > Geral) */
    #wdgMsgCfgGeralRoot :is(h2, h3){
      text-align: center;
    }
    #wdgMsgCfgGeralRoot .wdg-cfg-card-title{
      font-weight: 900;
      letter-spacing: -.01em;
      font-size: 1.05rem;
      line-height: 1.2;
      margin: 0;
    }
    #wdgMsgCfgGeralRoot .wdg-cfg-card-header{
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: .75rem;
      width: 100%;
      position: relative;
    }
    #wdgMsgCfgGeralRoot .wdg-cfg-card-titlewrap{
      grid-column: 2;
      justify-self: center;
      text-align: center;
    }
    #wdgMsgCfgGeralRoot .wdg-cfg-card-actions{
      grid-column: 3;
      justify-self: end;
    }
    @media (max-width: 576px){
      #wdgMsgCfgGeralRoot .wdg-cfg-card-header{
        grid-template-columns: 1fr;
        row-gap: .5rem;
      }
      #wdgMsgCfgGeralRoot .wdg-cfg-card-titlewrap,
      #wdgMsgCfgGeralRoot .wdg-cfg-card-actions{
        grid-column: 1;
        justify-self: center;
      }
    }

    #wdgMsgCfgGeralRoot .wdg-metrics-controls{
      width: 100%;
      display: flex;
      align-items: center;
      gap: .75rem;
      flex-wrap: wrap;
    }

    /* Layout: Caixas + Métricas lado a lado (desktop) */
    #wdgMsgCfgGeralRoot .wdg-cfg-two-col{
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      align-items: stretch;
    }
    @media (min-width: 992px){
      #wdgMsgCfgGeralRoot .wdg-cfg-two-col{
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }
    }

    /* Padronização visual: altura das listas e alinhamento entre Caixas x Métricas */
    #wdgMsgCfgGeralRoot{
      /* Área visível: cabeçalho + 6 linhas do corpo */
      --wdg-cfg-table-head-h: 2.9rem;
      --wdg-cfg-table-row-h: 2.25rem;
      --wdg-cfg-table-rows: 6;
      --wdg-cfg-table-fixed-h: calc(var(--wdg-cfg-table-head-h) + (var(--wdg-cfg-table-row-h) * var(--wdg-cfg-table-rows)));
    }

    /* Em grid 2-col, os cards ficam com altura igual */
    #wdgMsgCfgGeralRoot .wdg-cfg-two-col > .wdg-cfg-card{
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    /* Grupo inferior do card (controles + tabela + paginação) preso ao rodapé */
    #wdgMsgCfgGeralRoot .wdg-cfg-two-col > .wdg-cfg-card .wdg-cfg-bottom{
      margin-top: auto;
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    /* A linha "x por página" deve encostar na tabela */
    #wdgMsgCfgGeralRoot .wdg-cfg-two-col .wdg-cfg-bottom :is(.wdg-users-controls, .wdg-metrics-controls){
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    /* Evita espaçamento extra no topo das tabelas */
    #wdgMsgCfgGeralRoot .wdg-cfg-two-col .wdg-cfg-bottom :is(.wdg-mailbox-table-wrap, .wdg-metrics-table-wrap){
      margin-top: 0 !important;
    }

    /* Tabelas Caixas/Métricas: altura fixa (6 linhas) e scroll vertical quando exceder */
    #wdgMsgCfgGeralRoot :is(.wdg-mailbox-table-wrap, .wdg-metrics-table-wrap){
      max-height: var(--wdg-cfg-table-fixed-h);
      min-height: var(--wdg-cfg-table-fixed-h);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    /* Mantém o cabeçalho visível durante a rolagem */
    #wdgMsgCfgGeralRoot :is(.wdg-mailbox-table, .wdg-metrics-table) thead th{
      position: sticky;
      top: 0;
      z-index: 2;
    }

    /* Consistência de altura das linhas (aprox.) */
    #wdgMsgCfgGeralRoot :is(.wdg-mailbox-table, .wdg-metrics-table) tbody td{
      height: var(--wdg-cfg-table-row-h);
    }
    @media (max-width: 992px){
      #wdgMsgCfgGeralRoot .wdg-users-controls{ grid-template-columns: 1fr; }
      #wdgMsgCfgGeralRoot .wdg-users-summary{ text-align: left; margin-left: 0; }
      #wdgMsgCfgGeralRoot .wdg-metrics-controls .wdg-users-summary{ text-align: left; margin-left: 0; }
    }
    #wdgMsgCfgGeralRoot .wdg-users-page-size{
      width: 20ch;
      min-width: 20ch;
      max-width: 24ch;
    }

    #wdgMsgCfgGeralRoot .wdg-users-summary{
      margin-left: auto;
      text-align: right;
      font-size: .84rem;
      color: rgba(15,23,42,.70);
      background:
        linear-gradient(180deg, rgba(255,255,255,.92), rgba(248,250,252,.92));
      border: 1px solid rgba(15,23,42,.10);
      border-radius: 999px;
      padding: .35rem .65rem;
      white-space: nowrap;
    }

    #wdgMsgCfgGeralRoot .wdg-users-bulk{
      justify-self: center;
      width: 100%;
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-inner{
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-btn{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .25rem;
      border: 0;
      background: transparent;
      border-radius: 10px;
      padding: .28rem .40rem;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      position: relative;
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-btn:hover{
      background: rgba(15,23,42,.06);
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-btn:active{
      background: rgba(15,23,42,.10);
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-btn:disabled{
      opacity: .35;
      cursor: not-allowed;
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-ico{
      width: 28px;
      height: 28px;
      object-fit: contain;
      vertical-align: middle;
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-arrow{
      width: 16px;
      height: 16px;
      display: inline-block;
      position: relative;
      opacity: .70;
      margin: 0 .10rem;
    }
    #wdgMsgCfgGeralRoot .wdg-users-bulk-arrow::before{
      content: '';
      position: absolute;
      inset: 0;
      margin: auto;
      width: 10px;
      height: 10px;
      border-right: 3px solid rgba(15,23,42,.55);
      border-bottom: 3px solid rgba(15,23,42,.55);
      transform: rotate(-45deg);
    }

    #wdgMsgCfgGeralRoot .wdg-users-th{
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: .35rem;
      width: 100%;
      min-height: 1.25rem;
    }
    #wdgMsgCfgGeralRoot .wdg-users-th::before{
      content: '';
      grid-column: 1;
    }
    #wdgMsgCfgGeralRoot .wdg-users-th-label{
      appearance: none;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      text-transform: inherit;
      letter-spacing: inherit;
      font-weight: inherit;
      padding: 0;
      margin: 0;
      cursor: pointer;
      line-height: 1.1;
      grid-column: 2;
      justify-self: center;
    }
    #wdgMsgCfgGeralRoot .wdg-users-th-label:hover{ color: rgba(15,23,42,.78); }

    #wdgMsgCfgGeralRoot .wdg-users-th-drop{
      position: static;
      border: 0;
      background: transparent;
      color: rgba(15,23,42,.45);
      padding: .10rem .30rem;
      line-height: 1;
      font-size: .85rem;
      cursor: pointer;
      grid-column: 3;
      justify-self: end;
    }
    #wdgMsgCfgGeralRoot .wdg-users-th-drop:hover{ color: rgba(15,23,42,.72); }

    #wdgMsgCfgGeralRoot .wdg-users-sort-ind{
      font-size: .70rem;
      color: rgba(15,23,42,.45);
      margin-left: .25rem;
    }

    #wdgMsgCfgGeralRoot .wdg-users-table tbody td{
      padding: .85rem .75rem;
      border-top: 1px solid rgba(15,23,42,.06);
      vertical-align: middle;
      color: rgba(15,23,42,.82);
      font-weight: 400;
    }

    /* Larguras das colunas (reduz Nome/E-mail em ~1/3) */
    #wdgMsgCfgGeralRoot .wdg-users-table thead th:nth-child(1),
    #wdgMsgCfgGeralRoot .wdg-users-table tbody td:nth-child(1){
      width: 4%;
      text-align: center;
      padding-top: .55rem;
      padding-bottom: .55rem;
      padding-left: .35rem;
      padding-right: .35rem;
    }
    #wdgMsgCfgGeralRoot .wdg-users-table thead th:nth-child(1) .form-check-input,
