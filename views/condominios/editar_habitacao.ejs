<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WDGestor - Editar Habitações · Gestão de Condomínios</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/icon-buttons.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/pages/cadastrar_proprietario.css?v=1">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    .hab-search-form .form-label{ font-weight:650; }

    /* Mantém apenas ajustes específicos da tela; o visual base da tabela vem do padrão premium (ch-table). */

    /* Usar tamanho padrão de ícones definido em public/css/icon-buttons.css (24x24) */
    .col-acoes { width: 200px; }
    /* Moradores: cada um em uma linha */
    .hab-col-moradores{ white-space: normal; text-align: left; }
    .truncate{ max-width:320px; }

    .wdg-hab-stack{ display:flex; flex-direction:column; gap:.25rem; align-items:center; text-align:center; }
    .wdg-hab-primary{ font-weight:700; color:var(--wdg-text); }
    .wdg-hab-secondary{ font-size:.75rem; color:var(--wdg-text-light); }
    .wdg-hab-chip-row{ display:flex; flex-wrap:wrap; gap:.4rem; justify-content:center; }
    .wdg-hab-chip{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.42rem;
      min-height: 32px;
      padding:.38rem .9rem;
      border-radius:999px;
      font-size:.79rem;
      font-weight:750;
      letter-spacing:.01em;
      border:1px solid rgba(var(--wdg-accent-rgb), .18);
      text-decoration:none;
      line-height:1.1;
      background: linear-gradient(180deg, rgba(var(--wdg-accent-rgb), .12), rgba(var(--wdg-accent-rgb), .06)) !important;
      color:var(--wdg-text);
      white-space:nowrap;
      max-width: 100%;
      box-shadow: var(--wdg-shadow-sm) !important;
    }
    .wdg-hab-chip i{ font-size:.98rem; opacity:.95; }

    /* Variantes com mais contraste (sem cores novas) */
    .wdg-hab-chip[data-variant="accent"]{
      background: var(--wdg-primary) !important;
      border-color: rgba(var(--wdg-primary-rgb), .18) !important;
      color: #fff !important;
    }
    .wdg-hab-chip[data-variant="success"]{
      background: var(--wdg-success) !important;
      border-color: rgba(var(--wdg-success-rgb, var(--wdg-primary-rgb)), .18) !important;
      color: #fff !important;
    }
    .wdg-hab-chip[data-variant="muted"]{
      background: linear-gradient(180deg, var(--wdg-surface), var(--wdg-surface-alt));
      border-color: rgba(var(--wdg-accent-rgb), .18);
      color: var(--wdg-text-light);
      box-shadow: none;
    }
    .wdg-hab-chip[data-variant="warning"]{
      background: rgb(var(--bs-warning-rgb)) !important;
      border-color: rgba(var(--bs-warning-rgb), .22) !important;
      color: var(--wdg-text) !important;
    }
    .wdg-hab-chip[data-variant="danger"]{
      background: var(--wdg-danger) !important;
      border-color: rgba(var(--wdg-danger-rgb, var(--wdg-primary-rgb)), .18) !important;
      color: #fff !important;
    }
    .wdg-hab-chip--link{ cursor:pointer; user-select:none; transition:transform .15s ease, box-shadow .15s ease, background-color .15s ease, border-color .15s ease, color .15s ease; }
    .wdg-hab-chip--link:hover{ background:var(--wdg-primary); border-color:var(--wdg-primary); color:#fff; text-decoration:none; box-shadow: var(--wdg-shadow-sm); transform: translateY(-1px); }
    .wdg-hab-chip--link:active{ transform: translateY(0); box-shadow:none; }
    /* Garantir que <button> use o mesmo visual do chip */
    button.wdg-hab-chip{ border:0; background: inherit; padding: inherit; }
    button.wdg-hab-chip:disabled{ opacity:.45; cursor:not-allowed; }
    button.wdg-hab-chip:focus-visible{ outline:2px solid var(--wdg-primary); outline-offset:2px; }
    .wdg-hab-chip-text{ display:inline-block; overflow:hidden; text-overflow:ellipsis; max-width: 320px; }
    .wdg-hab-chip.wdg-loading{ opacity:.6; pointer-events:none; }
    .wdg-hab-empty{ color:var(--wdg-text-light); font-weight:650; }
  </style>
</head>
<body class="wdg-layout page-editar-habitacao" data-base-path="<%= _bp %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: (moduleLabel||'Gestão de Condomínios'),
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleia', children: [
              { label: 'Assembleias', path: '/assembleias' },
              { label: 'Nova assembleia', path: '/assembleias/nova' }
            ]},
            { label: 'Dirigência', path: '/administracao/dirigencia' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>

  <% 
    const _unidadesOptions = (typeof unidadesOptions !== 'undefined' && Array.isArray(unidadesOptions)) ? unidadesOptions : [];
    const _isScopeAll = Boolean(user && (user.isMaster || user.role === 'master' || user.role === 'admin'));
    const _userUnitId = (user && user.unidade_id) ? (user.unidade_id._id || user.unidade_id || user.unidadeId || '') : (user && user.unidadeId ? user.unidadeId : '');
    const _userUnitObj = (_userUnitId && _unidadesOptions.length) ? (_unidadesOptions||[]).find(u => String((u && (u._id || u.id)) || '') === String(_userUnitId)) : null;
    const _userUnitFromProfile = (user && user.unidade_id && typeof user.unidade_id === 'object') ? user.unidade_id : null;
    const _userUnitLabelFromProfile = _userUnitFromProfile ? ((_userUnitFromProfile.codigo ? (_userUnitFromProfile.codigo + ' - ') : '') + (_userUnitFromProfile.nome || _userUnitFromProfile.razaoSocial || '')) : '';
    const _fmtUnidadeLabel = (u) => {
      if(!u) return '';
      const codigo = (u.codigo || '').toString().trim();
      const nome = (u.nome || u.razaoSocial || u.label || '').toString().trim();
      return (codigo ? (codigo + ' - ') : '') + (nome || codigo);
    };
  %>

  <div class="container py-3">
    <div class="content mb-3 wdg-card wdg-card-hover">
      <h4 class="mb-3 text-center page-main-title">Editar Habitações</h4>

      <div class="wdg-panel-subbar wdg-condo-subbar" aria-label="Filtro de condomínio">
        <div class="wdg-condo-field">
          <div class="wdg-condo-label">Condomínio</div>
          <div class="wdg-condo-controlrow">
            <img id="unidadeTopLogo" data-condo-inline-logo="1" src="/images/unidade.png" alt="" aria-hidden="true" class="wdg-condo-inline-logo">
            <select class="form-select wdg-condo-select" id="unidadeTop" <%= !_isScopeAll ? 'disabled' : '' %> aria-label="Condomínio">
              <% if (_isScopeAll) { %>
                <option value="">Selecione...</option>
                <% (_unidadesOptions||[]).forEach(u => { %>
                  <option value="<%= (u._id || u.id) %>"><%= _fmtUnidadeLabel(u) %></option>
                <% }) %>
              <% } else { %>
                <% if (_userUnitObj) { %>
                  <option value="<%= (_userUnitObj._id || _userUnitObj.id) %>" selected><%= _fmtUnidadeLabel(_userUnitObj) %></option>
                <% } else if (_userUnitId) { %>
                  <option value="<%= _userUnitId %>" selected><%= (_userUnitLabelFromProfile || 'Condomínio selecionado') %></option>
                <% } else { %>
                  <option value="" selected>Condomínio não definido</option>
                <% } %>
              <% } %>
            </select>
          </div>
          <% if (!_isScopeAll) { %>
            <div class="text-muted small mt-1">Condomínio fixado pelo seu perfil.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Formulário de Pesquisa -->
    <form id="formPesquisaHab" class="content wdg-card wdg-card-hover p-3 mb-3 hab-search-form" autocomplete="off" novalidate>
      <div class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
          <label class="form-label">Bloco/Torre</label>
          <select id="fBloco" class="form-select" aria-label="Selecionar bloco" disabled>
            <option value="">Todos</option>
          </select>
        </div>
        <div class="col-lg-4 col-md-6">
          <label class="form-label">Andar</label>
          <select id="fAndar" class="form-select" aria-label="Selecionar andar" disabled>
            <option value="">Todos</option>
          </select>
        </div>
        <div class="col-lg-4 col-md-6">
          <label class="form-label">Nº / Identificação</label>
          <input id="fNumero" class="form-control" placeholder="Digite para buscar..." list="listaNumeros" autocomplete="off">
          <datalist id="listaNumeros"></datalist>
        </div>
      </div>
    </form>

    <!-- Lista de Habitações -->
    <div class="content wdg-card wdg-card-hover p-3 wdg-list-wide">
      <h5 class="mb-2 text-center wdg-section-title">Lista de Habitações</h5>
      <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
          <label for="habPageSize" class="form-label mb-0">Mostra</label>
          <select id="habPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
            <option value="1000">1000</option>
          </select>
          <span class="ms-1">itens</span>
        </div>
      </div>
      <div class="ch-table-wrap" id="habTableWrap" aria-label="Habitações cadastradas">
        <div id="habResultadoWrap" class="table-responsive table-vert-max ch-table-scroll">
          <table class="table table-hover table-sm align-middle text-center mb-0 ch-table" id="tabelaHabEdit">
            <thead>
              <tr>
                <th>Habitação</th>
                <th>Proprietário</th>
                <th>Alugado?</th>
                <th>Contrato Locação</th>
                <th>Moradores</th>
                <th>Veículos</th>
                <th>Pets</th>
                <th class="col-acoes">Ações</th>
              </tr>
            </thead>
            <tbody id="habResultadosBody">
              <!-- Linhas preenchidas via JS -->
            </tbody>
          </table>
        </div>
        <div id="habPaginas" class="wdg-pager ch-table-pager mt-2"></div>
      </div>
    </div>
  </div>

  <!-- Templates ocultos (para clonagem) -->
  <template id="tplLinhaHab">
    <tr>
      <td class="hab-col-hab truncate"></td>
      <td class="hab-col-prop truncate"></td>
      <td class="hab-col-alugado"></td>
      <td class="hab-col-contrato"></td>
      <td class="hab-col-moradores hab-moradores-list"></td>
      <td class="hab-col-veiculos"></td>
      <td class="hab-col-pets"></td>
      <td class="hab-col-acoes">
        <div class="d-flex gap-1 justify-content-center flex-nowrap">
          <button type="button" class="wdg-icon-btn" data-action="aluguel" title="Gerenciar aluguel" aria-label="Gerenciar aluguel">
            <img src="<%= _bp %>/images/inquilino.png" alt="Aluguel" onerror="this.outerHTML='&lt;i class=\'bi bi-house\'&gt;&lt;/i&gt;'">
          </button>
          <button type="button" class="wdg-icon-btn" data-action="veiculos" title="Gerenciar veículos" aria-label="Gerenciar veículos">
            <img src="<%= _bp %>/images/veiculo.png" alt="Veículos" onerror="this.outerHTML='&lt;i class=\'bi bi-car-front\'&gt;&lt;/i&gt;'">
          </button>
          <button type="button" class="wdg-icon-btn" data-action="pets" title="Gerenciar pets" aria-label="Gerenciar pets">
            <img src="<%= _bp %>/images/pet.png" alt="Pets" onerror="this.outerHTML='&lt;i class=\'bi bi-heart\'&gt;&lt;/i&gt;'">
          </button>
        </div>
      </td>
    </tr>
  </template>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script id="unidadesOptionsData" type="application/json"><%- JSON.stringify(_unidadesOptions) %></script>
  <script src="<%= _bp %>/js/condominios/editar_habitacao.js?v=1"></script>
  <%- include('./modal_detalhes_veiculo') %>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_veiculo.js?v=1"></script>
  <%- include('./modal_detalhes_pet') %>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_pet.js?v=1"></script>
  <% /* Modal: Gerenciar Aluguel */ %>
  <%- include('./modal_edit_hab_aluguel') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_hab_aluguel.js?v=1"></script>
  <% /* Modal: Gerenciar Veículos */ %>
  <%- include('./modal_edit_hab_veiculo') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_hab_veiculo.js?v=1"></script>
  <% /* Modal: Gerenciar Pets */ %>
  <%- include('./modal_edit_hab_pet') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_hab_pet.js?v=1"></script>
</body>
</html>
