<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WDGestor - Cadastrar Áreas Comuns · Gestão de Condomínios</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/icon-buttons.css?v=1">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
</head>
<body class="wdg-layout" data-base-path="<%= _bp %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: (moduleLabel||'Gestão de Condomínios'),
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleias', path: '/administracao/assembleias' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>

  <div class="container py-3">
    <div class="content mb-3 wdg-card wdg-card-hover">
      <h4 class="mb-3 text-center page-main-title">Estruturar Condomínio · Áreas Comuns</h4>
      <form id="formAreaComum" class="row g-2" novalidate>
        <!-- Linha 1: Condomínio, Nome da área e Área construída na mesma linha -->
        <div class="col-md-4">
          <label class="form-label">Condomínio</label>
          <select class="form-select" id="acUnidade">
            <% if ((unidadesOptions||[]).length === 0) { %>
              <option value="">Selecione...</option>
            <% } %>
            <% (unidadesOptions||[]).forEach(u => { %>
              <option value="<%= u._id %>"><%= u.codigo ? (u.codigo + ' - ' + u.nome) : u.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Nome da área</label>
          <input type="text" class="form-control" id="acNome" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Área construída (m²)</label>
          <input type="number" class="form-control" id="acArea" min="0" step="0.01">
        </div>
        <div class="col-md-4">
          <label class="form-label">Capacidade</label>
          <input type="text" class="form-control" id="acCapacidade" inputmode="numeric" placeholder="0 pessoa" autocomplete="off">
        </div>
        <div class="w-100"></div>
        <div class="col-md-8 mx-auto">
          <label class="form-label">Foto</label>
          <div class="d-flex gap-2">
            <input type="file" class="form-control" id="acFoto" accept="image/*">
            <button type="button" class="btn btn-outline-secondary" id="acFotoLimpar">Limpar</button>
          </div>
          <div class="mt-2 text-center"><img id="acFotoPrev" class="preview-thumb d-none" alt="Pré-visualização"></div>
        </div>
        <div class="col-12">
          <label class="form-label">Observações</label>
          <textarea id="acObs" class="form-control" rows="4" maxlength="4000" placeholder="Até 4000 caracteres..."></textarea>
          <div class="char-count"><span id="acObsCount">0</span>/4000</div>
        </div>
        <div class="col-12 d-flex gap-2 justify-content-end">
          <button type="button" class="btn btn-outline-secondary" id="acLimpar">Limpar</button>
          <button type="button" class="btn btn-outline-warning d-none" id="acCancelarEdicao">Cancelar edição</button>
          <button type="button" class="btn btn-primary" id="acSalvar">Cadastrar</button>
        </div>
      </form>
    </div>

    <div class="content wdg-card wdg-card-hover">
      <h5 class="mb-1 text-center wdg-section-title">Áreas Comuns cadastradas</h5>
      <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
          <label for="acPageSize" class="form-label mb-0">Mostra</label>
          <select id="acPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
            <option value="1000">1000</option>
          </select>
          <span class="ms-1">itens</span>
        </div>
      </div>
      <div class="table-responsive table-vert-max" id="acTableWrap">
        <table class="table table-sm align-middle text-center" id="acTable">
          <thead>
            <tr>
              <th data-sort="unidade">Condomínio</th>
              <th data-sort="nome">Nome da área</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="acLista"></tbody>
        </table>
      </div>
      <div id="acPaginas" class="wdg-pager mt-2"></div>
    </div>
  </div>

  <%- include('modal_detalhes_areaconst_cad') %>
  <div class="modal fade" id="modalFotoAreaComum" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Foto da Área Comum</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="d-flex justify-content-center mb-3 gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom="out">-</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom="reset">100%</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom="in">+</button>
          </div>
          <div class="zoom-img-container"><img id="fotoAreaComumZoom" alt="Foto área comum"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script id="unidadesOptionsData" type="application/json"><%- JSON.stringify(unidadesOptions||[]) %></script>
  <script src="<%= _bp %>/js/condominios/cadastrar_areas_comuns.js?v=1"></script>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_areaconst_cad.js?v=1"></script>
  <script src="<%= _bp %>/js/condominios/modal_foto_areacomum.js?v=1"></script>
</body>
</html>
