<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atas de Assembleias - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    body.wdg-atas{background:#f5f7fb;}
    .wdg-atas-hero{background:linear-gradient(135deg,#0f172a,#4c1d95);color:#fff;border-radius:28px;padding:2.4rem 2.9rem;margin-bottom:2rem;box-shadow:0 35px 90px rgba(15,23,42,.3);}
    .wdg-atas-hero h1{font-weight:700;font-size:2.1rem;margin-bottom:.4rem;}
    .wdg-atas-hero p{margin:0;max-width:740px;color:rgba(255,255,255,.85);}    
    .wdg-atas-panel{background:#fff;border-radius:26px;padding:1.9rem 2.3rem;box-shadow:0 32px 90px rgba(15,23,42,.12);margin-bottom:2rem;}
    .wdg-atas-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.2rem;}
    .wdg-atas-card{border:1px solid rgba(15,23,42,.08);border-radius:22px;padding:1.2rem;background:#f8fafc;box-shadow:inset 0 1px 0 rgba(255,255,255,.8);}    
    .wdg-atas-card h3{font-size:1rem;font-weight:600;margin-bottom:.35rem;}
    .wdg-atas-card small{color:#64748b;}
    .wdg-pill{display:inline-flex;align-items:center;gap:.25rem;padding:.25rem .65rem;border-radius:999px;font-size:.78rem;font-weight:600;background:#e0e7ff;color:#3730a3;}
    .wdg-atas-viewer{background:#0f172a;border-radius:22px;padding:1.2rem;height:100%;color:#fff;}
    .wdg-atas-viewer iframe{width:100%;height:420px;border:none;border-radius:16px;background:#fff;}
    .wdg-atas-controls .btn{border-radius:12px;}
    .table-pagination{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid rgba(15,23,42,.08);border-radius:14px;padding:.65rem 1rem;margin-top:.65rem;box-shadow:0 10px 24px rgba(15,23,42,.08);gap:1rem;}
    .table-pagination .pagination-info{font-size:.85rem;color:#475569;font-weight:600;}
    .table-pagination .btn{border-radius:999px;padding:.35rem .85rem;font-size:.85rem;}
    .table-pagination-hidden{display:none;}
    .wdg-empty-state{padding:2rem;border:1px dashed rgba(15,23,42,.2);border-radius:20px;text-align:center;color:#94a3b8;font-weight:600;}
    @media(max-width:768px){
      .wdg-atas-hero{padding:1.6rem;}
      .wdg-atas-panel{padding:1.3rem;}
    }
  </style>
</head>
<body class="wdg-layout wdg-atas">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: 'Gestão de Condomínios',
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleias', path: '/administracao/assembleias' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>

  <main class="container py-4" id="atasApp" data-base-path="<%= _bp %>">
    <section class="wdg-atas-hero">
      <h1>Biblioteca digital de Atas</h1>
      <p>Todos os registros formais de assembleias em um só lugar, com fluxo de assinatura digital, auditoria e download instantâneo — inspirado em plataformas como Superlógica, CondoConta e uCondo.</p>
    </section>

    <div class="wdg-atas-panel mb-4">
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label text-uppercase text-muted small" for="filtroPeriodo">Período</label>
          <select class="form-select" id="filtroPeriodo">
            <option value="ano">Ano corrente</option>
            <option value="ultimo">Últimos 12 meses</option>
            <option value="todos">Todos os registros</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label text-uppercase text-muted small" for="filtroFormato">Tipo</label>
          <select class="form-select" id="filtroFormato">
            <option value="todos">Todas</option>
            <option value="ordinaria">Ordinária</option>
            <option value="extraordinaria">Extraordinária</option>
            <option value="tematica">Reunião temática</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label text-uppercase text-muted small" for="filtroBusca">Busca</label>
          <input type="search" class="form-control" id="filtroBusca" placeholder="Título, responsável, assunto">
        </div>
      </div>
    </div>

    <div class="wdg-atas-panel mb-4">
      <div class="row g-4">
        <div class="col-lg-7">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Atas registradas</h2>
            <div class="btn-group wdg-atas-controls">
              <button class="btn btn-outline-secondary btn-sm" data-action="exportar-selecionadas"><i class="bi bi-download me-1"></i>Exportar PDF</button>
              <button class="btn btn-outline-secondary btn-sm" data-action="compartilhar-link"><i class="bi bi-link-45deg me-1"></i>Compartilhar link</button>
            </div>
          </div>
          <div class="table-responsive wdg-table">
            <table class="table mb-0" id="tabelaAtas">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Título</th>
                  <th>Tipo</th>
                  <th>Presidente</th>
                  <th>Status</th>
                  <th class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="table-pagination table-pagination-hidden" id="pagerAtas"></div>
        </div>
        <div class="col-lg-5">
          <div class="wdg-atas-viewer">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <span class="text-uppercase small text-white-50">Pré-visualização</span>
                <h3 class="h5 mb-0" id="viewerTitulo">Selecione uma ata</h3>
              </div>
              <button class="btn btn-light btn-sm" data-action="abrir-em-nova"><i class="bi bi-arrows-fullscreen"></i></button>
            </div>
            <div class="bg-white rounded-4 p-3" style="min-height:460px;">
              <p class="text-muted" id="viewerPlaceholder">Escolha uma ata para visualizar o PDF diretamente aqui. Compatível com assinatura digital ICP-Brasil.</p>
              <iframe id="viewerFrame" title="Visualizador de ata" class="d-none"></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="wdg-atas-panel">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Resumo anual</h2>
        <button class="btn btn-outline-primary btn-sm" data-action="baixar-relatorio"><i class="bi bi-clipboard-data me-1"></i>Relatório consolidado</button>
      </div>
      <div class="wdg-atas-grid" id="cardsResumo"></div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _bp %>/js/condominios/atas.js?v=1"></script>
</body>
</html>
