<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WDGestor - Cadastrar Proprietário · Gestão de Condomínios</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/icon-buttons.css?v=1">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    .content { background:#fff; border-radius:8px; padding:16px; }
    .table-sm td, .table-sm th { vertical-align: middle; }
    .blocked { background:#f8f9fa; cursor:not-allowed; }
    .hab-table td { font-size:.85rem; }
    .badge-role { font-size:.65rem; letter-spacing:.5px; }
    /* Oculta ícone do calendário para este campo específico */
    #pDataNasc + .btn-date-icon { display: none !important; }
    /* Aumenta largura e garante que não fique atrás do input */
  .tel-group .wa-addon { padding-left: 1rem; padding-right: 1rem; min-width: 121px; flex: 0 0 auto; position: relative; z-index: 3; white-space: nowrap; display: flex; align-items: center; justify-content: flex-end; text-align: right; }
  .tel-group .wa-addon .form-check { margin-left: auto; }
    .tel-group .form-control { position: relative; z-index: 1; }
  </style>
</head>
<body class="wdg-layout" data-base-path="<%= _bp %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: (moduleLabel||'Gestão de Condomínios'),
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleias', path: '/administracao/assembleias' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>

  <div class="container py-3">
    <div class="content mb-3">
  <h4 class="mb-3 text-center">Cadastrar Proprietário</h4>
      <form id="formProprietario" autocomplete="off" novalidate>
        <div class="row g-3 align-items-start">
          <div class="col-md-4">
            <label class="form-label">Condomínio</label>
            <select class="form-select" id="vUnidade" required></select>
          </div>
        </div>

        <!-- 1ª Linha -->
        <div class="row g-3 align-items-start">
          <div class="col-md-4">
            <label class="form-label">E-mail</label>
            <div class="input-group">
              <input type="email" class="form-control" id="pEmail" required placeholder="exemplo@dominio.com">
              <button type="button" class="btn btn-outline-primary" id="btnVerificarEmail">Verificar</button>
            </div>
            <div class="form-text text-danger d-none" id="pEmailMsg"></div>
          </div>
          <div class="col-md-8">
            <label class="form-label">Nome</label>
            <input type="text" class="form-control blocked" id="pNome" disabled>
          </div>
        </div>

        <!-- 2ª Linha -->
        <div class="row g-3 mt-0 align-items-start">
          <div class="col-md-3">
            <label class="form-label">RG</label>
            <input type="text" class="form-control blocked" id="pRg" disabled>
          </div>
          <div class="col-md-3">
            <label class="form-label">CPF</label>
            <input type="text" class="form-control blocked" id="pCpf" placeholder="000.000.000-00" disabled>
            <div class="form-text text-danger d-none" id="pCpfMsg">CPF inválido.</div>
          </div>
        </div>

        <!-- 3ª Linha -->
        <div class="row g-3 mt-0 align-items-start">
          <div class="col-md-3">
            <label class="form-label">Data de Nascimento</label>
            <input type="text" class="form-control date-br datepicker blocked w-auto" id="pDataNasc" placeholder="DD/MM/AAAA" autocomplete="off" data-formato="br" style="max-width:150px" readonly disabled>
          </div>
          <div class="col-md-3">
            <label class="form-label">Idade</label>
            <input type="text" class="form-control" id="pIdade" readonly>
          </div>
          <div class="col-md-3">
            <label class="form-label">Sexo</label>
            <select class="form-select blocked" id="pSexo" disabled></select>
          </div>
        </div>

        <!-- 4ª Linha -->
        <div class="row g-3 mt-0 align-items-start">
          <div class="col-md-6">
            <label class="form-label">Pai</label>
            <input type="text" class="form-control blocked" id="pPai" disabled>
          </div>
          <div class="col-md-6">
            <label class="form-label">Mãe</label>
            <input type="text" class="form-control blocked" id="pMae" disabled>
          </div>
        </div>

        <!-- Telefone (linha própria) -->
        <div class="row g-3 mt-0 align-items-start">
          <div class="col-md-4">
            <label class="form-label">Telefone</label>
            <div class="input-group flex-nowrap tel-group">
              <input type="text" class="form-control flex-grow-1 blocked" id="pTelefone" placeholder="(00) 0 0000-0000" disabled>
              <div class="input-group-text bg-white flex-shrink-0 wa-addon">
                <div class="form-check m-0 p-0 d-flex align-items-center">
                  <input class="form-check-input me-1" type="checkbox" id="pWhatsapp" disabled>
                  <label for="pWhatsapp" class="form-check-label" style="font-size:.75rem;">WhatsApp</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Vincular Habitações -->
        <div class="col-12 mt-2">
          <h6 class="mb-2">Vincular Habitações</h6>
          <div class="row g-3 align-items-end vinc-row-prop">
            <div class="col-md-4">
              <label class="form-label">Condomínio selecionado</label>
              <div class="form-control-plaintext" id="vUnidadeResumo">Selecione um condomínio</div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Habitação (livre)</label>
              <select class="form-select blocked" id="vHabitacao" disabled><option value="">Selecione...</option></select>
            </div>
            <div class="col-md-4 d-flex gap-2 vinc-toolbar align-items-stretch">
              <div class="flex-grow-1 d-flex flex-column" style="min-width:180px; max-width:260px;">
                <label class="form-label">É Morador?</label>
                <select class="form-select blocked h-100" id="vMorador" disabled>
                  <option value="N">Não</option>
                  <option value="S">Sim</option>
                </select>
              </div>
              <div class="d-flex flex-column justify-content-end">
                <button type="button" class="btn btn-outline-primary blocked vinc-btn" id="btnInserirVinculo" disabled>Inserir</button>
              </div>
              <div class="d-flex flex-column justify-content-end">
                <button type="button" class="btn btn-outline-secondary blocked vinc-btn" id="btnLimparVinculos" disabled>Limpar</button>
              </div>
            </div>
          </div>
          <div class="table-responsive mt-2">
            <table class="table table-sm table-bordered hab-table">
              <thead>
                <tr>
                  <th>Condomínio</th>
                  <th>Habitação</th>
                  <th>Morador</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody id="vTabela"></tbody>
            </table>
          </div>
        </div>

        <div class="col-12 d-flex gap-2 justify-content-end">
          <button type="button" class="btn btn-outline-danger d-none" id="btnCancelarEdicaoProp">Cancelar edição</button>
          <button type="button" class="btn btn-outline-secondary" id="btnLimparForm">Limpar</button>
          <button type="button" class="btn btn-primary" id="btnCadastrarProp" disabled>Cadastrar</button>
        </div>
      </form>
    </div>

    <!-- Lista proprietários -->
    <div class="content wdg-card wdg-card-hover wdg-list-wide">
      <h5 class="mb-1 text-center wdg-section-title">Proprietários cadastrados</h5>
      <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
          <label for="pPageSize" class="form-label mb-0">Mostra</label>
          <select id="pPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
            <option value="1000">1000</option>
          </select>
          <span class="ms-1">itens</span>
        </div>
      </div>
      <div class="table-responsive table-vert-max" id="propTableWrap">
        <table class="table table-sm align-middle text-center" id="tblProprietarios">
          <thead>
            <tr>
              <th data-sort="email">E-mail</th>
              <th data-sort="nome">Nome</th>
              <th data-sort="condominio">Condomínio</th>
              <th data-sort="habitacoes">Habitações</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="propLista"></tbody>
        </table>
      </div>
      <div id="pPaginas" class="wdg-pager mt-2"></div>
    </div>
  </div>

  <script id="existingUsersData" type="application/json"><%- JSON.stringify(existingUsers||[]) %></script>
  <script id="habitacoesLivresData" type="application/json"><%- JSON.stringify(habitacoesLivres||[]) %></script>
  <script id="unidadesData" type="application/json"><%- JSON.stringify(unidadesOptions||[]) %></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/gestor/js/core/simple-datepicker.js"></script>
  <script src="<%= _bp %>/js/condominios/cadastrar_proprietario.js?v=6"></script>
  <%- include('modal_detalhes_prop_cad') %>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_prop_cad.js?v=4"></script>
</body>
</html>
