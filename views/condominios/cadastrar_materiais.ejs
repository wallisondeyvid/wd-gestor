<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WDGestor - Cadastrar Materiais · Gestão de Condomínios</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/icon-buttons.css?v=1">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    /* Oculta ícone do calendário ao lado do campo de data de aquisição */
    #mDataAquisicao + .btn-date-icon { display: none !important; }
  </style>
</head>
<body class="wdg-layout" data-base-path="<%= _bp %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: (moduleLabel||'Gestão de Condomínios'),
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleias', path: '/administracao/assembleias' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>

  <div class="container py-3">
    <div class="content mb-3 wdg-card wdg-card-hover">
      <h4 class="mb-3 text-center page-main-title">Estruturar Condomínio · Natureza do Material</h4>
      <div class="row g-3 side-forms">
        <div class="col-12 form-col-wrapper">
          <form id="formNat" class="independent-box wdg-card wdg-card-hover" novalidate>
            <div class="box-toggle-header d-flex align-items-center gap-2">
              <button type="button" class="btn btn-light border toggle-collapse collapsed" data-bs-toggle="collapse" data-bs-target="#formNatBody" aria-expanded="false" title="Recolher / Expandir">+</button>
              <h6 class="mb-0">Cadastrar Natureza do Material</h6>
            </div>
            <div id="formNatBody" class="collapse">
              <div class="row g-2 mt-2">
                <div class="col-md-4">
                  <label class="form-label">Condomínio</label>
                  <select class="form-select" id="nUnidade"></select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Tipo de Material</label>
                  <select class="form-select" id="nTipo">
                    <option value="Fixo">Fixo</option>
                    <option value="Móvel">Móvel</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Nome da Natureza do Material</label>
                  <input type="text" class="form-control" id="nNome" placeholder="Ex.: Cadeira" required>
                </div>
                <div class="w-100"></div>
                <div class="col-12 d-flex gap-2 justify-content-end">
                  <button type="button" class="btn btn-outline-danger d-none" id="nCancelar" title="Cancelar edição">Cancelar edição</button>
                  <button type="button" class="btn btn-outline-secondary" id="nLimpar">Limpar</button>
                  <button type="button" class="btn btn-primary" id="nSalvar">Cadastrar</button>
                </div>
                <div class="table-responsive table-vert-max mt-3">
                  <table class="table table-sm align-middle text-center">
                    <thead><tr><th>Condomínio</th><th>Tipo Material</th><th>Nome</th><th>Ações</th></tr></thead>
                    <tbody id="nLista"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="content mb-3 wdg-card wdg-card-hover">
      <h5 class="mb-3 text-center wdg-section-title">Cadastrar Material</h5>
      <form id="formMat" class="row g-2" novalidate>
        <div class="col-md-4">
          <label class="form-label">Condomínio</label>
          <select class="form-select" id="mUnidade"></select>
        </div>
        <div class="col-md-4 text-center">
          <label class="form-label d-block mb-1">Tipo de material</label>
          <div class="d-flex gap-4 justify-content-center align-items-center" id="mTipoWrap">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="mTipo" id="mTipoFixo" value="Fixo" checked>
              <label class="form-check-label" for="mTipoFixo">Fixo</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="mTipo" id="mTipoMovel" value="Móvel">
              <label class="form-check-label" for="mTipoMovel">Móvel</label>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Nome do Material</label>
          <select class="form-select" id="mNome" required>
            <option value="">Selecione...</option>
          </select>
        </div>
        <!-- Linha adicional: Marca, Modelo, Nº Série, Peso, Cor -->
        <div class="w-100"></div>
        <div class="col-md-3">
          <label class="form-label">Marca</label>
          <input type="text" class="form-control" id="mMarca">
        </div>
        <div class="col-md-3">
          <label class="form-label">Modelo</label>
          <input type="text" class="form-control" id="mModelo">
        </div>
        <div class="col-md-2">
          <label class="form-label">Nº Série</label>
          <input type="text" class="form-control" id="mNumSerie" maxlength="40">
        </div>
        <div class="col-md-2">
          <label class="form-label">Peso</label>
          <input type="text" class="form-control" id="mPeso">
        </div>
        <div class="col-md-2">
          <label class="form-label">Cor</label>
          <input type="text" class="form-control" id="mCor">
        </div>
        <div class="w-100"></div>
        <div class="col-md-4">
          <label class="form-label">Nº de Patrimônio</label>
          <div class="input-group">
            <input type="text" class="form-control" id="mSerie" maxlength="15" placeholder="Até 15 caracteres (opcional)">
            <button type="button" class="btn btn-outline-secondary" id="mGerarSerie">Gerar</button>
          </div>
          <div class="form-text" id="mSerieInfo">Deixe em branco para não informar.</div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Data de aquisição</label>
          <input type="text" class="form-control date-br datepicker w-auto" id="mDataAquisicao" placeholder="DD/MM/AAAA" autocomplete="off" data-formato="br" style="max-width:150px" readonly>
        </div>
        <div class="w-100"></div>
        <div class="col-md-6">
          <label class="form-label">Foto</label>
          <div class="d-flex gap-2">
            <input type="file" class="form-control" id="mFoto" accept="image/*">
            <button type="button" class="btn btn-outline-secondary" id="mFotoLimpar">Limpar</button>
          </div>
          <div class="mt-2 text-center"><img id="mFotoPrev" class="preview-thumb d-none" alt="Pré-visualização"></div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Anexo (nota fiscal .pdf)</label>
          <div class="d-flex gap-2">
            <input type="file" class="form-control" id="mAnexo" accept="application/pdf">
            <button type="button" class="btn btn-outline-secondary" id="mAnexoLimpar">Limpar</button>
          </div>
          <ul class="list-group list-group-flush mt-2" id="mAnexoLista"></ul>
        </div>
        <div class="w-100"></div>
        <!-- Descrição -->
        <div class="col-12">
          <label class="form-label">Descrição</label>
          <textarea class="form-control" id="mDesc" rows="3" maxlength="4000" placeholder="Detalhes adicionais..."></textarea>
          <div class="form-text text-end"><span id="mDescCount">0</span>/4000</div>
        </div>
        <div class="w-100"></div>
        <div class="col-12 mt-2">
          <h6 class="mb-2">Vincular à área comum</h6>
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label">Condomínio</label>
              <input type="text" class="form-control" id="vUnidade" disabled>
            </div>
            <div class="col-md-4">
              <label class="form-label">Área comum</label>
              <select class="form-select" id="vArea"><option value="">Selecione...</option></select>
            </div>
            <div class="col-md-4 d-flex justify-content-end gap-2">
              <button type="button" class="btn btn-outline-primary" id="btnInserirVinc">Inserir</button>
              <button type="button" class="btn btn-outline-secondary" id="btnLimparVinc">Limpar</button>
            </div>
          </div>
          <div class="table-responsive mt-2">
            <table class="table table-sm align-middle text-center">
              <thead><tr><th>Condomínio</th><th>Área comum</th><th>Ações</th></tr></thead>
              <tbody id="vTabela"></tbody>
            </table>
          </div>
        </div>
        <div class="col-12 d-flex gap-2 justify-content-end">
          <button type="button" class="btn btn-outline-secondary" id="mLimpar">Limpar</button>
          <button type="button" class="btn btn-primary" id="mSalvar">Cadastrar</button>
        </div>
      </form>
    </div>

    <div class="content wdg-card wdg-card-hover">
      <h5 class="mb-1 text-center wdg-section-title">Materiais cadastrados</h5>
      <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
          <label for="matPageSize" class="form-label mb-0">Mostra</label>
          <select id="matPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
            <option value="1000">1000</option>
          </select>
          <span class="ms-1">itens</span>
        </div>
        <div class="ms-auto mt-2 mt-md-0" style="min-width: 240px;">
          <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="matSearch" class="form-control" placeholder="Buscar por nome, patrimônio, marca...">
          </div>
        </div>
      </div>
      <div class="table-responsive table-vert-max" id="matTableWrap">
        <table class="table table-sm align-middle text-center" id="matTable">
          <thead>
            <tr>
              <th data-sort="tipo">Tipo Material</th>
              <th data-sort="nome">Nome</th>
              <th data-sort="serie">Nº de Patrimônio</th>
              <th data-sort="data">Data de aquisição</th>
              <th data-sort="area">Área comum</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="matLista"></tbody>
        </table>
      </div>
      <div id="matPaginas" class="wdg-pager mt-2"></div>
    </div>
  </div>

  <script id="unidadesOptionsData" type="application/json"><%- JSON.stringify(unidadesOptions||[]) %></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/gestor/js/core/simple-datepicker.js"></script>
  <script src="<%= _bp %>/js/condominios/cadastrar_materiais.js?v=4"></script>
  <%- include('modal_detalhes_materiais_cad') %>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_materiais_cad.js?v=1"></script>
  <%- include('modal_qrcode_mat_cad') %>
  <!-- Biblioteca QRCode: tenta CDN (sem SRI) e mantém local como fallback -->
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
  <script>if(!window.QRCode){document.write('<script src="'+('<%= _bp %>')+'/js/condominios/vendor-qrcode.min.js?v=2"><\/script>');}</script>
  <script src="<%= _bp %>/js/condominios/modal_qrcode_mat_cad.js?v=9"></script>
  <script>
    (function(){
      var toggles = document.querySelectorAll('.toggle-collapse');
      toggles.forEach(function(btn){
        var targetSel = btn.getAttribute('data-bs-target');
        var body = document.querySelector(targetSel);
        if(!body) return;
        body.addEventListener('shown.bs.collapse', function(){ btn.textContent = '−'; btn.setAttribute('aria-expanded','true'); });
        body.addEventListener('hidden.bs.collapse', function(){ btn.textContent = '+'; btn.setAttribute('aria-expanded','false'); });
        if(!body.classList.contains('show')){ btn.textContent = '+'; btn.setAttribute('aria-expanded','false'); }
        else { btn.textContent = '−'; btn.setAttribute('aria-expanded','true'); }
      });
    })();
  </script>
</body>
</html>
