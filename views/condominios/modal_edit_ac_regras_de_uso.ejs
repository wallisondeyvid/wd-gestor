<% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
<div class="modal fade" id="modalEditACRegrasUso" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content wdg-modal wdg-modal-uso">
      <div class="modal-header border-0">
        <div class="wdg-uso-head">
          <span class="wdg-uso-head-pre">Termo de uso</span>
          <h5 class="modal-title">Regras de uso da área comum</h5>
          <p class="wdg-uso-head-sub">Defina e organize as orientações que os condôminos devem seguir ao utilizar esta área. Você pode registrar múltiplas regras e atualizá-las sempre que necessário.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <section class="wdg-uso-context" aria-live="polite">
          <div class="wdg-uso-context-item">
            <span class="wdg-uso-context-label">Condomínio</span>
            <strong id="acUsoContextUnidade">&mdash;</strong>
          </div>
          <div class="wdg-uso-context-item">
            <span class="wdg-uso-context-label">Área comum</span>
            <strong id="acUsoContextArea">&mdash;</strong>
          </div>
        </section>

        <section class="wdg-uso-editor" aria-labelledby="acUsoEditorTitle">
          <header class="wdg-uso-editor-head">
            <div>
              <span class="wdg-uso-editor-pre">Nova regra</span>
              <h6 id="acUsoEditorTitle" class="wdg-uso-editor-title">Cadastrar regra de uso</h6>
            </div>
            <div class="wdg-uso-counter" id="acUsoCharCounter">0 / 8000</div>
          </header>
          <div id="acUsoFeedback" class="wdg-uso-feedback" role="alert" aria-live="assertive"></div>
          <label class="form-label wdg-uso-label" for="acUsoTextarea">Regra</label>
          <textarea id="acUsoTextarea" class="form-control wdg-uso-textarea" rows="4" maxlength="8000" placeholder="Descreva a orientação para utilização da área"></textarea>
          <div class="wdg-uso-editor-actions">
            <button type="button" class="btn btn-outline-secondary" id="acUsoClearBtn">Limpar</button>
            <button type="button" class="btn btn-primary" id="acUsoInsertBtn">Inserir</button>
          </div>
        </section>

        <section class="wdg-uso-list" aria-labelledby="acUsoListaTitulo">
          <header class="wdg-uso-list-head">
            <div>
              <span class="wdg-uso-list-pre">Regras cadastradas</span>
              <h6 id="acUsoListaTitulo" class="wdg-uso-list-title">Regras da área comum</h6>
            </div>
            <span class="badge rounded-pill text-bg-primary" id="acUsoTotalBadge">0</span>
          </header>
          <div class="wdg-uso-list-controls">
            <label for="acUsoPageSize" class="wdg-uso-list-label">Mostrar</label>
            <select id="acUsoPageSize" class="form-select form-select-sm wdg-uso-page-size">
              <option value="5">5</option>
              <option value="10" selected>10</option>
              <option value="20">20</option>
            </select>
            <span class="wdg-uso-list-suffix">itens</span>
          </div>
          <div class="table-responsive">
            <table class="table table-sm align-middle wdg-uso-table">
              <thead>
                <tr>
                  <th scope="col" class="wdg-uso-table-order" aria-label="Mover ordem">Mover</th>
                  <th scope="col">Regra</th>
                  <th scope="col" class="wdg-uso-table-actions">Ações</th>
                </tr>
              </thead>
              <tbody id="acUsoRulesBody"></tbody>
            </table>
          </div>
          <div id="acUsoEmpty" class="wdg-uso-empty" role="status">Nenhuma regra cadastrada para esta área.</div>
          <div id="acUsoPager" class="wdg-pager wdg-uso-pager"></div>
        </section>
      </div>
      <div class="modal-footer border-0 pt-0 wdg-uso-footer">
        <div class="wdg-uso-footer-left">
          <span id="acUsoDirtyHint" class="wdg-uso-dirty" hidden>Alterações pendentes não salvas</span>
        </div>
        <div class="wdg-uso-footer-actions">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="acUsoCancelBtn">Cancelar</button>
          <button type="button" class="btn btn-primary" id="acUsoSaveBtn">Salvar regras</button>
        </div>
      </div>
    </div>
  </div>
</div>

