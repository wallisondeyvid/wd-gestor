<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WDGestor - Editar Áreas Comuns · Gestão de Condomínios</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/icon-buttons.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/pages/cadastrar_proprietario.css?v=1">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    .area-search-form .form-label{ font-weight:650; }
    .col-acoes{ width:260px; }

    .wdg-area-stack{ display:flex; flex-direction:column; gap:.25rem; align-items:center; text-align:center; }
    .wdg-area-primary{ font-weight:700; color:var(--wdg-text); white-space:nowrap; }
    .wdg-area-secondary{ font-size:.75rem; color:var(--wdg-text-light); white-space:nowrap; }
    .wdg-area-chip-row{ display:flex; flex-wrap:wrap; gap:.4rem; justify-content:center; }
    .wdg-area-chip-row[data-layout="column"]{ flex-direction:column; align-items:center; }
    .wdg-area-chip{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.42rem;
      min-height: 32px;
      padding:.38rem .9rem;
      border-radius:999px;
      font-size:.79rem;
      font-weight:750;
      letter-spacing:.01em;
      border:1px solid rgba(var(--wdg-accent-rgb), .18);
      text-decoration:none;
      line-height:1.1;
      background: linear-gradient(180deg, rgba(var(--wdg-accent-rgb), .12), rgba(var(--wdg-accent-rgb), .06)) !important;
      color:var(--wdg-text);
      white-space:nowrap;
      max-width: 100%;
      box-shadow: var(--wdg-shadow-sm) !important;
    }
    .wdg-area-chip i{ font-size:.98rem; opacity:.95; }
    .wdg-area-chip[data-variant="accent"]{ background: var(--wdg-primary) !important; border-color: rgba(var(--wdg-primary-rgb), .18) !important; color:#fff !important; }
    .wdg-area-chip[data-variant="success"]{ background: var(--wdg-success) !important; border-color: rgba(var(--wdg-primary-rgb), .12) !important; color:#fff !important; }
    .wdg-area-chip[data-variant="muted"]{ background: linear-gradient(180deg, var(--wdg-surface), var(--wdg-surface-alt)); border-color: rgba(var(--wdg-accent-rgb), .18); color: var(--wdg-text-light); box-shadow:none; }
    .wdg-area-chip[data-variant="warning"]{ background: rgb(var(--bs-warning-rgb)) !important; border-color: rgba(var(--bs-warning-rgb), .22) !important; color: var(--wdg-text) !important; }
    .wdg-area-chip[data-variant="danger"]{ background: var(--wdg-danger) !important; border-color: rgba(var(--wdg-primary-rgb), .12) !important; color:#fff !important; }
    .wdg-area-chip--link{ cursor:pointer; user-select:none; transition:transform .15s ease, box-shadow .15s ease, background-color .15s ease, border-color .15s ease, color .15s ease; }
    .wdg-area-chip--link:hover{ background:var(--wdg-primary) !important; border-color:var(--wdg-primary) !important; color:#fff !important; text-decoration:none; box-shadow: var(--wdg-shadow-sm); transform: translateY(-1px); }
    .wdg-area-chip--link:active{ transform: translateY(0); box-shadow:none; }
    button.wdg-area-chip{ border:0; background: inherit; padding: inherit; }
    button.wdg-area-chip:disabled{ opacity:.45; cursor:not-allowed; }
    button.wdg-area-chip:focus-visible{ outline:2px solid var(--wdg-primary); outline-offset:2px; }
    .wdg-area-chip-text{ display:inline-block; overflow:hidden; text-overflow:ellipsis; max-width: 320px; }
    .wdg-area-chip.wdg-loading{ opacity:.6; pointer-events:none; }
    .wdg-area-empty{ color:var(--wdg-text-light); font-weight:650; }
    .area-col-multi{ white-space:normal; }
  </style>
</head>
<body class="wdg-layout page-editar-area-comum" data-base-path="<%= _bp %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: (moduleLabel||'Gestão de Condomínios'),
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleia', children: [
              { label: 'Assembleias', path: '/assembleias' },
              { label: 'Nova assembleia', path: '/assembleias/nova' }
            ]},
            { label: 'Dirigência', path: '/administracao/dirigencia' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>

  <% 
    const _unidadesOptions = (typeof unidadesOptions !== 'undefined' && Array.isArray(unidadesOptions)) ? unidadesOptions : [];
    const _isScopeAll = Boolean(user && (user.isMaster || user.role === 'master' || user.role === 'admin'));
    const _userUnitId = (user && user.unidade_id) ? (user.unidade_id._id || user.unidade_id || user.unidadeId || '') : (user && user.unidadeId ? user.unidadeId : '');
    const _userUnitObj = (_userUnitId && _unidadesOptions.length) ? (_unidadesOptions||[]).find(u => String((u && (u._id || u.id)) || '') === String(_userUnitId)) : null;
    const _userUnitFromProfile = (user && user.unidade_id && typeof user.unidade_id === 'object') ? user.unidade_id : null;
    const _userUnitLabelFromProfile = _userUnitFromProfile ? ((_userUnitFromProfile.codigo ? (_userUnitFromProfile.codigo + ' - ') : '') + (_userUnitFromProfile.nome || _userUnitFromProfile.razaoSocial || '')) : '';
    const _fmtUnidadeLabel = (u) => {
      if(!u) return '';
      const codigo = (u.codigo || '').toString().trim();
      const nome = (u.nome || u.razaoSocial || u.label || '').toString().trim();
      return (codigo ? (codigo + ' - ') : '') + (nome || codigo);
    };
  %>

  <div class="container py-3">
    <div class="content mb-3 wdg-card wdg-card-hover">
      <h4 class="mb-3 text-center page-main-title">Editar Áreas Comuns</h4>

      <div class="wdg-panel-subbar wdg-condo-subbar" aria-label="Filtro de condomínio">
        <div class="wdg-condo-field">
          <div class="wdg-condo-label">Condomínio</div>
          <div class="wdg-condo-controlrow">
            <img id="fAreaUnidadeLogo" data-condo-inline-logo="1" src="/images/unidade.png" alt="" aria-hidden="true" class="wdg-condo-inline-logo">
            <select id="fAreaUnidade" class="form-select wdg-condo-select" aria-label="Condomínio" <%= !_isScopeAll ? 'disabled' : '' %>>
              <% if (_isScopeAll) { %>
                <option value="">Selecione...</option>
                <% (_unidadesOptions||[]).forEach(u => { %>
                  <option value="<%= (u._id || u.id) %>"><%= _fmtUnidadeLabel(u) %></option>
                <% }) %>
              <% } else { %>
                <% if (_userUnitObj) { %>
                  <option value="<%= (_userUnitObj._id || _userUnitObj.id) %>" selected><%= _fmtUnidadeLabel(_userUnitObj) %></option>
                <% } else if (_userUnitId) { %>
                  <option value="<%= _userUnitId %>" selected><%= (_userUnitLabelFromProfile || 'Condomínio selecionado') %></option>
                <% } else { %>
                  <option value="" selected>Condomínio não definido</option>
                <% } %>
              <% } %>
            </select>
          </div>
          <% if (!_isScopeAll) { %>
            <div class="text-muted small mt-1">Condomínio fixado pelo seu perfil.</div>
          <% } %>
        </div>
      </div>
    </div>

    <form id="formPesquisaArea" class="content wdg-card wdg-card-hover p-3 mb-3 area-search-form" autocomplete="off" novalidate>
      <div class="row g-3 align-items-end">
        <div class="col-lg-6 col-md-6">
          <label class="form-label" for="fAreaNome">Nome da área</label>
          <input id="fAreaNome" class="form-control" placeholder="Buscar por nome..." autocomplete="off">
        </div>
        <div class="col-lg-6 col-md-6">
          <label class="form-label" for="fAreaStatus">Status</label>
          <select id="fAreaStatus" class="form-select" aria-label="Filtrar status">
            <option value="">Todos</option>
            <option value="ativas" selected>Somente ativas</option>
            <option value="inativas">Somente inativas</option>
          </select>
        </div>
      </div>
    </form>

    <div class="content wdg-card wdg-card-hover p-3 wdg-list-wide">
      <h5 class="mb-2 text-center wdg-section-title">Lista de Áreas Comuns</h5>
      <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
          <label for="areaPageSize" class="form-label mb-0">Mostra</label>
          <select id="areaPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
            <option value="1000">1000</option>
          </select>
          <span class="ms-1">itens</span>
        </div>
      </div>
      <div class="ch-table-wrap" id="areaTableWrap" aria-label="Áreas comuns cadastradas">
        <div id="areaResultadoWrap" class="table-responsive table-vert-max ch-table-scroll">
          <table class="table table-hover table-sm align-middle text-center mb-0 ch-table" id="tabelaAreaEdit">
          <thead>
            <tr>
              <th>Área Comum</th>
              <th>Materiais</th>
              <th>Disponibilidades</th>
              <th>Restrições</th>
              <th class="col-acoes">Ações</th>
            </tr>
          </thead>
          <tbody id="areaResultadosBody"></tbody>
          </table>
        </div>
        <div id="areaPaginas" class="wdg-pager ch-table-pager mt-2"></div>
      </div>
    </div>
  </div>

  <template id="tplLinhaArea">
    <tr>
      <td class="area-col-area"></td>
      <td class="area-col-materiais area-col-multi"></td>
      <td class="area-col-disponibilidades area-col-multi"></td>
      <td class="area-col-restricoes area-col-multi"></td>
      <td class="area-col-acoes">
        <div class="d-flex gap-1 justify-content-center flex-wrap">
          <button type="button" class="wdg-icon-btn" data-action="ceder-uso" title="Ceder para uso" aria-label="Ceder para uso">
            <img src="<%= _bp %>/images/cessaodeuso.png" alt="Ceder para uso" onerror="this.outerHTML='&lt;i class=\'bi bi-calendar-event\'&gt;&lt;/i&gt;'">
          </button>
          <button type="button" class="wdg-icon-btn" data-action="materiais" title="Materiais" aria-label="Materiais">
            <img src="<%= _bp %>/images/materiais.png" alt="Materiais" onerror="this.outerHTML='&lt;i class=\'bi bi-boxes\'&gt;&lt;/i&gt;'">
          </button>
          <button type="button" class="wdg-icon-btn" data-action="disponibilidades" title="Definir disponibilidades" aria-label="Definir disponibilidades">
            <img src="<%= _bp %>/images/disponibilidade.png" alt="Disponibilidades" onerror="this.outerHTML='&lt;i class=\'bi bi-clock-history\'&gt;&lt;/i&gt;'">
          </button>
          <button type="button" class="wdg-icon-btn" data-action="restricoes" title="Definir restrições" aria-label="Definir restrições">
            <img src="<%= _bp %>/images/indisponivel.png" alt="Restrições" onerror="this.outerHTML='&lt;i class=\'bi bi-slash-circle\'&gt;&lt;/i&gt;'">
          </button>
          <button type="button" class="wdg-icon-btn" data-action="termo" title="Definir termo de uso" aria-label="Definir termo de uso">
            <img src="<%= _bp %>/images/termodeuso.png" alt="Termo de uso" onerror="this.outerHTML='&lt;i class=\'bi bi-file-text\'&gt;&lt;/i&gt;'">
          </button>
        </div>
      </td>
    </tr>
  </template>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script id="unidadesOptionsData" type="application/json"><%- JSON.stringify(_unidadesOptions) %></script>
  <script src="<%= _bp %>/js/condominios/editar_area_comum.js?v=1"></script>
  <%- include('./modal_edit_ac_ceder_para_uso') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_ceder_para_uso.js?v=2"></script>
  <%- include('./modal_edit_ac_disponibilidade') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_disponibilidade.js?v=1"></script>
  <%- include('./modal_edit_ac_restricoes') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_restricoes.js?v=1"></script>
  <%- include('./modal_edit_ac_regras_de_uso') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_regras_de_uso.js?v=1"></script>
  <%- include('./modal_edit_ac_material') %>
  <%- include('./modal_transferir_material') %>
  <script src="<%= _bp %>/js/condominios/modal_transferir_material.js?v=1"></script>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_material.js?v=1"></script>
  <%- include('./modal_detalhes_materiais_cad') %>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_materiais_cad.js?v=1"></script>
</body>
</html>
