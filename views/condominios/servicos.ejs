<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Serviços e Ordens - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    body.wdg-servicos{background:#f8fafc;}
    .wdg-servicos-hero{background:linear-gradient(120deg,#0f172a,#1e3a8a 55%,#0ea5e9);color:#fff;border-radius:30px;padding:2.6rem;margin-bottom:2rem;box-shadow:0 45px 90px rgba(15,23,42,.25);}
    .wdg-servicos-hero h1{font-weight:700;font-size:2.4rem;margin-bottom:.5rem;}
    .wdg-servicos-hero p{max-width:820px;margin-bottom:0;color:rgba(255,255,255,.9);}    
    .wdg-panel{background:#fff;border-radius:26px;padding:1.8rem 2rem;margin-bottom:1.8rem;box-shadow:0 28px 80px rgba(15,23,42,.11);}
    .wdg-panel h2{font-size:1.2rem;font-weight:700;margin-bottom:1rem;color:#0f172a;}
    .wdg-mini-card{border:1px solid rgba(15,23,42,.08);border-radius:22px;padding:1rem 1.2rem;background:#f1f5f9;box-shadow:inset 0 1px 0 rgba(255,255,255,.9);}    
    .wdg-mini-card span{font-size:.78rem;text-transform:uppercase;color:#94a3b8;letter-spacing:.05em;}
    .wdg-mini-card strong{font-size:1.6rem;color:#0f172a;display:block;}
    .wdg-service-card{border:1px solid rgba(15,23,42,.08);border-radius:24px;padding:1.2rem;margin-bottom:1rem;background:#fff;box-shadow:0 10px 32px rgba(15,23,42,.08);}
    .wdg-service-card .badge{border-radius:999px;padding:.45rem .75rem;font-weight:600;}
    .wdg-service-card .btn{border-radius:14px;}
    .wdg-os-panel{background:#0f172a;border-radius:24px;padding:1.7rem;color:#fff;height:100%;}
    .wdg-os-panel .form-control,.wdg-os-panel .form-select{border-radius:16px;border:none;}
    .wdg-os-panel .btn{border-radius:16px;}
    .wdg-kanban{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.2rem;}
    .wdg-kanban-column{background:#f1f5f9;border-radius:24px;padding:1.2rem;border:1px solid rgba(15,23,42,.08);}
    .wdg-kanban-column h3{font-size:1rem;font-weight:700;margin-bottom:1rem;color:#0f172a;display:flex;align-items:center;gap:.4rem;}
    .wdg-kanban-column ul{list-style:none;padding-left:0;margin-bottom:0;}
    .wdg-kanban-column li{background:#fff;border-radius:18px;padding:1rem;margin-bottom:.8rem;box-shadow:0 8px 20px rgba(15,23,42,.08);border:1px solid rgba(15,23,42,.08);}
    .wdg-history-table table{border-radius:18px;overflow:hidden;}
    .wdg-history-table thead{background:#0f172a;color:#fff;}
    .wdg-history-table tbody tr td{vertical-align:middle;}
    .wdg-portal-card{border:1px dashed rgba(14,165,233,.5);border-radius:24px;padding:1.5rem;background:#ecfeff;}
    .wdg-portal-card .btn{border-radius:16px;}
    .wdg-finance-link{border-radius:24px;background:#111827;color:#fff;padding:1.4rem;}
    @media(max-width:768px){
      .wdg-servicos-hero{padding:1.8rem;}
      .wdg-panel{padding:1.2rem;}
    }
  </style>
</head>
<body class="wdg-layout wdg-servicos">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: 'Gestão de Condomínios',
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleia', children: [
              { label: 'Assembleias', path: '/assembleias' },
              { label: 'Nova assembleia', path: '/assembleias/nova' }
            ]},
            { label: 'Dirigência', path: '/administracao/dirigencia' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Serviços', path: '/servicos/servicos' },
            { label: 'Solicitações do Portal', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>

  <main class="container py-4" id="servicosApp" data-base-path="<%= _bp %>" data-user-role="<%= (user && user.role) ? user.role : '' %>" data-user-unit="<%= user && user.unidade_id ? (user.unidade_id._id || user.unidade_id || user.unidadeId || '') : '' %>" data-user-unit-name="<%= user && (user.unidade_nome || (user.unidade_id && user.unidade_id.nome)) ? (user.unidade_nome || user.unidade_id.nome) : '' %>" data-scope-all="<%= (user && (user.isMaster || user.role === 'master' || user.role === 'admin')) ? 'true' : 'false' %>">
    <section class="wdg-servicos-hero">
      <h1>Operação de serviços</h1>
      <p>Gerencie solicitações, gere ordens de serviço, acompanhe execução em tempo real e sincronize lançamentos financeiros automaticamente. Um fluxo completo para limpeza, manutenção, facilities e ações emergenciais.</p>
    </section>

    <section class="wdg-panel">
      <div class="row g-4 align-items-center">
        <div class="col-lg-9">
          <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-3">
              <label class="form-label text-uppercase small text-muted" for="filtroCondominio">Condomínio</label>
              <select class="form-select" id="filtroCondominio" <%= (user && !(user.isMaster || user.role === 'master' || user.role === 'admin')) ? 'disabled' : '' %>>
                <option value="">Carregando...</option>
              </select>
              <% if (user && !(user.isMaster || user.role === 'master' || user.role === 'admin')) { %>
                <small class="text-muted">Vinculado a <strong><%= user && (user.unidade_nome || (user.unidade_id && user.unidade_id.nome)) ? (user.unidade_nome || user.unidade_id.nome) : 'unidade padrão' %></strong></small>
              <% } %>
            </div>
            <div class="col-6 col-lg-3">
              <label class="form-label text-uppercase small text-muted" for="filtroStatus">Status</label>
              <select class="form-select" id="filtroStatus">
                <option value="todos">Todos</option>
                <option value="pendente">Pendentes</option>
                <option value="aceita">Aceitas</option>
                <option value="executando">Execução</option>
                <option value="finalizado">Finalizados</option>
              </select>
            </div>
            <div class="col-6 col-lg-3">
              <label class="form-label text-uppercase small text-muted" for="filtroOrigem">Origem</label>
              <select class="form-select" id="filtroOrigem">
                <option value="todas">Todas</option>
                <option value="portal">Portal do Morador</option>
                <option value="condominio">Gerado pelo condomínio</option>
              </select>
            </div>
            <div class="col-12 col-lg-3">
              <label class="form-label text-uppercase small text-muted" for="filtroBusca">Busca</label>
              <input type="search" id="filtroBusca" class="form-control" placeholder="Área, morador, serviço">
            </div>
          </div>
        </div>
        <div class="col-lg-3">
          <div class="d-flex gap-3">
            <button class="btn btn-dark flex-fill" data-action="nova-solicitacao"><i class="bi bi-plus-lg me-2"></i>Novo serviço interno</button>
            <button class="btn btn-outline-dark flex-fill" data-action="abrir-portal"><i class="bi bi-door-open me-2"></i>Portal do Morador</button>
          </div>
        </div>
      </div>
    </section>

    <section class="wdg-panel">
      <div class="row g-4">
        <div class="col-md-4">
          <article class="wdg-mini-card">
            <span>Fila ativa</span>
            <strong id="metricPendentes">0</strong>
            <small class="text-muted" id="metricPendentesTexto">Solicitações aguardando atendimento</small>
          </article>
        </div>
        <div class="col-md-4">
          <article class="wdg-mini-card">
            <span>Status SLA</span>
            <strong id="metricSla">0%</strong>
            <small class="text-muted">Dentro do prazo nos últimos 30 dias</small>
          </article>
        </div>
        <div class="col-md-4">
          <article class="wdg-mini-card">
            <span>Impacto financeiro</span>
            <strong id="metricFinanceiro">R$ 0,00</strong>
            <small class="text-muted">Integrado ao módulo financeiro</small>
          </article>
        </div>
      </div>
    </section>

    <section class="wdg-panel">
      <div class="row g-4">
        <div class="col-lg-7">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Solicitações em aberto</h2>
            <div class="btn-group">
              <button class="btn btn-outline-secondary btn-sm" data-action="exportar"><i class="bi bi-download me-1"></i>Exportar</button>
              <button class="btn btn-outline-secondary btn-sm" data-action="compartilhar"><i class="bi bi-link-45deg me-1"></i>Compartilhar link</button>
            </div>
          </div>
          <div id="listaSolicitacoes"></div>
        </div>
        <div class="col-lg-5">
          <div class="wdg-os-panel">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div>
                <span class="text-uppercase small text-white-50">Ordem de serviço</span>
                <h2 class="h4">Gerar & vincular funcionário</h2>
              </div>
              <span class="badge text-bg-success" id="osStatusLabel">Pronto</span>
            </div>
            <div class="mb-3">
              <label class="form-label small text-uppercase text-white-50">Solicitação</label>
              <select class="form-select" id="osSolicitacao"></select>
            </div>
            <div class="mb-3">
              <label class="form-label small text-uppercase text-white-50">Responsável</label>
              <select class="form-select" id="osResponsavel"></select>
            </div>
            <div class="mb-3">
              <label class="form-label small text-uppercase text-white-50">Previsão</label>
              <input type="date" class="form-control" id="osPrevisao">
            </div>
            <div class="mb-3">
              <label class="form-label small text-uppercase text-white-50">Observações / checklist</label>
              <textarea class="form-control" id="osObservacoes" rows="3" placeholder="Checklist, EPIs, validação com síndico..."></textarea>
            </div>
            <div class="d-flex flex-column gap-2">
              <button class="btn btn-primary" data-action="gerar-os"><i class="bi bi-clipboard-check me-2"></i>Gerar ordem e enviar push</button>
              <button class="btn btn-outline-light" data-action="abrir-financeiro"><i class="bi bi-cash-coin me-2"></i>Gerar lançamento financeiro</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="wdg-panel">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Execução em tempo real</h2>
        <small class="text-muted">Visão estilo kanban (inspiração: Jira Service, Trello Workspaces)</small>
      </div>
      <div class="wdg-kanban" id="kanbanBoard"></div>
    </section>

    <section class="wdg-panel wdg-history-table">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Histórico e auditoria</h2>
        <button class="btn btn-outline-primary btn-sm" data-action="baixar-historico"><i class="bi bi-archive me-2"></i>Baixar relatório mensal</button>
      </div>
      <div class="table-responsive">
        <table class="table mb-0" id="tabelaHistorico">
          <thead>
            <tr>
              <th>OS</th>
              <th>Serviço</th>
              <th>Executado por</th>
              <th>Origem</th>
              <th>Custo</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <section class="wdg-panel">
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="wdg-finance-link h-100 d-flex flex-column justify-content-between">
            <div>
              <p class="text-uppercase small text-white-50 mb-1">Integração financeira</p>
              <h2 class="h4 mb-3">Cada OS pode gerar lançamento automático no financeiro</h2>
              <p class="mb-4">Sincronize centros de custo, rateio entre unidades, anexos de orçamento e aprovação digital com um clique.</p>
            </div>
            <button class="btn btn-light align-self-start" data-action="abrir-financeiro"><i class="bi bi-arrow-up-right me-2"></i>Abrir Financeiro</button>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="wdg-portal-card h-100 d-flex flex-column">
            <div>
              <p class="text-uppercase small text-info mb-1">Portal do Morador</p>
              <h2 class="h4">Moradores acompanham tudo via app</h2>
              <p>Solicitações nascem no Portal, recebem notificações push, fotos e aprovação do síndico. Tudo sincronizado com este painel.</p>
            </div>
            <div class="mt-auto">
              <button class="btn btn-info text-white" data-action="abrir-portal"><i class="bi bi-phone me-2"></i>Ver experiência do morador</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _bp %>/js/condominios/servicos.js?v=2"></script>
</body>
</html>
