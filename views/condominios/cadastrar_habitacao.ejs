<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WDGestor - Cadastrar Habitação · Gestão de Condomínios</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/icon-buttons.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/pages/cadastrar_habitacao.css?v=1">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
</head>
<body class="wdg-layout page-cadastrar-habitacao" data-base-path="<%= _bp %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: (moduleLabel||'Gestão de Condomínios'),
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleia', children: [
              { label: 'Assembleias', path: '/assembleias' },
              { label: 'Nova assembleia', path: '/assembleias/nova' }
            ]},
            { label: 'Dirigência', path: '/administracao/dirigencia' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: (moduleLabel||'Gestão de Condomínios'), user }) %>

  <% 
    const _isScopeAll = Boolean(user && (user.isMaster || user.role === 'master' || user.role === 'admin'));
    const _userUnitId = (user && user.unidade_id) ? (user.unidade_id._id || user.unidade_id || user.unidadeId || '') : (user && user.unidadeId ? user.unidadeId : '');
    const _userUnitObj = (_userUnitId && Array.isArray(unidadesOptions)) ? (unidadesOptions||[]).find(u => String(u._id) === String(_userUnitId)) : null;
  %>

  <div class="container py-3">
    <div class="content mb-3 wdg-card wdg-card-hover">
      <h4 class="mb-3 text-center page-main-title">Estruturar Condomínio · Habitações</h4>

      <div class="wdg-panel-subbar wdg-condo-subbar" aria-label="Filtro de condomínio">
        <div class="wdg-condo-field">
          <div class="wdg-condo-label">Condomínio</div>
          <div class="wdg-condo-controlrow">
            <img id="unidadeTopLogo" data-condo-inline-logo="1" src="/images/unidade.png" alt="" aria-hidden="true" class="wdg-condo-inline-logo">
            <select class="form-select wdg-condo-select" id="unidadeTop" <%= !_isScopeAll ? 'disabled' : '' %> aria-label="Condomínio">
              <% if (_isScopeAll) { %>
                <option value="">Selecione...</option>
                <% (unidadesOptions||[]).forEach(u => { %>
                  <option value="<%= u._id %>"><%= u.codigo ? (u.codigo + ' - ' + u.nome) : u.nome %></option>
                <% }) %>
              <% } else { %>
                <% if (_userUnitObj) { %>
                  <option value="<%= _userUnitObj._id %>" selected><%= _userUnitObj.codigo ? (_userUnitObj.codigo + ' - ' + _userUnitObj.nome) : _userUnitObj.nome %></option>
                <% } else if (_userUnitId) { %>
                  <option value="<%= _userUnitId %>" selected><%= _userUnitId %></option>
                <% } else { %>
                  <option value="" selected>Condomínio não definido</option>
                <% } %>
              <% } %>
            </select>
          </div>
          <% if (!_isScopeAll) { %>
            <div class="text-muted small mt-1">Condomínio fixado pelo seu perfil.</div>
          <% } %>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-lg-6">
          <div class="wdg-card wdg-card-hover p-0 overflow-hidden">
            <div class="box-toggle-header d-flex align-items-center justify-content-center position-relative mb-0">
              <button type="button" class="toggle-collapse collapsed position-absolute start-0 top-50 translate-middle-y ms-2" data-bs-toggle="collapse" data-bs-target="#formBlocoBody" aria-controls="formBlocoBody" aria-expanded="false" aria-label="Recolher / Expandir" title="Recolher / Expandir">
                <img src="/images/zoommais.png" alt="" aria-hidden="true">
              </button>
              <h6 class="mb-0 w-100 text-center px-5">Cadastrar Bloco/Torre</h6>
            </div>

            <div id="formBlocoBody" class="collapse">
              <div class="p-3">
                <form id="formBloco" novalidate>
                  <div class="mb-3">
                    <label class="form-label">Nome do Bloco/Torre</label>
                    <input type="text" class="form-control" id="bNome" required>
                  </div>
                  <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" id="bLimpar">Limpar</button>
                    <button type="button" class="btn btn-outline-danger d-none" id="bCancelar" title="Cancelar edição">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="bSalvar">Cadastrar</button>
                  </div>
                </form>

                <div class="ch-table-wrap mt-3" id="blocoTableWrap" aria-label="Blocos cadastrados">
                  <div class="table-responsive table-vert-max ch-table-scroll">
                    <table class="table table-hover table-sm align-middle text-center mb-0">
                      <thead><tr><th>Condomínio</th><th>Nome</th><th>Ações</th></tr></thead>
                      <tbody id="bLista"></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="wdg-card wdg-card-hover p-0 overflow-hidden">
            <div class="box-toggle-header d-flex align-items-center justify-content-center position-relative mb-0">
              <button type="button" class="toggle-collapse collapsed position-absolute start-0 top-50 translate-middle-y ms-2" data-bs-toggle="collapse" data-bs-target="#formAndarBody" aria-controls="formAndarBody" aria-expanded="false" aria-label="Recolher / Expandir" title="Recolher / Expandir">
                <img src="/images/zoommais.png" alt="" aria-hidden="true">
              </button>
              <h6 class="mb-0 w-100 text-center px-5">Cadastrar Andar</h6>
            </div>

            <div id="formAndarBody" class="collapse">
              <div class="p-3">
                <form id="formAndar" novalidate>
                  <div class="mb-3">
                    <label class="form-label">Nome do Andar</label>
                    <input type="text" class="form-control" id="aNome" required>
                  </div>
                  <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" id="aLimpar">Limpar</button>
                    <button type="button" class="btn btn-outline-danger d-none" id="aCancelar" title="Cancelar edição">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="aSalvar">Cadastrar</button>
                  </div>
                </form>

                <div class="ch-table-wrap mt-3" id="andarTableWrap" aria-label="Andares cadastrados">
                  <div class="table-responsive table-vert-max ch-table-scroll">
                    <table class="table table-hover table-sm align-middle text-center mb-0">
                      <thead><tr><th>Condomínio</th><th>Nome</th><th>Ações</th></tr></thead>
                      <tbody id="aLista"></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="content mb-3 wdg-card wdg-card-hover">
      <h5 class="mb-1 text-center wdg-section-title">Cadastrar Habitação</h5>
      <form id="formHab" class="row g-2" novalidate>
        <!-- Linha 1 -->
        <div class="col-md-4">
          <label class="form-label">Tipo de habitação</label>
          <select class="form-select" id="hTipo">
            <option value="">Selecione...</option>
            <option>Casa</option><option>Apartamento</option><option>Sobrado</option><option>Kitnet</option><option>Cobertura</option><option>Loja</option><option>Sala comercial</option><option>Galpão</option><option>Box</option><option>Vaga de garagem</option><option>Sítio</option><option>Chácara</option><option>Fazenda</option><option>Flat</option><option>Studio</option><option>Quitinete</option><option>Duplex</option><option>Triplex</option><option>Bangalô</option><option>Casa térrea</option><option>Casa geminada</option><option>Pousada</option><option>Hotel</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Bloco/Torre</label>
          <select class="form-select" id="hBloco"></select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Andar</label>
          <select class="form-select" id="hAndar"></select>
        </div>
        <div class="w-100"></div>
        <!-- Linha 3 -->
        <div class="col-md-4">
          <label class="form-label">Número/Identif.</label>
          <input type="text" class="form-control" id="hNumero" required>
        </div>
        <div class="w-100"></div>
        <!-- Linha 4 -->
        <div class="col-md-2">
          <label class="form-label">Área construída (m²)</label>
          <input type="number" class="form-control" id="hArea" min="0" step="0.01">
        </div>
        <div class="col-md-4">
          <label class="form-label">Fração ideal de contrib. cond. (%)</label>
          <input type="text" class="form-control" id="hFracao" inputmode="decimal" pattern="[0-9,.%]*">
        </div>
        <div class="col-md-4">
          <label class="form-label">Definir dia de vencim. contr. cond.</label>
          <select class="form-select" id="hVencimento">
            <option value="">Selecione...</option>
            <% for (let dia = 1; dia <= 31; dia++) { const label = String(dia).padStart(2, '0'); %>
              <option value="<%= dia %>"><%= label %></option>
            <% } %>
          </select>
        </div>
        <div class="w-100"></div>
        <!-- Linha 5 -->
        <div class="col-md-8 mx-auto">
          <label class="form-label">Foto</label>
          <input type="file" class="form-control" id="hFoto" accept="image/*">
          <div class="d-flex gap-2 justify-content-end mt-2">
            <button type="button" class="btn btn-outline-secondary" id="hFotoLimpar">Limpar</button>
            <button type="button" class="btn btn-outline-danger d-none" id="hFotoRemover" title="Remover a foto salva">Remover foto</button>
          </div>
          <div class="mt-2 text-center"><img id="hFotoPrev" class="preview-thumb d-none" alt="Pré-visualização"></div>
        </div>
        <div class="w-100"></div>
        <!-- Linha 6 -->
        <div class="col-12">
          <label class="form-label">Descrição/observação</label>
          <textarea id="hDesc" class="form-control" rows="4" maxlength="4000" placeholder="Até 4000 caracteres..."></textarea>
          <div class="char-count"><span id="hDescCount">0</span>/4000</div>
        </div>
        <div class="col-12 d-flex gap-2 justify-content-end">
          <button type="button" class="btn btn-outline-secondary" id="hLimpar">Limpar</button>
          <button type="button" class="btn btn-outline-danger d-none" id="hCancelar" title="Cancelar edição">Cancelar</button>
          <button type="button" class="btn btn-primary" id="hSalvar">Cadastrar</button>
        </div>
      </form>
    </div>

    <div class="content wdg-card wdg-card-hover">
      <h5 class="mb-1 text-center wdg-section-title">Habitações cadastradas</h5>
      <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
          <label for="hPageSize" class="form-label mb-0">Mostra</label>
          <select id="hPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
            <option value="1000">1000</option>
          </select>
          <span class="ms-1">itens</span>
        </div>
      </div>
      <div class="ch-table-wrap" id="habTableWrap" aria-label="Habitações cadastradas">
        <div class="table-responsive table-vert-max ch-table-scroll">
          <table class="table table-hover table-sm align-middle text-center mb-0 ch-table" id="habTable">
            <thead>
              <tr>
                <th data-sort="unidade">Condomínio</th>
                <th data-sort="tipo">Tipo de Hab.</th>
                <th data-sort="bloco">Bloco/Torre</th>
                <th data-sort="andar">Andar</th>
                <th data-sort="numero">Número/Ident.</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody id="hLista"></tbody>
          </table>
        </div>
        <div id="hPaginas" class="wdg-pager ch-table-pager" aria-label="Paginação da tabela"></div>
      </div>
    </div>
  </div>

  <%- include('modal_detalhes_hab_cad') %>

  <!-- Modal: confirmação de exclusão (Habitação) -->
  <div class="modal fade" id="habDeleteConfirmModal" tabindex="-1" aria-labelledby="habDeleteConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title d-flex align-items-center gap-2" id="habDeleteConfirmTitle">
            <i class="bi bi-trash3 text-danger" aria-hidden="true"></i>
            Confirmar exclusão
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="d-flex gap-3">
            <div class="text-danger" style="font-size:2rem; line-height:1">
              <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            </div>
            <div>
              <div class="mb-1">Tem certeza que deseja excluir essa habitação?</div>
              <div class="mb-1">
                <span class="text-muted">Habitação:</span>
                <strong><span id="habDeleteConfirmName">—</span></strong>
              </div>
              <div class="text-muted small">Esta exclusão é definitiva e não pode ser desfeita.</div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="habDeleteConfirmYes">Excluir definitivamente</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalFotoHab" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Foto da Habitação</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="d-flex justify-content-center mb-3 gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom="out">-</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom="reset">100%</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom="in">+</button>
          </div>
          <div class="zoom-img-container">
            <img id="fotoHabZoom" alt="Foto habitação">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script id="unidadesOptionsData" type="application/json"><%- JSON.stringify(unidadesOptions||[]) %></script>
  <script src="<%= _bp %>/js/condominios/cadastrar_habitacao.js?v=1"></script>
  <script src="<%= _bp %>/js/condominios/modal_foto_hab.js?v=1"></script>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_hab_cad.js?v=1"></script>
  <script>
    (function(){
      var toggles = document.querySelectorAll('.toggle-collapse[data-bs-target]');
      toggles.forEach(function(btn){
        var targetSel = btn.getAttribute('data-bs-target');
        if(!targetSel) return;
        var body = document.querySelector(targetSel);
        if(!body) return;
        var img = btn.querySelector('img');
        var iconPlus = '/images/zoommais.png';
        var iconMinus = '/images/zoommenos.png';
        function sync(){
          var expanded = body.classList.contains('show');
          btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          if(img) img.src = expanded ? iconMinus : iconPlus;
        }
        body.addEventListener('shown.bs.collapse', sync);
        body.addEventListener('hidden.bs.collapse', sync);
        sync();
      });
    })();
  </script>
</body>
</html>
