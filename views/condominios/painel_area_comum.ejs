<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel de Áreas Comuns - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    .wdg-area-hero{background:linear-gradient(135deg,#0f172a,#2563eb);color:#fff;border-radius:28px;padding:2rem 2.5rem;margin-bottom:1.8rem;box-shadow:0 30px 70px rgba(15,23,42,.35);}
    .wdg-area-hero h1{font-size:1.8rem;font-weight:700;margin-bottom:.35rem;}
    .wdg-area-hero p{margin:0;color:rgba(255,255,255,.85);max-width:720px;}
    .wdg-area-panel{background:#fff;border-radius:26px;padding:1.8rem 2rem;box-shadow:0 30px 90px rgba(15,23,42,.12);margin-bottom:2rem;}
    .wdg-area-panel h2{font-weight:700;font-size:1.3rem;margin-bottom:.25rem;color:#0f172a;}
    .wdg-area-panel p{margin:0;color:#475569;}
    .wdg-area-filters .form-label{text-transform:uppercase;font-size:.68rem;letter-spacing:.18em;font-weight:600;color:#475569;}
    .wdg-area-filters .form-select,.wdg-area-filters .form-control{border-radius:14px;padding:.65rem .85rem;border:1px solid rgba(15,23,42,.12);}
    .wdg-area-filter-actions{display:flex;justify-content:flex-end;gap:.75rem;flex-wrap:wrap;margin-top:.5rem;}
    .wdg-area-chip-group{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:1rem;}
    .wdg-area-chip{border-radius:999px;border:1px solid rgba(15,23,42,.12);padding:.3rem .85rem;font-size:.78rem;font-weight:600;color:#0f172a;background:#f8fafc;cursor:pointer;transition:all .15s ease;}
    .wdg-area-chip:is(:hover,.is-active){background:#2563eb;color:#fff;border-color:#2563eb;}
    .wdg-area-stage{width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:0 4vw;}
    .wdg-area-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(720px,720px));justify-content:center;gap:2rem;}
    .wdg-area-card{position:relative;border-radius:26px;border:1px solid rgba(15,23,42,.08);padding:1.5rem;box-shadow:0 20px 60px rgba(15,23,42,.12);display:flex;flex-direction:column;gap:1rem;background:#fff;overflow:hidden;min-height:280px;transition:transform .25s ease,box-shadow .25s ease;}
    .wdg-area-card::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(14,165,233,.18),rgba(59,130,246,.12));opacity:0;transition:opacity .25s ease;}
    .wdg-area-card:hover{transform:translateY(-6px);box-shadow:0 35px 90px rgba(15,23,42,.25);}
    .wdg-area-card:hover::before{opacity:1;}
    .wdg-area-card > *{position:relative;z-index:1;}
    .wdg-area-card.wdg-area-skeleton{min-height:240px;background:#f8fafc;border-style:dashed;}
    .wdg-area-card[data-status="reservado"]{border-color:rgba(234,179,8,.45);}
    .wdg-area-card[data-status="disponivel"]{border-color:rgba(34,197,94,.45);}
    .wdg-area-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;}
    .wdg-area-card-topline{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;}
    .wdg-area-card-title{margin:0;font-size:1.2rem;font-weight:700;color:#0f172a;}
    .wdg-area-card-meta{font-size:.86rem;color:#475569;}
    .wdg-area-card-status{border-radius:999px;padding:.35rem .95rem;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.16em;box-shadow:0 5px 18px rgba(15,23,42,.15);background:rgba(15,23,42,.85);color:#fff;}
    .wdg-area-card-status.status-disponivel{background:rgba(34,197,94,.85);}
    .wdg-area-card-status.status-reservado{background:rgba(234,179,8,.95);color:#4c2600;}
    .wdg-area-tag-row{display:flex;flex-wrap:wrap;gap:.4rem;}
    .wdg-area-tag{border-radius:999px;background:rgba(15,23,42,.05);padding:.25rem .75rem;font-size:.75rem;font-weight:600;color:#0f172a;border:1px solid rgba(15,23,42,.08);}
    .wdg-area-meta-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem;margin-top:.6rem;}
    .wdg-area-meta-item{padding:.85rem;border-radius:16px;border:1px solid rgba(15,23,42,.08);background:rgba(248,250,252,.85);min-height:96px;}
    .wdg-area-meta-item span{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:#94a3b8;margin-bottom:.3rem;}
    .wdg-area-meta-item strong{display:block;font-size:.96rem;color:#0f172a;font-weight:700;}
    .wdg-area-schedule{display:flex;flex-direction:column;gap:1rem;margin-top:.8rem;}
    .wdg-area-schedule-card{border-radius:18px;border:1px solid rgba(15,23,42,.08);background:#fff;padding:1rem;box-shadow:0 12px 30px rgba(15,23,42,.08);display:flex;flex-direction:column;gap:.75rem;min-height:140px;}
    .wdg-area-schedule-card h4{margin:0;font-size:.82rem;text-transform:uppercase;letter-spacing:.14em;color:#94a3b8;}
    .wdg-area-schedule-content{flex:1;min-height:80px;}
    .wdg-area-schedule-card.has-scroll .wdg-area-schedule-content{max-height:220px;overflow-y:auto;padding-right:.4rem;}
    .wdg-area-schedule-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.6rem;}
    .wdg-area-schedule-list li{display:flex;flex-direction:column;gap:.15rem;padding-bottom:.4rem;border-bottom:1px dashed rgba(15,23,42,.08);}
    .wdg-area-schedule-list li:last-child{border-bottom:none;padding-bottom:0;}
    .wdg-area-schedule-list strong{font-size:.95rem;color:#0f172a;font-weight:700;}
    .wdg-area-schedule-list span{font-size:.85rem;color:#475569;font-weight:600;}
    .wdg-area-schedule-list small{font-size:.72rem;font-weight:700;align-self:flex-start;border-radius:999px;padding:.15rem .55rem;}
    .wdg-area-schedule-list small.is-live{background:rgba(22,163,74,.15);color:#166534;border:1px solid rgba(22,163,74,.35);}
    .wdg-area-schedule-list small.is-future{background:rgba(59,130,246,.12);color:#1d4ed8;border:1px solid rgba(59,130,246,.35);}
    .wdg-area-schedule-list small.is-muted{background:rgba(148,163,184,.18);color:#475569;border:1px solid rgba(148,163,184,.4);}
    .wdg-area-schedule-empty{margin:0;color:#94a3b8;font-weight:600;font-size:.85rem;}
    .wdg-area-schedule-note p{margin:0 0 .45rem;font-size:.92rem;color:#0f172a;font-weight:600;}
    .wdg-area-schedule-note p:last-child{margin-bottom:0;}
    .wdg-area-timeline{list-style:none;margin:1.1rem 0 0;padding:0;display:flex;flex-wrap:wrap;gap:1rem;}
    .wdg-area-timeline li{flex:1 1 190px;border-radius:16px;padding:.85rem 1rem;background:rgba(15,23,42,.03);border:1px dashed rgba(15,23,42,.12);}
    .wdg-area-timeline small{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:#94a3b8;margin-bottom:.25rem;}
    .wdg-area-timeline span{font-weight:600;color:#0f172a;}
    .wdg-area-card-actions{margin-top:auto;}
    .wdg-area-card-action-icons{display:flex;flex-wrap:wrap;gap:.4rem;justify-content:center;padding-top:.25rem;border-top:1px dashed rgba(15,23,42,.12);}
    .wdg-area-card-action-icons .wdg-icon-btn{background:#fff;border:1px solid rgba(15,23,42,.12);border-radius:12px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 25px rgba(15,23,42,.08);transition:transform .15s ease,box-shadow .15s ease;}
    .wdg-area-card-action-icons .wdg-icon-btn:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(15,23,42,.15);}
    .wdg-area-card-action-icons .wdg-icon-btn img{width:26px;height:26px;}
    .wdg-icon-btn{background:transparent;border:none;padding:0;cursor:pointer;line-height:1;}
    .wdg-icon-btn:focus-visible{outline:2px solid rgba(37,99,235,.5);outline-offset:3px;}
    .wdg-area-empty{display:none;border:1px dashed rgba(15,23,42,.25);border-radius:18px;padding:1.6rem;text-align:center;color:#64748b;font-weight:600;}
    .wdg-area-empty.is-visible{display:block;}
    .wdg-area-skeleton{animation:pulse 1.6s ease-in-out infinite;background:linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 37%,#f1f5f9 63%);background-size:400% 100%;}
    .wdg-area-toast{position:fixed;bottom:20px;right:24px;background:#0f172a;color:#fff;padding:.85rem 1.2rem;border-radius:16px;box-shadow:0 20px 50px rgba(15,23,42,.35);opacity:0;transform:translateY(20px);transition:all .3s ease;pointer-events:none;z-index:1090;font-weight:600;}
    .wdg-area-toast.is-visible{opacity:1;transform:translateY(0);}
    @keyframes pulse{0%{background-position:0% 0;}100%{background-position:-135% 0;}}
    @media (max-width:1500px){
      .wdg-area-grid{grid-template-columns:repeat(auto-fit,minmax(520px,1fr));}
    }
    @media (max-width:1100px){
      .wdg-area-grid{grid-template-columns:repeat(auto-fit,minmax(420px,1fr));}
    }
    @media (max-width:820px){
      .wdg-area-grid{grid-template-columns:repeat(auto-fit,minmax(320px,1fr));}
    }
    @media (max-width:520px){
      .wdg-area-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;}
    }
    @media (max-width:768px){.wdg-area-hero{padding:1.5rem;} .wdg-area-panel{padding:1.25rem;} }
  </style>
</head>
<body class="wdg-layout wdg-area-body" data-base-path="<%= _bp %>" data-user-role="<%= (user && user.role) ? user.role : '' %>" data-user-unit="<%= user && user.unidade_id ? (user.unidade_id._id || user.unidade_id || user.unidadeId || '') : '' %>" data-user-name="<%= user && user.nome ? user.nome : '' %>" data-scope-all="<%= (user && (user.isMaster || user.role === 'master' || user.role === 'admin')) ? 'true' : 'false' %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: 'Gestão de Condomínios',
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleia', children: [
              { label: 'Assembleias', path: '/assembleias' },
              { label: 'Nova assembleia', path: '/assembleias/nova' }
            ]},
            { label: 'Dirigência', path: '/administracao/dirigencia' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>

  <main class="container py-4">
    <section class="wdg-area-hero">
      <h1>Painel de Áreas Comuns</h1>
      <p>Acompanhe reservas, disponibilidade e regras de uso das áreas compartilhadas em cada condomínio, com visão rápida para intervenções operacionais.</p>
    </section>

    <section class="wdg-area-panel">
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <h2>Pesquisar área comum</h2>
        </div>
        <div class="text-end">
          <div class="text-muted" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.18em;">Áreas</div>
          <div class="display-6" style="font-size:2rem;font-weight:700;color:#0f172a;" id="areaPanelCount">0</div>
        </div>
      </div>

      <form id="areaPanelFilters" class="wdg-area-filters">
        <div class="row g-3">
          <div class="col-lg-4 col-md-6">
            <label class="form-label" for="areaFilterUnidade">Condomínio</label>
            <select class="form-select" id="areaFilterUnidade" <%= (user && !(user.isMaster || user.role === 'master' || user.role === 'admin')) ? 'disabled' : '' %>>
              <option value="">Carregando...</option>
            </select>
            <% if (user && !(user.isMaster || user.role === 'master' || user.role === 'admin')) { %>
              <small class="text-muted">Vinculado a <strong><%= user && user.unidade_nome ? user.unidade_nome : 'unidade padrão' %></strong></small>
            <% } %>
          </div>
          <div class="col-lg-4 col-md-6">
            <label class="form-label" for="areaFilterTipo">Tipo de área</label>
            <select class="form-select" id="areaFilterTipo" disabled>
              <option value="">Selecione um condomínio</option>
            </select>
          </div>
          <div class="col-lg-4 col-md-12">
            <label class="form-label" for="areaFilterSearch">Pesquisar por nome / descrição</label>
            <input type="search" class="form-control" id="areaFilterSearch" placeholder="Ex.: Salão Gourmet" autocomplete="off">
          </div>
        </div>
        <div class="wdg-area-filter-actions">
          <button type="button" class="btn btn-outline-secondary" data-action="reset">Limpar filtros</button>
          <button type="button" class="btn btn-primary" data-action="refresh">Atualizar dados</button>
        </div>
      </form>

      <div class="wdg-area-chip-group" id="areaQuickFilters" aria-label="Atalhos de filtro"></div>
    </section>

    <section class="wdg-area-stage">
      <div class="wdg-area-grid" id="areaPanelGrid" aria-live="polite"></div>
      <div class="wdg-area-empty" id="areaPanelEmpty">Nenhuma área comum encontrada para os filtros aplicados.</div>
    </section>
    <div id="areaPanelToast" class="wdg-area-toast" role="status" aria-live="polite"></div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _bp %>/js/condominios/painel_area_comum.js?v=1"></script>
  <%- include('./modal_edit_ac_ceder_para_uso') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_ceder_para_uso.js?v=2"></script>
  <%- include('./modal_edit_ac_disponibilidade') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_disponibilidade.js?v=1"></script>
  <%- include('./modal_edit_ac_restricoes') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_restricoes.js?v=1"></script>
  <%- include('./modal_edit_ac_regras_de_uso') %>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_regras_de_uso.js?v=1"></script>
  <%- include('./modal_edit_ac_material') %>
  <%- include('./modal_transferir_material') %>
  <script src="<%= _bp %>/js/condominios/modal_transferir_material.js?v=1"></script>
  <script src="<%= _bp %>/js/condominios/modal_edit_ac_material.js?v=1"></script>
  <%- include('./modal_detalhes_materiais_cad') %>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_materiais_cad.js?v=1"></script>
  <%- include('./modal_detalhes_areaconst_cad') %>
  <script src="<%= _bp %>/js/condominios/modal_detalhes_areaconst_cad.js?v=1"></script>
</body>
</html>