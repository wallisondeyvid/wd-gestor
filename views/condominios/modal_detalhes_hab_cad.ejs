      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="border rounded p-3 h-100">
              <h6 class="text-primary mb-3">Informações</h6>
              <dl class="row mb-0">
                <dt class="col-sm-5">Condomínio</dt>
                <dd class="col-sm-7" id="detUnidade">-</dd>
                <dt class="col-sm-5">Tipo</dt>
                <dd class="col-sm-7" id="detTipo">-</dd>
                <dt class="col-sm-5">Bloco/Torre</dt>
                <dd class="col-sm-7" id="detBloco">-</dd>
                <dt class="col-sm-5">Andar</dt>
                <dd class="col-sm-7" id="detAndar">-</dd>
                <dt class="col-sm-5">Número/Ident.</dt>
                <dd class="col-sm-7" id="detNumero">-</dd>
                <dt class="col-sm-5">Área construída</dt>
                <dd class="col-sm-7" id="detArea">-</dd>
                <dt class="col-sm-5">Fração ideal</dt>
                <dd class="col-sm-7" id="detFracao">-</dd>
