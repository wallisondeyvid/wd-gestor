<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dirigência - Gestão de Condomínios - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>

  <style>
    :root{
      --wdg-bg: #f4f6fb;
      --wdg-card: #ffffff;
      --wdg-text: #0f172a;
      --wdg-muted: #64748b;
      --wdg-line: rgba(15,23,42,.10);
      --wdg-shadow: 0 30px 90px rgba(15,23,42,.14);
      --wdg-shadow-soft: 0 18px 55px rgba(15,23,42,.10);
      --wdg-primary: #1d4ed8;
      --wdg-primary-2: #38bdf8;
      --wdg-accent: #0f172a;
      --wdg-pill: rgba(29,78,216,.12);
      --wdg-maxw: 1600px;
    }

    body.wdg-dirigencia{ background: var(--wdg-bg); }

    /* Início: evita rolagem por padding extra do container-fluid */
    #dirigenciaApp.wdg-view-inicio{ padding-bottom: .5rem !important; }

    .wdg-drg-wrap{
      max-width: 100%;
      margin: 0;
    }

    .wdg-drg-hero{
      background: linear-gradient(135deg, var(--wdg-primary), var(--wdg-primary-2));
      color:#fff;
      border-radius: 28px;
      padding: 2rem 2.4rem;
      box-shadow: 0 28px 70px rgba(15,23,42,.28);
      position: relative;
      overflow: hidden;
    }
    .wdg-drg-hero::after{
      content:'';
      position:absolute;
      inset:-120px -140px auto auto;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      background: rgba(255,255,255,.14);
      filter: blur(1px);
      transform: rotate(12deg);
    }
    .wdg-drg-hero h1{ font-weight: 800; font-size: 1.9rem; margin:0 0 .35rem; letter-spacing: -.02em; }
    .wdg-drg-hero p{ margin:0; max-width: 980px; color: rgba(255,255,255,.92); }
    .wdg-drg-kpis{ display:flex; gap:.7rem; flex-wrap:wrap; margin-top: 1.2rem; }
    .wdg-kpi{
      display:flex; align-items:center; gap:.55rem;
      padding:.5rem .8rem;
      border-radius: 999px;
      background: rgba(255,255,255,.16);
      border: 1px solid rgba(255,255,255,.18);
      backdrop-filter: blur(6px);
      font-weight: 700;
      font-size: .85rem;
    }

    .wdg-drg-shell{ display:grid; grid-template-columns: 320px 1fr; gap: 1.1rem; margin-top: 1.1rem; }
    @media (max-width: 992px){
      .wdg-drg-shell{ grid-template-columns: 1fr; }
    }

    .wdg-drg-sidenav{
      /* Mesma identidade do menu vertical da Caixa de Mensagens (portal-morador/home.css) */
      background:
        radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.06), transparent 42%),
        linear-gradient(180deg, #0b1f44, #0e2d5f 45%, #0f3c80 100%);
      color: #f8fbff;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 22px;
      box-shadow:
        0 18px 36px rgba(5, 10, 26, 0.32),
        0 0 0 1px rgba(255, 255, 255, 0.06) inset;
      padding: .75rem;
      position: sticky;
      top: 90px;
      align-self: start;
      overflow: hidden;
    }
    .wdg-drg-sidenav .title{
      margin: .15rem 0 .65rem;
      font-weight: 900;
      color: #f8fbff;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: .6px;
      font-size: .95rem;
      line-height: 1.15;
      text-shadow:
        0 2px 6px rgba(0, 0, 0, 0.28),
        0 1px 0 rgba(255, 255, 255, 0.35),
        0 -1px 0 rgba(12, 34, 74, 0.35);
    }

    .wdg-navbtn{
      width: 100%;
      border-radius: 14px;
      text-align: left;
      padding: .48rem .85rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background:
        radial-gradient(circle at 16% 24%, rgba(255, 255, 255, 0.08), transparent 55%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
      color: rgba(248, 251, 255, 0.90);
      box-shadow:
        0 14px 26px rgba(1, 10, 28, 0.18),
        0 1px 0 rgba(255, 255, 255, 0.05) inset;
      display:flex;
      align-items:center;
      justify-content: space-between;
      gap: .75rem;
      transition: background .18s ease, color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }
    .wdg-navbtn:focus-visible{
      outline: 2px solid rgba(142, 197, 255, 0.55);
      outline-offset: 2px;
    }
    .wdg-navbtn:hover,
    .wdg-navbtn.active{
      background:
        radial-gradient(circle at 18% 40%, rgba(142, 197, 255, 0.22), transparent 52%),
        linear-gradient(180deg, rgba(44, 123, 255, 0.16), rgba(255, 255, 255, 0.04));
      border-color: rgba(142, 197, 255, 0.22);
      color: #fff;
      box-shadow:
        0 18px 40px rgba(1, 10, 28, 0.26),
        0 0 0 1px rgba(44, 123, 255, 0.10) inset,
        0 0 26px rgba(44, 123, 255, 0.32);
      transform: translateY(-1px);
    }
    .wdg-navbtn .left{ display:flex; align-items:center; gap:.6rem; }
    .wdg-navbtn .left .wdg-navico{
      width: 40px;
      height: 40px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      box-shadow: none;
      flex: 0 0 40px;
    }

    .wdg-navbtn .left .wdg-navico img{
      width: 32px;
      height: 32px;
      object-fit: contain;
      display: block;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.32));
      opacity: .98;
    }

    .wdg-navbtn:hover .left .wdg-navico img,
    .wdg-navbtn.active .left .wdg-navico img{
      opacity: 1;
    }
    .wdg-navbtn .meta{ color: rgba(255,255,255,.82); font-weight: 700; font-size: .78rem; }
    .wdg-navbtn:not(.active) .meta{ color: rgba(255,255,255,.70); }

    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      .wdg-drg-sidenav{
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        backdrop-filter: blur(16px) saturate(160%);
      }
    }

    .wdg-drg-content{
      background: var(--wdg-card);
      border: 1px solid var(--wdg-line);
      border-radius: 22px;
      box-shadow: var(--wdg-shadow);
      padding: 1.2rem 1.35rem;
      min-height: 540px;
    }

    /* Início (Staff): remove o quadro branco externo do conteúdo */
    .wdg-drg-content.wdg-drg-content--flat{
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 0;
      min-height: var(--wdg-inicio-fill-h, 0px);
    }

    .wdg-drg-content.wdg-drg-content--flat > [data-pane="inicio"]{
      padding: .25rem .25rem 0;
    }

    .wdg-panel-title{ display:flex; align-items:center; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; }
    .wdg-panel-title h2{ margin:0; font-size: 1.15rem; font-weight: 500; color: var(--wdg-text); }
    .wdg-panel-title .desc{ color: var(--wdg-muted); font-size: .92rem; margin:0; }

    /* Campo Condomínio (abaixo do título) */
    .wdg-panel-subbar{
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      gap: .9rem;
      margin: -.35rem 0 1rem;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
    }
    .wdg-condo-field{ display:flex; flex-direction: column; gap: .45rem; min-width: 420px; max-width: 760px; width: 100%; }
    .wdg-condo-controlrow{ display:flex; align-items:center; gap: .7rem; width: 100%; }
    .wdg-condo-inline-logo{
      width: 46px;
      height: 46px;
      border-radius: 999px;
      object-fit: cover;
      border: 1px solid rgba(15,23,42,.12);
      background: rgba(15,23,42,.04);
      box-shadow: 0 10px 22px rgba(15,23,42,.08);
      flex: 0 0 46px;
    }
    .wdg-condo-label{
      font-weight: 800;
      font-size: .78rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: rgba(15,23,42,.65);
    }
    .wdg-condo-select.form-select{
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.12);
      box-shadow: 0 10px 22px rgba(15,23,42,.06);
      transition: box-shadow .16s ease, border-color .16s ease, transform .16s ease;
      padding-left: 1rem;
      padding-right: 2.2rem;
      min-height: 62px;
      font-size: 1.05rem;
      font-weight: 750;
      flex: 1 1 auto;
      min-width: 0;
    }
    .wdg-condo-select.form-select:focus{
      border-color: rgba(29,78,216,.35);
      box-shadow:
        0 0 0 .25rem rgba(29,78,216,.12),
        0 18px 38px rgba(15,23,42,.10);
      transform: translateY(-1px);
    }
    .wdg-condo-select.form-select:disabled{
      background: rgba(2,6,23,.03);
      opacity: 1;
      color: rgba(15,23,42,.72);
    }

    .wdg-condo-userpickhost{ display: none; }
    .wdg-condo-userpickhost.wdg-on{ display: block; }
    .wdg-condo-userpickhost .wdg-userpick{ width: 100%; max-width: 100%; }
    .wdg-condo-userpickhost.wdg-on ~ .wdg-condo-controlrow{ display:none; }
    .wdg-condo-userpickhost .wdg-userpick.wdg-userpick-pro.wdg-userpick-pro-lg .wdg-userpick-input.form-control{
      min-height: 66px;
      padding-left: 84px;
      padding-right: 66px;
      font-size: 1.05rem;
      font-weight: 850;
    }
    .wdg-condo-userpickhost .wdg-userpick.wdg-userpick-pro.wdg-userpick-pro-lg .wdg-userpick-selected{ inset: 10px 52px 10px 12px; }
    .wdg-condo-userpickhost .wdg-userpick.wdg-userpick-pro.wdg-userpick-pro-lg .wdg-userpick-sel-avatar{ width: 46px; height: 46px; }

    @media (max-width: 700px){
      .wdg-condo-field{ min-width: 0; max-width: 100%; }
    }

    .wdg-card{
      background: #fff;
      border: 1px solid rgba(15,23,42,.08);
      border-radius: 18px;
      padding: 1rem;
      box-shadow: 0 16px 40px rgba(15,23,42,.06);
    }

    .wdg-badge{
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      padding:.35rem .65rem;
      border-radius: 999px;
      background: var(--wdg-pill);
      color: #1d4ed8;
      font-weight: 800;
      font-size: .8rem;
    }

    .wdg-grid{ display:grid; grid-template-columns: 1.2fr .8fr; gap: 1rem; }
    .wdg-grid--inicio{ grid-template-columns: 1fr; }

    /* Dirigentes · Atribuições: matriz de 4 colunas com slots compactos */
    .wdg-assignments-grid{
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.2rem;
      width: 100%;
    }
    .wdg-assignment-slot{
      min-height: 180px;
      width: 100%;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;

      /* Premium card */
      position: relative;
      overflow: hidden;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      border: 1px solid rgba(15,23,42,.10);
      box-shadow:
        0 22px 55px rgba(15,23,42,.10),
        0 1px 0 rgba(255,255,255,.8) inset;

      transform-style: preserve-3d;
      will-change: transform, box-shadow, border-color;
      transition:
        transform .18s cubic-bezier(.2,.8,.2,1),
        box-shadow .18s cubic-bezier(.2,.8,.2,1),
        border-color .18s cubic-bezier(.2,.8,.2,1),
        background .18s ease;
    }

    /* brilho discreto (neutro) */
    .wdg-assignment-slot::after{
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg,
        rgba(255,255,255,0) 0%,
        rgba(255,255,255,.55) 45%,
        rgba(255,255,255,0) 70%
      );
      transform: translateX(-35%) rotate(14deg);
      mix-blend-mode: overlay;
      opacity: .0;
      pointer-events: none;
      transition: opacity .18s ease, transform .35s cubic-bezier(.2,.8,.2,1);
    }

    .wdg-assignment-slot:hover{
      border-color: rgba(29,78,216,.22);
      box-shadow:
        0 30px 80px rgba(15,23,42,.14),
        0 18px 44px rgba(29,78,216,.10),
        0 1px 0 rgba(255,255,255,.85) inset;
      transform: translateY(-3px) perspective(900px) rotateX(1.2deg) rotateY(-1.2deg);
    }
    .wdg-assignment-slot:hover::after{ opacity: .45; transform: translateX(0%) rotate(14deg); }

    .wdg-assignment-slot:focus-within{
      border-color: rgba(29,78,216,.35);
      box-shadow:
        0 0 0 4px rgba(29,78,216,.14),
        0 30px 80px rgba(15,23,42,.12);
    }

    /* Quando o dropdown está aberto, não deixa o card “saltar” por hover/transform */
    .wdg-assignment-slot.wdg-assignment-slot--picking,
    .wdg-assignment-slot.wdg-assignment-slot--picking:hover{
      transform: none !important;
    }

    /* tipografia mais “premium” dentro do slot */
    .wdg-assignment-slot p{ letter-spacing: -.01em; }
    .wdg-assignment-slot small{ color: #64748b !important; }

    /* Estrutura premium do slot (head + pills + usuário + ações) */
    .wdg-assignment-slot{
      border-radius: 20px;
      padding: 14px 14px 12px;
    }

    .wdg-slot-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap: 12px;
      padding-bottom: 10px;
      margin-bottom: 10px;
      border-bottom: 1px solid rgba(15,23,42,.08);
    }
    .wdg-slot-role{
      font-weight: 850;
      color: var(--wdg-text);
      letter-spacing: -.015em;
      font-size: .98rem;
      line-height: 1.15;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .wdg-slot-sub{
      font-size: .78rem;
      color: var(--wdg-muted);
      margin-top: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .wdg-slot-pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap: .35rem;
      padding: .34rem .62rem;
      border-radius: 999px;
      font-weight: 900;
      font-size: .72rem;
      letter-spacing: .55px;
      text-transform: uppercase;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(15,23,42,.06);
      color: #334155;
      box-shadow: 0 10px 24px rgba(15,23,42,.08);
      user-select: none;
      white-space: nowrap;
    }
    .wdg-slot-pill--active{ background: rgba(22,163,74,.12); border-color: rgba(22,163,74,.26); color: #166534; }
    .wdg-slot-pill--vacant{ background: rgba(245,158,11,.14); border-color: rgba(245,158,11,.28); color: #92400e; }
    .wdg-slot-pill--ended{ background: rgba(220,38,38,.12); border-color: rgba(220,38,38,.26); color: #991b1b; }
    .wdg-slot-pill--primary{ background: rgba(124,58,237,.14); border-color: rgba(124,58,237,.30); color: #6d28d9; }

    .wdg-slot-label{
      font-size: .72rem;
      color: rgba(100,116,139,1);
      text-transform: uppercase;
      letter-spacing: .6px;
      font-weight: 900;
      margin-top: 8px;
    }
    .wdg-slot-value{ font-size: .88rem; color: var(--wdg-text); }

    .wdg-slot-doclink{
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: 100%;
      padding: .28rem .56rem;
      border-radius: 999px;
      border: 1px solid rgba(37,99,235,.18);
      background: rgba(37,99,235,.08);
      color: #1d4ed8;
      text-decoration: none;
      font-size: .84rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow: 0 12px 26px rgba(15,23,42,.08);
    }
    .wdg-slot-doclink:hover{ background: rgba(37,99,235,.12); border-color: rgba(37,99,235,.26); color: #1e40af; }

    .wdg-slot-user{
      display:flex;
      align-items:center;
      gap: 10px;
      min-width: 0;
    }
    .wdg-slot-avatar{
      width: 40px;
      height: 40px;
      border-radius: 999px;
      object-fit: cover;
      flex: 0 0 40px;
      border: 1px solid rgba(15,23,42,.10);
      background: #fff;
      box-shadow: 0 14px 34px rgba(15,23,42,.12);
      display:block;
    }
    .wdg-slot-usertext{ min-width: 0; }
    .wdg-slot-username{
      font-weight: 850;
      color: var(--wdg-text);
      font-size: .92rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.2;
    }
    .wdg-slot-usermeta{
      font-size: .78rem;
      color: var(--wdg-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.2;
      margin-top: 2px;
    }

    .wdg-slot-row{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap: 10px;
      margin-top: 10px;
    }

    .wdg-slot-actions{
      display:flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      width: 100%;
    }
    .wdg-slot-actions{
      padding-top: 10px;
      border-top: 1px solid rgba(15,23,42,.08);
    }
    .wdg-assignment-slot .btn{
      border-radius: 999px;
      font-weight: 600;
      letter-spacing: .2px;
      padding: .44rem .78rem;
      font-size: .78rem;
      box-shadow: 0 12px 26px rgba(15,23,42,.08);
    }
    .wdg-assignment-slot .btn.btn-primary{
      background: linear-gradient(135deg, var(--wdg-primary), #2563eb 50%, #60a5fa 100%);
      border: 0;
    }
    .wdg-assignment-slot .btn.btn-primary:hover{ filter: brightness(1.02); }
    .wdg-assignment-slot .btn.btn-outline-danger{ border-color: rgba(220,38,38,.45); color: #dc2626; }
    .wdg-assignment-slot .btn.btn-outline-danger:hover{ background: rgba(220,38,38,.10); }
    .wdg-assignment-slot .btn.btn-outline-secondary{ border-color: rgba(15,23,42,.12); }
    .wdg-assignment-slot .btn.btn-outline-secondary:hover{ background: rgba(29,78,216,.08); }

    /* Destaque do cargo Síndico */
    .wdg-assignment-slot.wdg-assignment-slot--featured{
      border-color: rgba(29,78,216,.22);
      box-shadow:
        0 42px 110px rgba(15,23,42,.18),
        0 26px 66px rgba(29,78,216,.16),
        0 1px 0 rgba(255,255,255,.90) inset;
    }
    .wdg-assignment-slot.wdg-assignment-slot--featured::after{
      opacity: .25;
    }

    /* UserPick PRO (input digitável + dropdown com avatar) — igual Caixa de Mensagens */
    .wdg-assignment-slot .wdg-userpick{ width: 100%; max-width: 100%; }

    .wdg-userpick.wdg-userpick-pro .wdg-userpick-field{
      position: relative;
      border-radius: 999px;
      padding: 0;
      background: linear-gradient(180deg, rgba(255,255,255,.95), rgba(255,255,255,1));
      box-shadow:
        0 1px 2px rgba(2,6,23,.06),
        0 14px 34px rgba(2,6,23,.10);
      border: 1px solid rgba(15,23,42,.10);
      transition: box-shadow .18s ease, transform .18s ease, border-color .18s ease;
      overflow: hidden;
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-field:hover{
      box-shadow:
        0 2px 4px rgba(2,6,23,.07),
        0 22px 56px rgba(2,6,23,.12);
      transform: translateY(-1px);
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-input.form-control{
      border: 0;
      box-shadow: none;
      border-radius: 999px;
      background: transparent;
      font-weight: 650;
      position: relative;
      z-index: 1;
      transition: opacity .12s ease;
      width: 100%;
    }
    .wdg-userpick.wdg-userpick-pro .wdg-userpick-input.form-control:focus{
      outline: none;
      box-shadow: 0 0 0 4px rgba(29,78,216,.12);
    }

    /* Tamanho compacto para caber no card */
    .wdg-userpick.wdg-userpick-pro.wdg-userpick-pro-sm .wdg-userpick-input.form-control{
      min-height: 58px;
      padding-left: 74px;
      padding-right: 66px;
    }

    /* Tamanho grande (usado em modais / campos principais) */
    .wdg-userpick.wdg-userpick-pro.wdg-userpick-pro-lg .wdg-userpick-input.form-control{
      min-height: 56px;
      padding-left: 74px;
      padding-right: 66px;
      font-size: 1rem;
      font-weight: 750;
    }

    .wdg-userpick.wdg-userpick-pro .wdg-userpick-selected{
      position: absolute;
      display: flex;
      align-items: center;
      gap: .6rem;
      pointer-events: none;
      z-index: 2;
      transition: opacity .12s ease;
    }
