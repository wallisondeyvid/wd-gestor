<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edital de Convocação</title>
  <style>
    :root{
      --ink:#0f172a;
      --muted:#475569;
      --line:rgba(15,23,42,.12);
      --bg:#ffffff;
      --paper:#f8fafc;
    }
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, "Noto Sans", "Liberation Sans", sans-serif;
      color:var(--ink);
      background: var(--paper);
    }
    .page{
      max-width: 820px;
      margin: 22px auto;
      background: transparent;
      overflow: visible;
    }
    body.print-mode .topbar{ display:none !important; }
    .topbar{
      display:flex;
      align-items:center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 6px;
    }
    .btn{
      border: 1px solid rgba(15,23,42,.16);
      background: #fff;
      padding: 8px 12px;
      border-radius: 10px;
      font-weight: 650;
      cursor: pointer;
    }
    .content{ padding: 0 6px 18px; }

    /* Documento */
    .doc{
      background: #fff;
      border: 1px solid rgba(15,23,42,.12);
      border-radius: 10px;
      padding: 34px 44px 32px;
      box-shadow: none;
    }

    .doc-header{ text-align: center; }
    .doc-logo{
      width: 74px;
      height: 74px;
      object-fit: contain;
      display: block;
      margin: 0 auto 10px;
      border-radius: 14px;
      background: rgba(15,23,42,.02);
      border: 1px solid rgba(15,23,42,.10);
      box-shadow: 0 6px 14px rgba(15,23,42,.08);
    }
    .doc-title{
      margin: 0;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-size: 1.38rem;
      color: rgba(15,23,42,.86);
    }
    .doc-title-wrap{ margin: 18px 0 12px; padding-bottom: 10px; }
    .doc-title-wrap::after{
      content: "";
      display: block;
      width: 320px;
      height: 1px;
      background: rgba(15,23,42,.30);
      margin: 10px auto 0;
    }
    .doc-condo{
      margin-top: 10px;
      font-size: 1.28rem;
      font-weight: 800;
      letter-spacing: -.015em;
    }

    .doc-submeta{
      margin-top: 8px;
      color: rgba(15,23,42,.56);
      font-weight: 450;
      font-size: .84rem;
      line-height: 1.35;
      white-space: normal;
    }
    .doc-submeta{ text-align: center; }
    .doc-hr{ border:0; border-top: 1px solid rgba(15,23,42,.14); margin: 14px 0; }

    .data-box{
      border: 1px solid rgba(15,23,42,.16);
      border-radius: 10px;
      padding: 18px 20px;
      background: rgba(255,255,255,.96);
      box-shadow: none;
      margin-top: 10px;
    }

    .doc-gap{ height: 26px; }
    /* Quadro essencial — hierarquia tipográfica + grid com coluna fixa */
    .data-list{
      display: grid;
      grid-template-columns: 160px 1fr;
      row-gap: 6px;
      column-gap: 12px;
    }
    /* Mantém o HTML atual, mas alinha como grid “jurídico” */
    .data-row{ display: contents; }
    .data-k{
      color: #4b5563;
      font-weight: 600;
      letter-spacing: .02em;
      line-height: 1.55;
      margin-bottom: 6px;
    }
    .data-v{
      color: #111827;
      font-weight: 500;
      line-height: 1.55;
      margin-bottom: 6px;
      word-break: break-word;
    }
    .data-v.muted{ color: #1f2937; font-weight: 500; }

    .doc-p{
      font-size: 1.02rem;
      line-height: 1.7;
      margin: 0;
      color: rgba(15,23,42,.92);
      text-align: justify;
    }
    .doc-p + .doc-p{ margin-top: 18px; }
    .doc-section-title{
      margin: 22px 0 2px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-size: .88rem;
      color: rgba(15,23,42,.78);
    }
    .doc-section-subtitle{
      margin: 0 0 12px;
      font-size: .94rem;
      font-weight: 500;
      color: rgba(15,23,42,.70);
    }

    .agenda{ margin: 0; padding-left: 20px; }
    .agenda li{ margin: 4px 0; line-height: 1.45; }
    .agenda-tipo{ color: rgba(15,23,42,.62); font-weight: 650; font-size: .92em; }

    .doc-footer{
      margin-top: 22px;
      padding-top: 14px;
      border-top: 1px dashed rgba(15,23,42,.22);
      display: grid;
      gap: 16px;
    }
    .emitido{ color: rgba(15,23,42,.68); font-weight: 650; }
    .assinatura{ text-align: center; margin-top: 28px; }
    /* Linha de assinatura dimensionada pelo nome (sempre um pouco maior). */
    .linha{ display: none; }
    .assinatura .nome{
      color: rgba(15,23,42,.92);
      display: inline-block;
      position: relative;
      padding-top: 18px;
    }
    .assinatura .nome::before{
      content: "";
      position: absolute;
      left: -18px;
      right: -18px;
      top: 6px;
      border-top: 1px solid rgba(15,23,42,.40);
    }
    .assinatura .cargo{ color: rgba(15,23,42,.86); }
    .sig-nome{ font-weight: 600; }
    .sig-cargo{ font-weight: 500; }
    .sig-condo{ font-style: italic; font-weight: 500; color: rgba(15,23,42,.82); }
    .organizador{ color: rgba(15,23,42,.70); font-weight: 650; font-size: .95rem; text-align:center; }

    .warn{
      margin: 12px 0 0;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid rgba(245, 158, 11, .28);
      background: rgba(245, 158, 11, .08);
      color: rgba(120, 53, 15, .92);
      font-weight: 750;
      font-size: .9rem;
      text-align: left;
    }

    @media (max-width: 640px){
      .content{ padding: 18px 16px 20px; }
      .doc{ padding: 22px 18px; }
      .linha{ width: 240px; }
      .doc-submeta{ white-space: normal; }
      .data-row{ grid-template-columns: 1fr; gap: 2px; }
      .doc-title-wrap::after{ width: 240px; }
    }

    @media print{
      /* TAREFA 1 — Definir página física A4 */
      @page{
        size: A4;
        margin: 10mm;
      }

      /* TAREFA 2 — Reset de impressão */
      html, body{
        margin: 0 !important;
        padding: 0 !important;
        background: white !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Evita que o algoritmo de paginação “erre” por causa de zoom */
      html{ font-size: 14px !important; }

      .topbar{ display:none !important; }
      .page{ margin: 0 auto; }
      .content{ padding: 0; }

      /* TAREFA 3 — Container do edital (dimensão física estável) */
      .edital-page,
      .doc{
        box-sizing: border-box;
        width: 190mm;
        margin: 0 auto;
      }

      .doc{
        border: none !important;
        box-shadow: none !important;
        padding: 28px 36px 26px;
      }

      .doc-footer{
        margin-top: 14px;
        padding-top: 10px;
        gap: 12px;
      }
      .assinatura{ margin-top: 18px; }

      .doc-gap{ height: 16px !important; }

      /* Garantir o “traço” do título na impressão (não depender de background graphics) */
      .doc-title-wrap::after{
        background: transparent !important;
        height: 0 !important;
        border-top: 1px solid rgba(15,23,42,.30) !important;
      }

      /* TAREFA 4 — Evitar quebra da assinatura */
      .edital-footer,
      .assinatura,
      .rodape-edital,
      .doc-footer{
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .doc-footer,
      .assinatura{
        break-before: avoid-page;
        page-break-before: avoid;
      }

      /* Mantém blocos-chave coesos na paginação (sem alterar layout visual) */
      .doc-header, .doc-title-wrap, .doc-condo, .doc-submeta{ break-inside: avoid; page-break-inside: avoid; }
      .data-box, .data-list{ break-inside: avoid; page-break-inside: avoid; }
      .doc-section-title{ break-before: avoid-page; page-break-before: avoid; break-after: avoid; page-break-after: avoid; }
      .agenda li{ break-inside: avoid; page-break-inside: avoid; }
      .doc-footer .emitido{ break-after: avoid; page-break-after: avoid; }
      .assinatura .nome, .assinatura .cargo{ break-inside: avoid; page-break-inside: avoid; }
      .doc-p{ orphans: 3; widows: 3; }
    }
  </style>
</head>
<% const __printMode = (typeof printMode !== 'undefined') ? printMode : false; %>
<body class="<%= (__printMode ? 'print-mode' : '') %>">
  <% const __print = (__printMode === true || String(__printMode || '').trim() === '1'); %>
  <% const a = (assembleia && typeof assembleia === 'object') ? assembleia : {}; %>
  <% const c = (condominio && typeof condominio === 'object') ? condominio : {}; %>
  <% const conv = (convocante && typeof convocante === 'object') ? convocante : {}; %>
  <% const org = (organizador && typeof organizador === 'object') ? organizador : {}; %>
  <% const aviso = String(convocanteAviso || '').trim(); %>

  <% const pauta = Array.isArray(a?.pauta) ? a.pauta : []; %>
  <% const regra = String(a?.regraConvocacao || '').trim().toLowerCase(); %>
  <% const naturezaRaw = String(a?.natureza || '').trim().toLowerCase(); %>
  <% const modalidadeRaw = String(a?.modalidade || '').trim().toLowerCase(); %>

  <% const dataAssembleia = (() => { try { return a?.data ? new Date(a.data) : null; } catch { return null; } })(); %>
  <% const dataAssembleiaStr = (() => { try { return dataAssembleia ? dataAssembleia.toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : ''; } catch { return ''; } })(); %>
  <% const dataEmissaoRaw = a?.dataEmissao || a?.dataPublicacao || null; %>
  <% const dataEmissao = (() => { try { return dataEmissaoRaw ? new Date(dataEmissaoRaw) : new Date(); } catch { return new Date(); } })(); %>
  <% const dataEmissaoStr = (() => { try { return dataEmissao.toLocaleDateString('pt-BR', { timeZone: 'UTC' }); } catch { return ''; } })(); %>

  <% const formatDataExtenso = (d) => {
    try {
      const dt = d instanceof Date ? d : new Date(d);
      if (!dt || Number.isNaN(dt.getTime())) return '';
      const meses = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
      // Usa UTC para evitar "voltar um dia" quando o valor vem como date-only (YYYY-MM-DD).
      const dd = String(dt.getUTCDate()).padStart(2, '0');
      const mm = meses[dt.getUTCMonth()] || '';
      const yyyy = String(dt.getUTCFullYear());
      return mm ? `${dd} de ${mm} de ${yyyy}` : `${dd}/${String(dt.getUTCMonth()+1).padStart(2,'0')}/${yyyy}`;
    } catch { return ''; }
  }; %>

  <% const naturezaHuman = (() => {
    if (naturezaRaw.includes('ordin')) return 'Assembleia Geral Ordinária';
    if (naturezaRaw.includes('extra')) return 'Assembleia Geral Extraordinária';
    return 'Assembleia Geral';
  })(); %>

  <% const modalidadeHuman = (() => {
    if (modalidadeRaw === 'presencial') return 'Presencial';
    if (modalidadeRaw === 'virtual') return 'Virtual';
    if (modalidadeRaw === 'hibrida' || modalidadeRaw === 'híbrida') return 'Híbrida';
    return modalidadeRaw ? modalidadeRaw.charAt(0).toUpperCase() + modalidadeRaw.slice(1) : '';
  })(); %>

  <% const modalidadeTextoCorrido = String(modalidadeHuman || modalidadeRaw || '').trim().toLowerCase(); %>

  <% const formatHoraDoc = (raw) => {
    const t = String(raw || '').trim();
    if (!t) return '';
    const m = t.match(/^(\d{1,2})\s*(?:[:hH])?\s*(\d{2})?\s*$/);
    if (!m) return t;
    const hh = String(m[1] || '').padStart(2, '0');
    const mm = String(m[2] || '00').padStart(2, '0');
    return `${hh}h${mm}`;
  }; %>

  <% const horaTextoCorrido = (() => {
    if (regra === 'dupla') {
      const h1 = formatHoraDoc(a?.hora1);
      const h2 = formatHoraDoc(a?.hora2);
      return h1 || h2 || '';
    }
    return formatHoraDoc(a?.horaUnica);
  })(); %>

  <% const horariosBox = (() => {
    const isDupla = (regra === 'dupla');
    const hUnica = formatHoraDoc(a?.horaUnica);
    const h1 = formatHoraDoc(a?.hora1);
    const h2 = formatHoraDoc(a?.hora2);

    if (isDupla) {
      return {
        tipo: '1ª e 2ª chamadas',
        linhas: [
          { k: 'Horário (1ª):', v: h1 || '-' },
          { k: 'Horário (2ª):', v: h2 || '-' }
        ]
      };
    }

    return {
      tipo: 'Chamada única',
      linhas: [
        { k: 'Horário:', v: hUnica || '-' }
      ]
    };
  })(); %>

  <% const condoNome = String(c?.nome || a?.unidade_nome || a?.unidadeNome || a?.unidade?.nome || a?.unidade_id?.nome || '').trim() || 'Condomínio'; %>
    <% // AJUSTE: cabeçalho deve mostrar o nome completo da unidade.
      // Para o texto "do Condomínio ...", usamos a versão sem o prefixo para evitar "Condomínio Condomínio".
    %>
  <% const condoNomeFull = (() => {
    const n = String(condoNome || '').trim();
    return n.replace(/^condom[ií]nio\s+condom[ií]nio\s+/i, 'Condomínio ').trim() || n;
  })(); %>
  <% const condoNomeSemPrefixo = (() => {
    const n = String(condoNomeFull || '').trim();
    const stripped = n.replace(/^condom[ií]nio\s+/i, '').trim();
    return stripped || n;
  })(); %>
  <% const condoCnpj = String(c?.cnpj || '').trim(); %>
  <% const condoEndereco = String(c?.endereco || '').trim(); %>

  <% const convocanteNome = String(conv?.nome || '').trim(); %>
  <% const convocanteEmail = String(conv?.email || '').trim(); %>
  <% const convocanteCargo = String(conv?.cargo || 'Síndico').trim() || 'Síndico'; %>

  <% const organizadorNome = String(org?.nome || '').trim(); %>
  <% const organizadorEmail = String(org?.email || '').trim(); %>
  <% const organizadorCargo = String(org?.cargo || '').trim(); %>
  <% const organizadorDiff = !!(organizadorNome && convocanteNome && organizadorNome.toLowerCase() !== convocanteNome.toLowerCase()); %>

  <% const local = String(a?.local || '').trim(); %>
  <% const link = String(a?.link || '').trim(); %>
  <% const localLinkHuman = (() => {
    if ((modalidadeRaw === 'virtual') && link) return `Link: ${link}`;
    if ((modalidadeRaw === 'presencial') && local) return `Local: ${local}`;
    if ((modalidadeRaw === 'hibrida' || modalidadeRaw === 'híbrida')) {
      const parts = [];
      if (local) parts.push(`Local: ${local}`);
      if (link) parts.push(`Link: ${link}`);
      return parts.join(' | ');
    }
    if (local && link) return `Local: ${local} | Link: ${link}`;
    if (local) return `Local: ${local}`;
    if (link) return `Link: ${link}`;
    return '';
  })(); %>

  <% const localTextoCorrido = (() => {
    const _local = String(local || '').trim();
    const _link = String(link || '').trim();
    if ((modalidadeRaw === 'virtual') && _link) return `no link ${_link}`;
    if ((modalidadeRaw === 'presencial') && _local) return `no ${_local}`;
    if ((modalidadeRaw === 'hibrida' || modalidadeRaw === 'híbrida')) {
      if (_local && _link) return `no ${_local} e por meio do link ${_link}`;
      if (_local) return `no ${_local}`;
      if (_link) return `no link ${_link}`;
    }
    if (_local) return `no ${_local}`;
    if (_link) return `no link ${_link}`;
    return 'no local a definir';
  })(); %>

  <% const ensurePontoFinal = (s) => {
    const t = String(s || '').trim();
    if (!t || t === '-') return t;
    if (/[.!?]$/.test(t)) return t;
    return `${t}.`;
  }; %>

  <% // AJUSTE 1: Linha única CNPJ • Endereço – CEP (sem ruído visual) %>
  <% const formatCnpj = (raw) => {
    const digits = String(raw || '').replace(/\D/g, '');
    if (digits.length !== 14) return String(raw || '').trim();
    return `${digits.slice(0,2)}.${digits.slice(2,5)}.${digits.slice(5,8)}/${digits.slice(8,12)}-${digits.slice(12,14)}`;
  }; %>
  <% const extractCep = (text) => {
    const s = String(text || '');
    const m = s.match(/\bCEP\s*[:\-]?\s*([0-9]{2}\.?[0-9]{3}-?[0-9]{3})\b/i);
    if (m) return String(m[1] || '').trim();
    const m2 = s.match(/\b([0-9]{2}\.?[0-9]{3}-?[0-9]{3})\b/);
    return m2 ? String(m2[1] || '').trim() : '';
  }; %>
  <% const cepRaw = extractCep(condoEndereco); %>
  <% const cepDigits = String(cepRaw || '').replace(/\D/g, ''); %>
  <% const cepFmt = (cepDigits.length === 8) ? `${cepDigits.slice(0,2)}.${cepDigits.slice(2,5)}-${cepDigits.slice(5,8)}` : String(cepRaw || '').trim(); %>
  <% const enderecoSemCep = (() => {
    // Remove Código IBGE e qualquer CEP do texto do endereço para evitar duplicação.
    const s0 = String(condoEndereco || '');
    const s1 = s0
      .replace(/\s*[,•|–-]?\s*C[óo]digo\s*IBGE\s*[:\-]?\s*\d+\s*/gi, ' ')
      .replace(/\s*[,•|–-]?\s*CEP\s*[:\-]?\s*[0-9\.\-]{8,12}\s*/gi, ' ');
    return s1
      .replace(/\s{2,}/g, ' ')
      .replace(/\s+,/g, ',')
      .trim()
      .replace(/[\s,•|–-]+$/g, '')
      .trim();
  })(); %>
  <% const metaLine = (() => {
    const parts = [];
    const cnpjFmt = formatCnpj(condoCnpj);
    if (cnpjFmt) parts.push(`CNPJ: ${cnpjFmt}`);
    if (enderecoSemCep) parts.push(enderecoSemCep);
    let line = parts.join(' • ');
    if (cepFmt) line = `${line}${line ? ' – ' : ''}CEP ${cepFmt}`;
    return String(line || '').trim();
  })(); %>

  <% const cidadeUfLinha = (() => {
    const cidade = String(c?.cidade || c?.municipio || c?.nome_cidade || '').trim();
    const uf = String(c?.uf || c?.estado || '').trim();
    if (cidade && uf) return `${cidade}/${uf}`;

    const src = String(condoEndereco || '').trim();
    if (src) {
      const re = /(?:^|,|\s)([^,\n]+?)\s*-\s*([A-Za-z]{2})\b/g;
      let m;
      let last = null;
      while ((m = re.exec(src)) !== null) last = m;
      if (last) {
        const c0 = String(last[1] || '').trim();
        const uf0 = String(last[2] || '').trim().toUpperCase();
        if (c0 && uf0) return `${c0}/${uf0}`;
      }
    }

    return 'Montes Claros/MG';
  })(); %>
  <% const dataEmissaoExtenso = formatDataExtenso(dataEmissao) || (dataEmissaoStr || '-'); %>

  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <% const unidadeLogoUrlSafe = (() => { try { return String(unidadeLogoUrl || '').trim(); } catch { return ''; } })(); %>
  <% const unidadeIdStr = (() => {
    try {
      const raw = a?.unidade_id?._id || a?.unidade_id || '';
      return String(raw || '').trim();
    } catch { return ''; }
  })(); %>
  <% const unidadeIdOk = (/^[0-9a-fA-F]{24}$/).test(unidadeIdStr); %>
  <% const logoSrc = unidadeLogoUrlSafe || (unidadeIdOk ? `${String(_bp).replace(/\/+$/, '')}/api/unidades/${encodeURIComponent(unidadeIdStr)}/logo` : ''); %>

  <div class="page">
    <% if (!__print) { %>
      <div class="topbar">
        <div style="font-weight:800; color:rgba(15,23,42,.85)">Edital</div>
        <button class="btn" type="button" onclick="window.print()">Imprimir</button>
      </div>
    <% } %>

    <div class="content">
      <div class="doc">
        <div class="doc-header">
          <% if (logoSrc) { %>
            <img class="doc-logo" src="<%= logoSrc %>" alt="Logo do condomínio" onerror="this.onerror=null; this.src='<%= String(_bp).replace(/\/+$/, '') %>/img/placeholder-logo.svg';" />
          <% } %>

          <div class="doc-condo"><%= condoNomeFull %></div>

          <% if (metaLine) { %>
            <div class="doc-submeta"><%= metaLine %></div>
          <% } %>

          <% if (aviso) { %>
            <div class="warn"><%= aviso %></div>
          <% } %>

          <hr class="doc-hr" />
          <div class="doc-title-wrap">
            <div class="doc-title">EDITAL DE CONVOCAÇÃO</div>
          </div>
        </div>

        <div class="data-box" aria-label="Dados essenciais">
          <div class="data-list">
            <div class="data-row"><div class="data-k">Natureza:</div><div class="data-v"><%= naturezaHuman %></div></div>
            <div class="data-row"><div class="data-k">Data:</div><div class="data-v"><%= dataAssembleiaStr || '-' %></div></div>
            <div class="data-row"><div class="data-k">Modalidade:</div><div class="data-v"><%= modalidadeHuman || '-' %></div></div>
            <div class="data-row"><div class="data-k">Local:</div><div class="data-v muted"><%= String(localLinkHuman || '-').replace(/\b(Local|Link)\s*:\s*/gi, '').trim() %></div></div>
            <!-- Estrutura preparada para futura convocação em 2ª chamada -->
            <div class="data-row"><div class="data-k">Convocação:</div><div class="data-v"><%= horariosBox?.tipo || '-' %></div></div>
            <% (Array.isArray(horariosBox?.linhas) ? horariosBox.linhas : []).forEach((ln) => { %>
              <div class="data-row"><div class="data-k"><%= String(ln?.k || '').trim() %></div><div class="data-v"><%= String(ln?.v || '').trim() || '-' %></div></div>
            <% }) %>
            <div class="data-row"><div class="data-k">Número:</div><div class="data-v"><%= String(a?.numero || '').trim() || '-' %></div></div>
            <div class="data-row"><div class="data-k">Assunto:</div><div class="data-v"><%= String(a?.titulo || '').trim() || '-' %></div></div>
          </div>
        </div>

        <div class="doc-gap"></div>

        <% /* AJUSTE 3: Texto institucional (jurídico premium) */ %>
        <p class="doc-p">
          Nos termos da Convenção Condominial e da legislação aplicável, o Síndico do <strong><%= condoNomeFull %></strong>, no uso de suas atribuições,
          <strong>CONVOCA</strong> os condôminos para a <strong><%= naturezaHuman %></strong>, a realizar-se no dia <strong><%= dataAssembleiaStr || 'data a definir' %></strong>,
          às <strong><%= horaTextoCorrido || 'horário a definir' %></strong>, <%= localTextoCorrido %>, na modalidade <strong><%= modalidadeTextoCorrido || (modalidadeRaw || '—') %></strong>,
          para deliberar sobre a ordem do dia abaixo.
        </p>
        <% /* AJUSTE 4: Cláusula de quórum (sempre) */ %>
        <p class="doc-p">A assembleia será instalada em conformidade com o quórum previsto na Convenção Condominial.</p>

        <p class="doc-p">Os condôminos impossibilitados de comparecer poderão se fazer representar por procuração, na forma prevista na Convenção Condominial.</p>

        <div class="doc-section-title">ORDEM DO DIA</div>
        <% if (!pauta.length) { %>
          <p class="doc-p" style="color: var(--muted)">Nenhum item informado.</p>
        <% } else { %>
          <ol class="agenda">
            <% pauta.forEach((it) => { %>
              <li>
                <% const desc0 = String(it?.descricao || '').trim() || '-'; %>
                <% const desc1 = ensurePontoFinal(desc0); %>
                <% const tipo0 = String(it?.tipo || '').trim(); %>
                <% const tipo1 = (() => {
                  const t = String(tipo0 || '').trim().toLowerCase();
                  if (!t) return '';
                  if (t.startsWith('elei')) return 'eleição';
                  return t;
                })(); %>
                <%= desc1 %><% if (tipo1) { %><span class="agenda-tipo"> (<%= tipo1 %>)</span><% } %>
              </li>
            <% }) %>
          </ol>
        <% } %>

        <div class="doc-footer">
          <div class="emitido"><%= cidadeUfLinha %>, <%= dataEmissaoExtenso || '-' %>.</div>

          <div class="assinatura">
            <div class="linha"></div>
            <div class="nome"><span class="sig-nome"><%= (convocanteNome || organizadorNome || '—') %></span><span class="sig-cargo">, Síndico</span></div>
            <div class="cargo sig-condo"><%= condoNomeFull %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if (__print) { %>
    <script>
      (function(){
        function sleep(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }

        async function doPrint(){
          try { window.focus(); } catch(e) {}

          // Aguarda estabilização de layout (fonts + imagens + 2 frames)
          try {
            await new Promise(function(r){ requestAnimationFrame(function(){ requestAnimationFrame(r); }); });
          } catch(e) {}

          try {
            if (document.fonts && document.fonts.ready) {
              await Promise.race([document.fonts.ready, sleep(600)]);
            }
          } catch(e) {}

          try {
            var imgs = Array.prototype.slice.call(document.images || []).filter(function(img){ return img && !img.complete; });
            if (imgs.length) {
              var promises = imgs.map(function(img){
                try {
                  if (typeof img.decode === 'function') return img.decode().catch(function(){});
                } catch(e) {}
                return new Promise(function(resolve){
                  try {
                    img.addEventListener('load', resolve, { once: true });
                    img.addEventListener('error', resolve, { once: true });
                  } catch(e) { resolve(); }
                });
              });
              await Promise.race([Promise.all(promises), sleep(900)]);
            }
          } catch(e) {}

          // Margem extra para o browser assentar o reflow do print
          await sleep(300);
          try { window.print(); } catch(e) {}
        }

        if (document.readyState === 'complete' || document.readyState === 'interactive') doPrint();
        else document.addEventListener('DOMContentLoaded', function(){ doPrint(); });
      })();
    </script>
  <% } %>
</body>
</html>
