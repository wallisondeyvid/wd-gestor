              <span class="wdg-exec-navlabel">Votações</span>
            </span>
            <span class="wdg-exec-navchev" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
          </button>
          <button class="wdg-exec-navbtn" data-tab="ata" type="button" role="tab" aria-selected="false">
            <span class="left">
              <span class="wdg-exec-navico" aria-hidden="true"><img src="<%= _bp %>/images/assembleia_ata.png" alt=""></span>
              <span class="wdg-exec-navlabel">Ata</span>
            </span>
            <span class="wdg-exec-navchev" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
          </button>
          <button class="wdg-exec-navbtn" data-tab="encerramento" type="button" role="tab" aria-selected="false">
            <span class="left">
              <span class="wdg-exec-navico" aria-hidden="true"><img src="<%= _bp %>/images/fechar.png" alt=""></span>
              <span class="wdg-exec-navlabel">Encerramento</span>
            </span>
            <span class="wdg-exec-navchev" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
