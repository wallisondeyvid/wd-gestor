<div class="container-fluid py-3" id="wdg-exec-root">
  <div class="row g-3">
    <div class="col-12 col-lg-2">
      <aside class="wdg-exec-sidenav">
        <div class="wdg-exec-sidenav-title" aria-label="Execução da Assembleia">
          <span>EXECUÇÃO</span>
          <span>DA</span>
          <span>ASSEMBLEIA</span>
        </div>
        <div id="wdg-tabs" class="wdg-exec-nav" role="tablist" aria-label="Navegação da execução">
          <button class="wdg-exec-navbtn active" data-tab="sessao" type="button" role="tab" aria-selected="true">
            <span class="left">
              <span class="wdg-exec-navico" aria-hidden="true"><img src="<%= _bp %>/images/assembleia_sessao.png" alt=""></span>
              <span class="wdg-exec-navlabel">Sessão</span>
            </span>
            <span class="wdg-exec-navchev" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
          </button>
          <button class="wdg-exec-navbtn" data-tab="presencas" type="button" role="tab" aria-selected="false">
            <span class="left">
              <span class="wdg-exec-navico" aria-hidden="true"><img src="<%= _bp %>/images/pessoal.png" alt=""></span>
              <span class="wdg-exec-navlabel">Presenças</span>
            </span>
            <span class="wdg-exec-navchev" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
