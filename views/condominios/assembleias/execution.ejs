    body.wdg-exec-page .wdg-exec-navbtn:active{
      transform: translateY(0);
      box-shadow:
        0 12px 26px rgba(1, 10, 28, 0.22),
        0 0 0 1px rgba(44, 123, 255, 0.10) inset,
        inset 0 1px 0 rgba(255,255,255,.10);
