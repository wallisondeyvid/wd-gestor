    /* item selecionado bem distinto */
    body.wdg-exec-page .wdg-exec-navbtn.active{
      background:
        radial-gradient(circle at 18% 40%, rgba(255,255,255,.24), transparent 58%),
        linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,.10));
      border-color: rgba(255,255,255,.32);
      box-shadow:
        0 20px 44px rgba(1, 10, 28, 0.30),
        0 0 0 1px rgba(255,255,255,.14) inset,
        0 0 0 3px rgba(255,255,255,.08);
    }
    body.wdg-exec-page .wdg-exec-navbtn.active::before{
      content:'';
      position:absolute;
      left: .35rem;
      top: .72rem;
