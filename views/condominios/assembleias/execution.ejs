      background: rgba(var(--bs-body-bg-rgb), .90);
    }
    body.wdg-exec-page #wdg-agenda-list.list-group .list-group-item{
      border-radius: var(--wdg-radius-lg);
      border: 1px solid rgba(var(--bs-border-color-rgb), .55);
      box-shadow:
        0 12px 28px rgba(2,6,23,.08),
        0 4px 12px rgba(2,6,23,.06),
        inset 0 1px 0 rgba(255,255,255,.62);
      overflow: hidden;
      position: relative;
      transform: translateZ(0);
    }
    body.wdg-exec-page #wdg-agenda-list.list-group .list-group-item::before{
      content:'';
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(520px 180px at 12% 0%, rgba(var(--bs-primary-rgb), .06), transparent 58%),
        linear-gradient(180deg, rgba(255,255,255,.52), transparent 45%);
