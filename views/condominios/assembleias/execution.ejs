          <button class="wdg-exec-navbtn" data-tab="pauta" type="button" role="tab" aria-selected="false">
            <span class="left">
              <span class="wdg-exec-navico" aria-hidden="true"><img src="<%= _bp %>/images/assembleia_revisao_pauta.png" alt=""></span>
              <span class="wdg-exec-navlabel">Pauta ao vivo</span>
            </span>
            <span class="wdg-exec-navchev" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
