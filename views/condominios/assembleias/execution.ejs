<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Execução da Assembleia - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="<%= _bp %>/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _bp %>/css/icon-buttons.css?v=1">
  <%- include('../../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <link rel="stylesheet" href="<%= _bp %>/css/assembleias-execution-presencas.css?v=<%= (typeof assetVersion !== 'undefined' && assetVersion) ? assetVersion : Date.now() %>">
  <style>
    body.wdg-exec-page .wdg-page-header-card{
      overflow:hidden;
      border-radius: 1.05rem;
      border: 1px solid rgba(var(--bs-border-color-rgb), .65);
      background: rgba(var(--bs-body-bg-rgb), .92);
      box-shadow:
        0 24px 60px rgba(2,6,23,.10),
        0 10px 22px rgba(2,6,23,.08);
      position: relative;
      transform: translateZ(0);
    }
    body.wdg-exec-page .wdg-page-header-card::before{
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(700px 260px at 8% 12%, rgba(var(--bs-primary-rgb), .14), transparent 62%),
        radial-gradient(520px 240px at 92% 18%, rgba(var(--bs-info-rgb), .10), transparent 58%),
        linear-gradient(180deg, rgba(255,255,255,.55), transparent 26%);
      opacity: .9;
    }
    body.wdg-exec-page .wdg-page-header-card > *{ position: relative; z-index: 1; }

    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-exec-page .wdg-page-header-card{
        -webkit-backdrop-filter: blur(14px) saturate(155%);
        backdrop-filter: blur(14px) saturate(155%);
      }
    }
    body.wdg-exec-page .wdg-page-icon{
      width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;
      border-radius:12px;
      background: var(--bs-tertiary-bg);
      border: 1px solid var(--bs-border-color);
      flex: 0 0 auto;
    }
    body.wdg-exec-page .wdg-tab-icon{
      width:18px;
      height:18px;
      object-fit: contain;
      display:inline-block;
      vertical-align: text-bottom;
    }
    body.wdg-exec-page .wdg-kpi{
      padding:.75rem .9rem;
      border-radius: .75rem;
      border: 1px solid rgba(var(--bs-border-color-rgb), .65);
      background: rgba(var(--bs-body-bg-rgb), .92);
      height: 100%;
      position: relative;
      box-shadow:
        0 16px 44px rgba(2,6,23,.08),
        0 6px 16px rgba(2,6,23,.06),
        inset 0 1px 0 rgba(255,255,255,.65);
      transform: translateZ(0);
    }
    body.wdg-exec-page .wdg-kpi::before{
      content:'';
      position:absolute;
      inset:0;
      border-radius: inherit;
      pointer-events:none;
      background:
        radial-gradient(520px 220px at 12% 8%, rgba(var(--bs-primary-rgb), .08), transparent 60%),
        linear-gradient(180deg, rgba(255,255,255,.55), transparent 30%);
      opacity: .85;
    }
    body.wdg-exec-page .wdg-kpi > *{ position: relative; z-index: 1; }
    body.wdg-exec-page .wdg-kpi .small{ letter-spacing: .02em; }

    /* Campos (visual moderno + padronizado + leve 3D) */
    body.wdg-exec-page{
      --wdg-field-radius: .95rem;
      --wdg-field-border: rgba(var(--bs-border-color-rgb), .65);
      --wdg-field-bg: rgba(var(--bs-body-bg-rgb), .86);
      --wdg-field-shadow:
        0 10px 26px rgba(2,6,23,.06),
        0 4px 12px rgba(2,6,23,.05),
        inset 0 1px 0 rgba(255,255,255,.62);
      --wdg-field-shadow-focus:
        0 14px 34px rgba(2,6,23,.08),
        0 6px 16px rgba(2,6,23,.06),
        0 0 0 .22rem rgba(var(--bs-primary-rgb), .14),
        inset 0 1px 0 rgba(255,255,255,.68);
    }

    body.wdg-exec-page :is(.form-control, .form-select){
      border-radius: var(--wdg-field-radius);
      border: 1px solid var(--wdg-field-border);
      background:
        radial-gradient(520px 180px at 10% 0%, rgba(var(--bs-primary-rgb), .06), transparent 58%),
        linear-gradient(180deg, rgba(255,255,255,.55), transparent 40%),
        var(--wdg-field-bg);
      box-shadow: var(--wdg-field-shadow);
      transform: translateZ(0);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    body.wdg-exec-page :is(.form-control, .form-select)::placeholder{
      color: rgba(var(--bs-secondary-rgb), .75);
    }

    body.wdg-exec-page :is(.form-control, .form-select):disabled,
    body.wdg-exec-page :is(.form-control, .form-select)[readonly]{
      opacity: .92;
      background:
        linear-gradient(180deg, rgba(255,255,255,.45), transparent 44%),
        rgba(var(--bs-body-bg-rgb), .78);
    }

    body.wdg-exec-page :is(.form-control, .form-select):focus{
      border-color: rgba(var(--bs-primary-rgb), .35);
      box-shadow: var(--wdg-field-shadow-focus);
    }

    @media (hover:hover) and (pointer:fine){
      body.wdg-exec-page :is(.form-control, .form-select):not(:disabled):not([readonly]):hover{
        border-color: rgba(var(--bs-primary-rgb), .22);
        transform: translateY(-1px);
        box-shadow:
          0 12px 30px rgba(2,6,23,.07),
          0 5px 14px rgba(2,6,23,.06),
          inset 0 1px 0 rgba(255,255,255,.66);
      }
    }

    body.wdg-exec-page .input-group-text{
      border-radius: var(--wdg-field-radius);
      border: 1px solid var(--wdg-field-border);
      background:
        linear-gradient(180deg, rgba(255,255,255,.55), transparent 42%),
        rgba(var(--bs-body-bg-rgb), .88);
      box-shadow: var(--wdg-field-shadow);
    }

    /* alinhar arredondamento no input-group */
    body.wdg-exec-page .input-group > :is(.form-control, .form-select){
      box-shadow: var(--wdg-field-shadow);
    }
    body.wdg-exec-page .input-group > :not(:first-child){
      margin-left: -1px;
    }

    @media (prefers-reduced-motion: reduce){
      body.wdg-exec-page :is(.form-control, .form-select){
        transition: none;
      }
    }

    /* Premium: botões, listas e superfícies (efeito depth/3D sem mudar identidade) */
    body.wdg-exec-page{
      --wdg-radius-lg: 1.10rem;
      --wdg-radius-md: 1.00rem;
      --wdg-radius-sm: .85rem;
      --wdg-surface: rgba(var(--bs-body-bg-rgb), .92);
      --wdg-surface-soft: rgba(var(--bs-body-bg-rgb), .86);
      --wdg-border-soft: rgba(var(--bs-border-color-rgb), .65);
      --wdg-elev-1:
        0 16px 44px rgba(2,6,23,.08),
        0 6px 16px rgba(2,6,23,.06),
        inset 0 1px 0 rgba(255,255,255,.65);
      --wdg-elev-2:
        0 22px 56px rgba(2,6,23,.10),
        0 10px 22px rgba(2,6,23,.08),
        inset 0 1px 0 rgba(255,255,255,.70);
      --wdg-elev-3:
        0 34px 90px rgba(2,6,23,.16),
        0 14px 30px rgba(2,6,23,.10),
        inset 0 1px 0 rgba(255,255,255,.72);
      --wdg-gloss: linear-gradient(180deg, rgba(255,255,255,.58), transparent 34%);
      --wdg-ring: 0 0 0 .22rem rgba(var(--bs-primary-rgb), .16);
    }

    body.wdg-exec-page .card.shadow-sm:not(.wdg-page-header-card){
      border-radius: var(--wdg-radius-lg);
      border: 1px solid var(--wdg-border-soft);
      background: var(--wdg-surface);
      box-shadow: var(--wdg-elev-1);
      overflow: hidden;
      position: relative;
      transform: translateZ(0);
    }
    body.wdg-exec-page .card.shadow-sm:not(.wdg-page-header-card)::before{
      content:'';
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(560px 220px at 10% 10%, rgba(var(--bs-primary-rgb), .06), transparent 62%),
        var(--wdg-gloss);
      opacity: .9;
    }
    body.wdg-exec-page .card.shadow-sm:not(.wdg-page-header-card) > *{ position: relative; z-index: 1; }

    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-exec-page .card.shadow-sm:not(.wdg-page-header-card){
        -webkit-backdrop-filter: blur(10px) saturate(140%);
        backdrop-filter: blur(10px) saturate(140%);
      }
    }

    /* Botões (exclui os pills de escolha que já têm visual próprio) */
    body.wdg-exec-page .btn:not(.wdg-choice-btn){
      border-radius: var(--wdg-radius-md);
      box-shadow:
        0 1px 0 rgba(255,255,255,.65) inset,
        0 12px 26px rgba(2,6,23,.10),
        0 4px 10px rgba(2,6,23,.08);
      transform: translateZ(0);
      position: relative;
      overflow: hidden;
      transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
    }
    body.wdg-exec-page .btn:not(.wdg-choice-btn)::before{
      content:'';
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(520px 180px at 14% 0%, rgba(255,255,255,.22), transparent 55%),
        linear-gradient(180deg, rgba(255,255,255,.22), transparent 55%);
      opacity: .9;
    }
    body.wdg-exec-page .btn:not(.wdg-choice-btn) > *{ position: relative; z-index: 1; }

    @media (hover:hover) and (pointer:fine){
      body.wdg-exec-page .btn:not(.wdg-choice-btn):hover{
        transform: translateY(-1px);
        box-shadow:
          0 1px 0 rgba(255,255,255,.65) inset,
          0 18px 40px rgba(2,6,23,.14),
          0 6px 14px rgba(2,6,23,.10);
        filter: saturate(1.02);
      }
    }
    body.wdg-exec-page .btn:not(.wdg-choice-btn):active{
      transform: translateY(0);
      box-shadow:
        0 1px 0 rgba(255,255,255,.62) inset,
        0 10px 22px rgba(2,6,23,.12),
        0 3px 8px rgba(2,6,23,.10);
    }
    body.wdg-exec-page .btn:not(.wdg-choice-btn):focus-visible{
      box-shadow:
        var(--wdg-ring),
        0 1px 0 rgba(255,255,255,.65) inset,
        0 18px 40px rgba(2,6,23,.14),
        0 6px 14px rgba(2,6,23,.10);
    }

    /* Glow por variante (usa apenas variáveis Bootstrap) */
    body.wdg-exec-page :is(.btn-primary, .btn-outline-primary):focus-visible{ --wdg-ring: 0 0 0 .22rem rgba(var(--bs-primary-rgb), .18); }
    body.wdg-exec-page :is(.btn-success, .btn-outline-success):focus-visible{ --wdg-ring: 0 0 0 .22rem rgba(var(--bs-success-rgb), .18); }
    body.wdg-exec-page :is(.btn-warning, .btn-outline-warning):focus-visible{ --wdg-ring: 0 0 0 .22rem rgba(var(--bs-warning-rgb), .20); }
    body.wdg-exec-page :is(.btn-danger, .btn-outline-danger):focus-visible{ --wdg-ring: 0 0 0 .22rem rgba(var(--bs-danger-rgb), .18); }
    body.wdg-exec-page :is(.btn-info, .btn-outline-info):focus-visible{ --wdg-ring: 0 0 0 .22rem rgba(var(--bs-info-rgb), .18); }

    @media (hover:hover) and (pointer:fine){
      body.wdg-exec-page :is(.btn-primary, .btn-outline-primary):hover{ box-shadow: 0 1px 0 rgba(255,255,255,.62) inset, 0 22px 56px rgba(2,6,23,.16), 0 10px 22px rgba(var(--bs-primary-rgb), .12); }
      body.wdg-exec-page :is(.btn-success, .btn-outline-success):hover{ box-shadow: 0 1px 0 rgba(255,255,255,.62) inset, 0 22px 56px rgba(2,6,23,.16), 0 10px 22px rgba(var(--bs-success-rgb), .12); }
      body.wdg-exec-page :is(.btn-warning, .btn-outline-warning):hover{ box-shadow: 0 1px 0 rgba(255,255,255,.62) inset, 0 22px 56px rgba(2,6,23,.16), 0 10px 22px rgba(var(--bs-warning-rgb), .14); }
      body.wdg-exec-page :is(.btn-danger, .btn-outline-danger):hover{ box-shadow: 0 1px 0 rgba(255,255,255,.62) inset, 0 22px 56px rgba(2,6,23,.16), 0 10px 22px rgba(var(--bs-danger-rgb), .12); }
    }

    /* Listas */
    body.wdg-exec-page .list-group{
      border-radius: var(--wdg-radius-lg);
      overflow: hidden;
      border: 1px solid rgba(var(--bs-border-color-rgb), .55);
      background: rgba(var(--bs-body-bg-rgb), .88);
      box-shadow: 0 14px 30px rgba(2,6,23,.08);
    }
    body.wdg-exec-page .list-group-item{
      border-color: rgba(var(--bs-border-color-rgb), .55);
      background:
        radial-gradient(520px 180px at 12% 0%, rgba(var(--bs-primary-rgb), .04), transparent 58%),
        rgba(var(--bs-body-bg-rgb), .92);
    }
    @media (hover:hover) and (pointer:fine){
      body.wdg-exec-page .list-group-item:hover{
        background:
          radial-gradient(520px 180px at 12% 0%, rgba(var(--bs-primary-rgb), .07), transparent 58%),
          rgba(var(--bs-body-bg-rgb), .94);
      }
    }

    /* Tabelas: container premium */
    body.wdg-exec-page .table-responsive{
      border-radius: var(--wdg-radius-lg);
      border: 1px solid rgba(var(--bs-border-color-rgb), .55);
      background: rgba(var(--bs-body-bg-rgb), .92);
      box-shadow: 0 16px 44px rgba(2,6,23,.08);
      overflow: hidden;
    }
    body.wdg-exec-page .table{
      margin-bottom: 0;
    }
    body.wdg-exec-page .table thead th{
      background:
        linear-gradient(180deg, rgba(var(--bs-tertiary-bg-rgb), .92), rgba(var(--bs-body-bg-rgb), .92));
      border-bottom-color: rgba(var(--bs-border-color-rgb), .55);
      text-transform: uppercase;
      letter-spacing: .08em;
      font-size: .72rem;
      color: rgba(var(--bs-body-color-rgb), .72);
    }
    body.wdg-exec-page .table tbody td{
      border-top-color: rgba(var(--bs-border-color-rgb), .45);
    }

    /* Dropdowns e modais */
    body.wdg-exec-page #wdg-exec-root .dropdown-menu{
      border-radius: var(--wdg-radius-lg);
      border: 1px solid rgba(var(--bs-border-color-rgb), .55);
      background: rgba(var(--bs-body-bg-rgb), .95);
      box-shadow: 0 26px 70px rgba(2,6,23,.18);
      overflow: hidden;
    }
    body.wdg-exec-page #wdg-exec-root .dropdown-item{ transition: background-color .12s ease; }
    body.wdg-exec-page #wdg-exec-root .dropdown-item:hover{
      background: rgba(var(--bs-primary-rgb), .08);
    }
    body.wdg-exec-page .modal-content{
      border-radius: calc(var(--wdg-radius-lg) + .10rem);
      border: 1px solid rgba(var(--bs-border-color-rgb), .55);
      background: rgba(var(--bs-body-bg-rgb), .96);
      box-shadow: var(--wdg-elev-3);
      overflow: hidden;
    }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-exec-page #wdg-exec-root .dropdown-menu,
      body.wdg-exec-page .modal-content{
        -webkit-backdrop-filter: blur(14px) saturate(150%);
        backdrop-filter: blur(14px) saturate(150%);
      }
    }

    /* Badges: efeito glossy */
    body.wdg-exec-page .badge{
      box-shadow: inset 0 1px 0 rgba(255,255,255,.45);
    }
    body.wdg-exec-page .badge.rounded-pill{
      position: relative;
      overflow: hidden;
    }
    body.wdg-exec-page .badge.rounded-pill::before{
      content:'';
      position:absolute;
      inset:0;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.30), transparent 58%);
      opacity: .9;
    }

    /* Bloco de eventos (logs) */
    body.wdg-exec-page pre#wdg-exec-events,
    body.wdg-exec-page pre#wdg-doc-meta{
      border-radius: 1rem !important;
      border-color: rgba(var(--bs-border-color-rgb), .55) !important;
      background:
        radial-gradient(520px 220px at 12% 0%, rgba(var(--bs-primary-rgb), .05), transparent 62%),
        rgba(var(--bs-body-bg-rgb), .92) !important;
      box-shadow:
        0 16px 44px rgba(2,6,23,.08),
        0 6px 16px rgba(2,6,23,.06),
        inset 0 1px 0 rgba(255,255,255,.60);
    }

    @media (prefers-reduced-motion: reduce){
      body.wdg-exec-page .btn:not(.wdg-choice-btn){
        transition: none;
      }
    }

    /* Header (XL+): reduzir "Dados da assembleia" em 1/3 e ampliar "Status operacional" */
    @media (min-width: 1200px){
      body.wdg-exec-page .wdg-exec-col-dados{
        flex: 0 0 52.7778%;
        max-width: 52.7778%;
      }
      body.wdg-exec-page .wdg-exec-col-status{
        flex: 0 0 47.2222%;
        max-width: 47.2222%;
      }
    }

    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-exec-page .wdg-kpi{
        -webkit-backdrop-filter: blur(12px) saturate(155%);
        backdrop-filter: blur(12px) saturate(155%);
      }
    }

    @media (hover:hover) and (pointer:fine){
      body.wdg-exec-page .wdg-page-header-card,
      body.wdg-exec-page .wdg-kpi{
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      }
      body.wdg-exec-page .wdg-kpi:hover{
        transform: translateY(-2px);
        border-color: rgba(var(--bs-primary-rgb), .22);
        box-shadow:
          0 22px 56px rgba(2,6,23,.10),
          0 10px 22px rgba(2,6,23,.08),
          inset 0 1px 0 rgba(255,255,255,.70);
      }
    }

    body.wdg-exec-page .wdg-asm-grid{
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .6rem;
    }
    body.wdg-exec-page .wdg-asm-grid.wdg-asm-grid-2{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (max-width: 991.98px){
      body.wdg-exec-page .wdg-asm-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
      body.wdg-exec-page .wdg-asm-grid.wdg-asm-grid-2{ grid-template-columns: 1fr; }
    }
    @media (max-width: 575.98px){
      body.wdg-exec-page .wdg-asm-grid{ grid-template-columns: 1fr; }
    }

    /* Dados da assembleia (layout 2 linhas com proporções fixas) */
    body.wdg-exec-page .wdg-asm-dados{
      display: grid;
      gap: .55rem;
    }
    body.wdg-exec-page .wdg-asm-dados-row{
      display: grid;
      gap: .55rem;
      width: 100%;
      min-width: 0;
    }
    body.wdg-exec-page .wdg-asm-dados-row--1{
      grid-template-columns: 2fr 1fr 1fr; /* 50% | 25% | 25% */
    }
    body.wdg-exec-page .wdg-asm-dados-row--2{
      grid-template-columns: 15fr 15fr 35fr 35fr; /* 15% | 15% | 35% | 35% */
    }
    body.wdg-exec-page .wdg-asm-dados-row .wdg-asm-chip{
      min-width: 0;
      width: 100%;
    }
    body.wdg-exec-page .wdg-asm-dados-row .wdg-asm-chip .wdg-asm-chip-val,
    body.wdg-exec-page .wdg-asm-dados-row .wdg-asm-chip .wdg-asm-chip-sub{
      min-width: 0;
    }
    @media (max-width: 991.98px){
      body.wdg-exec-page .wdg-asm-dados-row--1,
      body.wdg-exec-page .wdg-asm-dados-row--2{
        grid-template-columns: 1fr;
      }
    }
    body.wdg-exec-page .wdg-asm-item{
      padding: .65rem .75rem;
      border-radius: .75rem;
      border: 1px solid rgba(var(--bs-border-color-rgb), .65);
      background: rgba(var(--bs-body-bg-rgb), .70);
      position: relative;
      box-shadow:
        0 10px 28px rgba(2,6,23,.06),
        0 4px 12px rgba(2,6,23,.05),
        inset 0 1px 0 rgba(255,255,255,.60);
      transform: translateZ(0);
    }
    body.wdg-exec-page .wdg-asm-item::before{
      content:'';
      position:absolute;
      inset:0;
      border-radius: inherit;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.52), transparent 30%);
      opacity: .85;
    }
    body.wdg-exec-page .wdg-asm-item > *{ position: relative; z-index: 1; }

    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-exec-page .wdg-asm-item{
        -webkit-backdrop-filter: blur(10px) saturate(155%);
        backdrop-filter: blur(10px) saturate(155%);
      }
    }

    @media (hover:hover) and (pointer:fine){
      body.wdg-exec-page .wdg-asm-item{ transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
      body.wdg-exec-page .wdg-asm-item:hover{
        transform: translateY(-1px);
        border-color: rgba(var(--bs-primary-rgb), .18);
        box-shadow:
          0 14px 34px rgba(2,6,23,.08),
          0 6px 16px rgba(2,6,23,.06),
          inset 0 1px 0 rgba(255,255,255,.68);
      }
    }

    body.wdg-exec-page .wdg-stepper .progress{
      background: rgba(var(--bs-tertiary-bg-rgb), .9);
      border: 1px solid rgba(var(--bs-border-color-rgb), .55);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.55);
      overflow: hidden;
    }
    body.wdg-exec-page .wdg-stepper .progress-bar{
      box-shadow: 0 10px 18px rgba(0,0,0,.10);
    }
    body.wdg-exec-page .wdg-asm-label{
      display:flex;
      align-items:center;
