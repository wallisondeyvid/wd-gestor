      box-shadow: inset 0 1px 0 rgba(255,255,255,.55);
    }

    body.wdg-exec-page .wdg-asm-fields{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: .55rem;
      margin-top: .55rem;
    }
    @media (max-width: 991.98px){
      body.wdg-exec-page .wdg-asm-fields{ grid-template-columns: 1fr; }
    }
    body.wdg-exec-page .wdg-asm-field{
      display:flex;
      gap: .6rem;
      align-items: center;
      padding: .55rem .65rem;
      border-radius: 1rem;
      border: 1px solid rgba(var(--bs-border-color-rgb), .60);
      background: rgba(var(--bs-body-bg-rgb), .70);
      box-shadow:
        0 10px 26px rgba(2,6,23,.06),
        0 4px 12px rgba(2,6,23,.05),
        inset 0 1px 0 rgba(255,255,255,.62);
      position: relative;
      transform: translateZ(0);
      min-height: 56px;
    }
    body.wdg-exec-page .wdg-asm-field::before{
      content:'';
      position:absolute;
      inset:0;
      border-radius: inherit;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.52), transparent 34%);
      opacity: .85;
    }
    body.wdg-exec-page .wdg-asm-field > *{ position: relative; z-index: 1; }
    @supports ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
      body.wdg-exec-page .wdg-asm-field{
        -webkit-backdrop-filter: blur(10px) saturate(155%);
        backdrop-filter: blur(10px) saturate(155%);
      }
    }
    @media (hover:hover) and (pointer:fine){
      body.wdg-exec-page .wdg-asm-field{ transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
      body.wdg-exec-page .wdg-asm-field:hover{
        transform: translateY(-1px);
        border-color: rgba(var(--bs-primary-rgb), .18);
        box-shadow:
          0 14px 34px rgba(2,6,23,.08),
          0 6px 16px rgba(2,6,23,.06),
          inset 0 1px 0 rgba(255,255,255,.68);
      }
