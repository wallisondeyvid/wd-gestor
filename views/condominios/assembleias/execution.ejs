    /* Espaço de altura de um menu entre título e primeiro item */
    body.wdg-exec-page .wdg-exec-nav{ margin-top: var(--wdg-exec-navbtn-minh); }

    /* Espaço de altura de um menu abaixo do último item */
    body.wdg-exec-page .wdg-exec-nav{ padding-bottom: var(--wdg-exec-navbtn-minh); }

    body.wdg-exec-page .wdg-exec-navbtn{
      width: 100%;
      border-radius: 14px;
