        </div>
      </aside>
    </div>

    <div class="col-12 col-lg-10">
      <div class="row g-3">
        <div class="col-12">
      <% 
        const __asmId = assembleia?._id ? String(assembleia._id) : '';
        const __asmTitulo = assembleia?._id ? (assembleia?.titulo || ('#' + __asmId)) : 'Selecione uma assembleia';
        const __asmModalidade = assembleia?.modalidade || '—';
        const __asmModalKey = String(__asmModalidade || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();
        const __isHibrida = __asmModalKey.includes('hibr');
        const __isVirtual = __asmModalKey.includes('virtual');
        const __isPresencial = __asmModalKey.includes('pres');

        const __toTitle = (value) => {
          const s = String(value || '').trim();
          if (!s) return '';
          return s
            .replace(/[_\-]+/g, ' ')
            .split(/\s+/)
            .map(w => w ? (w[0].toUpperCase() + w.slice(1).toLowerCase()) : '')
            .join(' ');
        };

        const __asmModalLabel = __isHibrida ? 'Híbrida' : (__isVirtual ? 'Virtual' : (__isPresencial ? 'Presencial' : (__toTitle(__asmModalidade) || '—')));

        const __asmData = assembleia?.data ? new Date(assembleia.data) : null;
        const __asmDataStr = __asmData ? __asmData.toLocaleDateString('pt-BR') : '—';
        const __horaUnica = String(assembleia?.horaUnica || '').trim();
        const __hora1 = String(assembleia?.hora1 || '').trim();
        const __hora2 = String(assembleia?.hora2 || '').trim();
        const __hasChamadas = !!(__horaUnica || __hora1 || __hora2);
        const __chamadaTipo = __horaUnica ? 'HORÁRIO ÚNICO' : ((__hora1 || __hora2) ? '1ª / 2ª CHAMADA' : '—');
        const __asmStatusRaw = String(assembleia?.status || '').trim();
        const __asmStatusKey = __asmStatusRaw
          ? __asmStatusRaw.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
          : '';
        const __asmStatusLabel = __asmStatusRaw
          ? ((__asmStatusKey === 'aberta' || __asmStatusKey === 'em_andamento')
            ? 'Em andamento'
            : (__toTitle(__asmStatusRaw) || __asmStatusRaw))
          : '—';
        const __asmStatusVariant = (__asmStatusKey.includes('abert') || __asmStatusKey.includes('andament')) ? 'success'
          : (__asmStatusKey.includes('paus') ? 'warning'
          : ((__asmStatusKey.includes('encerr') || __asmStatusKey.includes('final')) ? 'dark'
          : (__asmStatusKey.includes('convoc') ? 'info' : 'secondary')));
        const __asmModalVariant = __isHibrida ? 'primary' : (__isVirtual ? 'info' : (__isPresencial ? 'secondary' : 'light'));

        const __asmCondominioNome = String(
          assembleia?.condominioNome
          || assembleia?.unidadeNome
          || assembleia?.unidade_nome
          || assembleia?.unidade
          || assembleia?.condominio?.nome
          || ''
        ).trim() || '—';

        const __asmViewUnidadeId = (typeof unidadeId !== 'undefined') ? unidadeId : '';
        const __asmUnidadeId = String(
          __asmViewUnidadeId
          || assembleia?.unidade_id?._id
          || assembleia?.unidade_id
          || assembleia?.unidadeId?._id
          || assembleia?.unidadeId
          || assembleia?.unidade?._id
          || assembleia?.unidade?.id
          || ''
        ).trim();
        const __asmUnidadeIdOk = /^[a-f\d]{24}$/i.test(__asmUnidadeId);
        const __asmCondominioLogoUrl = __asmUnidadeIdOk
          ? (`${_bp}/api/unidades/${encodeURIComponent(__asmUnidadeId)}/logo`)
          : (`${_bp}/images/unidade.png`);

        const __asmLocal = String(assembleia?.local || '').trim();
        const __asmLink = String(assembleia?.link || '').trim();
        const __asmLinkHref = __asmLink
          ? ((/^https?:\/\//i.test(__asmLink) || __asmLink.startsWith('//')) ? __asmLink : `https://${__asmLink}`)
          : '';
      %>
      <div class="card shadow-sm wdg-page-header-card">
        <div class="card-body">
          

          <div class="row g-3 mt-1">
            <div class="col-12 wdg-exec-col-dados">
              <div class="wdg-kpi">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                  <div class="text-muted small fw-semibold">Dados da assembleia</div>
                  <span class="badge rounded-pill text-bg-light border" title="ID"><%= __asmId ? ('#' + __asmId) : '—' %></span>
                </div>
                <div class="wdg-asm-dados">
                  <div class="wdg-asm-dados-row wdg-asm-dados-row--1" aria-label="Linha 1">
                    <div class="wdg-asm-chip">
                      <div class="wdg-asm-chip-hd">
                        <img class="wdg-asm-ico" src="<%= __asmCondominioLogoUrl %>" alt="" onerror="this.onerror=null;this.src='<%= _bp %>/images/unidade.png';">
                        <span>Condomínio</span>
                      </div>
                      <div class="wdg-asm-chip-val text-truncate"><%= __asmCondominioNome %></div>
                    </div>

                    <div class="wdg-asm-chip">
                      <div class="wdg-asm-chip-hd"><img class="wdg-asm-ico" src="<%= _bp %>/images/calendario.png" alt=""><span>Data</span></div>
                      <div class="wdg-asm-chip-val"><%= __asmDataStr %></div>
                    </div>

                    <div class="wdg-asm-chip">
                      <div class="wdg-asm-chip-hd"><img class="wdg-asm-ico" src="<%= _bp %>/images/relogio.png" alt=""><span>Chamada</span></div>
                      <div class="wdg-asm-chip-sub">
                        <span class="wdg-asm-mini"><%= __chamadaTipo %></span>
                        <% if (!__hasChamadas) { %>
                          <span class="wdg-asm-sub">—</span>
                        <% } else if (__horaUnica) { %>
                          <span class="wdg-asm-mini"><span class="fw-semibold">Única</span> <%= __horaUnica %></span>
                        <% } else { %>
                          <span class="wdg-asm-mini"><span class="fw-semibold">1ª</span> <%= __hora1 || '—' %></span>
                          <span class="wdg-asm-mini"><span class="fw-semibold">2ª</span> <%= __hora2 || '—' %></span>
                        <% } %>
                      </div>
                    </div>
                  </div>

                  <div class="wdg-asm-dados-row wdg-asm-dados-row--2" aria-label="Linha 2">
                    <div class="wdg-asm-chip">
                      <div class="wdg-asm-chip-hd"><img class="wdg-asm-ico" src="<%= _bp %>/images/modalidade.png" alt=""><span>Modalidade</span></div>
                      <div class="wdg-asm-chip-sub">
                        <% if (__asmModalVariant === 'light') { %>
                          <span class="badge rounded-pill text-bg-light border"><%= __asmModalLabel %></span>
                        <% } else { %>
                          <span class="badge rounded-pill text-bg-<%= __asmModalVariant %>"><%= __asmModalLabel %></span>
                        <% } %>
                      </div>
                    </div>

                    <div class="wdg-asm-chip">
                      <div class="wdg-asm-chip-hd"><img class="wdg-asm-ico" src="<%= _bp %>/images/info.png" alt=""><span>Status</span></div>
                      <div class="wdg-asm-chip-sub">
                        <span class="badge rounded-pill text-bg-<%= __asmStatusVariant %>"><%= __asmStatusLabel %></span>
                      </div>
                    </div>

                    <div class="wdg-asm-chip">
                      <div class="wdg-asm-chip-hd"><img class="wdg-asm-ico" src="<%= _bp %>/images/local.png" alt=""><span><%= (__isHibrida || __isVirtual) ? 'Local (físico)' : 'Local' %></span></div>
                      <div class="wdg-asm-chip-val text-truncate"><%= __asmLocal || '—' %></div>
                    </div>

                    <div class="wdg-asm-chip">
                      <div class="wdg-asm-chip-hd"><img class="wdg-asm-ico" src="<%= _bp %>/images/web.png" alt=""><span>Link (virtual)</span></div>
                      <div class="wdg-asm-chip-val text-truncate">
                        <% if (__asmLink) { %>
                          <a class="link-primary text-decoration-none" href="<%= __asmLinkHref %>" target="_blank" rel="noopener">
                            <i class="bi bi-box-arrow-up-right me-1"></i><span><%= __asmLink %></span>
                          </a>
                        <% } else { %>
                          —
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 wdg-exec-col-status">
              <div class="wdg-kpi">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div class="d-flex align-items-center gap-2">
                    <div class="text-muted small fw-semibold">Status operacional</div>
                    <span id="wdg-exec-status-badge" class="badge rounded-pill text-bg-secondary"><span id="wdg-exec-status">Carregando…</span></span>
                  </div>
                  <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-success btn-sm" id="wdg-btn-open" type="button"><i class="bi bi-play-fill me-1"></i>Abrir</button>
                    <button class="btn btn-warning btn-sm" id="wdg-btn-pause" type="button"><i class="bi bi-pause-fill me-1"></i><span id="wdg-btn-pause-label">Pausar</span></button>
                    <button class="btn btn-danger btn-sm" id="wdg-btn-close" type="button"><i class="bi bi-x-circle me-1"></i>Encerrar</button>
                  </div>
                </div>

                <div class="wdg-stepper mt-2">
                  <div class="progress" style="height: 8px;">
                    <div id="wdg-exec-status-progress" class="progress-bar" role="progressbar" style="width: 0%" aria-label="Progresso da sessão"></div>
                  </div>
                  <div class="d-flex flex-wrap justify-content-between gap-2 mt-2">
                    <span id="wdg-step-open" class="badge rounded-pill wdg-step-badge"><i class="bi bi-door-open me-1"></i>Abertura</span>
                    <span id="wdg-step-pause" class="badge rounded-pill wdg-step-badge"><i class="bi bi-pause-circle me-1"></i>Pausa</span>
                    <span id="wdg-step-resume" class="badge rounded-pill wdg-step-badge"><i class="bi bi-play-circle me-1"></i>Retorno</span>
                    <span id="wdg-step-close" class="badge rounded-pill wdg-step-badge"><i class="bi bi-flag me-1"></i>Encerramento</span>
                  </div>
                </div>

                <div class="row g-2 mt-2">
                  <div class="col-12 col-md-4">
                    <div class="text-muted small"><i class="bi bi-stopwatch me-1"></i>Relógio</div>
                    <div class="fw-semibold" id="wdg-exec-clock">—</div>
                  </div>
                  <div class="col-12 col-md-4">
                    <div class="text-muted small"><i class="bi bi-people me-1"></i>Quórum</div>
                    <div class="fw-semibold" id="wdg-exec-quorum">—</div>
                  </div>
                  <div class="col-12 col-md-4">
                    <div class="text-muted small"><i class="bi bi-list-check me-1"></i>Item da pauta</div>
                    <div class="fw-semibold text-truncate" id="wdg-exec-agenda">—</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
        </div>

        <% if (!assembleia || !assembleia._id) { %>
          <div class="col-12">
            <div class="alert alert-warning mb-0">
              <div class="fw-semibold mb-1">Esta tela precisa de uma assembleia.</div>
              <div class="small text-muted">Abra pela lista de assembleias (ou informe o ID abaixo).</div>
              <% if (typeof resolveError !== 'undefined' && resolveError) { %>
                <div class="alert alert-danger mt-2 mb-0" role="alert"><%= String(resolveError) %></div>
              <% } %>
              <div class="d-flex flex-wrap gap-2 mt-2">
                <a class="btn btn-sm btn-outline-secondary" href="/condominios/assembleias">Ir para Assembleias</a>
                <form class="d-flex flex-wrap gap-2" method="GET" action="/condominios/administracao/assembleia/execucao">
                  <input class="form-control form-control-sm" name="id" placeholder="Cole o ID da assembleia" style="min-width: 320px;" />
                  <button class="btn btn-sm btn-primary" type="submit">Abrir Execução</button>
                </form>
              </div>
            </div>
          </div>
        <% } %>

        <div class="col-12 col-xl-9">
      <div class="card shadow-sm">
        <div class="card-body">
          <div id="wdg-tab-sessao" class="wdg-tab">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
              <h5 class="mb-0">Sessão</h5>
            </div>
            <div class="row g-3">
              <div class="col-12">
                <div class="text-muted small">Últimos eventos</div>
                <pre class="bg-light border rounded p-2 small mb-0" style="max-height: 280px; overflow:auto;" id="wdg-exec-events">(carregando…)</pre>
              </div>
            </div>
          </div>

          <div id="wdg-tab-presencas" class="wdg-tab d-none">
            <h5 class="mb-3">Presenças</h5>

            <div id="wdg-presencas-app" data-mode="local">
              <div class="row g-3">
                <div class="col-12 col-xl-6">
                  <div class="wdg-pres-card">
                    <div class="wdg-pres-card-hd">
                      <div class="fw-bold text-uppercase text-center">Registrar presença de representante da habitação</div>
                      <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mt-1">
                        <span class="badge text-bg-light border" id="wdg-pres-config-pill">Config: —</span>
                      </div>
                    </div>
                    <div class="wdg-pres-card-bd">

                      <div class="alert alert-warning d-none wdg-pres-inline-alert" role="alert" id="wdg-pres-form-warn"></div>
                      <div class="alert alert-success d-none wdg-pres-inline-alert" role="alert" id="wdg-pres-form-ok"></div>

                      <form id="wdg-form-presence" novalidate>
                        <div class="row g-3">
                          <!-- 1ª linha: Habitação -->
                          <div class="col-12">
                            <div class="wdg-pres-field">
                              <label for="wdg-habitacao-picker-input">Habitação</label>
                              <div class="wdg-pres-picker" data-pres-picker="habitacao">
                                <div class="wdg-pres-picker-box" tabindex="0" data-pres-picker-box>
                                  <div data-pres-picker-tokens></div>
                                  <input class="wdg-pres-picker-input" id="wdg-habitacao-picker-input" type="text" data-pres-picker-input placeholder="" autocomplete="off" />
                                  <div class="wdg-pres-picker-placeholder" data-pres-picker-placeholder></div>
                                </div>
                                <div class="wdg-pres-picker-menu" data-pres-picker-menu hidden></div>
                                <input type="hidden" id="wdg-habitacao-id" value="" />
                              </div>
                            </div>
                          </div>

                          <!-- 2ª linha: Fração ideal | Financeiro -->
                          <div class="col-12 col-md-6">
                            <div class="wdg-pres-field">
                              <label for="wdg-fracao-ideal">Fração ideal</label>
                              <input class="form-control" id="wdg-fracao-ideal" readonly placeholder="Selecione a habitação" />
                            </div>
                          </div>
                          <div class="col-12 col-md-6">
                            <div class="wdg-pres-field">
                              <label>Financeiro</label>
                              <div>
                                <span class="badge text-bg-secondary" id="wdg-financeiro-badge">—</span>
                              </div>
                            </div>
                          </div>

                          <!-- 3ª linha: Tipo representante -->
                          <div class="col-12">
                            <label class="form-label visually-hidden">Tipo representante</label>
                            <div class="wdg-choice-group wdg-choice-center" id="wdg-rep-tipo" role="group" aria-label="Selecione o tipo de representante">
                              <input class="btn-check" type="radio" name="wdg-rep-tipo" id="wdg-rep-tipo-proprietario" value="proprietario" checked>
                              <label class="btn wdg-choice-btn" for="wdg-rep-tipo-proprietario"><img class="wdg-choice-icon" src="/images/proprietario.png" alt="" loading="lazy">Proprietário</label>

                              <input class="btn-check" type="radio" name="wdg-rep-tipo" id="wdg-rep-tipo-inquilino" value="inquilino_autorizado">
                              <label class="btn wdg-choice-btn" for="wdg-rep-tipo-inquilino"><img class="wdg-choice-icon" src="/images/inquilino.png" alt="" loading="lazy">Inquilino</label>

                              <input class="btn-check" type="radio" name="wdg-rep-tipo" id="wdg-rep-tipo-procurador" value="procurador">
                              <label class="btn wdg-choice-btn" for="wdg-rep-tipo-procurador"><img class="wdg-choice-icon" src="/images/procurador.png" alt="" loading="lazy">Procurador</label>
                            </div>
                          </div>

                          <!-- 3ª linha (Procurador): campos manuais -->
                          <div class="col-12 d-none" id="wdg-rep-procurador-manual-wrap">
                            <div class="row g-2">
                              <div class="col-12 col-md-5">
                                <label class="form-label" for="wdg-rep-proc-nome">Nome</label>
                                <input class="form-control" id="wdg-rep-proc-nome" placeholder="Nome completo" maxlength="120" />
                              </div>
                              <div class="col-12 col-md-3">
                                <label class="form-label" for="wdg-rep-proc-cpf">CPF</label>
                                <input class="form-control" id="wdg-rep-proc-cpf" placeholder="Somente números" inputmode="numeric" maxlength="14" />
                              </div>
                              <div class="col-12 col-md-4">
                                <label class="form-label" for="wdg-rep-proc-email">E-mail</label>
                                <input class="form-control" id="wdg-rep-proc-email" placeholder="email@exemplo.com" maxlength="140" />
                              </div>
                              <div class="col-12">
                                <label class="form-label" for="wdg-rep-proc-obs">Observação</label>
                                <input class="form-control" id="wdg-rep-proc-obs" placeholder="Opcional" maxlength="220" />
                              </div>
                            </div>
                          </div>

                          <!-- 4ª linha: Seleção -->
                          <div class="col-12" id="wdg-rep-pessoa-wrap">
                            <label class="form-label visually-hidden" for="wdg-rep-search">Seleção</label>
                            <div class="wdg-outros-picker" data-rep-picker data-outros-picker>
                              <input type="hidden" id="wdg-rep-pessoa-id" value="" />
                              <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input class="form-control" type="search" id="wdg-rep-search" placeholder="Buscar por nome, e-mail, cargo..." autocomplete="off">
                                <button class="btn btn-outline-secondary" type="button" title="Atualizar" id="wdg-rep-refresh">
                                  <img src="/images/atualizar.png" alt="" style="width:18px;height:18px;display:block;">
                                </button>
                              </div>

                              <div class="wdg-list-wrap">
                                <div class="wdg-list-head">
                                  <div class="wdg-list-title">Pessoas</div>
                                </div>
                                <div class="wdg-recipients-pane" id="wdg-rep-scroll">
                                  <div class="d-flex flex-column gap-2" id="wdg-rep-list"></div>
                                  <div class="wdg-muted small mt-2" id="wdg-rep-hint" style="display:none;"></div>
                                </div>
                              </div>
                            </div>
                          </div>

                          <!-- 5ª linha: Anexo de procuração -->
                          <div class="col-12">
                            <div class="wdg-pres-field">
                              <label for="wdg-anexo-file" id="wdg-doc-label">Anexo de procuração</label>
                              <input class="form-control" type="file" id="wdg-anexo-file" accept="application/pdf,image/*" />
                            </div>
                          </div>

                          <!-- 6ª linha: Votação -->
                          <div class="col-12">
                            <div class="wdg-pres-field">
                              <label>Votação</label>
                              <input type="hidden" id="wdg-voto-status" value="votante" />
                              <div class="dropdown">
                                <button class="badge text-bg-success dropdown-toggle" type="button" id="wdg-voto-badge" data-bs-toggle="dropdown" aria-expanded="false">
                                  Apto para votar
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="wdg-voto-badge" id="wdg-voto-menu">
                                  <li><button class="dropdown-item" type="button" data-voto-set="votante">Apto para votar</button></li>
                                  <li><button class="dropdown-item" type="button" data-voto-set="nao_votante">Inapto para votar</button></li>
                                </ul>
                              </div>
                            </div>
                          </div>

                          <div class="col-12">
                            <div class="wdg-pres-actions wdg-pres-actions-right" id="wdg-rep-actions">
                              <button class="btn btn-sm btn-outline-secondary w-auto" type="button" id="wdg-btn-limpar">Limpar</button>
                              <button class="btn btn-sm btn-primary w-auto" type="submit" id="wdg-btn-confirmar">Confirmar</button>
                            </div>
                          </div>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-xl-6">
                  <div class="wdg-pres-card">
                    <div class="wdg-pres-card-hd">
                      <div class="fw-bold text-uppercase text-center">Registrar presença de não representante</div>
                    </div>
                    <div class="wdg-pres-card-bd">
                      <div class="row g-3">
                        <div class="col-12">
                          <label class="form-label visually-hidden">Tipo</label>
                          <div class="wdg-choice-group wdg-choice-center" id="wdg-outros-tipo" role="group" aria-label="Selecione o tipo">
                            <input class="btn-check" type="radio" name="wdg-outros-tipo" id="wdg-outros-tipo-dirigente" value="dirigente" checked>
                            <label class="btn wdg-choice-btn" for="wdg-outros-tipo-dirigente"><img class="wdg-choice-icon" src="/images/funcionario.png" alt="" loading="lazy">Dirigente</label>

                            <input class="btn-check" type="radio" name="wdg-outros-tipo" id="wdg-outros-tipo-colaborador" value="colaborador">
                            <label class="btn wdg-choice-btn" for="wdg-outros-tipo-colaborador"><img class="wdg-choice-icon" src="/images/colaborador.png" alt="" loading="lazy">Colaborador</label>

                            <input class="btn-check" type="radio" name="wdg-outros-tipo" id="wdg-outros-tipo-morador" value="morador">
                            <label class="btn wdg-choice-btn" for="wdg-outros-tipo-morador"><img class="wdg-choice-icon" src="/images/unidade.png" alt="" loading="lazy">Morador</label>

                            <input class="btn-check" type="radio" name="wdg-outros-tipo" id="wdg-outros-tipo-outros" value="outros">
                            <label class="btn wdg-choice-btn" for="wdg-outros-tipo-outros"><img class="wdg-choice-icon" src="/images/pessoal.png" alt="" loading="lazy">Outro</label>
                          </div>
                        </div>

                        <div class="col-12" id="wdg-outros-pessoa-wrap">
                          <label class="form-label visually-hidden" for="wdg-outros-search">Seleção</label>
                          <div class="wdg-outros-picker" data-outros-picker>
                            <input type="hidden" id="wdg-outros-pessoa-id" value="" />
                            <div class="input-group mb-2">
                              <span class="input-group-text"><i class="bi bi-search"></i></span>
                              <input class="form-control" type="search" id="wdg-outros-search" placeholder="Buscar por nome, e-mail, cargo..." autocomplete="off">
                              <button class="btn btn-outline-secondary" type="button" title="Atualizar" id="wdg-outros-refresh">
                                <img src="/images/atualizar.png" alt="" style="width:18px;height:18px;display:block;">
                              </button>
                            </div>

                            <div class="wdg-list-wrap">
                              <div class="wdg-list-head">
                                <div class="wdg-list-title">Pessoas</div>
                              </div>
                              <div class="wdg-recipients-pane" id="wdg-outros-scroll">
                                <div class="d-flex flex-column gap-2" id="wdg-outros-list"></div>
                                <div class="wdg-muted small mt-2" id="wdg-outros-hint" style="display:none;"></div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <div class="col-12 d-none" id="wdg-outros-manual-wrap">
                          <div class="row g-2">
                            <div class="col-12 col-md-5">
                              <label class="form-label" for="wdg-outros-nome">Nome</label>
                              <input class="form-control" id="wdg-outros-nome" placeholder="Nome completo" maxlength="120" />
                            </div>
                            <div class="col-12 col-md-3">
                              <label class="form-label" for="wdg-outros-cpf">CPF</label>
                              <input class="form-control" id="wdg-outros-cpf" placeholder="Somente números" inputmode="numeric" maxlength="14" />
                            </div>
                            <div class="col-12 col-md-4">
                              <label class="form-label" for="wdg-outros-email">E-mail</label>
                              <input class="form-control" id="wdg-outros-email" placeholder="email@exemplo.com" maxlength="140" />
                            </div>
                            <div class="col-12">
                              <label class="form-label" for="wdg-outros-obs">Observação</label>
                              <input class="form-control" id="wdg-outros-obs" placeholder="Opcional" maxlength="220" />
                            </div>
                          </div>
                        </div>

                        <div class="col-12">
                          <div class="d-flex justify-content-end">
                            <button class="btn btn-outline-primary" type="button" id="wdg-outros-add" style="min-width: 180px;">Adicionar</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="row g-3 mt-0">
                <div class="col-12">
                  <div class="wdg-pres-card">
                    <div class="wdg-pres-card-hd">
                      <div class="fw-bold">Quórum atual</div>
                    </div>
                    <div class="wdg-pres-card-bd">
                      <div class="wdg-pres-quorum-kpi" id="wdg-quorum-card">
                        <div class="wdg-pres-kpi">
                          <div class="hd">Aprovados (unidades)</div>
                          <div class="val" id="wdg-quorum-aprovados-unidades">0</div>
                        </div>
                        <div class="wdg-pres-kpi">
                          <div class="hd">Aprovados (fração)</div>
                          <div class="val" id="wdg-quorum-aprovados-fracao">0</div>
                        </div>
                        <div class="wdg-pres-kpi">
                          <div class="hd">Pendentes</div>
                          <div class="val" id="wdg-quorum-pendentes">0</div>
                        </div>
                        <div class="wdg-pres-kpi">
                          <div class="hd">Bloqueados</div>
                          <div class="val" id="wdg-quorum-bloqueados">0</div>
                        </div>
                        <div class="wdg-pres-kpi">
                          <div class="hd">Falta p/ instalar</div>
                          <div class="val" id="wdg-quorum-falta">—</div>
                        </div>
                      </div>
                      <hr class="my-3" />
                      <div class="wdg-pres-help" id="wdg-quorum-effective">—</div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="mt-3 wdg-pres-list-block">
                <div class="wdg-pres-list-head">
                  <div class="wdg-pres-list-caption">Lista de participantes</div>
                  <div class="wdg-pres-list-sub">Resumo de presenças registradas</div>
                </div>
                <div class="wdg-pres-list-wrap" aria-label="Lista de participantes da assembleia">
                  <div class="table-responsive wdg-pres-list-scroll">
                    <table class="table wdg-pres-table align-middle mb-0 text-center">
                    <thead>
                      <tr>
                        <th>Habitação</th>
                        <th>Participante</th>
                        <th>Representante</th>
                        <th>Tipo</th>
                        <th>Status</th>
                        <th>Fração</th>
                        <th>Ações</th>
                      </tr>
                    </thead>
                    <tbody id="wdg-presences-body">
                      <tr><td colspan="7" class="text-muted wdg-pres-empty">Nenhuma presença registrada.</td></tr>
                    </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- Modal: simular presença do portal -->
              <div class="modal fade" id="wdg-modal-portal-presence" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Simular presença do portal</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                      <div class="alert alert-danger d-none" role="alert" id="wdg-portal-error"></div>
                      <form id="wdg-form-portal" novalidate>
                        <div class="row g-3">
                          <div class="col-12 col-md-6">
                            <label class="form-label">Habitação</label>
                            <select class="form-select" id="wdg-portal-hab"></select>
                          </div>
                          <div class="col-12 col-md-6">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" id="wdg-portal-tipo">
                              <option value="proprietario">Proprietário</option>
                              <option value="procurador">Procurador</option>
                              <option value="inquilino_autorizado">Inquilino autorizado</option>
                            </select>
                          </div>
                          <div class="col-12">
                            <label class="form-label">Nome</label>
                            <input class="form-control" id="wdg-portal-nome" placeholder="Nome completo" />
                          </div>
                          <div class="col-12">
                            <label class="form-label">Procuração (anexo)</label>
                            <input class="form-control" type="file" id="wdg-portal-doc" accept="application/pdf,image/*" />
                          </div>
                        </div>
                      </form>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <button type="button" class="btn btn-primary" id="wdg-portal-submit">Criar presença</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Modal: ver doc -->
              <div class="modal fade" id="wdg-modal-confirmar-pin" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <form id="wdg-pin-presence-form" onsubmit="return false;" novalidate>
                      <div class="modal-header">
                        <h5 class="modal-title">Confirmar presença (PIN)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                      </div>
                      <div class="modal-body">
                        <input type="hidden" id="wdg-pin-presence-id" value="" />
                        <label class="form-label" for="wdg-pin-presence-value">PIN/Senha do participante</label>
                        <input class="form-control" id="wdg-pin-presence-value" type="password" autocomplete="off" />
                        <div class="small text-muted mt-2">Use o PIN de presença do participante (ou senha do portal, fallback).</div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary" id="wdg-pin-presence-submit">Confirmar</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>

              <!-- Modal: ver doc -->
              <div class="modal fade" id="wdg-modal-doc" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Documento anexado</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                      <div class="text-muted small">Metadados (em memória):</div>
                      <pre class="bg-light border rounded p-2 small mb-0" id="wdg-doc-meta">—</pre>

                      <hr class="my-3" />

                      <div class="row g-2">
                        <div class="col-12">
                          <label class="form-label">Substituir anexo</label>
                          <input class="form-control" type="file" id="wdg-doc-replace" accept="application/pdf,image/*" />
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-2">
                          <button class="btn btn-outline-danger" type="button" id="wdg-doc-remove">Remover doc</button>
                          <button class="btn btn-primary" type="button" id="wdg-doc-save">Salvar novo anexo</button>
                        </div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Ok</button>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <div id="wdg-tab-pauta" class="wdg-tab d-none">
            <h5 class="mb-3">Pauta ao vivo</h5>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <button class="btn btn-outline-secondary" id="wdg-btn-agenda-prev" type="button">Anterior</button>
              <button class="btn btn-outline-secondary" id="wdg-btn-agenda-next" type="button">Próximo</button>
              <button class="btn btn-outline-primary" id="wdg-btn-agenda-discuss" type="button">Iniciar discussão</button>
            </div>
            <div class="text-muted small">Itens</div>
            <div class="list-group" id="wdg-agenda-list">
              <div class="list-group-item text-muted">Carregando…</div>
            </div>
          </div>

          <div id="wdg-tab-votacoes" class="wdg-tab d-none">
            <h5 class="mb-3">Votações</h5>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <select class="form-select" id="wdg-vote-rule" style="max-width: 240px;">
                <option value="maioria_simples">Maioria simples</option>
                <option value="maioria_qualificada">Maioria qualificada</option>
                <option value="unanimidade">Unanimidade</option>
              </select>
              <select class="form-select" id="wdg-vote-type" style="max-width: 240px;">
                <option value="sim_nao_abstencao">SIM / NÃO / ABSTENÇÃO</option>
              </select>
              <button class="btn btn-outline-primary" id="wdg-btn-vote-open" type="button">Abrir votação do item atual</button>
              <button class="btn btn-outline-danger" id="wdg-btn-vote-close" type="button">Fechar votação</button>
            </div>

            <form class="row g-2" id="wdg-form-vote">
              <div class="col-12 col-md-4">
                <input class="form-control" name="presenceKey" placeholder="Chave (ex: APTO-101)" required />
              </div>
              <div class="col-12 col-md-4">
                <select class="form-select" name="choice" required>
                  <option value="sim">Sim</option>
                  <option value="nao">Não</option>
                  <option value="abstencao">Abstenção</option>
                </select>
              </div>
              <div class="col-12 col-md-4">
                <button class="btn btn-success w-100" type="submit">Registrar voto</button>
              </div>
            </form>

            <div class="mt-3">
              <div class="text-muted small">Resumo</div>
              <div class="row g-2">
                <div class="col-12 col-md-3"><div class="border rounded p-2"><div class="text-muted small">Sim</div><div class="fw-semibold" id="wdg-vote-sim">—</div></div></div>
                <div class="col-12 col-md-3"><div class="border rounded p-2"><div class="text-muted small">Não</div><div class="fw-semibold" id="wdg-vote-nao">—</div></div></div>
                <div class="col-12 col-md-3"><div class="border rounded p-2"><div class="text-muted small">Abst.</div><div class="fw-semibold" id="wdg-vote-abst">—</div></div></div>
                <div class="col-12 col-md-3"><div class="border rounded p-2"><div class="text-muted small">Total</div><div class="fw-semibold" id="wdg-vote-total">—</div></div></div>
              </div>
            </div>
          </div>

          <div id="wdg-tab-ata" class="wdg-tab d-none">
            <h5 class="mb-3">Ata</h5>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <button class="btn btn-outline-primary" id="wdg-btn-ata-load" type="button">Carregar prévia</button>
              <a class="btn btn-outline-secondary" id="wdg-btn-ata-pdf" target="_blank" rel="noopener">Exportar PDF</a>
            </div>
            <textarea class="form-control" rows="14" id="wdg-ata-text" placeholder="Carregue a prévia para editar/revisar…"></textarea>
          </div>

          <div id="wdg-tab-encerramento" class="wdg-tab d-none">
            <h5 class="mb-3">Encerramento</h5>
            <div class="alert alert-warning">
              Ao encerrar, a sessão é bloqueada e a votação (se aberta) é finalizada.
            </div>
            <button class="btn btn-danger" id="wdg-btn-close-2" type="button">Encerrar sessão</button>
          </div>

          <div class="mt-3">
            <div class="alert alert-danger d-none" id="wdg-error"></div>
            <div class="alert alert-success d-none" id="wdg-success"></div>
          </div>
        </div>
      </div>
    </div>

        <div class="col-12 col-xl-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="mb-2">Resumo</h6>
          <div class="small text-muted">As informações abaixo vêm do status.</div>
          <hr />
          <div class="mb-2"><div class="text-muted small">Presentes confirmados</div><div class="fw-semibold" id="wdg-summary-presences">—</div></div>
          <div class="mb-2"><div class="text-muted small">Votação aberta</div><div class="fw-semibold" id="wdg-summary-vote">—</div></div>
          <div class="mb-0"><div class="text-muted small">Última atualização</div><div class="fw-semibold" id="wdg-summary-updated">—</div></div>
        </div>
      </div>
    </div>
      </div>
    </div>
  </div>
</div>

<div id="wdg-exec-config" data-assembleia-id="<%= String((assembleia && assembleia._id) || '') %>"></div>

<script>
  // Boot opcional mínimo. O restante (config/habitações) vem de providers no JS.
  window.__WDG_BOOT__ = window.__WDG_BOOT__ || {
    assembleiaId: <%- JSON.stringify(String((assembleia && assembleia._id) || '')) %>,
    userLabel: <%- JSON.stringify(String((user && (user.nome || user.name || user.email)) || 'Gestor')) %>
  };

  // Diretório de habitações (filtrado pelo condomínio da assembleia). Sem fetch.
  // Enviamos sempre array (mesmo vazio) para desativar mocks/fallbacks.
  window.__HABITACOES__ = <%- JSON.stringify((typeof habitacoesDirectory !== 'undefined' && Array.isArray(habitacoesDirectory)) ? habitacoesDirectory : []) %>;
</script>
<script src="<%= _bp %>/js/condominios/assembleias/assembleia-execution.js?v=<%= (typeof assetVersion !== 'undefined' && assetVersion) ? assetVersion : Date.now() %>"></script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
