<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Assembleias do Condomínio - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    body.wdg-assembleias{background:#f4f6fb;}
    .wdg-asm-hero{background:linear-gradient(135deg,#1d4ed8,#38bdf8);color:#fff;border-radius:28px;padding:2.3rem 2.8rem;margin-bottom:2rem;box-shadow:0 28px 70px rgba(15,23,42,.28);}
    .wdg-asm-hero h1{font-weight:700;font-size:2rem;margin-bottom:.35rem;}
    .wdg-asm-hero p{margin:0;max-width:760px;color:rgba(255,255,255,.9);}    
    .wdg-asm-tabs .nav-link{border-radius:16px;font-weight:600;padding:.65rem 1.4rem;margin-right:.65rem;background:#fff;color:#0f172a;border:1px solid rgba(15,23,42,.08);box-shadow:0 12px 30px rgba(15,23,42,.08);}
    .wdg-asm-tabs .nav-link.active{background:#0f172a;color:#fff;border-color:#0f172a;box-shadow:0 14px 40px rgba(15,23,42,.25);}  
    .wdg-asm-panel{background:#fff;border-radius:26px;padding:1.9rem 2.2rem;box-shadow:0 32px 90px rgba(15,23,42,.12);margin-bottom:2rem;}
    .wdg-asm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.1rem;}
    .wdg-asm-card{border:1px solid rgba(15,23,42,.08);border-radius:22px;padding:1.3rem;background:#f8fafc;box-shadow:inset 0 1px 0 rgba(255,255,255,.7);}    
    .wdg-asm-card h3{font-size:1rem;font-weight:600;margin-bottom:.45rem;color:#0f172a;}
    .wdg-asm-card small{color:#64748b;}
    .wdg-asm-step{border-left:3px solid #1d4ed8;padding-left:1rem;margin-bottom:1.2rem;}
    .wdg-asm-step span{display:block;font-size:.78rem;text-transform:uppercase;letter-spacing:.2em;color:#94a3b8;margin-bottom:.2rem;}
    .wdg-asm-step strong{font-size:1.05rem;color:#0f172a;}
    .timeline{list-style:none;margin:0;padding:0;}
    .timeline li{position:relative;padding-left:2.5rem;margin-bottom:1.5rem;}
    .timeline li::before{content:'';position:absolute;left:.75rem;top:.35rem;width:12px;height:12px;border-radius:50%;background:#1d4ed8;box-shadow:0 0 0 4px rgba(29,78,216,.15);}
    .timeline li::after{content:'';position:absolute;left:1.3rem;top:1.5rem;bottom:-1.5rem;width:2px;background:rgba(15,23,42,.08);} 
    .timeline li:last-child::after{display:none;}
    .wdg-pill{display:inline-flex;align-items:center;gap:.25rem;padding:.25rem .65rem;border-radius:999px;font-size:.78rem;font-weight:600;background:#e0e7ff;color:#3730a3;}
    .wdg-asm-form .form-label{text-transform:uppercase;font-size:.7rem;letter-spacing:.18em;color:#475569;font-weight:600;}
    .wdg-asm-form .form-control,.wdg-asm-form .form-select{border-radius:16px;border:1px solid rgba(15,23,42,.12);padding:.65rem .85rem;}
    .wdg-empty-state{padding:2rem;border:1px dashed rgba(15,23,42,.2);border-radius:20px;text-align:center;color:#94a3b8;font-weight:600;}
    @media(max-width:768px){
      .wdg-asm-hero{padding:1.6rem;}
      .wdg-asm-panel{padding:1.3rem;}
    }
  </style>
</head>
<body class="wdg-layout wdg-assembleias">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: 'Gestão de Condomínios',
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleias', path: '/administracao/assembleias' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>

  <main class="container py-4" id="assembleiaApp"
        data-base-path="<%= _bp %>"
        data-user-nome="<%= user && user.nome ? user.nome : '' %>">
    <section class="wdg-asm-hero">
      <h1>Orquestração de Assembleias</h1>
      <p>Planeje, conduza e documente assembleias com o mesmo rigor usado em plataformas como Superlógica, uCondo e CondoBlue: agenda colaborativa, ata viva, votação digital e comunicação integrada com os moradores.</p>
    </section>

    <div class="wdg-asm-tabs mb-4">
      <ul class="nav nav-pills" id="assembleiaTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="tab-agenda" data-bs-toggle="pill" data-bs-target="#pane-agenda" type="button" role="tab">Agendamento</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-live" data-bs-toggle="pill" data-bs-target="#pane-live" type="button" role="tab">Assembleia em andamento</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-historico" data-bs-toggle="pill" data-bs-target="#pane-historico" type="button" role="tab">Histórico & Atas</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-engajamento" data-bs-toggle="pill" data-bs-target="#pane-engajamento" type="button" role="tab">Enquetes & Comunicados</button>
        </li>
      </ul>
    </div>

    <div class="tab-content">
      <section class="tab-pane fade show active" id="pane-agenda" role="tabpanel" aria-labelledby="tab-agenda">
        <div class="wdg-asm-panel mb-4">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
              <h2 class="h4 mb-1">Agendar assembleia</h2>
              <small class="text-muted">Modelos inspirados em apps líderes: defina pauta, público-alvo e formato (presencial, híbrido ou remoto).</small>
            </div>
            <button class="btn btn-primary" data-action="criar-assembleia"><i class="bi bi-calendar-plus me-2"></i>Salvar agendamento</button>
          </div>
          <form class="row g-3 wdg-asm-form" id="formAgendamento">
            <div class="col-md-4">
              <label class="form-label" for="asmTitulo">Título</label>
              <input type="text" class="form-control" id="asmTitulo" placeholder="Assembleia Extraordinária" required>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="asmData">Data e horário</label>
              <input type="datetime-local" class="form-control" id="asmData" required>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="asmFormato">Formato</label>
              <select class="form-select" id="asmFormato">
                <option value="presencial">Presencial</option>
                <option value="hibrido">Híbrido</option>
                <option value="remoto">100% on-line</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="asmPauta">Pauta principal</label>
              <input type="text" class="form-control" id="asmPauta" placeholder="Reforma da fachada, prestação de contas">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="asmPublico">Convidados</label>
              <select class="form-select" id="asmPublico" multiple size="3">
                <option value="condominos">Condôminos</option>
                <option value="conselho">Conselho Fiscal</option>
                <option value="sindico">Síndico/Subsíndico</option>
                <option value="fornecedores">Fornecedor convidado</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="asmObservacoes">Observações e documentos prévios</label>
              <textarea class="form-control" id="asmObservacoes" rows="3" placeholder="Link da sala virtual, documentos de apoio, instruções de votação..."></textarea>
            </div>
          </form>
        </div>
        <div class="wdg-asm-panel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h5 mb-0">Próximas assembleias</h3>
            <div class="btn-group">
              <button class="btn btn-outline-secondary btn-sm" data-action="compartilhar-convite">Compartilhar convite</button>
              <button class="btn btn-outline-secondary btn-sm" data-action="baixar-calendario">Exportar calendário</button>
            </div>
          </div>
          <div id="listaAgendamentos" class="wdg-asm-grid"></div>
        </div>
      </section>

      <section class="tab-pane fade" id="pane-live" role="tabpanel" aria-labelledby="tab-live">
        <div class="wdg-asm-panel mb-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h2 class="h4 mb-1">Ata em tempo real</h2>
              <small class="text-muted">Inicie o registro colaborativo, marque presença e publique a ata assim que finalizado.</small>
            </div>
            <div class="btn-group">
              <button class="btn btn-outline-primary btn-sm" data-action="gerar-minuta"><i class="bi bi-file-earmark-text me-1"></i>Gerar minuta</button>
              <button class="btn btn-primary btn-sm" data-action="finalizar-ata"><i class="bi bi-check-circle me-1"></i>Fechar ata</button>
            </div>
          </div>
          <div class="row g-3">
            <div class="col-lg-5">
              <div class="wdg-asm-card h-100">
                <h3>Checklist da sessão</h3>
                <div class="wdg-asm-step">
                  <span>Etapa 1</span>
                  <strong>Quórum alcançado</strong>
                  <small class="d-block">68% dos votos presentes · <a href="#" data-action="ver-presenca">ver lista</a></small>
                </div>
                <div class="wdg-asm-step">
                  <span>Etapa 2</span>
                  <strong>Pauta atual</strong>
                  <small class="d-block" id="pautaAtiva">Prestação de contas 24/25</small>
                </div>
                <div class="wdg-asm-step">
                  <span>Etapa 3</span>
                  <strong>Próxima votação</strong>
                  <small class="d-block">Rateio extra para fachada · <span class="wdg-pill">em preparação</span></small>
                </div>
              </div>
            </div>
            <div class="col-lg-7">
              <div class="wdg-asm-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h3 class="mb-0">Editor da ata</h3>
                  <button class="btn btn-outline-secondary btn-sm" data-action="inserir-modelo">Aplicar modelo</button>
                </div>
                <textarea class="form-control" id="ataEditor" rows="10" placeholder="Resumo das decisões, responsáveis, prazos e anexos..." style="border-radius:18px; border:1px solid rgba(15,23,42,.1);"></textarea>
              </div>
            </div>
          </div>
        </div>
        <div class="wdg-asm-panel">
          <div class="row g-3">
            <div class="col-lg-6">
              <h3 class="h5">Participantes conectados</h3>
              <ul class="list-group" id="listaParticipantes"></ul>
            </div>
            <div class="col-lg-6">
              <h3 class="h5">Votações abertas</h3>
              <div id="listaVotacoes" class="d-flex flex-column gap-3"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="tab-pane fade" id="pane-historico" role="tabpanel" aria-labelledby="tab-historico">
        <div class="wdg-asm-panel mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h2 class="h4 mb-1">Linha do tempo</h2>
              <small class="text-muted">Todas as atas e decisões centralizadas, com links rápidos para download.</small>
            </div>
            <button class="btn btn-outline-secondary btn-sm" data-action="filtrar-historico"><i class="bi bi-funnel me-1"></i>Filtros</button>
          </div>
          <ul class="timeline" id="timelineAtas"></ul>
        </div>
        <div class="wdg-asm-panel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h5 mb-0">Atas e deliberações</h3>
            <button class="btn btn-outline-primary btn-sm" data-action="exportar-atas">Exportar selecionadas</button>
          </div>
          <div class="table-responsive wdg-table">
            <table class="table mb-0" id="tabelaAtas">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Título</th>
                  <th>Presidente</th>
                  <th>Deliberações</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="table-pagination table-pagination-hidden" id="pagerAtas"></div>
        </div>
      </section>

      <section class="tab-pane fade" id="pane-engajamento" role="tabpanel" aria-labelledby="tab-engajamento">
        <div class="wdg-asm-panel mb-4">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
            <div>
              <h2 class="h4 mb-1">Enquetes aos moradores</h2>
              <small class="text-muted">Colete opiniões antes da votação oficial ou acompanhe execuções pós-ata.</small>
            </div>
            <button class="btn btn-primary btn-sm" data-action="nova-enquete"><i class="bi bi-bar-chart-line me-1"></i>Publicar enquete</button>
          </div>
          <form class="row g-3 wdg-asm-form" id="formEnquete">
            <div class="col-md-5">
              <label class="form-label" for="enquetePergunta">Pergunta</label>
              <input type="text" class="form-control" id="enquetePergunta" placeholder="Quais horários preferem para a assembleia?">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="enqueteAlvo">Segmento</label>
              <select class="form-select" id="enqueteAlvo">
                <option value="todos">Todos os moradores</option>
                <option value="blocoA">Bloco A</option>
                <option value="garden">Garden</option>
                <option value="coberturas">Coberturas</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="enqueteExpira">Expira em</label>
              <input type="date" class="form-control" id="enqueteExpira">
            </div>
            <div class="col-12">
              <label class="form-label" for="enqueteOpcoes">Opções (uma por linha)</label>
              <textarea class="form-control" id="enqueteOpcoes" rows="3" placeholder="Manhã\nNoite\nFim de semana"></textarea>
            </div>
          </form>
        </div>
        <div class="wdg-asm-panel">
          <div class="row g-3">
            <div class="col-lg-6">
              <h3 class="h5">Enquetes ativas</h3>
              <div id="listaEnquetes" class="d-flex flex-column gap-3"></div>
            </div>
            <div class="col-lg-6">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="h5 mb-0">Comunicados e follow-up</h3>
                <button class="btn btn-outline-secondary btn-sm" data-action="novo-comunicado"><i class="bi bi-megaphone me-1"></i>Novo comunicado</button>
              </div>
              <div id="listaComunicados" class="d-flex flex-column gap-3"></div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _bp %>/js/condominios/assembleiais.js?v=1"></script>
</body>
</html>
