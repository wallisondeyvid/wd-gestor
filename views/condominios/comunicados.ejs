<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Comunicados - WDGestor</title>
  <% const _bp = (typeof basePath === 'string' && basePath) ? basePath : '/condominios'; %>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="shortcut icon" type="image/png" href="<%= _bp %>/images/logoWDGestor.png?v=4">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _bp }) %>
  <style>
    body.wdg-comunicados{background:#f5f7fb;}
    .wdg-com-hero{background:radial-gradient(1200px 800px at 10% 10%, rgba(99,102,241,.35), transparent 60%),
                 radial-gradient(900px 700px at 90% 20%, rgba(16,185,129,.25), transparent 55%),
                 linear-gradient(135deg,#0f172a,#111827);color:#fff;border-radius:28px;padding:2.2rem 2.6rem;margin-bottom:1.8rem;box-shadow:0 35px 90px rgba(15,23,42,.30);position:relative;overflow:hidden;}
    .wdg-com-hero h1{font-weight:800;letter-spacing:-.02em;font-size:2.05rem;margin:0 0 .35rem;}
    .wdg-com-hero p{margin:0;max-width:860px;color:rgba(255,255,255,.86);}
    .wdg-com-hero .wdg-com-chip{display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:.4rem .75rem;font-weight:700;font-size:.82rem;margin-top:1rem;}

    .wdg-com-panel{background:#fff;border-radius:26px;padding:1.7rem 2.1rem;box-shadow:0 28px 90px rgba(15,23,42,.12);margin-bottom:1.6rem;border:1px solid rgba(15,23,42,.08);} 
    .wdg-com-panel h2{font-size:1.05rem;font-weight:800;letter-spacing:-.01em;margin:0;}
    .wdg-com-sub{color:#64748b;font-weight:600;font-size:.92rem;margin-top:.35rem;}

    .wdg-com-form-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:1.1rem;}
    @media(max-width: 992px){ .wdg-com-form-grid{grid-template-columns:1fr;} }
    .wdg-com-card{background:#f8fafc;border:1px solid rgba(15,23,42,.08);border-radius:22px;padding:1.25rem 1.35rem;}
    .wdg-com-card-title{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.6rem;}
    .wdg-com-section-label{font-size:.74rem;text-transform:uppercase;letter-spacing:.18em;color:#64748b;font-weight:800;}

    .wdg-com-ico{width:36px;height:36px;object-fit:contain;vertical-align:middle;}
    .wdg-com-icon-btn{border:0;background:transparent;padding:.35rem;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;line-height:1;}
    .wdg-com-icon-btn:hover{background:#f1f5f9;}
    .wdg-com-icon-btn:disabled{opacity:.35;pointer-events:none;}
    .wdg-com-icon-btn img{width:36px;height:36px;object-fit:contain;display:block;}

    .wdg-com-photo-preview{margin-top:.45rem;}
    .wdg-com-photo-preview img{display:block;max-width:100%;max-height:220px;object-fit:cover;border-radius:16px;border:1px solid rgba(15,23,42,.08);background:#fff;}

    /* Reuso do picker visual (mesmo do Enquetes) */
    .wdg-enq-picker{position:relative;}
    .wdg-enq-picker-box{min-height:42px;display:flex;align-items:center;flex-wrap:wrap;gap:.45rem;padding:.5rem .65rem;border-radius:.5rem;border:1px solid #dee2e6;background:#fff;cursor:text;}
    .wdg-enq-picker-box:focus{outline:none;box-shadow:0 0 0 .25rem rgba(13,110,253,.12);border-color:rgba(13,110,253,.35);}
    .wdg-enq-token{display:inline-flex;align-items:center;gap:.4rem;border-radius:999px;border:1px solid rgba(15,23,42,.10);background:#f1f5f9;color:#0f172a;padding:.22rem .55rem;font-weight:800;font-size:.82rem;}
    .wdg-enq-token button{border:0;background:transparent;padding:0;margin:0;line-height:1;color:#64748b;font-weight:900;}
    .wdg-enq-token button:hover{color:#0f172a;}
    .wdg-enq-picker-input{border:0;outline:none;flex:1;min-width:180px;font-weight:600;font-size:.92rem;background:transparent;}
    .wdg-enq-picker-placeholder{color:#94a3b8;font-weight:600;font-size:.92rem;user-select:none;}
    .wdg-enq-picker-menu{position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:60;background:#fff;border:1px solid rgba(15,23,42,.12);border-radius:16px;box-shadow:0 18px 60px rgba(15,23,42,.18);max-height:280px;overflow:auto;padding:.35rem;}
    .wdg-enq-picker-item{display:flex;align-items:center;justify-content:flex-start;gap:.8rem;width:100%;text-align:left;border:0;background:transparent;border-radius:12px;padding:.55rem .7rem;font-weight:600;color:#0f172a;}
    .wdg-enq-picker-item:hover{background:#f8fafc;}
    .wdg-enq-picker-item small{color:#64748b;font-weight:700;}

    .wdg-pick-avatar{
      width:34px;
      height:34px;
      border-radius:999px;
      background:#e9ecef;
      color:#495057;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      flex:0 0 34px;
      font-weight:700;
      font-size:12px;
      overflow:hidden;
    }
    .wdg-pick-avatar img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }
    .wdg-pick-lines{
      display:flex;
      flex-direction:column;
      min-width:0;
      line-height:1.2;
    }
    .wdg-pick-name{
      font-weight:600;
      color:#212529;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .wdg-pick-hab{
      font-size:12px;
      color:#6c757d;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .wdg-com-actions{display:flex;gap:.8rem;justify-content:flex-end;flex-wrap:wrap;margin-top:1.1rem;}
    .wdg-com-actions .btn{border-radius:14px;font-weight:600;}

    .wdg-com-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.05rem;}
    @media(max-width: 1200px){ .wdg-com-list{grid-template-columns:repeat(2,minmax(0,1fr));} }
    @media(max-width: 768px){ .wdg-com-list{grid-template-columns:1fr;} }
    .wdg-com-item{background:#fff;border-radius:22px;border:1px solid rgba(15,23,42,.08);box-shadow:0 20px 60px rgba(15,23,42,.10);padding:1rem 1.05rem;display:flex;flex-direction:column;height:230px;}
    .wdg-com-top{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem;min-height:34px;}
    .wdg-com-badge{display:inline-flex;align-items:center;gap:.4rem;border-radius:999px;padding:.28rem .65rem;font-size:.78rem;font-weight:500;border:1px solid rgba(15,23,42,.10);white-space:nowrap;max-width:100%;min-width:0;overflow:hidden;text-overflow:ellipsis;}
    .wdg-com-badge--ativa{background:#dcfce7;color:#166534;border-color:rgba(22,101,52,.18);} 
    .wdg-com-badge--agendada{background:#dbeafe;color:#1e40af;border-color:rgba(30,64,175,.18);} 
    .wdg-com-badge--encerrada{background:#e2e8f0;color:#0f172a;border-color:rgba(15,23,42,.18);} 
    .wdg-com-mid{flex:1;display:flex;flex-direction:column;gap:.55rem;justify-content:center;padding:.25rem 0;min-width:0;}
    .wdg-com-msg{font-weight:900;color:#0f172a;letter-spacing:-.01em;line-height:1.25;max-width:100%;}
    .wdg-com-subject{display:block;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;overflow-wrap:normal !important;word-break:normal !important;}
    .wdg-com-msg small{display:block;color:#64748b;font-weight:700;margin-top:.25rem;}
    .wdg-com-thumb{width:100%;height:86px;border-radius:16px;overflow:hidden;border:1px solid rgba(15,23,42,.10);background:#fff;}
    .wdg-com-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
    .wdg-com-toolbar{display:flex;gap:.35rem;flex-wrap:wrap;margin-top:auto;justify-content:center;}
    .wdg-com-tool{display:inline-flex;align-items:center;justify-content:center;border-radius:14px;border:0;padding:.35rem;background:transparent;line-height:1;}
    .wdg-com-tool:hover{background:#f1f5f9;}
    .wdg-com-tool img{width:42px;height:42px;object-fit:contain;display:block;}

    .wdg-empty{padding:1.8rem;border:1px dashed rgba(15,23,42,.2);border-radius:20px;text-align:center;color:#94a3b8;font-weight:600;background:#fff;}
    .wdg-com-pager{display:flex;align-items:center;justify-content:center;gap:.45rem;flex-wrap:wrap;margin-top:1.1rem;}
    .wdg-com-page{border-radius:12px;border:1px solid rgba(15,23,42,.10);background:#fff;padding:.4rem .7rem;font-weight:900;color:#0f172a;min-width:42px;}
    .wdg-com-page:hover{background:#f8fafc;}
    .wdg-com-page[disabled]{opacity:.45;pointer-events:none;}
    .wdg-com-page.is-active{background:#0f172a;color:#fff;border-color:#0f172a;}

    @media(max-width:768px){
      .wdg-com-hero{padding:1.55rem;}
      .wdg-com-panel{padding:1.25rem;}
    }
  </style>
</head>
<body class="wdg-layout wdg-comunicados" data-base-path="<%= _bp %>" data-user-unit="<%= user && user.unidade_id ? (user.unidade_id._id || user.unidade_id || user.unidadeId || '') : '' %>" data-scope-all="<%= (user && (user.isMaster || user.role === 'master' || user.role === 'admin')) ? 'true' : 'false' %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>
  <%- include('../shared/partials/navbar-shared', {
        moduleBasePath: _bp,
        moduleLabel: 'Gestão de Condomínios',
        user,
        menuLabel: 'Menu',
        prefixMenuPaths: true,
        menuTree: [
          { label: 'Estruturar condomínio', children: [
            { label: 'Habitações', path: '/estruturar/habitacoes' },
            { label: 'Garagem', path: '/estruturar/garagem' },
            { label: 'Áreas comuns', path: '/estruturar/areas-comuns' }
          ]},
          { label: 'Cadastros', children: [
            { label: 'Proprietários', path: '/cadastros/proprietarios' },
            { label: 'Moradores', path: '/cadastros/moradores' },
            { label: 'Materiais', path: '/cadastros/materiais' }
          ]},
          { label: 'Editar', children: [
            { label: 'Editar habitações', path: '/editar/habitacoes' },
            { label: 'Editar áreas comuns', path: '/editar/areas-comuns' }
          ]},
          { label: 'Operação', children: [
            { label: 'Painel de habitações', path: '/operacao/painel-habitacoes' },
            { label: 'Painel de áreas comuns', path: '/operacao/painel-areas-comuns' }
          ]},
          { label: 'Administração', children: [
            { label: 'Assembleias', path: '/administracao/assembleias' },
            { label: 'Atas', path: '/administracao/atas' },
            { label: 'Financeiro', path: '/administracao/financeiro' },
            { label: 'Configurações', path: '/administracao/configuracoes' }
          ]},
          { label: 'Serviços', children: [
            { label: 'Solicitar Serviços', path: '/servicos/solicitar' }
          ]},
          { label: 'Configurações', children: [
            { label: 'Usuários', path: '/configuracoes/usuarios' }
          ]}
        ]
      }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _bp, moduleLabel: 'Gestão de Condomínios', user }) %>

  <main class="container py-4" id="comunicadosApp" data-base-path="<%= _bp %>">
    <section class="wdg-com-hero">
      <h1>Comunicados</h1>
      <p>Publique avisos oficiais com vigência, foto e restrições de público. Os comunicados aparecem no mural do Portal do Morador e podem gerar notificação automática.</p>
      <div class="wdg-com-chip"><i class="bi bi-megaphone" aria-hidden="true"></i><span>Administração · Comunicados</span></div>
    </section>

    <section class="wdg-com-panel" aria-label="Formulário de comunicado">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
          <h2>Novo comunicado</h2>
          
        </div>
        <div class="text-end">
          <div class="wdg-com-section-label">Comunicados cadastrados</div>
          <div class="display-6" style="font-size:2rem;font-weight:900;color:#0f172a;margin:0;" data-com-count>0</div>
        </div>
      </div>

      <form id="comForm" autocomplete="off">
        <input type="hidden" id="comId" value="">
        <input type="hidden" id="comFotoUrl" value="">

        <div class="wdg-com-form-grid">
          <div class="wdg-com-card">
            <div class="wdg-com-card-title">
              <div>
                <div class="wdg-com-section-label">Conteúdo</div>
              </div>
              
            </div>

            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="comUnidadeSelect">Condomínio</label>
                <select class="form-select" id="comUnidadeSelect"></select>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold" for="comVigInicio">Início</label>
                <input class="form-control" type="date" id="comVigInicio" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold" for="comVigFim">Fim</label>
                <input class="form-control" type="date" id="comVigFim" required>
              </div>
              <div class="col-12">
                <label class="form-label fw-bold" for="comAssunto">Assunto</label>
                <input class="form-control" type="text" id="comAssunto" maxlength="140">
              </div>
              <div class="col-12">
                <label class="form-label fw-bold" for="comMensagem">Mensagem</label>
                <textarea class="form-control" id="comMensagem" rows="6" required></textarea>
              </div>
              <div class="col-12">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <label class="form-label fw-bold" for="comFoto" style="margin:0">Foto do comunicado (opcional)</label>
                  <button class="wdg-com-icon-btn" type="button" id="comFotoToggle" title="Adicionar imagem" aria-label="Adicionar imagem">
                    <img class="wdg-com-ico" src="<%= _bp %>/images/foto.png" alt="">
                  </button>
                </div>
                <div id="comFotoWrap" hidden>
                  <input class="form-control mt-2" type="file" id="comFoto" accept="image/png,image/jpeg,image/webp" />
                  <div class="form-text">PNG/JPG/WebP (até ~2MB).</div>
                  <div class="wdg-com-photo-preview" id="comFotoPreviewWrap" hidden>
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                      <div class="wdg-com-section-label" style="margin:0">Pré-visualização</div>
                      <button class="wdg-com-icon-btn" type="button" id="comFotoRemover" title="Remover foto" aria-label="Remover foto">
                        <img class="wdg-com-ico" src="<%= _bp %>/images/remover.png" alt="">
                      </button>
                    </div>
                    <img id="comFotoPreview" alt="" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="wdg-com-card">
            <div class="wdg-com-card-title">
              <div>
                <div class="wdg-com-section-label">Restrições</div>
                
              </div>
            </div>

            <div class="row g-3">
              <div class="col-12">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="rNaoExibirDesabitadas">
                  <label class="form-check-label fw-semibold" for="rNaoExibirDesabitadas">Não exibir para habitações desabitadas</label>
                </div>
              </div>
              <div class="col-12">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="rApenasResponsavel">
                  <label class="form-check-label fw-semibold" for="rApenasResponsavel">Exibir apenas responsável da habitação</label>
                </div>
              </div>
              <div class="col-12">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="rApenasProprietario">
                  <label class="form-check-label fw-semibold" for="rApenasProprietario">Exibir apenas proprietário</label>
                </div>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold" for="rExcluirHabitacoes">Não exibir para habitações</label>
                <div class="wdg-enq-picker" data-enq-picker="habitacoes">
                  <div class="wdg-enq-picker-box" tabindex="0" data-enq-picker-box>
                    <div data-enq-picker-tokens></div>
                    <input class="wdg-enq-picker-input" type="text" data-enq-picker-input placeholder="" autocomplete="off" />
                    <div class="wdg-enq-picker-placeholder" data-enq-picker-placeholder hidden></div>
                  </div>
                  <div class="wdg-enq-picker-menu" data-enq-picker-menu hidden></div>
                  <textarea class="form-control" id="rExcluirHabitacoes" rows="2" hidden></textarea>
                </div>
              </div>
              <div class="col-12">
                <label class="form-label fw-bold" for="rExcluirMoradores">Não exibir para moradores</label>
                <div class="wdg-enq-picker" data-enq-picker="moradores">
                  <div class="wdg-enq-picker-box" tabindex="0" data-enq-picker-box>
                    <div data-enq-picker-tokens></div>
                    <input class="wdg-enq-picker-input" type="text" data-enq-picker-input placeholder="" autocomplete="off" />
                    <div class="wdg-enq-picker-placeholder" data-enq-picker-placeholder hidden></div>
                  </div>
                  <div class="wdg-enq-picker-menu" data-enq-picker-menu hidden></div>
                  <textarea class="form-control" id="rExcluirMoradores" rows="2" hidden></textarea>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="wdg-com-actions">
          <button type="button" class="btn btn-outline-secondary" id="btnComLimpar">Limpar</button>
          <button type="submit" class="btn btn-primary" id="btnComEnviar">Enviar comunicado</button>
        </div>
      </form>
    </section>

    <section class="wdg-com-panel" aria-label="Lista de comunicados">
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <div>
          <h2>Comunicados cadastrados</h2>
          
        </div>
      </div>

      <div id="comList" class="wdg-com-list" hidden></div>
      <div id="comEmpty" class="wdg-empty">Nenhum comunicado cadastrado ainda.</div>
      <div id="comPager" class="wdg-com-pager" hidden aria-label="Paginação"></div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _bp %>/js/condominios/comunicados.js?v=<%= (typeof assetVersion !== 'undefined' && assetVersion) ? assetVersion : Date.now() %>"></script>
</body>
</html>
