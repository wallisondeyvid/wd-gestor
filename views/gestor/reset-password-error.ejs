<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <% /* Template compartilhado Reset Password Error.
         Parâmetros: moduleLabel, basePath, title, message, showRetry */ %>
    <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
    <% const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
    <%- include('partials/basepath-var') %>
    <title><%= title %> - <%= _moduleLabel %></title>
    <%- include('partials/favicon') %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        body {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .error-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            padding: 40px;
            max-width: 500px;
            width: 100%;
            margin: 20px;
            text-align: center;
        }

        .logo-section {
            margin-bottom: 30px;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #dc3545;
            margin-bottom: 10px;
        }

        .error-icon {
            font-size: 64px;
            color: #dc3545;
            margin-bottom: 20px;
        }

        .message {
            font-size: 18px;
            color: #495057;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .btn-primary {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
            color: white;
        }

        .btn-outline-primary {
            border: 2px solid #007bff;
            color: #007bff;
            background: transparent;
            padding: 10px 25px;
            border-radius: 25px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-outline-primary:hover {
            background: #007bff;
            color: white;
            transform: translateY(-2px);
        }

        .additional-info {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #dc3545;
        }

        .additional-info h6 {
            color: #495057;
            margin-bottom: 10px;
        }

        .additional-info p {
            color: #6c757d;
            margin: 0;
            font-size: 14px;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="logo-section">
            <div class="logo"><%= _moduleLabel %></div>
        </div>

        <div class="error-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h2 class="mb-3"><%= title %></h2>

        <div class="message">
            <%= message %>
        </div>

        <% if (showRetry) { %>
        <div class="additional-info">
            <h6><i class="bi bi-info-circle me-2"></i>Precisa de ajuda?</h6>
            <p>Se você não recebeu o email ou o link expirou, solicite uma nova redefinição de senha.</p>
        </div>
        <% } %>

        <div class="action-buttons mt-4">
            <% if (showRetry) { %>
            <a href="<%= _basePath %>/esquecisenha" class="btn btn-outline-primary">
                <i class="bi bi-arrow-repeat me-2"></i>Tentar Novamente
            </a>
            <% } %>
            <a href="<%= _basePath %>/login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-2"></i>Voltar ao Login
            </a>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>