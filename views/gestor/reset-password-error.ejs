<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <% /* Template compartilhado Reset Password Error.
         Parâmetros: moduleLabel, basePath, title, message, showRetry */ %>
        <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
        <% const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
        <% const _moduleSegment = _basePath.replace(/^\/+/, '').split('/')[0] || 'gestor'; %>
        <% const _moduleBadgeMap = { gestor: 'Gestor', condominios: 'Gestão de Condomínio', escalas: 'Escalas', 'portal-morador': 'Portal do Morador', clinica: 'Clínica' }; %>
        <% const _normalizedModuleLabel = String(_moduleLabel || '').trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); %>
        <% const _resolvedModuleName = _moduleBadgeMap[_moduleSegment]
            || (_normalizedModuleLabel === 'wdgestor' || _normalizedModuleLabel === 'gestor' ? 'Gestor' : '')
            || (_normalizedModuleLabel.includes('condominio') ? 'Gestão de Condomínio' : '')
            || (_normalizedModuleLabel.includes('escala') ? 'Escalas' : '')
            || (_normalizedModuleLabel.includes('portal do morador') ? 'Portal do Morador' : '')
            || (_normalizedModuleLabel.includes('clinica') ? 'Clínica' : '')
            || _moduleLabel
            || (_moduleSegment.charAt(0).toUpperCase() + _moduleSegment.slice(1)); %>
        <% const _badgeLabel = 'Módulo ' + _resolvedModuleName; %>
    <%- include('partials/basepath-var') %>
    <title><%= title %> - <%= _moduleLabel %></title>
    <%- include('partials/favicon') %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="<%= _basePath %>/css/login.css?v=<%= Date.now() %>">
</head>
<body class="login-bg">
    <main class="min-vh-100 d-flex align-items-center justify-content-center px-3 py-4">
    <div class="login-card auth-card-shell card shadow-lg border-0">
      <div class="card-body p-4 p-sm-5 text-center">
        <div class="mb-4">
            <img src="<%= _basePath %>/images/logoWDGestor.png" alt="<%= _moduleLabel %>" class="brand-logo mb-2" />
            <span class="auth-eyebrow"><i class="bi bi-exclamation-triangle"></i><%= _badgeLabel %></span>
            <h1 class="auth-card-title"><%= title %></h1>
            <p class="auth-subtitle mb-0">Link inválido ou expirado. Solicite uma nova redefinição de senha para continuar.</p>
        </div>

        <div class="mb-3">
            <span class="auth-status-icon is-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            </span>
        </div>

        <div class="message auth-subtitle fs-6 mb-4">
            <%= message %>
        </div>

        <% if (showRetry) { %>
        <div class="auth-info-box text-start">
            <h6><i class="bi bi-info-circle me-2"></i>Precisa de ajuda?</h6>
            <p>Solicite uma nova redefinição de senha e utilize o link mais recente recebido.</p>
        </div>
        <% } %>

        <div class="auth-actions mt-4">
            <% if (showRetry) { %>
            <a href="<%= _basePath %>/esquecisenha" class="btn btn-outline-primary">
                <i class="bi bi-arrow-repeat me-2"></i>Tentar Novamente
            </a>
            <% } %>
            <a href="<%= _basePath %>/login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-2"></i>Voltar ao Login
            </a>
        </div>
      </div>
    </div>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>