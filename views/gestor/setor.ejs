<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _basePath = (typeof basePath === 'string' && basePath) ? basePath : (typeof moduleBasePath === 'string' && moduleBasePath) ? moduleBasePath : '/gestor'; %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Setores - WDGestor</title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap / Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
  <!-- Estilos centrais Gestor -->
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _basePath }) %>
  <!-- Tema moderno (paridade com Condomínios) -->
  <link rel="stylesheet" href="/condominios/css/condominios-modern.css?v=1"/>
  <!-- Botões por ícone padronizados -->
  <link rel="stylesheet" href="<%= _basePath %>/css/icon-buttons.css?v=1"/>
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>

  <style>
    /* Ajustes específicos desta página */
    .wdg-setores-table .table th,
    .wdg-setores-table .table td{
      vertical-align: middle;
      text-align: center;
    }
    .wdg-setores-table table { table-layout: fixed; min-width: 1240px; }
    .wdg-setores-table .col-unid { width: 360px; }
    .wdg-setores-table .col-nome { width: 200px; }
    .wdg-setores-table .col-desc { width: 520px; }
    .wdg-setores-table .col-acoes{ width: 160px; }
    /* Wrapper para evitar sobreposição e aplicar ellipsis ocupando 100% da célula */
    .wdg-setores-table .cell-clip{ display:block; width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .wdg-setores-table .badge.text-bg-secondary { font-weight:500; }
  @media (max-width: 992px){ }
    .gestor-divider{ height:2px; width:300px; margin:6px auto 18px; background:#0d6efd; border-radius:2px; }
    /* Linhas sempre brancas */
    .wdg-setores-table tbody tr td{ background:#ffffff !important; }
    .wdg-setores-table tbody tr:hover td{ background:#f5f9ff !important; }
  </style>
</head>
<body class="wdg-layout">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>
  <%- include('../shared/partials/navbar-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user, prefixMenuPaths: false }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>

  <div class="wdg-page">
    <!-- Toasts -->
    <div aria-live="polite" aria-atomic="true" class="position-relative">
      <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080"></div>
    </div>
  <!-- Título (padrão unidades) -->
  <h4 class="mb-3 text-center page-main-title">Gerenciar Setores</h4>
  <div class="gestor-divider"></div>

    <!-- Card do formulário -->
    <div class="wdg-card content wdg-card-hover">
      <div class="wdg-card-body wdg-form wdg-tight">
  <form id="formSetor" action="<%= _basePath %>/api/setores" method="POST" class="row gy-3 wdg-form auto-colon">
          <input type="hidden" id="setor_edit_id" name="setor_edit_id" value=""/>

          <div class="col-12 col-lg-4">
            <label for="unidade_id" class="form-label">Unidade</label>
            <select class="form-select" id="unidade_id" name="unidade_id" required>
              <option value="">Selecione...</option>
              <% (unidadesFiltradas || []).forEach(function(unidade){ %>
                <option value="<%= unidade.id || unidade._id %>">
                  <%= (unidade.codigo && unidade.nome) ? unidade.codigo + ' - ' + unidade.nome : (unidade.nome || unidade.codigo || (unidade.id || unidade._id)) %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="col-12 col-lg-4">
            <label for="nome" class="form-label">Nome do Setor</label>
            <input type="text" class="form-control" id="nome" name="nome" required placeholder="Ex.: Financeiro, RH, Compras..."/>
          </div>

          <div class="col-12">
            <label for="descricao" class="form-label">Descrição</label>
            <textarea class="form-control" id="descricao" name="descricao" rows="2" placeholder="Breve descrição (opcional)"></textarea>
          </div>

          <div class="col-12 d-flex justify-content-lg-end gap-2">
            <button type="button" id="btnCancelarEdicao" class="btn btn-outline-secondary d-none" title="Cancelar edição" aria-label="Cancelar edição">Cancelar</button>
            <button type="reset" id="btnResetForm" class="btn btn-outline-secondary" title="Limpar" aria-label="Limpar">Limpar</button>
            <button type="submit" class="btn btn-primary" id="btnSubmitSetor" data-mode="create" title="Cadastrar" aria-label="Cadastrar">Cadastrar</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Lista -->
    <h5 class="mb-1 text-center wdg-section-title" style="margin-top:18px">Setores cadastrados</h5>

    <!-- Controles da lista de setores -->
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
      <div class="d-flex align-items-center gap-2">
        <label for="sPageSize" class="form-label mb-0">Mostra</label>
        <select id="sPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="100">100</option>
          <option value="200">200</option>
          <option value="300">300</option>
          <option value="400">400</option>
          <option value="500">500</option>
          <option value="1000">1000</option>
        </select>
        <span class="ms-1">itens</span>
      </div>
    </div>

    <div class="wdg-card content wdg-card-hover wdg-table wdg-setores-table">
      <div id="wrapperTabelaSetores" class="table-responsive table-vert-max">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th class="col-unid">Unidade</th>
              <th class="col-nome">Nome</th>
              <th class="col-desc">Descrição</th>
              <th class="col-acoes">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% (setoresFiltrados || []).forEach(function(setor){ %>
              <tr>
                <td class="col-unid">
                  <% const unidadeTexto = (setor.unidade_nome) || (setor.unidade_id && (setor.unidade_id.nome || setor.unidade_id.codigo)); %>
                  <% if (unidadeTexto) { %>
                    <div class="cell-clip" title="<%= unidadeTexto %>"><%= unidadeTexto %></div>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td class="col-nome">
                  <div class="cell-clip" title="<%= setor.nome %>"><%= setor.nome %></div>
                </td>
                <td class="col-desc">
                  <% if (setor.descricao) { %>
                    <div class="cell-clip" title="<%= setor.descricao %>"><%= setor.descricao %></div>
                  <% } else { %>
                    <span class="badge rounded-pill text-bg-secondary" title="Sem descrição">Sem descrição</span>
                  <% } %>
                </td>
                <td class="col-acoes">
                  <div class="d-flex gap-1 justify-content-center flex-nowrap">
                    <button type="button" class="wdg-icon-btn" data-action="editar" data-id="<%= setor._id %>" title="Editar" aria-label="Editar">
                      <img src="<%= _basePath %>/images/editar.png" alt="Editar" onerror="this.outerHTML='&lt;i class=\'bi bi-pencil\'&gt;&lt;/i&gt;'" />
                    </button>
                    <button type="button" class="wdg-icon-btn" data-action="excluir" data-id="<%= setor._id %>" data-nome="<%= (setor.nome||'').replace(/'/g,'&#39;') %>" title="Excluir" aria-label="Excluir">
                      <img src="<%= _basePath %>/images/excluir.png" alt="Excluir" onerror="this.outerHTML='&lt;i class=\'bi bi-trash\'&gt;&lt;/i&gt;'" />
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
            <% if (!(setoresFiltrados && setoresFiltrados.length)) { %>
              <tr><td colspan="4" class="text-center text-muted">Nenhum setor cadastrado.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="sPaginas" class="wdg-pager mt-2"></div>
  </div>

  <script src="<%= _basePath %>/js/lib/fetchJson.js"></script>
  <script src="<%= _basePath %>/js/pages/setor.js"></script>
  <!-- (Removido) Script de injeção de __WD_UNIDADES -->

  <!-- Modal de confirmação de exclusão reutilizável -->
  <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Confirmar Exclusão</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p id="confirmDeleteMessage" class="mb-0">Tem certeza que deseja excluir este registro?</p>
          <small class="text-muted d-block mt-2">Esta ação não poderá ser desfeita.</small>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-outline-danger" id="btnConfirmDelete" data-id="">Excluir</button>
        </div>
      </div>
    </div>
  </div>

  <!-- (Removido) Modal de atribuição de unidade -->

  <!-- Script de perfil modular -->
  <script>window.__perfilBasePath='<%= _basePath %>';</script>
  <script src="<%= _basePath %>/js/perfil-modulo.js"></script>
</body>
<script>
document.addEventListener('DOMContentLoaded', function(){
  // Alterna botão Cadastrar/Salvar conforme modo edição
  (function(){
    const idField = document.getElementById('setor_edit_id');
    const btn = document.getElementById('btnSubmitSetor');
    const btnCancel = document.getElementById('btnCancelarEdicao');
    if(!idField || !btn) return;
    function update(){
      const editing = !!(idField.value && idField.value.trim());
      if(editing){
        btn.textContent='Salvar'; btn.title='Salvar'; btn.setAttribute('aria-label','Salvar');
        btn.classList.remove('btn-primary'); btn.classList.add('btn-outline-success');
        btn.dataset.mode='edit'; if(btnCancel) btnCancel.classList.remove('d-none');
      } else {
        btn.textContent='Cadastrar'; btn.title='Cadastrar'; btn.setAttribute('aria-label','Cadastrar');
        btn.classList.remove('btn-outline-success'); btn.classList.add('btn-primary');
        btn.dataset.mode='create'; if(btnCancel) btnCancel.classList.add('d-none');
      }
    }
    const mo = new MutationObserver(update); mo.observe(idField, { attributes:true, attributeFilter:['value'] });
    ['change','input'].forEach(ev=> idField.addEventListener(ev, update));
    update();
  })();
  // Paginação da tabela de Setores
  (function initSetoresPagination(){
    const tbody = document.querySelector('.wdg-setores-table tbody');
    const pager = document.getElementById('sPaginas');
    const pageSizeSel = document.getElementById('sPageSize');
    if (!tbody || !pager || !pageSizeSel) return;
    let allRows = Array.from(tbody.querySelectorAll('tr'));
    // Excluir linha de "Nenhum setor" da paginação se presente e controlar scroll-limit
    const emptyRow = allRows.find(tr => tr.querySelector('.text-muted'));
    const dataRows = emptyRow ? allRows.filter(tr => tr!==emptyRow) : allRows;
    const wrapper = document.getElementById('wrapperTabelaSetores');
    if (wrapper && dataRows.length > 4){ wrapper.classList.add('scroll-limit'); }
    allRows = dataRows;
    function getPageSize(){ const v=parseInt(pageSizeSel.value,10); return (!isNaN(v)&&v>0)? v : 50; }
    const state = { page: 0 };
    function mkBtn(label, go, dis){ const b=document.createElement('button'); b.type='button'; b.textContent=label; b.disabled=!!dis; b.addEventListener('click', ()=>{ state.page=go; render(); }); return b; }
    function buildPager(totalPages, totalItems){
      pager.innerHTML='';
      if (totalPages <= 1){
        const info=document.createElement('div'); info.className='w-100 text-center mt-1'; info.style.fontSize='.7rem'; info.textContent='Total: '+totalItems+' setor(es)'; pager.appendChild(info); return;
      }
      const win=5; let start=Math.max(0, state.page-Math.floor(win/2)); let end=Math.min(totalPages-1, start+win-1);
      pager.appendChild(mkBtn('<<',0,state.page===0)); pager.appendChild(mkBtn('<',state.page-1,state.page===0));
      if(start>0){ const b0=mkBtn('1',0,false); if(state.page===0) b0.classList.add('active'); pager.appendChild(b0); const dots=document.createElement('span'); dots.textContent='...'; dots.style.padding='0 .4rem'; pager.appendChild(dots); }
      for(let p=start;p<=end;p++){ const b=mkBtn(String(p+1),p,false); if(p===state.page) b.classList.add('active'); pager.appendChild(b); }
      if(end<totalPages-1){ const dots2=document.createElement('span'); dots2.textContent='...'; dots2.style.padding='0 .4rem'; pager.appendChild(dots2); const blast=mkBtn(String(totalPages), totalPages-1,false); if(state.page===totalPages-1) blast.classList.add('active'); pager.appendChild(blast); }
      pager.appendChild(mkBtn('>', state.page+1, state.page===totalPages-1)); pager.appendChild(mkBtn('>>', totalPages-1, state.page===totalPages-1));
      const info2=document.createElement('div'); info2.className='w-100 text-center mt-1'; info2.style.fontSize='.7rem'; info2.textContent='Total: '+totalItems+' setor(es)'; pager.appendChild(info2);
    }
    function render(){
      const size = getPageSize();
      const totalPages = Math.ceil(allRows.length / size) || 1;
      if (state.page < 0) state.page = 0; if (state.page >= totalPages) state.page = totalPages - 1;
      const start = state.page * size; const end = Math.min(allRows.length, start + size);
      allRows.forEach((tr, idx)=>{ tr.style.display = (idx>=start && idx<end) ? '' : 'none'; });
      buildPager(totalPages, allRows.length);
    }
    pageSizeSel.addEventListener('change', ()=>{ state.page=0; render(); });
    render();
  })();
});
</script>
</html>
<style>
/* Scroll limit e cabeçalho sticky — padrão Unidades */
#wrapperTabelaSetores.scroll-limit{ max-height:360px; overflow-y:auto; }
#wrapperTabelaSetores.scroll-limit thead th{ position:sticky; top:0; background:#f8f9fa; z-index:2; box-shadow:0 1px 0 rgba(0,0,0,.06); }
</style>