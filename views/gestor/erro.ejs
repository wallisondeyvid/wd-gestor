<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Erro - WDGestor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
  <%- include('../shared/partials/header-shared', { moduleBasePath: '/gestor', moduleLabel: 'Gestor', user }) %>
  <%- include('../shared/partials/navbar-shared', { moduleBasePath: '/gestor', moduleLabel: 'Gestor', user, prefixMenuPaths: false }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: '/gestor', moduleLabel: 'Gestor', user }) %>
  <div class="container mt-5">
    <div class="alert alert-danger text-center" role="alert">
      <h4 class="alert-heading">Erro!</h4>
      <p id="errorMessage"></p>
  <button class="btn btn-primary mt-3" onclick="window.location.href='/'">Voltar ao início</button>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const errorMessage = urlParams.get('message');
      if (errorMessage) {
        document.getElementById('errorMessage').textContent = decodeURIComponent(errorMessage);
      } else {
        document.getElementById('errorMessage').textContent = 'Ocorreu um erro desconhecido.';
      }
    });
  </script>
</body>
</html>