  <!-- Script de perfil modular -->
  <script>window.__perfilBasePath='/gestor';</script>
  <script src="<%= _basePath %>/js/perfil-modulo.js"></script>

  <!-- Utilitários necessários (gestor) -->
  <script src="/gestor/js/core/validators.js"></script>

  <!-- Scripts de submissão de formulário (gestor) -->
  <script src="<%= _basePath %>/js/pages/form-submit-unidade.js?v=<%= Date.now() %>"></script>

  <!-- Script principal da página (gestor) -->
  <script src="<%= _basePath %>/js/pages/unidades.js?v=<%= Date.now() %>"></script>
  <script>
    // Ajuste dinâmico botão cadastrar/salvar (modo edição vs criação)
    (function(){
      const form = document.getElementById('cadastroUnidadeForm');
      const idField = document.getElementById('unidadeId');
      const btn = document.getElementById('btnSubmitUnidade');
      if(form && idField && btn){
        const updateState = () => {
          const editing = !!(idField.value && idField.value.trim());
          if(editing){
            btn.textContent = 'Salvar';
            btn.title = 'Salvar alterações';
            btn.setAttribute('aria-label','Salvar alterações');
            btn.dataset.mode = 'edit';
            btn.classList.remove('btn-primary');
            btn.classList.add('btn-outline-success');
          } else {
            btn.textContent = 'Cadastrar';
            btn.title = 'Cadastrar';
            btn.setAttribute('aria-label','Cadastrar');
            btn.dataset.mode = 'create';
            btn.classList.remove('btn-outline-success');
            btn.classList.add('btn-primary');
          }
        };
        // Observa mudanças programáticas no hidden usando MutationObserver + eventos customizados
        const observer = new MutationObserver(updateState);
        observer.observe(idField, { attributes:true, attributeFilter:['value'] });
        ['change','input'].forEach(ev=> idField.addEventListener(ev, updateState));
        // Expor helper global para scripts externos atualizarem
        window.__unidadeUpdateSubmitState = updateState;
        updateState();
      }
    })();
    // Scroll limit: ativa se mais de 4 registros reais (exclui linha "Nenhuma")
    (function(){
      const wrapper = document.getElementById('wrapperTabelaUnidades');
      if(!wrapper) return;
      const rows = wrapper.querySelectorAll('#tabelaUnidades tbody tr');
      let count = 0;
      rows.forEach(r=>{ if(!r.querySelector('.text-muted')) count++; });
      if(count > 4){ wrapper.classList.add('scroll-limit'); }
    })();
  </script>
</body>
