<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <% /* Template compartilhado Esqueci Minha Senha.
    Parâmetros opcionais:
    - moduleLabel: Nome exibido do módulo (default 'WDGestor')
    - basePath: Prefixo de rota ('' para Gestor, '/escalas' para Escalas)
  */ %>
  <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
  <% // Garantir _basePath definido antes de qualquer uso (fallback /gestor)
    const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
  <% const _moduleSegment = _basePath.replace(/^\/+/, '').split('/')[0] || 'gestor'; %>
  <% const _moduleBadgeMap = { gestor: 'Gestor', condominios: 'Gestão de Condomínio', escalas: 'Escalas', 'portal-morador': 'Portal do Morador', clinica: 'Clínica' }; %>
  <% const _normalizedModuleLabel = String(_moduleLabel || '').trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); %>
  <% const _resolvedModuleName = _moduleBadgeMap[_moduleSegment]
    || (_normalizedModuleLabel === 'wdgestor' || _normalizedModuleLabel === 'gestor' ? 'Gestor' : '')
    || (_normalizedModuleLabel.includes('condominio') ? 'Gestão de Condomínio' : '')
    || (_normalizedModuleLabel.includes('escala') ? 'Escalas' : '')
    || (_normalizedModuleLabel.includes('portal do morador') ? 'Portal do Morador' : '')
    || (_normalizedModuleLabel.includes('clinica') ? 'Clínica' : '')
    || _moduleLabel
    || (_moduleSegment.charAt(0).toUpperCase() + _moduleSegment.slice(1)); %>
  <% const _badgeLabel = 'Módulo ' + _resolvedModuleName; %>
  <% const _solicitacaoRecebida = solicitacaoRecebida === true; %>
  <% const _recoveryMessage = typeof recoveryMessage === 'string' && recoveryMessage
    ? recoveryMessage
    : 'Se os dados informados corresponderem a um usuário cadastrado, enviaremos as instruções de recuperação.'; %>
  <% const _mensagemErro = typeof mensagemErro === 'string' && mensagemErro ? mensagemErro : null; %>
  <%- include('partials/basepath-var') %>
  <title>Esqueci minha senha - <%= _moduleLabel %></title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <!-- Seu CSS -->
  <link rel="stylesheet" href="<%= _basePath %>/css/login.css?v=<%= Date.now() %>" />
  <style>
    /* Fallback inline caso o CSS não carregue */
    .login-bg {
      background: linear-gradient(180deg, #4a90e2 0%, #63a4ff 35%, #8bb8ff 70%, #b3d1ff 100%) !important;
      min-height: 100vh !important;
    }
  </style>
</head>
<body class="login-bg">

  <main class="min-vh-100 d-flex align-items-center justify-content-center px-3">
    <div class="login-card auth-card-shell card shadow-lg border-0">
      <div class="card-body p-4 p-sm-5">

        <!-- Marca / título -->
        <div class="auth-brand text-center">
          <img src="<%= _basePath %>/images/logoWDGestor.png" alt="<%= _moduleLabel %>" class="brand-logo auth-brand-logo" />
          <span class="auth-eyebrow auth-brand-badge"><%= _badgeLabel %></span>
        </div>

        <% if (_mensagemErro) { %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i><%= _mensagemErro %>
          </div>
        <% } %>

        <!-- Botão de informação (popover) -->
        <div class="d-flex justify-content-end mb-3 <%= _solicitacaoRecebida ? 'd-none' : '' %>" id="recoveryHelpSection">
          <button type="button" id="infoCpfBtn" class="btn btn-sm btn-outline-info" data-bs-toggle="popover" data-bs-trigger="focus" data-bs-placement="bottom" title="Ajuda" data-bs-content="Informe seu CPF para solicitar a redefinição de senha. Se os dados informados corresponderem a um usuário cadastrado, enviaremos as instruções de recuperação.">
            <i class="bi bi-info-circle me-1"></i> Ajuda
          </button>
        </div>

        <section id="recoveryRequestSection" class="<%= _solicitacaoRecebida ? 'd-none' : '' %>">
          <form action="<%= _basePath %>/esquecisenha" method="POST" id="esqueciSenhaForm" class="auth-form" novalidate>
            <div class="mb-4">
              <label for="cpf" class="form-label fw-medium">
                <i class="bi bi-person-vcard me-2"></i>CPF
              </label>
              <input type="text" class="form-control form-control-lg" id="cpf" name="cpf" required
                     placeholder="000.000.000-00" maxlength="14" autocomplete="off" inputmode="numeric" aria-describedby="cpfHelp" autofocus>
              <div class="form-text" id="cpfHelp">Digite apenas os números. A formatação será aplicada automaticamente.</div>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg" data-loading-label="Enviando solicitação...">
                <i class="bi bi-envelope-arrow-up me-2"></i>Solicitar recuperação
              </button>
            </div>
          </form>

          <div class="auth-link-row">
            <a href="<%= _basePath %>/login" class="auth-link">
              <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
            </a>
          </div>
        </section>

        <section id="recoveryConfirmationSection" class="<%= _solicitacaoRecebida ? '' : 'd-none' %>" aria-live="polite">
          <div class="auth-panel-soft p-4 text-center">
            <div class="mb-3">
              <span class="auth-status-icon is-success">
                <i class="bi bi-check-circle fs-2"></i>
              </span>
            </div>
            <h2 class="h4 mb-3">Solicitação recebida</h2>
            <p class="text-muted mb-2" id="recoveryConfirmationMessage"><%= _recoveryMessage %></p>
            <p class="small text-muted mb-4">Verifique sua caixa de entrada e também a pasta de spam.</p>
            <div class="auth-actions">
              <a href="<%= _basePath %>/login" class="btn btn-primary">Voltar ao Login</a>
              <a href="<%= _basePath %>/esquecisenha" class="btn btn-outline-secondary" id="recoveryNewRequestLink">Fazer nova solicitação</a>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _basePath %>/js/pages/esquecisenha.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('infoCpfBtn');
      if (btn) { new bootstrap.Popover(btn); }
    });
  </script>
</body>
</html>