<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <% /* Template compartilhado Esqueci Minha Senha.
    Parâmetros opcionais:
    - moduleLabel: Nome exibido do módulo (default 'WDGestor')
    - basePath: Prefixo de rota ('' para Gestor, '/escalas' para Escalas)
  */ %>
  <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
  <% // Garantir _basePath definido antes de qualquer uso (fallback /gestor)
    const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
  <%- include('partials/basepath-var') %>
  <title>Esqueci Minha Senha - <%= _moduleLabel %></title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <!-- Seu CSS -->
  <link rel="stylesheet" href="<%= _basePath %>/css/login.css?v=<%= Date.now() %>" />
  <style>
    /* Fallback inline caso o CSS não carregue */
    .login-bg {
      background: linear-gradient(180deg, #4a90e2 0%, #63a4ff 35%, #8bb8ff 70%, #b3d1ff 100%) !important;
      min-height: 100vh !important;
    }
  </style>
</head>
<body class="login-bg">

  <main class="min-vh-100 d-flex align-items-center justify-content-center px-3">
    <div class="login-card card shadow-lg border-0">
      <div class="card-body p-4 p-sm-5">

        <!-- Marca / título -->
        <div class="text-center mb-4">
          <img src="<%= _basePath %>/images/logoWDGestor.png" alt="<%= _moduleLabel %>" class="brand-logo mb-2" />
          <p class="text-muted m-0">Esqueci Minha Senha - <%= _moduleLabel %></p>
        </div>

        <!-- Botão de informação (popover) -->
        <div class="d-flex justify-content-end mb-3">
          <button type="button" id="infoCpfBtn" class="btn btn-sm btn-outline-info" data-bs-toggle="popover" data-bs-trigger="focus" data-bs-placement="bottom" title="Ajuda" data-bs-content="Informe seu CPF para solicitar a redefinição de senha. Se os dados informados corresponderem a um usuário cadastrado, enviaremos as instruções de recuperação.">
            <i class="bi bi-info-circle me-1"></i> Ajuda
          </button>
        </div>

        <!-- Formulário para solicitar senha -->
  <form action="<%= _basePath %>/esquecisenha" method="POST" id="esqueciSenhaForm">
          <div class="mb-4">
            <label for="cpf" class="form-label fw-medium">
              <i class="bi bi-person-vcard me-2"></i>CPF
            </label>
            <input type="text" class="form-control form-control-lg" id="cpf" name="cpf" required
                   placeholder="000.000.000-00" maxlength="14">
            <div class="form-text">Digite apenas números, pontos e traço serão adicionados automaticamente.</div>
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg">
              <i class="bi bi-envelope-arrow-up me-2"></i>Solicitar Alteração de Senha
            </button>
          </div>
        </form>

        <!-- Links de navegação -->
        <div class="text-center mt-4">
          <a href="<%= _basePath %>/login" class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
          </a>
        </div>

      </div>
    </div>
  </main>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _basePath %>/js/pages/esquecisenha.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('infoCpfBtn');
      if (btn) { new bootstrap.Popover(btn); }
    });
  </script>
</body>
</html>