<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <% /* Template compartilhado Reset Password.
                Parâmetros: moduleLabel, basePath, token, userName */ %>
            <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
            <% const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
            <%- include('partials/basepath-var') %>
        <title>Definir nova senha - <%= _moduleLabel %></title>
    <%- include('partials/favicon') %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="<%= _basePath %>/css/login.css?v=<%= Date.now() %>">
</head>
<body class="login-bg">
    <main class="min-vh-100 d-flex align-items-center justify-content-center px-3 py-4">
    <div class="login-card auth-card-shell card shadow-lg border-0">
      <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
            <img src="<%= _basePath %>/images/logoWDGestor.png" alt="<%= _moduleLabel %>" class="brand-logo mb-2" />
            <span class="auth-eyebrow"><i class="bi bi-key"></i>Módulo Gestor</span>
            <h1 class="auth-card-title">Definir nova senha</h1>
            <p class="auth-subtitle mb-0">Crie uma nova senha para concluir a recuperação de acesso.</p>
        </div>

        <div class="alert alert-info auth-panel-soft" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            Olá <strong><%= userName %></strong>, defina sua nova senha abaixo.
        </div>

    <form id="resetPasswordForm" class="auth-form" method="POST" action="<%= _basePath %>/reset-password">
            <input type="hidden" name="token" value="<%= token %>">

            <div class="form-floating">
                <input type="password" class="form-control" id="senha" name="senha"
                       placeholder="Nova senha" required minlength="6" autocomplete="new-password" autofocus>
                <label for="senha">
                    <i class="bi bi-lock me-2"></i>Nova senha
                </label>
                <div id="passwordStrength" class="password-strength"></div>
            </div>

            <div class="form-floating">
                <input type="password" class="form-control" id="confirmarSenha" name="confirmarSenha"
                       placeholder="Confirmar senha" required minlength="6" autocomplete="new-password">
                <label for="confirmarSenha">
                    <i class="bi bi-lock-fill me-2"></i>Confirmar senha
                </label>
            </div>

            <div class="auth-info-box requirements">
                <h6><i class="bi bi-shield-check me-2"></i>Requisitos da senha:</h6>
                <ul>
                    <li id="req-length" class="invalid">Mínimo 6 caracteres</li>
                    <li id="req-match" class="invalid">Senhas coincidem</li>
                </ul>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" data-loading-label="Salvando nova senha..." disabled>
                    <i class="bi bi-check-circle me-2"></i>Salvar nova senha
                </button>
            </div>
        </form>

     <div class="auth-link-row">
         <a href="<%= _basePath %>/login" class="auth-link">
                <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
            </a>
        </div>
      </div>
    </div>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const senhaInput = document.getElementById('senha');
            const confirmarSenhaInput = document.getElementById('confirmarSenha');
            const passwordStrength = document.getElementById('passwordStrength');
            const submitBtn = document.getElementById('submitBtn');
            const reqLength = document.getElementById('req-length');
            const reqMatch = document.getElementById('req-match');
            const originalBtnHtml = submitBtn.innerHTML;

            function validatePassword() {
                const senha = senhaInput.value;
                const confirmar = confirmarSenhaInput.value;

                // Validar comprimento
                const isLengthValid = senha.length >= 6;
                reqLength.classList.toggle('invalid', !isLengthValid);

                // Validar coincidência
                const isMatchValid = senha === confirmar && senha.length > 0;
                reqMatch.classList.toggle('invalid', !isMatchValid);

                // Força da senha
                let strength = '';
                let strengthClass = '';

                if (senha.length === 0) {
                    strength = '';
                    strengthClass = '';
                } else if (senha.length < 6) {
                    strength = 'Fraca';
                    strengthClass = 'weak';
                } else if (senha.length < 8) {
                    strength = 'Média';
                    strengthClass = 'medium';
                } else {
                    strength = 'Forte';
                    strengthClass = 'strong';
                }

                passwordStrength.textContent = strength;
                passwordStrength.className = 'password-strength ' + strengthClass;

                // Habilitar/desabilitar botão
                const isValid = isLengthValid && isMatchValid;
                submitBtn.disabled = !isValid;

                return isValid;
            }

            senhaInput.addEventListener('input', validatePassword);
            confirmarSenhaInput.addEventListener('input', validatePassword);

            document.getElementById('resetPasswordForm').addEventListener('submit', function(event) {
                if (!validatePassword()) {
                    event.preventDefault();
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.setAttribute('aria-busy', 'true');
                submitBtn.innerHTML = '<span class="auth-submit-spinner"><i class="bi bi-hourglass-split"></i>Salvando nova senha...</span>';
            });

            // Validação inicial
            validatePassword();
        });
    </script>
</body>
</html>