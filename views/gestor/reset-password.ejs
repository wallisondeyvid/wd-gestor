<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <% /* Template compartilhado Reset Password.
                Parâmetros: moduleLabel, basePath, token, userName */ %>
            <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
            <% const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
            <%- include('partials/basepath-var') %>
        <title>Redefinir Senha - <%= _moduleLabel %></title>
    <%- include('partials/favicon') %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .reset-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            padding: 40px;
            max-width: 500px;
            width: 100%;
            margin: 20px;
        }

        .logo-section {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #007bff;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #6c757d;
            font-size: 16px;
        }

        .form-floating {
            margin-bottom: 20px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
        }

        .password-strength {
            margin-top: 5px;
            font-size: 12px;
        }

        .password-strength.weak {
            color: #dc3545;
        }

        .password-strength.medium {
            color: #ffc107;
        }

        .password-strength.strong {
            color: #28a745;
        }

        .requirements {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
        }

        .requirements h6 {
            color: #495057;
            margin-bottom: 10px;
        }

        .requirements ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .requirements li {
            font-size: 13px;
            color: #6c757d;
            margin-bottom: 5px;
        }

        .requirements li:before {
            content: "✓";
            color: #28a745;
            margin-right: 8px;
        }

        .requirements li.invalid:before {
            content: "✗";
            color: #dc3545;
        }
    </style>
</head>
<body>
    <div class="reset-container">
        <div class="logo-section">
            <div class="logo">WD Gestor</div>
            <div class="subtitle">Redefinição de Senha</div>
        </div>

        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            Olá <strong><%= userName %></strong>, defina sua nova senha abaixo.
        </div>

    <form id="resetPasswordForm" method="POST" action="<%= _basePath %>/reset-password">
            <input type="hidden" name="token" value="<%= token %>">

            <div class="form-floating">
                <input type="password" class="form-control" id="senha" name="senha"
                       placeholder="Nova senha" required minlength="6">
                <label for="senha">
                    <i class="bi bi-lock me-2"></i>Nova Senha
                </label>
                <div id="passwordStrength" class="password-strength"></div>
            </div>

            <div class="form-floating">
                <input type="password" class="form-control" id="confirmarSenha" name="confirmarSenha"
                       placeholder="Confirmar nova senha" required minlength="6">
                <label for="confirmarSenha">
                    <i class="bi bi-lock-fill me-2"></i>Confirmar Nova Senha
                </label>
            </div>

            <div class="requirements">
                <h6><i class="bi bi-shield-check me-2"></i>Requisitos da senha:</h6>
                <ul>
                    <li id="req-length" class="invalid">Mínimo 6 caracteres</li>
                    <li id="req-match" class="invalid">Senhas coincidem</li>
                </ul>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
                    <i class="bi bi-check-circle me-2"></i>Redefinir Senha
                </button>
            </div>
        </form>

     <div class="text-center mt-4">
         <a href="<%= _basePath %>/login" class="text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
            </a>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const senhaInput = document.getElementById('senha');
            const confirmarSenhaInput = document.getElementById('confirmarSenha');
            const passwordStrength = document.getElementById('passwordStrength');
            const submitBtn = document.getElementById('submitBtn');
            const reqLength = document.getElementById('req-length');
            const reqMatch = document.getElementById('req-match');

            function validatePassword() {
                const senha = senhaInput.value;
                const confirmar = confirmarSenhaInput.value;

                // Validar comprimento
                const isLengthValid = senha.length >= 6;
                reqLength.classList.toggle('invalid', !isLengthValid);

                // Validar coincidência
                const isMatchValid = senha === confirmar && senha.length > 0;
                reqMatch.classList.toggle('invalid', !isMatchValid);

                // Força da senha
                let strength = '';
                let strengthClass = '';

                if (senha.length === 0) {
                    strength = '';
                    strengthClass = '';
                } else if (senha.length < 6) {
                    strength = 'Fraca';
                    strengthClass = 'weak';
                } else if (senha.length < 8) {
                    strength = 'Média';
                    strengthClass = 'medium';
                } else {
                    strength = 'Forte';
                    strengthClass = 'strong';
                }

                passwordStrength.textContent = strength;
                passwordStrength.className = 'password-strength ' + strengthClass;

                // Habilitar/desabilitar botão
                const isValid = isLengthValid && isMatchValid;
                submitBtn.disabled = !isValid;

                return isValid;
            }

            senhaInput.addEventListener('input', validatePassword);
            confirmarSenhaInput.addEventListener('input', validatePassword);

            // Validação inicial
            validatePassword();
        });
    </script>
</body>
</html>