<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <% /* Template compartilhado Contato.
    Parâmetros opcionais: moduleLabel, basePath */ %>
  <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
  <% const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
  <%- include('partials/basepath-var') %>
  <title>Contato - <%= _moduleLabel %></title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <!-- Seu CSS -->
  <link rel="stylesheet" href="<%= _basePath %>/css/login.css?v=<%= Date.now() %>" />
  <style>
    /* Fallback inline caso o CSS não carregue */
    .login-bg {
      background: linear-gradient(180deg, #4a90e2 0%, #63a4ff 35%, #8bb8ff 70%, #b3d1ff 100%) !important;
      min-height: 100vh !important;
    }
  </style>
</head>
<body class="login-bg">

  <main class="min-vh-100 d-flex align-items-center justify-content-center px-3">
    <div class="login-card auth-card-shell card shadow-lg border-0">
      <div class="card-body p-4 p-sm-5">

        <!-- Marca / título -->
        <div class="auth-brand text-center">
          <img src="<%= _basePath %>/images/logoWDGestor.png" alt="<%= _moduleLabel %>" class="brand-logo auth-brand-logo" />
          <span class="auth-eyebrow auth-brand-badge">MÓDULO GESTOR</span>
        </div>

        <!-- Informações de contato -->
        <div class="text-center mb-4">
          <div class="mb-3">
            <i class="bi bi-envelope text-primary fs-4 me-2"></i>
            <a href="mailto:suporte@wdgestor.app.br" class="fw-medium text-decoration-none text-reset">suporte@wdgestor.app.br</a>
          </div>
          <div class="mb-3">
            <i class="bi bi-telephone text-primary fs-4 me-2"></i>
            <a href="tel:+5538998977042" class="fw-medium text-decoration-none text-reset">(38) 9 9897-7042</a>
          </div>
          <div class="mb-3">
            <i class="bi bi-whatsapp text-success fs-4 me-2"></i>
            <a href="https://wa.me/5538998977042" class="fw-medium text-decoration-none text-reset">(38) 9 9897-7042</a>
          </div>
        </div>

        <!-- Mensagem -->
        <div class="alert alert-info auth-panel-soft" role="alert">
          <i class="bi bi-info-circle me-2"></i>
          Para solicitar acesso à plataforma, entre em contato conosco através dos canais acima.
          Nossa equipe terá prazer em ajudá-lo!
        </div>

        <!-- Botão voltar -->
        <div class="d-grid mt-4">
       <% /* _basePath já definido no head */ %>
          <a href="<%= _basePath %>/login" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-arrow-left me-2"></i>
            Voltar ao Login
          </a>
        </div>

      </div>
    </div>
  </main>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Migrado para namespace gestor -->
  <script src="<%= _basePath %>/js/pages/contato.js"></script>
</body>
</html>
