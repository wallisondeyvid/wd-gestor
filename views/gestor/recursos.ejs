<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _basePath = (typeof basePath === 'string' && basePath) ? basePath : (typeof moduleBasePath === 'string' && moduleBasePath) ? moduleBasePath : '/gestor'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recursos - WDGestor</title>
  <%- include('partials/favicon') %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Estilos centrais Gestor -->
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _basePath }) %>
  <!-- Tema moderno (paridade com Unidades) e padrões de botões/linhas -->
  <link rel="stylesheet" href="/condominios/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _basePath %>/css/icon-buttons.css?v=1">
  <link rel="stylesheet" href="<%= _basePath %>/css/gestor-app.css?v=1">
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>

  <!-- Cleave + Phone addon antes das máscaras -->
  <script src="https://cdn.jsdelivr.net/npm/cleave.js@1.6.0/dist/cleave.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/cleave.js@1.6.0/dist/addons/cleave-phone.br.js"></script>
  <script src="<%= _basePath %>/js/core/masks-global.js"></script>
  <script src="<%= _basePath %>/js/core/masks.js"></script>
</head>
<body class="wdg-layout">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>
  <%- include('../shared/partials/navbar-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user, prefixMenuPaths: false }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>

  <div class="wdg-page">
    <!-- Título padronizado -->
    <h4 class="mb-3 text-center page-main-title">Cadastrar Recursos</h4>
    <div class="gestor-divider"></div>

    <div class="wdg-card content wdg-card-hover">
      <div class="wdg-card-body wdg-form wdg-tight">
  <form id="formNovoRecurso" method="POST" action="<%= _basePath %>/api/recursos" class="row gy-3 needs-validation wdg-form auto-colon" novalidate>
          <input type="hidden" id="recursoId" name="recursoId">

          <!-- Unidade -->
          <div class="col-12 col-lg-6">
            <label for="unidade_id" class="form-label">Unidade</label>
            <select name="unidade_id" id="unidade_id" class="form-select" required>
              <option value="">Selecione uma unidade...</option>
              <% if (typeof unidadesFiltradas !== 'undefined') { (unidadesFiltradas||[]).forEach(u => { %>
                <option value="<%= u._id %>"><%= u.codigo %> - <%= u.nome %></option>
              <% }) } %>
            </select>
          </div>

          <!-- Tipo de Veículo -->
          <div class="col-12 col-lg-6">
            <label for="tipo" class="form-label">Tipo de Veículo</label>
            <select name="tipo" id="tipo" class="form-select" required>
              <option value="">Selecione o tipo...</option>
              <option value="carro">Carro</option>
              <option value="motocicleta">Motocicleta</option>
              <option value="bicicleta">Bicicleta</option>
              <option value="carroça">Carroça</option>
              <option value="caminhão">Caminhão</option>
              <option value="ônibus">Ônibus</option>
              <option value="van">Van</option>
              <option value="caminhonete">Caminhonete</option>
              <option value="outro">Outro</option>
            </select>
          </div>

          <!-- Placa -->
          <div class="col-12 col-lg-4">
            <label for="placa" class="form-label">Placa</label>
            <input name="placa" id="placa" type="text" class="form-control" placeholder="ABC-1234 ou ABC-1D34" maxlength="8" required>
          </div>

          <!-- Chassi -->
          <div class="col-12 col-lg-4">
            <label for="chassi" class="form-label">Chassi</label>
            <input name="chassi" id="chassi" type="text" class="form-control" placeholder="Chassi do veículo" maxlength="17" required>
          </div>

          <!-- RENAVAM -->
          <div class="col-12 col-lg-4">
            <label for="renavam" class="form-label">RENAVAM</label>
            <input name="renavam" id="renavam" type="text" class="form-control" placeholder="RENAVAM" maxlength="11" required>
          </div>

          <!-- Ano -->
          <div class="col-12 col-lg-2">
            <label for="ano" class="form-label">Ano</label>
            <input name="ano" id="ano" type="number" class="form-control" placeholder="<%= new Date().getFullYear() %>" min="1900" max="<%= new Date().getFullYear() + 1 %>" value="<%= new Date().getFullYear() %>" required>
          </div>

          <!-- Mod. -->
          <div class="col-12 col-lg-2">
            <label for="mod" class="form-label">Mod.</label>
            <input name="mod" id="mod" type="number" class="form-control" placeholder="<%= new Date().getFullYear() %>" min="1900" max="<%= new Date().getFullYear() + 1 %>" value="<%= new Date().getFullYear() %>" required>
          </div>

          <!-- Marca -->
          <div class="col-12 col-lg-2">
            <label for="marca" class="form-label">Marca</label>
            <select name="marca" id="marca" class="form-select" required>
              <option value="">Selecione a marca...</option>
              <!-- Opções padrão como fallback -->
              <option value="GM - Chevrolet">GM - Chevrolet</option>
              <option value="Volkswagen">Volkswagen</option>
              <option value="Fiat">Fiat</option>
              <option value="Ford">Ford</option>
              <option value="Honda">Honda</option>
              <option value="Toyota">Toyota</option>
              <option value="Outro">Outro</option>
              <!-- Marcas serão carregadas via JavaScript e substituirão estas -->
            </select>
          </div>

          <!-- Modelo -->
          <div class="col-12 col-lg-3">
            <label for="modelo" class="form-label">Modelo</label>
            <input name="modelo" id="modelo" type="text" class="form-control" placeholder="Modelo do veículo" required>
          </div>

          <!-- Cor -->
          <div class="col-12 col-lg-3">
            <label for="cor" class="form-label">Cor</label>
            <input name="cor" id="cor" type="text" class="form-control" placeholder="Cor do veículo" required>
          </div>

          <!-- Botões -->
          <div class="col-12 d-flex justify-content-end gap-2">
            <button type="button" id="btnCancelarEdicao" class="btn btn-outline-secondary d-none" title="Cancelar edição" aria-label="Cancelar edição">Cancelar</button>
            <button type="reset" id="btnResetRecurso" class="btn btn-outline-secondary" title="Limpar" aria-label="Limpar">Limpar</button>
            <button type="submit" id="btnSubmitRecurso" class="btn btn-primary" title="Cadastrar" aria-label="Cadastrar">Cadastrar</button>
          </div>
        </form>
      </div>
    </div>

    <h5 class="mb-1 text-center wdg-section-title" style="margin-top:18px">Recursos cadastrados</h5>

    <!-- Controles da lista -->
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
      <div class="d-flex align-items-center gap-2">
        <label for="rPageSize" class="form-label mb-0">Mostra</label>
        <select id="rPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="100">100</option>
          <option value="200">200</option>
          <option value="300">300</option>
          <option value="400">400</option>
          <option value="500">500</option>
          <option value="1000">1000</option>
        </select>
        <span class="ms-1">itens</span>
      </div>
    </div>

    <div class="wdg-card content wdg-card-hover wdg-table wdg-recursos-table">
      <div id="wrapperTabelaRecursos" class="table-responsive table-vert-max">
        <table class="table table-sm align-middle" id="tabelaRecursos">
          <thead>
            <tr>
              <th>Unidade</th>
              <th>Tipo</th>
              <th>Placa</th>
              <th>Marca</th>
              <th>Modelo</th>
              <th>Ano</th>
              <th>Mod.</th>
              <th>Cor</th>
              <th>Ativo</th>
              <th class="col-acoes">Ações</th>
            </tr>
          </thead>
          <tbody id="recursosTableBody">
            <!-- Recursos serão carregados via JavaScript -->
          </tbody>
        </table>
      </div>
    </div>
    <div id="rPaginas" class="wdg-pager mt-2"></div>
  </div>

  <script src="/gestor/js/pages/recursos.js"></script>
  <script>
    // Carregar marcas de veículos
    document.addEventListener('DOMContentLoaded', async () => {
      try {
        console.log('Carregando marcas...');
  const basePath = '<%= _basePath %>'.replace(/\/$/,'');
  const response = await fetch(basePath + '/data/marcas_veiculos.json');
        console.log('Resposta do fetch:', response);
        if (response.ok) {
          const marcas = await response.json();
          console.log('Marcas carregadas:', marcas.length);
          const selectMarca = document.getElementById('marca');
          if (selectMarca) {
            // Limpar opções existentes (exceto a primeira)
            selectMarca.innerHTML = '<option value="">Selecione a marca...</option>';
            marcas.forEach(marca => {
              const option = document.createElement('option');
              option.value = marca;
              option.textContent = marca;
              selectMarca.appendChild(option);
            });
            console.log('Marcas adicionadas ao select');
          } else {
            console.error('Select de marca não encontrado');
          }
        } else {
          console.error('Erro na resposta:', response.status);
        }
      } catch (error) {
        console.error('Erro ao carregar marcas:', error);
      }
    });
  </script>

  <!-- Script de perfil modular -->
  <script>window.__perfilBasePath='/gestor';</script>
  <script src="<%= _basePath %>/js/perfil-modulo.js"></script>
  <style>
    /* Centralizar títulos e conteúdo da tabela de recursos */
    .wdg-recursos-table .table th,
    .wdg-recursos-table .table td{ vertical-align: middle; text-align: center; white-space: nowrap; }
    /* largura otimizada para coluna de ações com ícones */
    .wdg-recursos-table .col-acoes{ width: 160px; }
    /* Linhas sempre brancas + hover suave (paridade Unidades) */
    .wdg-recursos-table tbody tr td{ background:#ffffff !important; }
    .wdg-recursos-table tbody tr:hover td{ background:#f5f9ff !important; }
    /* Scroll limit e sticky header após 4 itens */
    #wrapperTabelaRecursos.scroll-limit{ max-height:360px; overflow-y:auto; }
    #wrapperTabelaRecursos.scroll-limit thead th{ position:sticky; top:0; background:#f8f9fa; z-index:2; box-shadow:0 1px 0 rgba(0,0,0,.06); }
    .gestor-divider{ height:2px; width:300px; margin:6px auto 18px; background:#0d6efd; border-radius:2px; }
  </style>
</body>
</html>