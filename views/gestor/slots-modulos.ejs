<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _basePath = (typeof basePath === 'string' && basePath) ? basePath : (typeof moduleBasePath === 'string' && moduleBasePath) ? moduleBasePath : '/gestor'; %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Módulos - WDGestor</title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap / Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
  <!-- Estilos centrais Gestor -->
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _basePath }) %>
  <!-- Tema moderno (igual ao módulo Condomínios) e padrões de botões/linhas -->
  <link rel="stylesheet" href="/condominios/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _basePath %>/css/icon-buttons.css?v=1">
  <link rel="stylesheet" href="<%= _basePath %>/css/gestor-app.css?v=1">
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>

  <style>
    /* Ajustes visuais específicos desta página */
    .wdg-modulos-table .table th,
    .wdg-modulos-table .table td{
      vertical-align: middle;
      text-align: center;
      white-space: nowrap;
    }
    .wdg-modulos-table .col-desc { max-width: 560px; }
    .wdg-modulos-table .col-url  { max-width: 340px; }
  .wdg-modulos-table .col-acoes{ width: 160px; }
    /* Título/divisor padronizados */
    .page-main-title{ font-weight:600; letter-spacing:.5px; color:#1f2d3d; }
    .gestor-divider{ height:2px; width:300px; margin:6px auto 18px; background:#0d6efd; border-radius:2px; }
    /* Linhas sempre brancas */
    .wdg-modulos-table tbody tr td{ background:#ffffff !important; }
    .wdg-modulos-table tbody tr:hover td{ background:#f5f9ff !important; }
    /* Scroll limit e cabeçalho sticky após 4 itens */
    #wrapperTabelaModulos.scroll-limit{ max-height:360px; overflow-y:auto; }
    #wrapperTabelaModulos.scroll-limit thead th{ position:sticky; top:0; background:#f8f9fa; z-index:2; box-shadow:0 1px 0 rgba(0,0,0,.06); }
  </style>
</head>
<body class="wdg-layout">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>
  <%- include('../shared/partials/navbar-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user, prefixMenuPaths: false }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>

  <div class="wdg-page">
    <!-- Título (padrão Unidades/Funções/Setores) -->
    <h4 class="mb-3 text-center page-main-title">Gerenciar Módulos</h4>
    <div class="gestor-divider"></div>

    <!-- Card do formulário -->
    <div class="wdg-card content wdg-card-hover">
      <div class="wdg-card-body wdg-form wdg-tight auto-colon">
  <form action="<%= _basePath %>/api/modulos" method="POST" id="formModulo" class="row gy-3">
          <input type="hidden" id="modulo_edit_id" value=""/>

          <div class="col-12 col-lg-6">
            <label for="nome" class="form-label">Nome do Módulo</label>
            <input type="text" class="form-control" id="nome" name="nome" required placeholder="Ex.: Escalas, Ponto, RH"/>
          </div>

          <div class="col-12 col-lg-6">
            <label for="status" class="form-label">Status</label>
            <select class="form-select" id="status" name="status" required>
              <option value="planejado">Planejado</option>
              <option value="ativo">Ativo</option>
            </select>
          </div>

          <div class="col-12">
            <label for="descricao" class="form-label">Descrição</label>
            <textarea class="form-control" id="descricao" name="descricao" rows="2" placeholder="Breve descrição do módulo"></textarea>
          </div>

          <div class="col-12 col-lg-6">
            <label for="url_base" class="form-label">URL Base</label>
            <input type="text" class="form-control" id="url_base" name="url_base" placeholder="Ex.: /escalas"/>
          </div>

          <div class="col-12 col-lg-6 d-flex align-items-end justify-content-lg-end gap-2">
            <button type="button" id="btnCancelarEdicao" class="btn btn-outline-secondary d-none" title="Cancelar edição" aria-label="Cancelar edição">Cancelar</button>
            <button type="reset" class="btn btn-outline-secondary" id="btnResetModulo" title="Limpar" aria-label="Limpar">Limpar</button>
            <button type="submit" class="btn btn-primary" id="btnSubmitModulo" title="Cadastrar" aria-label="Cadastrar">Cadastrar</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Lista -->
    <h5 class="mb-1 text-center wdg-section-title" style="margin-top:18px">Módulos cadastrados</h5>

    <!-- Controles da lista -->
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
      <div class="d-flex align-items-center gap-2">
        <label for="mPageSize" class="form-label mb-0">Mostra</label>
        <select id="mPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="100">100</option>
          <option value="200">200</option>
          <option value="300">300</option>
          <option value="400">400</option>
          <option value="500">500</option>
          <option value="1000">1000</option>
        </select>
        <span class="ms-1">itens</span>
      </div>
    </div>

    <div class="wdg-card content wdg-card-hover wdg-table wdg-modulos-table">
      <div id="wrapperTabelaModulos" class="table-responsive table-vert-max">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th class="col-id">Slot/ID</th>
              <th class="col-nome">Nome</th>
              <th class="col-desc">Descrição</th>
              <th class="col-status">Status</th>
              <th class="col-url">URL Base</th>
              <th class="col-acoes">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% (modulos||[]).forEach(modulo => { %>
              <tr>
                <td><%= modulo.id %></td>
                <td><%= modulo.nome %></td>
                <td class="col-desc">
                  <div class="text-truncate"><%= modulo.descricao || '-' %></div>
                </td>
                <td>
                  <% const ativo = (String(modulo.status).toLowerCase() === 'ativo'); %>
                  <span class="badge <%= ativo ? 'bg-success' : 'bg-secondary' %>">
                    <%= ativo ? 'Ativo' : 'Planejado' %>
                  </span>
                </td>
                <td class="col-url">
                  <div class="text-truncate"><%= modulo.url_base || 'N/A' %></div>
                </td>
                <td class="col-acoes">
                  <div class="d-flex gap-1 justify-content-center flex-nowrap">
                    <button type="button" class="wdg-icon-btn" data-action="editar" data-id="<%= modulo.id %>" title="Editar" aria-label="Editar">
                      <img src="<%= _basePath %>/images/editar.png" alt="Editar" onerror="this.outerHTML='&lt;i class=\'bi bi-pencil\'&gt;&lt;/i&gt;'" />
                    </button>
                    <button type="button" class="wdg-icon-btn" data-action="excluir" data-id="<%= modulo.id %>" title="Excluir" aria-label="Excluir">
                      <img src="<%= _basePath %>/images/excluir.png" alt="Excluir" onerror="this.outerHTML='&lt;i class=\'bi bi-trash\'&gt;&lt;/i&gt;'" />
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
            <% if (!(modulos&&modulos.length)) { %>
              <tr><td colspan="6" class="text-center text-muted">Nenhum módulo cadastrado.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="mPaginas" class="wdg-pager mt-2"></div>
  </div>

  <!-- JS da página -->
  <script>
    // ===== Edição inline de módulos (sem modal) =====
    const formModulo        = document.getElementById('formModulo');
    const hiddenModuloId    = document.getElementById('modulo_edit_id');
    const btnSubmitModulo   = document.getElementById('btnSubmitModulo');
    const btnCancelarEdicao = document.getElementById('btnCancelarEdicao');
    const btnResetModulo    = document.getElementById('btnResetModulo');

    function entrarModoEdicaoModulo(){
      btnSubmitModulo.textContent = 'Salvar';
      btnSubmitModulo.title = 'Salvar';
      btnSubmitModulo.setAttribute('aria-label', 'Salvar');
      btnSubmitModulo.classList.remove('btn-primary');
      btnSubmitModulo.classList.add('btn-outline-success');
      btnCancelarEdicao.classList.remove('d-none');
    }
    function cancelarEdicaoModulo(){
      hiddenModuloId.value = '';
      formModulo.reset();
      btnSubmitModulo.textContent = 'Cadastrar';
      btnSubmitModulo.title = 'Cadastrar';
      btnSubmitModulo.setAttribute('aria-label', 'Cadastrar');
      btnSubmitModulo.classList.remove('btn-outline-success');
      btnSubmitModulo.classList.add('btn-primary');
      btnCancelarEdicao.classList.add('d-none');
      btnSubmitModulo.disabled = false;
    }
    btnCancelarEdicao.addEventListener('click', cancelarEdicaoModulo);
    btnResetModulo.addEventListener('click', ()=> { if (hiddenModuloId.value) cancelarEdicaoModulo(); });

    // Intercepta submit para criar (POST) e editar (PUT) via fetch (evita navegar para JSON)
    formModulo.addEventListener('submit', function(e){
      e.preventDefault();
      const isEdit = !!hiddenModuloId.value;
      const id = hiddenModuloId.value;

      const payload = {
        nome:       document.getElementById('nome').value.trim(),
        descricao:  document.getElementById('descricao').value.trim(),
        status:     document.getElementById('status').value,
        url_base:   document.getElementById('url_base').value.trim()
      };

      const originalText = btnSubmitModulo.textContent;
      btnSubmitModulo.disabled = true;
      btnSubmitModulo.textContent = isEdit ? 'Salvando...' : 'Cadastrando...';
      btnSubmitModulo.title = btnSubmitModulo.textContent;
      btnSubmitModulo.setAttribute('aria-label', btnSubmitModulo.textContent);

  const url = isEdit ? '<%= _basePath %>/api/modulos/' + encodeURIComponent(id) : '<%= _basePath %>/api/modulos';
      const method = isEdit ? 'PUT' : 'POST';

      fetch(url, {
        method,
        headers: { 'Content-Type':'application/json' },
        body: JSON.stringify(payload),
        credentials: 'same-origin'
      })
      .then(async r => {
        if (!r.ok) { const t = await r.text(); throw new Error(t || 'Erro'); }
        return r.json();
      })
      .then(() => location.reload())
      .catch(err => {
        alert(`Erro ao ${isEdit ? 'salvar' : 'cadastrar'}: ` + err.message);
        btnSubmitModulo.disabled = false;
        btnSubmitModulo.textContent = originalText;
        btnSubmitModulo.title = originalText;
        btnSubmitModulo.setAttribute('aria-label', originalText);
      });
    });

    // ===== Ações globais =====
    function unwrapData(json){
      if (json && typeof json === 'object'){
        if (json.dados && typeof json.dados === 'object') return json.dados;
        if (json.data && typeof json.data === 'object') return json.data;
      }
      return json;
    }

    // Delegação de eventos para botões de ação ícone
    document.addEventListener('click', function(e){
      const btn = e.target.closest('button[data-action]');
      if(!btn) return;
      const action = btn.getAttribute('data-action');
      const id = btn.getAttribute('data-id');
      if(!action || !id) return;
      if(action === 'editar'){
        fetch('<%= _basePath %>/api/modulos/' + encodeURIComponent(id), { credentials: 'same-origin' })
          .then(r => r.ok ? r.json() : Promise.reject(r))
          .then(json => {
            const data = unwrapData(json) || {};
            hiddenModuloId.value = data._id || data.id || id;
            document.getElementById('nome').value      = data.nome || '';
            document.getElementById('descricao').value = data.descricao || '';
            document.getElementById('status').value    = data.status || 'planejado';
            document.getElementById('url_base').value  = data.url_base || '';
            entrarModoEdicaoModulo();
            formModulo.scrollIntoView({ behavior:'smooth', block:'start' });
          })
          .catch(async r => {
            let msg = 'Falha ao carregar módulo.';
            try { msg += ' ' + await r.text(); } catch {}
            alert(msg);
          });
      }
      if(action === 'excluir'){
        if (!confirm('Confirma exclusão?')) return;
        fetch('<%= _basePath %>/api/modulos/' + encodeURIComponent(id), {
          method: 'DELETE',
          headers: { 'Content-Type':'application/json' },
          credentials: 'same-origin'
        })
        .then(r => r.ok ? (alert('Módulo excluído com sucesso.'), location.reload()) : r.text().then(t => { throw new Error(t); }))
        .catch(err => alert('Erro ao excluir módulo: ' + err.message));
      }
    });

    // Hover desabilitado — manter apenas clique padrão do Bootstrap
  </script>

  <!-- Script de perfil modular -->
  <script>window.__perfilBasePath='<%= _basePath %>';</script>
  <script src="<%= _basePath %>/js/perfil-modulo.js"></script>
  <script>
  // Paginação da tabela de Módulos (padrão Funções/Setores)
  (function initModulosPagination(){
    const tbody = document.querySelector('.wdg-modulos-table tbody');
    const pager = document.getElementById('mPaginas');
    const pageSizeSel = document.getElementById('mPageSize');
    if (!tbody || !pager || !pageSizeSel) return;
    let allRows = Array.from(tbody.querySelectorAll('tr'));
    // Excluir linha de "Nenhum módulo" e controlar scroll-limit
    const emptyRow = allRows.find(tr => tr.querySelector('.text-muted'));
    const dataRows = emptyRow ? allRows.filter(tr => tr!==emptyRow) : allRows;
    const wrapper = document.getElementById('wrapperTabelaModulos');
    if (wrapper && dataRows.length > 4){ wrapper.classList.add('scroll-limit'); }
    allRows = dataRows;
    function getPageSize(){ const v=parseInt(pageSizeSel.value,10); return (!isNaN(v)&&v>0)? v : 50; }
    const state = { page: 0 };
    function mkBtn(label, go, dis){ const b=document.createElement('button'); b.type='button'; b.textContent=label; b.disabled=!!dis; b.addEventListener('click', ()=>{ state.page=go; render(); }); return b; }
    function buildPager(totalPages, totalItems){
      pager.innerHTML='';
      if (totalPages <= 1){
        const info=document.createElement('div'); info.className='w-100 text-center mt-1'; info.style.fontSize='.7rem'; info.textContent='Total: '+totalItems+' módulo(s)'; pager.appendChild(info); return;
      }
      const win=5; let start=Math.max(0, state.page-Math.floor(win/2)); let end=Math.min(totalPages-1, start+win-1);
      pager.appendChild(mkBtn('<<',0,state.page===0)); pager.appendChild(mkBtn('<',state.page-1,state.page===0));
      if(start>0){ const b0=mkBtn('1',0,false); if(state.page===0) b0.classList.add('active'); pager.appendChild(b0); const dots=document.createElement('span'); dots.textContent='...'; dots.style.padding='0 .4rem'; pager.appendChild(dots); }
      for(let p=start;p<=end;p++){ const b=mkBtn(String(p+1),p,false); if(p===state.page) b.classList.add('active'); pager.appendChild(b); }
      if(end<totalPages-1){ const dots2=document.createElement('span'); dots2.textContent='...'; dots2.style.padding='0 .4rem'; pager.appendChild(dots2); const blast=mkBtn(String(totalPages), totalPages-1,false); if(state.page===totalPages-1) blast.classList.add('active'); pager.appendChild(blast); }
      pager.appendChild(mkBtn('>', state.page+1, state.page===totalPages-1)); pager.appendChild(mkBtn('>>', totalPages-1, state.page===totalPages-1));
      const info2=document.createElement('div'); info2.className='w-100 text-center mt-1'; info2.style.fontSize='.7rem'; info2.textContent='Total: '+totalItems+' módulo(s)'; pager.appendChild(info2);
    }
    function render(){
      const size = getPageSize();
      const totalPages = Math.ceil(allRows.length / size) || 1;
      if (state.page < 0) state.page = 0; if (state.page >= totalPages) state.page = totalPages - 1;
      const start = state.page * size; const end = Math.min(allRows.length, start + size);
      allRows.forEach((tr, idx)=>{ tr.style.display = (idx>=start && idx<end) ? '' : 'none'; });
      buildPager(totalPages, allRows.length);
    }
    pageSizeSel.addEventListener('change', ()=>{ state.page=0; render(); });
    render();
  })();
  </script>
</body>
</html>