<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <% /* Template compartilhado Primeiro Acesso.
    Parâmetros:
    - moduleLabel (string): rótulo do módulo exibido
    - basePath (string): prefixo de rotas ('' ou '/escalas') */ %>
  <% const _moduleLabel = typeof moduleLabel !== 'undefined' ? moduleLabel : 'WDGestor'; %>
  <% const _basePath = (typeof basePath === 'string' && basePath && basePath !== '/') ? basePath : '/gestor'; %>
  <%- include('partials/basepath-var') %>
  <title>Primeiro Acesso - <%= _moduleLabel %></title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <!-- Seu CSS -->
  <link rel="stylesheet" href="<%= _basePath %>/css/login.css?v=<%= Date.now() %>" />
  <link rel="stylesheet" href="/gestor/css/icons.css" />
  <style>
    /* Fallback inline caso o CSS não carregue */
    .login-bg {
      background: linear-gradient(180deg, #4a90e2 0%, #63a4ff 35%, #8bb8ff 70%, #b3d1ff 100%) !important;
      min-height: 100vh !important;
    }
  </style>
</head>
<body class="login-bg">

  <main class="min-vh-100 d-flex align-items-center justify-content-center px-3">
    <div class="login-card card shadow-lg border-0">
      <div class="card-body p-4 p-sm-5">

        <!-- Marca / título -->
        <div class="text-center mb-4">
          <img src="<%= _basePath %>/images/logoWDGestor.png" alt="<%= _moduleLabel %>" class="brand-logo mb-2" />
          <p class="text-muted m-0">Primeiro Acesso - <%= _moduleLabel %></p>
        </div>

        <!-- Mensagem de instrução -->
        <div class="alert alert-info mb-4 d-flex align-items-center" role="alert">
          <img src="<%= _basePath %>/images/senha.png" alt="Senha" class="icon icon-sm icon-left"> Altere sua senha provisória para continuar usando o sistema.
        </div>

        <!-- Formulário para alterar senha -->
    <% /* _basePath já definido no head */ %>
  <form action="<%= _basePath %>/primeiroacesso" method="POST" id="primeiroAcessoForm">
          <div class="mb-3">
            <label for="senha" class="form-label fw-medium d-flex align-items-center">
              <img src="<%= _basePath %>/images/senha.png" alt="Senha" class="icon icon-sm icon-left"> Nova Senha
            </label>
            <div class="input-group">
              <input type="password" class="form-control form-control-lg" id="senha" name="senha" required
                     placeholder="Digite sua nova senha">
              <button class="btn btn-outline-secondary toggle-pass" type="button">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <div class="mb-4">
            <label for="confirmar_senha" class="form-label fw-medium d-flex align-items-center">
              <img src="<%= _basePath %>/images/senha.png" alt="Senha" class="icon icon-sm icon-left"> Confirmar Nova Senha
            </label>
            <div class="input-group">
              <input type="password" class="form-control form-control-lg" id="confirmar_senha" name="confirmar_senha" required
                     placeholder="Confirme sua nova senha">
              <button class="btn btn-outline-secondary toggle-pass-confirm" type="button">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg">Alterar Senha</button>
          </div>
        </form>

        <!-- Links de navegação -->
        <div class="text-center mt-4">
          <a href="<%= _basePath %>/login" class="text-decoration-none d-inline-flex align-items-center">Voltar ao Login</a>
        </div>

      </div>
    </div>
  </main>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="<%= _basePath %>/js/pages/primeiroacesso.js"></script>
</body>
</html>