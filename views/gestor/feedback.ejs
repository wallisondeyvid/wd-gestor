<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _basePath = (typeof basePath === 'string' && basePath) ? basePath : (typeof moduleBasePath === 'string' && moduleBasePath) ? moduleBasePath : '/gestor'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feedback - WDGestor</title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap / Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <!-- Estilos centrais Gestor + widget -->
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _basePath }) %>
  <link rel="stylesheet" href="/condominios/css/condominios-modern.css?v=1">
  <link rel="stylesheet" href="<%= _basePath %>/css/icon-buttons.css?v=1">
  <link rel="stylesheet" href="<%= _basePath %>/css/pages/feedback.css?v=<%= Date.now() %>">

  <style>
    /* manter apenas helpers locais; o grosso do visual está em /css/pages/feedback.css */
    .fb-anexo{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
  </style>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="<%= _basePath %>/js/pages/feedback.js?v=<%= Date.now() %>" defer></script>
</head>
<body class="wdg-layout page-feedback" data-base-path="<%= _basePath %>">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>
  <%- include('../shared/partials/navbar-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user, prefixMenuPaths: false }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>

  <div class="wdg-page">
    <h4 class="text-center page-main-title fb-title">Gerenciar Feedback</h4>
    <div class="fb-breadcrumb">Cadastros Gerais &gt; Feedback</div>
    <div class="gestor-divider"></div>

    <div id="fbAlert" class="mt-3" aria-live="polite"></div>

    <div class="wdg-card content wdg-card-hover fb-shell">
      <div class="wdg-card-body wdg-form wdg-tight">

        <div class="fb-layout mt-3">
          <!-- LISTA -->
          <section class="fb-card fb-card--list" style="margin:0">
            <div class="fb-card-header">
              <div class="fb-card-head-center">
                <div class="fb-card-title">Feedbacks</div>
                <div class="fb-card-sub" id="fbCount">—</div>
              </div>
              <div class="d-flex align-items-center gap-2 fb-list-actions">
                <button id="fbBtnRefresh" class="fb-icon-btn" type="button" title="Atualizar" aria-label="Atualizar">
                  <img class="fb-icon" src="/images/atualizar.png" alt="" aria-hidden="true">
                </button>
                <button id="fbBtnDelete" class="fb-icon-btn" type="button" hidden title="Excluir selecionados" aria-label="Excluir selecionados">
                  <img class="fb-icon" src="/images/excluir.png" alt="" aria-hidden="true">
                </button>
                <button id="fbBtnClear" class="fb-icon-btn" type="button" title="Limpar seleção" aria-label="Limpar seleção">
                  <img class="fb-icon" src="/images/limpar.png" alt="" aria-hidden="true">
                </button>
              </div>
            </div>
            <div class="fb-card-body">

              <div class="table-responsive">
                <div class="fb-table-scroll">
                  <table class="table table-hover fb-table mb-0">
                    <thead>
                      <tr>
                        <th class="fb-col-select" style="width:44px; min-width:44px">
                          <input id="fbSelectAll" class="form-check-input fb-select-all" type="checkbox" aria-label="Selecionar todos os itens exibidos">
                        </th>
                        <th style="min-width:110px">
                          <div class="fb-th">
                            <span>Protocolo</span>
                            <button type="button" class="btn btn-sm btn-link fb-colfilter-btn" data-col="protocolo" aria-label="Filtrar Protocolo" title="Filtrar">
                              <i class="bi bi-filter" aria-hidden="true"></i>
                            </button>
                          </div>
                        </th>
                        <th style="min-width:120px">
                          <div class="fb-th">
                            <span>Tipo</span>
                            <button type="button" class="btn btn-sm btn-link fb-colfilter-btn" data-col="tipo" aria-label="Filtrar Tipo" title="Filtrar">
                              <i class="bi bi-filter" aria-hidden="true"></i>
                            </button>
                          </div>
                        </th>
                        <th style="min-width:120px">
                          <div class="fb-th">
                            <span>Status</span>
                            <button type="button" class="btn btn-sm btn-link fb-colfilter-btn" data-col="status" aria-label="Filtrar Status" title="Filtrar">
                              <i class="bi bi-filter" aria-hidden="true"></i>
                            </button>
                          </div>
                        </th>
                        <th style="min-width:170px">
                          <div class="fb-th">
                            <span>Usuário</span>
                            <button type="button" class="btn btn-sm btn-link fb-colfilter-btn" data-col="usuario" aria-label="Filtrar Usuário" title="Filtrar">
                              <i class="bi bi-filter" aria-hidden="true"></i>
                            </button>
                          </div>
                        </th>
                        <th style="min-width:190px">
                          <div class="fb-th">
                            <span>Data</span>
                            <button type="button" class="btn btn-sm btn-link fb-colfilter-btn" data-col="data" aria-label="Filtrar Data" title="Filtrar">
                              <i class="bi bi-filter" aria-hidden="true"></i>
                            </button>
                          </div>
                        </th>
                      </tr>
                    </thead>
                    <tbody id="fbTbody">
                      <tr><td colspan="6" class="text-muted">Carregando…</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Filtro por coluna (estilo Excel) -->
              <div id="fbColFilter" class="fb-colfilter" hidden aria-hidden="true">
                <div class="fb-colfilter-head">
                  <strong id="fbColFilterTitle">Filtro</strong>
                  <button id="fbColFilterClose" type="button" class="btn btn-sm btn-outline-secondary" title="Fechar" aria-label="Fechar">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="fb-colfilter-body">
                  <input id="fbColFilterSearch" type="text" class="form-control form-control-sm" placeholder="Pesquisar" autocomplete="off">
                  <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="fbColFilterAll">
                    <label class="form-check-label" for="fbColFilterAll">(Selecionar tudo)</label>
                  </div>
                  <div id="fbColFilterList" class="fb-colfilter-list mt-2"></div>
                </div>
                <div class="fb-colfilter-footer">
                  <button id="fbColFilterClear" type="button" class="btn btn-sm btn-outline-secondary">Limpar</button>
                  <div class="fb-colfilter-footer-actions">
                    <button id="fbColFilterCancel" type="button" class="btn btn-sm btn-outline-secondary">Cancelar</button>
                    <button id="fbColFilterApply" type="button" class="btn btn-sm btn-primary">OK</button>
                  </div>
                </div>
              </div>

              <div class="fb-pager fb-pager--split">
                <div class="fb-pager-left d-flex align-items-center gap-2 text-muted small">
                  <span>Mostra</span>
                  <select id="fbPageSize" class="form-select form-select-sm" style="width:auto">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                  </select>
                  <span>itens</span>
                </div>
                <div class="fb-pager-center d-flex align-items-center gap-2">
                  <button id="fbBtnPrev" type="button" class="btn btn-sm btn-outline-secondary">Anterior</button>
                  <span id="fbPagerInfo" class="text-muted small">—</span>
                  <button id="fbBtnNext" type="button" class="btn btn-sm btn-outline-secondary">Próxima</button>
                </div>
                <div class="fb-pager-right"></div>
              </div>
            </div>
          </section>

          <!-- DETALHE -->
          <aside class="fb-card fb-card--detail" id="fbDetailCard" style="margin:0">
            <div class="fb-card-header">
              <div class="fb-card-title">Detalhes</div>
            </div>
            <div class="fb-card-body">

              <div id="fbDetail">
                <div id="fbDetailHint" class="text-muted small mb-2">Selecione um feedback na lista para ver os detalhes.</div>
                <div class="mb-3">
                  <div class="d-flex align-items-baseline justify-content-between gap-2">
                    <div class="text-muted small" id="fbDetailId">—</div>
                    <div class="text-muted small" id="fbDetailData">—</div>
                  </div>
                  <div class="d-flex align-items-center gap-2 mt-1">
                    <strong id="fbDetailTipo">—</strong>
                    <span class="text-muted">•</span>
                    <strong id="fbDetailStatus">—</strong>
                  </div>
                </div>

                <div class="mb-3">
                  <div class="fb-section-label">Mensagem</div>
                  <textarea id="fbDetailMensagem" class="form-control" rows="5" readonly></textarea>
                </div>

                <div class="mb-3">
                  <div class="fb-section-label">Contexto (URL)</div>
                  <div class="fb-url-row">
                    <input id="fbDetailUrl" class="form-control" readonly placeholder="—">
                    <a id="fbDetailUrlLink" class="btn btn-outline-secondary" href="#" target="_blank" rel="noopener" hidden title="Abrir em nova aba">
                      <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                  </div>
                </div>

                <div class="row g-3">
                  <div class="col-12">
                    <div class="fb-section-label">Atualizar status</div>
                    <div class="input-group fb-status-row">
                      <input id="fbEditStatus" type="hidden" value="">
                      <div class="dropdown fb-status-select">
                        <button id="fbEditStatusBtn" type="button" class="btn fb-selectlike dropdown-toggle w-100 text-start" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                          <span id="fbEditStatusPill" class="fb-status-pill" hidden>—</span>
                          <span id="fbEditStatusLabel">Selecione…</span>
                        </button>
                        <ul id="fbEditStatusMenu" class="dropdown-menu w-100">
                          <li>
                            <button class="dropdown-item fb-status-item" type="button" data-value="novo">
                              <span class="fb-status-dot fb-status--novo" aria-hidden="true"></span>
                              <span class="fb-status-item-label">Novo</span>
                              <i class="bi bi-check2 fb-status-check" aria-hidden="true"></i>
                            </button>
                          </li>
                          <li>
                            <button class="dropdown-item fb-status-item" type="button" data-value="respondido">
                              <span class="fb-status-dot fb-status--respondido" aria-hidden="true"></span>
                              <span class="fb-status-item-label">Respondido</span>
                              <i class="bi bi-check2 fb-status-check" aria-hidden="true"></i>
                            </button>
                          </li>
                          <li>
                            <button class="dropdown-item fb-status-item" type="button" data-value="aberto">
                              <span class="fb-status-dot fb-status--aberto" aria-hidden="true"></span>
                              <span class="fb-status-item-label">Aberto</span>
                              <i class="bi bi-check2 fb-status-check" aria-hidden="true"></i>
                            </button>
                          </li>
                          <li>
                            <button class="dropdown-item fb-status-item" type="button" data-value="em_andamento">
                              <span class="fb-status-dot fb-status--em_andamento" aria-hidden="true"></span>
                              <span class="fb-status-item-label">Em andamento</span>
                              <i class="bi bi-check2 fb-status-check" aria-hidden="true"></i>
                            </button>
                          </li>
                          <li>
                            <button class="dropdown-item fb-status-item" type="button" data-value="resolvido">
                              <span class="fb-status-dot fb-status--resolvido" aria-hidden="true"></span>
                              <span class="fb-status-item-label">Resolvido</span>
                              <i class="bi bi-check2 fb-status-check" aria-hidden="true"></i>
                            </button>
                          </li>
                          <li>
                            <button class="dropdown-item fb-status-item" type="button" data-value="cancelado">
                              <span class="fb-status-dot fb-status--cancelado" aria-hidden="true"></span>
                              <span class="fb-status-item-label">Cancelado</span>
                              <i class="bi bi-check2 fb-status-check" aria-hidden="true"></i>
                            </button>
                          </li>
                        </ul>
                      </div>
                      <button id="fbBtnSaveStatus" type="button" class="btn btn-outline-success" disabled>Salvar status</button>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="fb-section-label">Resposta</div>
                    <textarea id="fbResposta" class="form-control" rows="4" placeholder="Escreva uma resposta para registrar…" disabled></textarea>
                    <div class="d-flex justify-content-end mt-2">
                      <button id="fbBtnSaveResposta" type="button" class="btn btn-success btn-sm" disabled>Salvar resposta</button>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="fb-section-label">Anexos</div>
                    <div id="fbAnexos" class="d-flex flex-column gap-2">
                      <div class="text-muted">—</div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </aside>
        </div>

        <!-- Linha inferior: Widgets (esquerda) + Avatar (direita) -->
        <div class="fb-layout fb-layout--bottom">
          <section class="fb-card fb-card--widgets">
            <div class="fb-card-header">
              <div class="fb-card-title">Widgets</div>
            </div>
            <div class="fb-card-body">
              <div class="text-muted small mb-2">Controle a exibição do widget de feedback por módulo.</div>
              <div id="fbWidgetsBox" class="fb-widgets-box">
                <div class="text-muted">Carregando…</div>
              </div>
            </div>
          </section>

          <div class="fb-detail-avatar-outside" aria-hidden="true">
            <img id="fbDetailAvatar" class="fb-detail-avatar-img" src="/images/avatarposicao1.png" alt="" role="presentation">
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Modal: confirmação de exclusão (Feedback) -->
  <div class="modal fade" id="fbDeleteConfirmModal" tabindex="-1" aria-labelledby="fbDeleteConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title d-flex align-items-center gap-2" id="fbDeleteConfirmTitle">
            <i class="bi bi-trash3 text-danger" aria-hidden="true"></i>
            Confirmar exclusão
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="d-flex gap-3">
            <div class="text-danger" style="font-size:2rem; line-height:1">
              <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            </div>
            <div>
              <div class="mb-1">
                Deseja excluir <strong><span id="fbDeleteConfirmCount">—</span></strong>?
              </div>
              <div class="text-muted small">
                Esta exclusão é definitiva e não pode ser desfeita.
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="fbDeleteConfirmYes">
            Excluir definitivamente
          </button>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
