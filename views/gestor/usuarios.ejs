    // Função para mostrar alertas bonitos
    function showAlert(message, type = 'error') {
      // Remover alertas existentes
      const existingAlerts = document.querySelectorAll('.custom-alert');
      existingAlerts.forEach(alert => alert.remove());

      // Criar novo alerta
      const alertDiv = document.createElement('div');
      alertDiv.className = 'custom-alert';

      let bgColor, icon, title;
      switch(type) {
        case 'success':
          bgColor = '#28a745';
          icon = '✅';
          title = 'Sucesso';
          break;
        case 'warning':
          bgColor = '#ffc107';
          icon = '⚠️';
          title = 'Atenção';
          break;
        case 'info':
          bgColor = '#17a2b8';
          icon = 'ℹ️';
          title = 'Informação';
          break;
        default: // error
          bgColor = '#dc3545';
          icon = '❌';
          title = 'Erro';
      }

      alertDiv.style.cssText = `
        background: ${bgColor};
        color: white;
        padding: 15px 20px;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        max-width: 100%;
        border-left: 4px solid rgba(255,255,255,0.3);
        animation: slideInDown 0.3s ease-out;
        margin-bottom: 15px;
      `;

      alertDiv.innerHTML = `
        <div style="display: flex; align-items: flex-start; gap: 12px;">
          <span style="font-size: 20px; line-height: 1; flex-shrink: 0;">${icon}</span>
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 600; margin-bottom: 4px; font-size: 16px;">${title}</div>
            <div style="font-size: 14px; line-height: 1.4; opacity: 0.95;">${message}</div>
          </div>
          <button onclick="this.parentElement.parentElement.remove()" style="
            background: none;
            border: none;
            color: white;
            font-size: 22px;
            cursor: pointer;
            padding: 0;
            opacity: 0.8;
            line-height: 1;
            flex-shrink: 0;
            margin-top: -2px;
            transition: opacity 0.2s;
          " onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'">&times;</button>
        </div>
      `;

      // Adicionar ao contêiner específico
      const container = document.getElementById('alerts-container');
      if (container) {
        container.appendChild(alertDiv);
      } else {
        // Fallback para body se o contêiner não existir
        alertDiv.style.cssText += `
          position: fixed;
          top: 20px;
          right: 20px;
          z-index: 10000;
          min-width: 300px;
          max-width: 400px;
        `;
        document.body.appendChild(alertDiv);
      }

      // Adicionar animação CSS
      const style = document.createElement('style');
      style.textContent = `
        @keyframes slideInDown {
          from {
            transform: translateY(-20px);
            opacity: 0;
          }
          to {
            transform: translateY(0);
            opacity: 1;
          }
        }
        .custom-alert {
          transition: all 0.3s ease-out;
        }
        .custom-alert.fade-out {
          opacity: 0;
          transform: translateY(-10px);
        }
      `;
      if (!document.head.querySelector('style[data-alert-styles]')) {
        style.setAttribute('data-alert-styles', 'true');
        document.head.appendChild(style);
      }

      // Auto-remover após 8 segundos
      setTimeout(() => {
        if (alertDiv.parentNode) {
          alertDiv.classList.add('fade-out');
          setTimeout(() => {
            if (alertDiv.parentNode) {
              alertDiv.remove();
            }
          }, 300);
        }
      }, 8000);
    }

    // Helper: modal de confirmação de vinculação (Promise-based)
    function confirmarVinculoFuncionario(funcionario, matchType){
      return new Promise(resolve => {
        try {
          const modalEl = document.getElementById('modalMatchFuncionario');
          const resumo = document.getElementById('matchFuncionarioResumo');
          const aviso = document.getElementById('matchFuncionarioAviso');
          aviso.classList.add('d-none'); aviso.textContent='';
          const cpfFmt = (window.WDMasks && funcionario?.cpf) ? window.WDMasks.formatCPF(funcionario.cpf) : (funcionario?.cpf || '-');
          const linha1 = `<strong>${(funcionario?.nome||'Funcionário')}</strong>`;
          const linha2 = `CPF: ${cpfFmt}${funcionario?.email? ' · E-mail: ' + funcionario.email : ''}`;
          const linha3 = matchType ? `<span class="badge text-bg-secondary">match: ${matchType}</span>` : '';
          resumo.innerHTML = `${linha1}<br><small>${linha2}</small><div class="mt-1">${linha3}</div>`;

          const modal = new bootstrap.Modal(modalEl);
          const btnOk = document.getElementById('btnConfirmarMatch');
          const btnCancel = document.getElementById('btnCancelarMatch');

          const onOk = ()=>{ cleanup(); resolve(true); };
          const onCancel = ()=>{ cleanup(); resolve(false); };
          function onHide(){ cleanup(); resolve(false); }
          function cleanup(){
            btnOk.removeEventListener('click', onOk);
            btnCancel.removeEventListener('click', onCancel);
            modalEl.removeEventListener('hidden.bs.modal', onHide);
          }

          btnOk.addEventListener('click', onOk);
          btnCancel.addEventListener('click', onCancel);
          modalEl.addEventListener('hidden.bs.modal', onHide);
          modal.show();
        } catch(_e){ resolve(false); }
      });
    }

    // Função para submeter formulário via AJAX (com pré-checagem de Funcionário correspondente)
    window.submitUsuarioForm = async function(event) {
      event.preventDefault();

      const form = event.target;
      const btnSubmit = document.getElementById('btnSubmitUsuario');
      const spinner = btnSubmit.querySelector('.spinner-border');

  // Mostrar loading
  btnSubmit.disabled = true;
  spinner.classList.remove('d-none');

  // Helper para encerrar estado de loading em early-returns
  const stopLoading = () => {
    try {
      spinner.classList.add('d-none');
      updateUserFormAvailability();
    } catch(_){}
  };

      try {
        // Coletar dados do formulário manualmente
        const formData = new FormData(form);
        const data = {};

        for (let [key, value] of formData.entries()) {
          // Converter valores vazios para null quando apropriado
          if (value === '' && ['unidade_id', 'funcionario_id'].includes(key)) {
            data[key] = null;
          } else {
            data[key] = value;
          }
        }

        if (!data.role) {
          showAlert('Selecione o nível de acesso antes de continuar.', 'warning');
          stopLoading();
          return false;
        }

        // Validação básica de e-mail (o atributo required do HTML não é acionado pois interceptamos o submit)
        const emailVal = (data.email || '').trim().toLowerCase();
        if (!emailVal) {
          showAlert('E-mail é obrigatório.', 'warning');
          stopLoading();
          return false;
        }
        data.email = emailVal;

        const emailPrecheck = await runEmailPrecheck(emailVal);
        const emailExistsGlobal = emailPrecheck?.exists === true;
        const emailValidated = hasValidatedEmail();
        const blockedUnidadeIds = new Set(
          (Array.isArray(emailPrecheck?.blockedUnidadeIds) ? emailPrecheck.blockedUnidadeIds : [])
            .map((blockedId) => normalizeIdValue(blockedId))
            .filter(Boolean)
        );

        if (!emailValidated) {
          showAlert('Valide o e-mail antes de continuar.', 'warning');
          stopLoading();
          return false;
        }

        // Validação: unidade obrigatória para user e diretor
        const userRole = data.role;
        const unidadeId = data.unidade_id;

        if ((userRole === 'user' || userRole === 'diretor') && (!unidadeId || unidadeId === '')) {
          showAlert('Para usuários e diretores, é obrigatório selecionar uma unidade vinculada.', 'warning');
          stopLoading();
          return false;
        }

        if (emailExistsGlobal) {
          if (!currentRoleAllowsContextualLink()) {
            showAlert('Este e-mail já existe globalmente. Para adicionar novo vínculo, selecione User ou Diretor e uma unidade disponível.', 'warning');
            stopLoading();
            return false;
          }
          if (!hasCompleteExistingIdentity()) {
            showAlert('Este e-mail já existe globalmente, mas a identidade está sem Nome ou CPF completo. Corrija isso fora deste fluxo antes de vincular.', 'warning');
            stopLoading();
            return false;
          }
          if (getAvailableUnitOptionCount() === 0) {
            showAlert('Este usuário já está vinculado a todas as unidades disponíveis para este formulário.', 'warning');
            stopLoading();
            return false;
          }
          if (!unidadeId) {
            showAlert('Este e-mail já existe globalmente. Selecione uma unidade disponível para adicionar novo vínculo.', 'warning');
            stopLoading();
            return false;
          }
          if (blockedUnidadeIds.has(normalizeIdValue(unidadeId))) {
            showSameUnitDuplicateModal({ email: emailVal, unidadeId, force: true });
            stopLoading();
            return false;
          }
        }

        // Validação de CPF (se informado)
        if (data.cpf && window.WDMasks && !window.WDMasks.isValidCPF(data.cpf)) {
          showAlert('CPF inválido. Corrija o CPF antes de continuar.', 'warning');
          stopLoading();
          return false;
        }

        // Lógica para senha inicial
        const senhaInicial = data.senha;
        const criarNovoFuncionario = data.criarNovoFuncionario === 'on';
        const funcionarioId = data.funcionario_id;

        if (emailExistsGlobal) {
          delete data.senha;
        }

        // Se senha estiver vazia OU se for criado a partir de funcionário, gerar senha automaticamente
        if (!emailExistsGlobal && (!senhaInicial || senhaInicial.trim() === '' || (funcionarioId && !criarNovoFuncionario))) {
          data.senha = gerarSenha(8);
          console.log('Senha provisória gerada automaticamente:', data.senha);
        } else if (!emailExistsGlobal) {
          // Validar senha fornecida manualmente
          const senhaFornecida = senhaInicial.trim();
          if (senhaFornecida.length < 6) {
            showAlert('A senha deve ter pelo menos 6 caracteres.', 'warning');
            stopLoading();
            return false;
          }
          data.senha = senhaFornecida;
          console.log('Usando senha inicial fornecida pelo usuário');
        }

        // Pré-checagem: se não foi escolhido um funcionario_id explicitamente, mas há CPF+unidade ou e-mail,
        // consultar endpoint de match e oferecer opção de vincular
        const emailNorm = (data.email || '').toLowerCase();
        const cpfDigits = (data.cpf || '').replace(/\D/g,'');
        const canPrecheck = (!data.funcionario_id || data.funcionario_id === '') && ((cpfDigits && unidadeId) || emailNorm);
        if (canPrecheck) {
          try {
            const qs = new URLSearchParams();
            if (cpfDigits) qs.set('cpf', cpfDigits);
            if (unidadeId) qs.set('unidade_id', unidadeId);
            if (emailNorm) qs.set('email', emailNorm);
            const resMatch = await fetch(basePath + '/api/funcionarios/match?' + qs.toString(), { headers: { 'X-Requested-With':'XMLHttpRequest' } });
            let matchJson = null; try { matchJson = await resMatch.json(); } catch(_){ matchJson = null; }
            const payload = matchJson && (matchJson.data || matchJson); // compat: ok() envolve em {success,data}
            if (resMatch.ok && payload?.exists && payload?.funcionario) {
              if (payload.canLink) {
                const aceitar = await confirmarVinculoFuncionario(payload.funcionario, payload.matchType);
                if (!aceitar) {
                  // Usuário optou por não vincular; cancelar criação
                  showAlert('Criação cancelada pelo operador.', 'info');
                  stopLoading();
                  return false;
                }
                // Vincular: força funcionario_id e desmarca criação de novo funcionário
                data.funcionario_id = payload.funcionario._id;
                if (data.criarNovoFuncionario) delete data.criarNovoFuncionario;
              } else {
                showAlert('Já existe um Funcionário correspondente, porém ele já está vinculado a outro usuário.', 'warning');
                stopLoading();
                return false;
              }
            }
          } catch (e) {
            console.warn('[precheck match] falhou:', e);
            // Em caso de falha na checagem, seguir fluxo normal
          }
        }

        const response = await fetch(form.action, {
          method: 'POST',
          body: JSON.stringify(data),
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

  let result = null;
  try { result = await response.json(); } catch(_e){ result = null; }

        if (response.ok) {
          // Sucesso - mostrar mensagem específica e recarregar página
          const outcome = String(result?.data?.outcome || (result?.data?.tempPassword ? 'created' : 'linked')).toLowerCase();
          const successMessage = outcome === 'linked'
            ? 'Usuário existente vinculado à unidade atual com sucesso!'
            : 'Usuário criado e vinculado à unidade com sucesso!';
          showAlert(successMessage, 'success');
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          // Erro - mostrar mensagem específica baseada no tipo de erro
          let errorMessage = 'Erro desconhecido ao criar usuário';
          let alertType = 'error';
          const serverCode = result && (result.code || result.errorCode || result.error_code);
          const serverMsg = result && (result.error || result.message);
          console.warn('[usuarios][criarUsuario] 400/erro', { status: response.status, code: serverCode, serverMsg, payload: result });
          if (serverMsg) {
            // Mapear mensagens de erro específicas com verificação mais precisa
            const errorText = String(serverMsg).toLowerCase();

            if (serverCode === 'EMAIL_REQUIRED' || errorText.includes('email obrigatório') || errorText.includes('e-mail obrigatório')) {
              errorMessage = 'E-mail é obrigatório';
            } else if (serverCode === 'USER_MEMBERSHIP_DUPLICATE' || errorText.includes('já vinculado a esta unidade')) {
            errorMessage = 'Este e-mail já está vinculado a esta unidade. Nenhum vínculo duplicado foi criado.';
              alertType = 'warning';
            } else if (serverCode === 'EMAIL_DUPLICATE' || errorText.includes('usuário já cadastrado') || errorText.includes('usuário já existe') || errorText.includes('email já cadastrado')) {
              errorMessage = 'Este e-mail já está cadastrado para outro usuário';
            } else if (serverCode === 'UNIT_REQUIRED' || errorText.includes('unidade é obrigatória') || errorText.includes('campo obrigatório para usuários e diretores')) {
              errorMessage = 'Selecione uma unidade para usuários e diretores';
            } else if (serverCode === 'CPF_REQUIRED' || errorText.includes('cpf é obrigatório')) {
              errorMessage = 'Informe um CPF válido para criar o funcionário automaticamente';
            } else if (errorText.includes('cpf já cadastrado')) {
              errorMessage = 'Este CPF já está cadastrado para outro usuário nesta unidade';
            } else if (errorText.includes('falha ao criar usuário') || errorText.includes('erro interno')) {
              errorMessage = 'Erro interno do servidor. Tente novamente em alguns instantes';
            } else {
              // Usar a mensagem de erro do servidor se não for uma das específicas
              errorMessage = serverMsg;
            }
          }

          showAlert(errorMessage, alertType);
        }
      } catch (error) {
        console.error('Erro na requisição:', error);
        showAlert('Erro de conexão. Verifique sua internet e tente novamente.', 'error');
      } finally {
        // Esconder loading
        spinner.classList.add('d-none');
        updateUserFormAvailability();
      }

      return false;
    };

    // Expor função global para testes (remover em produção)
    window.showAlert = showAlert;

    // Exemplo de uso (descomente para testar):
    // setTimeout(() => showAlert('Este é um exemplo de alerta de erro!', 'error'), 1000);
    // setTimeout(() => showAlert('Este é um exemplo de alerta de sucesso!', 'success'), 3000);
    // setTimeout(() => showAlert('Este é um exemplo de alerta de informação!', 'info'), 5000);

  });
  </script>

  <style>
    /* Mantém cabeçalho do modal branco (evita heranças do tema) */
    #usrDeleteConfirmModal .modal-header{ background:#fff !important; color:#212529 !important; border-bottom:1px solid rgba(0,0,0,.08) !important; }
  </style>

  <style>
  /* Scroll-limit padrão Unidades */
  #wrapperTabelaUsuarios.scroll-limit{ max-height:360px; overflow-y:auto; }
  #wrapperTabelaUsuarios.scroll-limit thead th{ position:sticky; top:0; background:#f8f9fa; z-index:2; box-shadow:0 1px 0 rgba(0,0,0,.06); }
  </style>

  <!-- Script de perfil modular -->
  <script>window.__perfilBasePath='<%= _basePath %>';</script>
  <script src="<%= _basePath %>/js/perfil-modulo.js"></script>
</body>
</html>