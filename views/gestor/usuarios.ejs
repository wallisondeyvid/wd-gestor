    async function carregarFuncionariosDisponiveis(unidadeId) {
      if (!unidadeId) {
        funcionarioSelect.innerHTML = '<option value="">-- Selecione uma unidade primeiro --</option>';
        prepareFuncionarioOptions();
        updateUserFormAvailability();
        return;
      }

      try {
        // Mostrar loading
        funcionarioSelect.innerHTML = '<option value="">Carregando...</option>';

    const response = await fetch(basePath + '/api/funcionarios/disponiveis/' + unidadeId);
        const data = await response.json();

        if (data.success) {
          let options = '<option value="">-- Nenhum --</option>';

          if (data.funcionarios && data.funcionarios.length > 0) {
            data.funcionarios.forEach(func => {
              const cpfDigits = normalizeCpfDigits(func.cpf);
              const nome = String(func.nome || '').trim();
              const email = normalizeEmailValue(func.email || '');
              const cpfLabel = formatCpfForUi(func.cpf) || (func.cpf || '-');
              options += `<option value="${func._id}" data-cpf="${cpfDigits}" data-nome="${nome}" data-email="${email}">${nome} - ${cpfLabel}</option>`;
            });
          } else {
            options += '<option value="" disabled>Nenhum funcionário disponível nesta unidade</option>';
          }

          funcionarioSelect.innerHTML = options;
          prepareFuncionarioOptions();
          updateUserFormAvailability();
        } else {
          console.error('Erro ao carregar funcionários:', data.error);
          funcionarioSelect.innerHTML = '<option value="">Erro ao carregar funcionários</option>';
          prepareFuncionarioOptions();
          updateUserFormAvailability();
        }
      } catch (error) {
        console.error('Erro na requisição:', error);
        funcionarioSelect.innerHTML = '<option value="">Erro ao carregar funcionários</option>';
        prepareFuncionarioOptions();
        updateUserFormAvailability();
      }
    }

