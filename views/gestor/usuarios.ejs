        const arr=new Uint32Array(len); crypto.getRandomValues(arr);
        return Array.from(arr,n=>chars[n%chars.length]).join('');
      }
      return Math.random().toString(36).replace(/[^a-zA-Z0-9!@#$%^&*]/gi,'').slice(-len);
    };

