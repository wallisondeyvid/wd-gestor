    async function carregarFuncionariosDisponiveisEdicao(unidadeId, funcionarioAtual = null) {
      if (!unidadeId) {
        editUserFuncionario.innerHTML = '<option value="">-- Selecione uma unidade primeiro --</option>';
        return;
      }

      try {
        // Mostrar loading
        editUserFuncionario.innerHTML = '<option value="">Carregando...</option>';

        let url = basePath + '/api/funcionarios/disponiveis/' + unidadeId;
        if (funcionarioAtual) url += '?include=' + encodeURIComponent(funcionarioAtual);
        const response = await fetch(url);
        const data = await response.json();

        if (data.success) {
          let options = '<option value="">-- Nenhum --</option>';

          if (data.funcionarios && data.funcionarios.length > 0) {
            data.funcionarios.forEach(func => {
              const selected = funcionarioAtual === func._id ? ' selected' : '';
              options += `<option value="${func._id}"${selected}>${func.nome} - ${func.cpf}</option>`;
            });
          } else {
            options += '<option value="" disabled>Nenhum funcionário disponível nesta unidade</option>';
          }

          editUserFuncionario.innerHTML = options;
        } else {
          console.error('Erro ao carregar funcionários:', data.error);
          editUserFuncionario.innerHTML = '<option value="">Erro ao carregar funcionários</option>';
        }
      } catch (error) {
        console.error('Erro na requisição:', error);
        editUserFuncionario.innerHTML = '<option value="">Erro ao carregar funcionários</option>';
      }
    }

