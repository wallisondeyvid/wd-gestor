<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _basePath = (typeof basePath === 'string' && basePath) ? basePath : (typeof moduleBasePath === 'string' && moduleBasePath) ? moduleBasePath : '/gestor'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários - WDGestor</title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap / Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Estilos centrais Gestor -->
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _basePath }) %>
  <!-- Tema moderno (paridade com Unidades / Condomínios) -->
  <link rel="stylesheet" href="/condominios/css/condominios-modern.css?v=1">
  <!-- Botões de ação padronizados por ícone -->
  <link rel="stylesheet" href="<%= _basePath %>/css/icon-buttons.css?v=1">
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
  <!-- Ajustes específicos da tabela de usuários -->
  <style>
    .wdg-users-table th,
    .wdg-users-table td{
      white-space: nowrap;     /* não quebrar linhas */
      text-align: center;      /* centralizar conteúdo */
      vertical-align: middle;
    }
    .wdg-users-table .col-email{ min-width: 300px; }
    .wdg-users-table .col-nome { min-width: 140px; }
    .wdg-users-table .col-role { min-width: 130px; }
    .wdg-users-table .col-ativo{ min-width: 110px; }
    .wdg-users-table .col-vinc { min-width: 160px; }
  .wdg-users-table .col-acoes{ width: 160px; } /* espaço otimizado para ícones */
  </style>
 </head>
<body class="wdg-layout">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>
  <%- include('../shared/partials/navbar-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user, prefixMenuPaths: false }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>

  <div class="wdg-page">
    <h4 class="mb-3 text-center page-main-title">Gerenciar Usuários</h4>
    <div class="gestor-divider"></div>

    <!-- Contêiner para alertas -->
    <div id="alerts-container" class="mt-3"></div>

    <% if (typeof dbOffline !== 'undefined' && dbOffline) { %>
      <div class="alert alert-warning mt-3" role="alert">
        Banco de dados em reconexão (modo leve). A lista pode aparecer vazia temporariamente; recarregue em alguns instantes.
      </div>
    <% } %>

    <div class="wdg-card content wdg-card-hover">
      <div class="wdg-card-body wdg-form wdg-tight">

        <!-- FORM: grid limpo e responsivo -->
  <form id="formNovoUsuario" method="POST" action="<%= _basePath %>/api/usuarios" class="row gy-3 wdg-form auto-colon" onsubmit="return submitUsuarioForm(event)">
          <!-- Linha 1 -->
          <div class="col-12 col-lg-6">
            <label class="form-label">Nome</label>
            <input name="nome" type="text" class="form-control" placeholder="Nome completo" autocomplete="name">
          </div>

          <div class="col-12 col-lg-6">
            <label class="form-label">E-mail</label>
            <input name="email" type="email" required class="form-control" placeholder="E-mail" autocomplete="email">
          </div>

          <!-- Linha 2 -->
          <div class="col-6 col-lg-3">
            <label class="form-label">CPF</label>
            <input name="cpf" id="cpfUsuario" type="text" class="form-control" placeholder="CPF" maxlength="14" autocomplete="off">
          </div>

          <div class="col-12 col-sm-6 col-lg-5">
            <label class="form-label">Senha inicial</label>
            <div class="input-group">
              <input name="senha" id="senhaInicial" type="text" class="form-control" placeholder="Deixe vazio para gerar automaticamente" autocomplete="new-password">
              <button class="btn btn-outline-primary" type="button" id="btnGerarSenha">Gerar</button>
            </div>
            <div class="form-text text-muted" id="senhaHelpText">
              <small>Se vazio, uma senha provisória será gerada automaticamente</small>
            </div>
          </div>

          <div class="col-6 col-lg-4">
            <label class="form-label">Nível de acesso</label>
            <select name="role" id="roleSelect" class="form-select">
              <option value="admin">Admin</option>
              <option value="diretor">Diretor</option>
              <option value="user" selected>User</option>
            </select>
          </div>

          <!-- Linha 3 -->
          <div class="col-12 col-lg-6">
            <label class="form-label" id="unidadeLabel">Unidade vinculada</label>
            <select name="unidade_id" id="unidadeSelect" class="form-select">
              <option value="">-- Selecionar --</option>
              <% if (typeof unidadesFiltradas !== 'undefined') { (unidadesFiltradas||[]).forEach(u => { %>
                <option value="<%= u._id %>"><%= (u.codigo && u.nome) ? u.codigo + ' - ' + u.nome : (u.nome || u.codigo || u._id) %></option>
              <% }) } %>
            </select>
            <div class="form-text text-muted" id="unidadeHelpText">
              <small>Campo obrigatório para usuários e diretores</small>
            </div>
          </div>

          <div class="col-12 col-lg-6">
            <label class="form-label">Funcionário existente</label>
            <select name="funcionario_id" id="funcionarioSelect" class="form-select">
              <option value="">-- Selecione uma unidade primeiro --</option>
            </select>
          </div>

          <!-- Linha 4 -->
          <div class="col-12 col-lg-6 d-flex align-items-center">
            <div class="form-check mt-1">
              <input class="form-check-input" type="checkbox" id="criarNovoFuncionario" name="criarNovoFuncionario">
              <label class="form-check-label" for="criarNovoFuncionario">Criar novo funcionário</label>
            </div>
          </div>

          <div class="col-12 col-lg-6 d-flex justify-content-end align-items-center">
            <!-- alinhado à direita em todas as larguras -->
            <div class="d-block ms-auto">
              <button type="submit" class="btn btn-primary" id="btnSubmitUsuario" data-mode="create">
                <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                Cadastrar
              </button>
            </div>
          </div>
        </form>
        <!-- /FORM -->

      </div>
    </div>

  <h5 class="mb-1 text-center wdg-section-title" style="margin-top:18px">Usuários cadastrados</h5>

    <!-- Controles da lista de usuários -->
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
      <div class="d-flex align-items-center gap-2">
        <label for="uPageSize" class="form-label mb-0">Mostra</label>
        <select id="uPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="100">100</option>
          <option value="200">200</option>
          <option value="300">300</option>
          <option value="400">400</option>
          <option value="500">500</option>
          <option value="1000">1000</option>
        </select>
        <span class="ms-1">itens</span>
      </div>
    </div>

    <div class="wdg-card content wdg-card-hover wdg-table wdg-users-table">
      <div id="wrapperTabelaUsuarios" class="table-responsive table-vert-max">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th class="col-email">E-mail</th>
              <th class="col-nome">Nome</th>
              <th class="col-role">Níveis de acesso</th>
              <th class="col-ativo">Ativo</th>
              <th class="col-vinc">Vinc. Funcionário</th>
              <th class="col-acoes">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% (usuarios||[]).forEach(u => { %>
        <tr data-user-id="<%= u._id %>"
          data-user-email="<%= u.email %>"
          data-user-nome="<%= u.nome || '' %>"
                  data-user-role="<%= u.role %>"
                  data-user-cpf="<%= u.cpf || '' %>"
                  data-user-unidade="<%= u.unidade_id || '' %>"
                  data-user-funcionario="<%= u.funcionario_id || '' %>">
                <td class="col-email"><%= u.email %></td>
                <td class="col-nome"><%= u.nome || '-' %></td>
                <td class="col-role"><%= u.role %></td>

                <!-- Dica: para não escapar HTML em EJS use &lt;%- ... %&gt; -->
                <td class="col-ativo">
                  <%- u.ativo
                        ? '<span class="badge bg-success">Sim</span>'
                        : '<span class="badge bg-secondary">Não</span>' %>
                </td>

                <td class="col-vinc"><%= u.funcionario_id || '-' %></td>
                <td class="col-acoes">
                  <div class="d-flex gap-1 justify-content-center flex-nowrap">
                    <% const localUser = (typeof user !== 'undefined' && user) ? user : (typeof sessionUser !== 'undefined' ? sessionUser : null); %>
                    <% const isMasterRow = (u && (u.isMaster === true || String(u.role || '').toLowerCase() === 'master')); %>
                    <% if (!isMasterRow) { %>
                      <form method="POST" action="<%= _basePath %>/api/usuarios/<%= u._id %>/toggle" class="wdg-user-action-form" data-action="toggle" data-user-id="<%= u._id %>">
                        <button class="wdg-icon-btn wdg-btn-toggle" type="submit" title="<%= u.ativo ? 'Desativar' : 'Ativar' %>" aria-label="<%= u.ativo ? 'Desativar' : 'Ativar' %>">
                          <img src="<%= _basePath %>/images/ativar.png" alt="<%= u.ativo ? 'Desativar' : 'Ativar' %>" onerror="this.outerHTML='&lt;i class=\'bi bi-power\'&gt;&lt;/i&gt;'">
                        </button>
                      </form>
                    <% } %>
                    <% if (localUser && (localUser.isMaster || localUser.role === 'admin')) { %>
                      <button type="button" class="wdg-icon-btn btn-edit-user" title="Editar" aria-label="Editar">
                        <img src="<%= _basePath %>/images/editar.png" alt="Editar" onerror="this.outerHTML='&lt;i class=\'bi bi-pencil\'&gt;&lt;/i&gt;'">
                      </button>
                    <% } %>
                    <% const isSelf = (localUser && (String(localUser._id) === String(u._id))); %>
                    <% if (localUser && localUser.isMaster && !isMasterRow && !isSelf) { %>
                      <form method="POST" action="<%= _basePath %>/api/usuarios/<%= u._id %>/delete" class="wdg-user-action-form" data-action="delete" data-user-id="<%= u._id %>">
                        <button class="wdg-icon-btn wdg-btn-delete" type="submit" title="Excluir" aria-label="Excluir">
                          <img src="<%= _basePath %>/images/excluir.png" alt="Excluir" onerror="this.outerHTML='&lt;i class=\'bi bi-trash\'&gt;&lt;/i&gt;'">
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="uPaginas" class="wdg-pager mt-2"></div>
  </div>

  <!-- Modal: confirmar exclusão de usuário -->
  <div class="modal fade" id="usrDeleteConfirmModal" tabindex="-1" aria-labelledby="usrDeleteConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="usrDeleteConfirmTitle">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
            Confirmar exclusão
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">Deseja excluir o usuário <strong id="usrDeleteConfirmName">este usuário</strong>?</p>
          <p class="mb-0 text-danger"><strong>Esta exclusão é definitiva</strong> e não pode ser desfeita.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="usrDeleteConfirmYes">Excluir definitivamente</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de confirmação de vinculação de Funcionário -->
  <div class="modal fade" id="modalMatchFuncionario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Vincular ao Funcionário existente?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div id="matchFuncionarioResumo" class="mb-2"></div>
          <div class="small text-muted">Detectamos um Funcionário correspondente. Você deseja vincular este usuário a ele?</div>
          <div id="matchFuncionarioAviso" class="text-danger mt-2 d-none"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="btnCancelarMatch">Cancelar</button>
          <button type="button" class="btn btn-outline-primary" id="btnConfirmarMatch">Vincular</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Editar Usuário -->
  <div class="modal fade modal-sheet theme-blue" id="modalEditarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
  <form method="POST" id="formEditarUsuario" class="wdg-form auto-colon">
          <div class="modal-header">
            <h5 class="modal-title">Editar Usuário</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body row g-2 wdg-form wdg-tight">
            <input type="hidden" name="_id" id="editUserId">
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">E-mail</label>
              <input type="text" id="editUserEmail" class="form-control" disabled>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Nome</label>
              <input type="text" name="nome" id="editUserNome" class="form-control" autocomplete="name">
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">CPF</label>
              <input type="text" name="cpf" id="editUserCpf" class="form-control" maxlength="14" autocomplete="off">
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Nível de acesso</label>
              <select name="role" id="editUserRole" class="form-select">
                <option value="admin">Admin</option>
                <option value="diretor">Diretor</option>
                <option value="user">User</option>
              </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Unidade vinculada</label>
              <select name="unidade_id" id="editUserUnidade" class="form-select">
                <option value="">-- Nenhuma --</option>
                <% if (typeof unidadesFiltradas !== 'undefined') { (unidadesFiltradas||[]).forEach(u2 => { %>
                  <option value="<%= u2._id %>"><%= (u2.codigo && u2.nome) ? u2.codigo + ' - ' + u2.nome : (u2.nome || u2.codigo || u2._id) %></option>
                <% }) } %>
              </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Funcionário</label>
              <select name="funcionario_id" id="editUserFuncionario" class="form-select">
                <option value="">-- Selecione uma unidade primeiro --</option>
              </select>
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-outline-primary">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

    <!-- Utilitários de máscaras e validações (CPF, CNPJ, etc.) -->
  <script src="<%= _basePath %>/js/core/masks.js" defer></script>

  <style>
    /* Correções específicas para o modal Editar Usuário: evitar overflow e garantir responsividade */
    #modalEditarUsuario .modal-dialog { max-width: 820px; width: calc(100% - 1rem); margin: .75rem auto; }
    #modalEditarUsuario .modal-content { overflow: hidden; }
    #modalEditarUsuario .modal-body { max-height: 72vh; overflow-y: auto; }
    #modalEditarUsuario .form-control, #modalEditarUsuario .form-select, #modalEditarUsuario .input-group { max-width: 100%; min-width: 0; }
  </style>

  <script>
  document.addEventListener('DOMContentLoaded', function(){
    // Base path resolvido no servidor e exposto no window; evitar uso de `${_basePath}` que gera ReferenceError
    const basePath = (window.__perfilBasePath || '<%= _basePath %>').replace(/\/$/, '');

    // =============================================================
    // Modal de confirmação de exclusão
    // =============================================================
    const usrDeleteModalEl = document.getElementById('usrDeleteConfirmModal');
    const usrDeleteNameEl  = document.getElementById('usrDeleteConfirmName');
    const usrDeleteYesBtn  = document.getElementById('usrDeleteConfirmYes');

    function askDeleteUsuarioConfirm(label){
      const labelTxt = (label && String(label).trim()) ? String(label).trim() : 'este usuário';
      const fallbackMsg = `Deseja excluir o usuário "${labelTxt}"?\n\nEsta exclusão é definitiva e não pode ser desfeita.`;

      if (!usrDeleteModalEl || !usrDeleteYesBtn || !(window.bootstrap && window.bootstrap.Modal)) {
        return Promise.resolve(window.confirm(fallbackMsg));
      }

      if (usrDeleteNameEl) usrDeleteNameEl.textContent = labelTxt;
      const modal = window.bootstrap.Modal.getOrCreateInstance(usrDeleteModalEl);

      return new Promise((resolve) => {
        let resolved = false;

        const cleanup = () => {
          usrDeleteModalEl.removeEventListener('hidden.bs.modal', onHidden);
          usrDeleteYesBtn.removeEventListener('click', onConfirm);
        };

        const onHidden = () => {
          if (resolved) return;
          resolved = true;
          cleanup();
          resolve(false);
        };

        const onConfirm = () => {
          if (resolved) return;
          resolved = true;
          cleanup();
          resolve(true);
          modal.hide();
        };

        usrDeleteModalEl.addEventListener('hidden.bs.modal', onHidden);
        usrDeleteYesBtn.addEventListener('click', onConfirm);
        modal.show();
      });
    }
    // =============================================================
    // AÇÕES USUÁRIOS (Toggle / Delete) via AJAX
    // =============================================================
    const tableBody = document.querySelector('.wdg-users-table tbody');
    function flashRow(tr, color){
      if(!tr) return; const orig = tr.style.backgroundColor; tr.style.backgroundColor = color||'#fff3cd';
      setTimeout(()=>{ tr.style.transition='background-color .6s'; tr.style.backgroundColor=orig||''; setTimeout(()=>{ tr.style.transition=''; },700); }, 80);
    }
    async function postJsonOrForm(url){
      const res = await fetch(url, { method:'POST', headers:{ 'X-Requested-With':'XMLHttpRequest' } });
      let data = null; try { data = await res.json(); } catch(_){ }
      return { ok: res.ok, status: res.status, data };
    }
    function updateActiveBadge(tr, ativo){
      const td = tr.querySelector('.col-ativo'); if(!td) return;
      td.innerHTML = ativo ? '<span class="badge bg-success">Sim</span>' : '<span class="badge bg-secondary">Não</span>';
      // Atualiza tooltip/título do botão toggle
      const btn = tr.querySelector('.wdg-btn-toggle');
      if(btn){
        btn.title = ativo ? 'Desativar' : 'Ativar';
        btn.setAttribute('aria-label', btn.title);
      }
    }
    tableBody?.addEventListener('submit', async (e)=>{
      const form = e.target.closest('.wdg-user-action-form');
      if(!form) return; e.preventDefault();
      const action = form.getAttribute('data-action');
      const tr = form.closest('tr');
      const url = form.getAttribute('action');
      if(action === 'delete'){
        const nome = tr?.getAttribute('data-user-nome') || '';
        const email = tr?.getAttribute('data-user-email') || '';
        const label = (nome && String(nome).trim()) ? nome : email;
        const ok = await askDeleteUsuarioConfirm(label);
        if(!ok) return;
      }
      form.classList.add('disabled');
      const { ok, data } = await postJsonOrForm(url);
      form.classList.remove('disabled');
      if(!ok){
        const msg = (data && (data.error||data.message)) || 'Falha na operação';
        if(window.showAlert) window.showAlert(msg, 'error'); else alert(msg);
        return;
      }
      if(action === 'toggle'){
        const ativo = data?.ativo;
        updateActiveBadge(tr, ativo);
        flashRow(tr, ativo ? '#d1f7d6' : '#ececec');
        if(window.showAlert) window.showAlert('Status atualizado', 'success');
      } else if(action === 'delete'){
        tr.remove();
        if(window.showAlert) window.showAlert('Usuário excluído', 'success');
      }
    });

    // =============================================================
    // FIM AÇÕES USUÁRIOS
    // =============================================================
    // =============================================================
    // Paginação (oculta/exibe linhas existentes)
    // =============================================================
    (function initUsersPagination(){
      const tbody = document.querySelector('.wdg-users-table tbody');
      const pager = document.getElementById('uPaginas');
      const pageSizeSel = document.getElementById('uPageSize');
      if (!tbody || !pager || !pageSizeSel) return;
      let allRows = Array.from(tbody.querySelectorAll('tr[data-user-id]'));
      // Scroll-limit e cabeçalho sticky
      const wrapper = document.getElementById('wrapperTabelaUsuarios');
      if(wrapper){ const dataRows = allRows; if(dataRows.length > 4){ wrapper.classList.add('scroll-limit'); } }
      function getPageSize(){ const v=parseInt(pageSizeSel.value,10); return (!isNaN(v)&&v>0)? v : 50; }
      const state = { page: 0 };
      function mkBtn(label, go, dis){ const b=document.createElement('button'); b.type='button'; b.textContent=label; b.disabled=!!dis; b.addEventListener('click', ()=>{ state.page=go; render(); }); return b; }
      function buildPager(totalPages, totalItems){
        pager.innerHTML='';
        if (totalPages <= 1){
          const info=document.createElement('div'); info.className='w-100 text-center mt-1'; info.style.fontSize='.7rem'; info.textContent='Total: '+totalItems+' usuário(s)'; pager.appendChild(info); return;
        }
        const win=5; let start=Math.max(0, state.page-Math.floor(win/2)); let end=Math.min(totalPages-1, start+win-1);
        pager.appendChild(mkBtn('<<',0,state.page===0)); pager.appendChild(mkBtn('<',state.page-1,state.page===0));
        if(start>0){ const b0=mkBtn('1',0,false); if(state.page===0) b0.classList.add('active'); pager.appendChild(b0); const dots=document.createElement('span'); dots.textContent='...'; dots.style.padding='0 .4rem'; pager.appendChild(dots); }
        for(let p=start;p<=end;p++){ const b=mkBtn(String(p+1),p,false); if(p===state.page) b.classList.add('active'); pager.appendChild(b); }
        if(end<totalPages-1){ const dots2=document.createElement('span'); dots2.textContent='...'; dots2.style.padding='0 .4rem'; pager.appendChild(dots2); const blast=mkBtn(String(totalPages), totalPages-1,false); if(state.page===totalPages-1) blast.classList.add('active'); pager.appendChild(blast); }
        pager.appendChild(mkBtn('>', state.page+1, state.page===totalPages-1)); pager.appendChild(mkBtn('>>', totalPages-1, state.page===totalPages-1));
        const info2=document.createElement('div'); info2.className='w-100 text-center mt-1'; info2.style.fontSize='.7rem'; info2.textContent='Total: '+totalItems+' usuário(s)'; pager.appendChild(info2);
      }
      function render(){
        const size = getPageSize();
        const totalPages = Math.ceil(allRows.length / size) || 1;
        if (state.page < 0) state.page = 0; if (state.page >= totalPages) state.page = totalPages - 1;
        const start = state.page * size; const end = Math.min(allRows.length, start + size);
        allRows.forEach((tr, idx)=>{ tr.style.display = (idx>=start && idx<end) ? '' : 'none'; });
        buildPager(totalPages, allRows.length);
      }
      pageSizeSel.addEventListener('change', ()=>{ state.page=0; render(); });
      render();
    })();
