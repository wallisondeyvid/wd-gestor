<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <% const _basePath = (typeof basePath === 'string' && basePath) ? basePath : (typeof moduleBasePath === 'string' && moduleBasePath) ? moduleBasePath : '/gestor'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários - WDGestor</title>
  <%- include('partials/favicon') %>

  <!-- Bootstrap / Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Estilos centrais Gestor -->
  <%- include('../shared/partials/head-styles-gestor', { moduleBasePath: _basePath }) %>
  <!-- Tema moderno (paridade com Unidades / Condomínios) -->
  <link rel="stylesheet" href="/condominios/css/condominios-modern.css?v=1">
  <!-- Botões de ação padronizados por ícone -->
  <link rel="stylesheet" href="<%= _basePath %>/css/icon-buttons.css?v=1">
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
  <!-- Ajustes específicos da tabela de usuários -->
  <style>
    .wdg-users-table th,
    .wdg-users-table td{
      white-space: nowrap;     /* não quebrar linhas */
      text-align: center;      /* centralizar conteúdo */
      vertical-align: middle;
    }
    .wdg-users-table .col-email{ min-width: 300px; }
    .wdg-users-table .col-nome { min-width: 140px; }
    .wdg-users-table .col-role { min-width: 130px; }
    .wdg-users-table .col-ativo{ min-width: 110px; }
    .wdg-users-table .col-vinc { min-width: 160px; }
  .wdg-users-table .col-acoes{ width: 160px; } /* espaço otimizado para ícones */
    .wdg-users-table th.col-email,
    .wdg-users-table td.col-email{ text-align: left; }
    .wdg-users-table td.col-email{ white-space: normal; }
    .wdg-user-identity{ display:flex; flex-direction:column; gap:6px; align-items:flex-start; }
    .wdg-user-email{ font-weight:600; word-break:break-word; }
    .wdg-user-meta{ display:flex; flex-wrap:wrap; gap:6px; align-items:center; font-size:.78rem; color:#6c757d; }
    .wdg-user-memberships{ display:flex; flex-wrap:wrap; gap:6px; }
    .wdg-user-membership-chip{ display:inline-flex; flex-wrap:wrap; gap:4px; align-items:center; padding:3px 8px; border-radius:999px; background:#f8f9fa; border:1px solid #dee2e6; font-size:.75rem; color:#495057; }
    .wdg-user-membership-chip.is-inactive{ background:#fff3cd; border-color:#ffe69c; color:#7a5a00; }
    .wdg-user-legacy-note{ font-size:.75rem; color:#8a6d3b; }
    .wdg-email-precheck-card{ border:1px solid #dee2e6; border-radius:10px; background:#f8f9fa; padding:10px 12px; }
    .wdg-email-precheck-card.is-pending{ background:#eef4ff; border-color:#c9dafc; }
    .wdg-email-precheck-card.is-new{ background:#eef9f0; border-color:#b7dfbf; }
    .wdg-email-precheck-card.is-existing{ background:#fff8e1; border-color:#f0d58c; }
    .wdg-email-precheck-title{ font-weight:600; margin-bottom:4px; }
    .wdg-email-precheck-meta{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
    .wdg-email-precheck-units{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
    .wdg-email-precheck-warning{ font-size:.78rem; margin-top:8px; color:#8a6d3b; }
  </style>
 </head>
<body class="wdg-layout">
  <%- include('../shared/partials/header-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>
  <%- include('../shared/partials/navbar-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user, prefixMenuPaths: false }) %>
  <%- include('../shared/partials/perfil-shared', { moduleBasePath: _basePath, moduleLabel: 'Gestor', user }) %>

  <div class="wdg-page">
    <h4 class="mb-3 text-center page-main-title">Gerenciar Usuários</h4>
    <div class="gestor-divider"></div>

    <!-- Contêiner para alertas -->
    <div id="alerts-container" class="mt-3"></div>

    <% if (typeof dbOffline !== 'undefined' && dbOffline) { %>
      <div class="alert alert-warning mt-3" role="alert">
        Banco de dados em reconexão (modo leve). A lista pode aparecer vazia temporariamente; recarregue em alguns instantes.
      </div>
    <% } %>

    <div class="wdg-card content wdg-card-hover">
      <div class="wdg-card-body wdg-form wdg-tight">

        <div class="alert alert-info py-2 px-3 mb-3" role="note" id="usuarioCreateOrLinkHint">
          <strong>Como funciona o vínculo multiunidade:</strong>
          <span>E-mail novo cria o usuário e o vínculo da unidade atual. E-mail já existente em outra unidade adiciona o vínculo à unidade atual. E-mail já vinculado nesta unidade gera aviso e não duplica o vínculo.</span>
        </div>

        <!-- FORM: grid limpo e responsivo -->
  <form id="formNovoUsuario" method="POST" action="<%= _basePath %>/api/usuarios" class="row gy-3 wdg-form auto-colon" onsubmit="return submitUsuarioForm(event)">
          <!-- Linha 1 -->
          <div class="col-12 col-lg-4">
            <label class="form-label">Nível de acesso</label>
            <select name="role" id="roleSelect" class="form-select" required>
              <option value="" selected>-- Selecione o nível de acesso --</option>
              <option value="master" disabled>Master</option>
              <option value="admin">Admin</option>
              <option value="diretor">Diretor</option>
              <option value="user">User</option>
            </select>
            <div class="form-text text-muted" id="roleHelpText">
              <small>Escolha primeiro o papel visível deste vínculo. Master permanece fora deste formulário.</small>
            </div>
          </div>

          <div class="col-12 col-lg-8">
            <label class="form-label" id="unidadeLabel">Unidade vinculada</label>
            <select name="unidade_id" id="unidadeSelect" class="form-select" disabled>
              <option value="">-- Selecionar --</option>
              <% if (typeof unidadesFiltradas !== 'undefined') { (unidadesFiltradas||[]).forEach(u => { %>
                <option value="<%= u._id %>"><%= (u.codigo && u.nome) ? u.codigo + ' - ' + u.nome : (u.nome || u.codigo || u._id) %></option>
              <% }) } %>
            </select>
            <div class="form-text text-muted" id="unidadeHelpText">
              <small>Selecione o nível de acesso primeiro.</small>
            </div>
          </div>

          <!-- Linha 2 -->
          <div class="col-12 col-lg-6">
            <label class="form-label">E-mail</label>
            <input name="email" type="email" required class="form-control" placeholder="Selecione o nível de acesso e a unidade primeiro" autocomplete="email" id="emailUsuario" disabled>
            <div class="form-text text-muted" id="emailHelpText">
              <small>O e-mail é a chave operacional do fluxo. Depois da validação, os demais campos serão liberados com base nesta identidade.</small>
            </div>
            <div id="emailPrecheckCard" class="wdg-email-precheck-card d-none mt-2" aria-live="polite">
              <div class="wdg-email-precheck-title" id="emailPrecheckTitle"></div>
              <div class="small text-muted" id="emailPrecheckMessage"></div>
              <div id="emailPrecheckMeta" class="wdg-email-precheck-meta d-none"></div>
              <div id="emailPrecheckUnits" class="wdg-email-precheck-units d-none"></div>
              <div id="emailPrecheckWarning" class="wdg-email-precheck-warning d-none"></div>
            </div>
          </div>

          <div class="col-12 col-lg-6">
            <label class="form-label">Nome</label>
            <input name="nome" id="nomeUsuario" type="text" class="form-control" placeholder="Nome completo" autocomplete="name" disabled>
            <div class="form-text text-muted" id="nomeHelpText">
              <small>Disponível após validar o e-mail.</small>
            </div>
          </div>

          <!-- Linha 3 -->
          <div class="col-12 col-lg-4">
            <label class="form-label">CPF</label>
            <input name="cpf" id="cpfUsuario" type="text" class="form-control" placeholder="CPF" maxlength="14" autocomplete="off" disabled>
            <div class="form-text text-muted" id="cpfHelpText">
              <small>Disponível após validar o e-mail.</small>
            </div>
          </div>

          <div class="col-12 col-lg-4">
            <label class="form-label">Funcionário existente</label>
            <select name="funcionario_id" id="funcionarioSelect" class="form-select" disabled>
              <option value="">-- Valide o e-mail primeiro --</option>
            </select>
            <div class="form-text text-muted" id="funcionarioHelpText">
              <small>Disponível após validar o e-mail e escolher uma unidade.</small>
            </div>
          </div>

          <div class="col-12 col-sm-6 col-lg-4">
            <label class="form-label">Senha inicial</label>
            <div class="input-group">
              <input name="senha" id="senhaInicial" type="text" class="form-control" placeholder="Valide o e-mail para continuar" autocomplete="new-password" disabled>
              <button class="btn btn-outline-primary" type="button" id="btnGerarSenha" disabled>Gerar</button>
            </div>
            <div class="form-text text-muted" id="senhaHelpText">
              <small>Disponível após validar o e-mail.</small>
            </div>
          </div>

          <!-- Linha 4 -->
          <div class="col-12 col-lg-6">
            <div class="form-check mt-1">
              <input class="form-check-input" type="checkbox" id="criarNovoFuncionario" name="criarNovoFuncionario" disabled>
              <label class="form-check-label" for="criarNovoFuncionario">Criar novo funcionário</label>
            </div>
            <div class="form-text text-muted" id="criarNovoFuncionarioHelpText">
              <small>Disponível após validar o e-mail.</small>
            </div>
          </div>

          <div class="col-12 col-lg-6 d-flex justify-content-end align-items-center">
            <!-- alinhado à direita em todas as larguras -->
            <div class="d-block ms-auto">
              <button type="submit" class="btn btn-primary" id="btnSubmitUsuario" data-mode="create" disabled>
                <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                <span id="btnSubmitUsuarioLabel">Criar usuário ou adicionar vínculo</span>
              </button>
            </div>
          </div>
        </form>
        <!-- /FORM -->

      </div>
    </div>

  <h5 class="mb-1 text-center wdg-section-title" style="margin-top:18px">Usuários cadastrados</h5>

    <!-- Controles da lista de usuários -->
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap">
      <div class="d-flex align-items-center gap-2">
        <label for="uPageSize" class="form-label mb-0">Mostra</label>
        <select id="uPageSize" class="form-select form-select-sm" style="width:auto; min-width:90px">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="100">100</option>
          <option value="200">200</option>
          <option value="300">300</option>
          <option value="400">400</option>
          <option value="500">500</option>
          <option value="1000">1000</option>
        </select>
        <span class="ms-1">itens</span>
      </div>
    </div>

    <div class="wdg-card content wdg-card-hover wdg-table wdg-users-table">
      <div id="wrapperTabelaUsuarios" class="table-responsive table-vert-max">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th class="col-email">E-mail</th>
              <th class="col-nome">Nome</th>
              <th class="col-role">Níveis de acesso</th>
              <th class="col-ativo">Ativo</th>
              <th class="col-vinc">Vinc. Funcionário</th>
              <th class="col-acoes">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% (usuarios||[]).forEach(u => { %>
        <% const membershipsSummary = Array.isArray(u.membershipsSummary) ? u.membershipsSummary : []; %>
        <% const membershipsCount = Number(u.membershipsCount || membershipsSummary.length || 0); %>
        <% const membershipsCountLabel = membershipsCount === 1 ? '1 unidade vinculada' : membershipsCount + ' unidades vinculadas'; %>
        <% const normalizedRole = String(u.role || '').toLowerCase(); %>
        <% const displayRole = normalizedRole === 'gestor' ? 'diretor' : (u.role || '-'); %>
        <% const hasLegacyMembershipGap = membershipsCount === 0 && !!u.unidade_id; %>
        <% const hasGlobalAccessWithoutContext = membershipsCount === 0 && !u.unidade_id && (normalizedRole === 'master' || normalizedRole === 'admin'); %>
        <tr data-user-id="<%= u._id %>"
          data-user-email="<%= u.email %>"
          data-user-nome="<%= u.nome || '' %>"
                  data-user-role="<%= u.role %>"
                  data-user-cpf="<%= u.cpf || '' %>"
                  data-user-unidade="<%= u.unidade_id || '' %>"
                  data-user-funcionario="<%= u.funcionario_id || '' %>">
                <td class="col-email">
                  <div class="wdg-user-identity">
                    <div class="wdg-user-email"><%= u.email %></div>
                    <div class="wdg-user-meta">
                      <span class="badge text-bg-light border">Identidade global</span>
                      <% if (membershipsCount > 0) { %>
                        <span><%= membershipsCountLabel %></span>
                      <% } else if (hasLegacyMembershipGap) { %>
                        <span>Vínculos ainda não sincronizados</span>
                      <% } else if (hasGlobalAccessWithoutContext) { %>
                        <span>Acesso global</span>
                      <% } %>
                    </div>
                    <% if (membershipsCount > 0) { %>
                      <div class="wdg-user-memberships">
                        <% membershipsSummary.forEach((membership) => { %>
                          <% const statusLabel = membership.status === 'inactive' ? 'inativo' : (membership.status === 'active' ? 'ativo' : (membership.status || 'sem status')); %>
                          <% const membershipRoleLabel = membership.papel_contextual === 'gestor' ? 'diretor' : membership.papel_contextual; %>
                          <span class="wdg-user-membership-chip <%= membership.status === 'inactive' ? 'is-inactive' : '' %>" title="unidade_id: <%= membership.unidade_id %>">
                            <span><%= membership.unidade_nome || membership.unidade_id %></span>
                            <% if (membershipRoleLabel) { %><span>· <%= membershipRoleLabel %></span><% } %>
                            <span>· <%= statusLabel %></span>
                            <% if (membership.funcionario_id) { %><span title="funcionario_id: <%= membership.funcionario_id %>">· func. vinculado</span><% } %>
                          </span>
                        <% }) %>
                      </div>
                    <% } else if (hasLegacyMembershipGap) { %>
                      <div class="wdg-user-legacy-note">Cadastro legado sem user_memberships sincronizados.</div>
                    <% } else if (hasGlobalAccessWithoutContext) { %>
                      <div class="wdg-user-legacy-note">Sem vínculo contextual necessário.</div>
                    <% } %>
                  </div>
                </td>
                <td class="col-nome"><%= u.nome || '-' %></td>
                <td class="col-role"><%= displayRole %></td>

                <!-- Dica: para não escapar HTML em EJS use &lt;%- ... %&gt; -->
                <td class="col-ativo">
                  <%- u.ativo
                        ? '<span class="badge bg-success">Sim</span>'
                        : '<span class="badge bg-secondary">Não</span>' %>
                </td>

                <td class="col-vinc"><%= u.funcionario_id || '-' %></td>
                <td class="col-acoes">
                  <div class="d-flex gap-1 justify-content-center flex-nowrap">
                    <% const localUser = (typeof user !== 'undefined' && user) ? user : (typeof sessionUser !== 'undefined' ? sessionUser : null); %>
                    <% const isMasterRow = (u && (u.isMaster === true || String(u.role || '').toLowerCase() === 'master')); %>
                    <% if (!isMasterRow) { %>
                      <form method="POST" action="<%= _basePath %>/api/usuarios/<%= u._id %>/toggle" class="wdg-user-action-form" data-action="toggle" data-user-id="<%= u._id %>">
                        <button class="wdg-icon-btn wdg-btn-toggle" type="submit" title="<%= u.ativo ? 'Desativar' : 'Ativar' %>" aria-label="<%= u.ativo ? 'Desativar' : 'Ativar' %>">
                          <img src="<%= _basePath %>/images/ativar.png" alt="<%= u.ativo ? 'Desativar' : 'Ativar' %>" onerror="this.outerHTML='&lt;i class=\'bi bi-power\'&gt;&lt;/i&gt;'">
                        </button>
                      </form>
                    <% } %>
                    <% if (localUser && (localUser.isMaster || localUser.role === 'admin')) { %>
                      <button type="button" class="wdg-icon-btn btn-edit-user" title="Editar" aria-label="Editar">
                        <img src="<%= _basePath %>/images/editar.png" alt="Editar" onerror="this.outerHTML='&lt;i class=\'bi bi-pencil\'&gt;&lt;/i&gt;'">
                      </button>
                    <% } %>
                    <% const isSelf = (localUser && (String(localUser._id) === String(u._id))); %>
                    <% if (localUser && localUser.isMaster && !isMasterRow && !isSelf) { %>
                      <form method="POST" action="<%= _basePath %>/api/usuarios/<%= u._id %>/delete" class="wdg-user-action-form" data-action="delete" data-user-id="<%= u._id %>">
                        <button class="wdg-icon-btn wdg-btn-delete" type="submit" title="Excluir" aria-label="Excluir">
                          <img src="<%= _basePath %>/images/excluir.png" alt="Excluir" onerror="this.outerHTML='&lt;i class=\'bi bi-trash\'&gt;&lt;/i&gt;'">
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="uPaginas" class="wdg-pager mt-2"></div>
  </div>

  <!-- Modal: confirmar exclusão de usuário -->
  <div class="modal fade" id="usrDeleteConfirmModal" tabindex="-1" aria-labelledby="usrDeleteConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="usrDeleteConfirmTitle">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
            Confirmar exclusão
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">Deseja excluir o usuário <strong id="usrDeleteConfirmName">este usuário</strong>?</p>
          <p class="mb-0 text-danger"><strong>Esta exclusão é definitiva</strong> e não pode ser desfeita.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="usrDeleteConfirmYes">Excluir definitivamente</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: e-mail já vinculado à unidade atual -->
  <div class="modal fade" id="usrEmailAlreadyLinkedModal" tabindex="-1" aria-labelledby="usrEmailAlreadyLinkedTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-danger">
        <div class="modal-header">
          <h5 class="modal-title text-danger" id="usrEmailAlreadyLinkedTitle">
            <i class="bi bi-x-octagon-fill me-2"></i>
            E-mail já vinculado à unidade
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0" id="usrEmailAlreadyLinkedMessage">Este e-mail já está vinculado à unidade selecionada.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-danger" data-bs-dismiss="modal" id="usrEmailAlreadyLinkedOk">OK</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de confirmação de vinculação de Funcionário -->
  <div class="modal fade" id="modalMatchFuncionario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Vincular ao Funcionário existente?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div id="matchFuncionarioResumo" class="mb-2"></div>
          <div class="small text-muted">Detectamos um Funcionário correspondente. Você deseja vincular este usuário a ele?</div>
          <div id="matchFuncionarioAviso" class="text-danger mt-2 d-none"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="btnCancelarMatch">Cancelar</button>
          <button type="button" class="btn btn-outline-primary" id="btnConfirmarMatch">Vincular</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Editar Usuário -->
  <div class="modal fade modal-sheet theme-blue" id="modalEditarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
  <form method="POST" id="formEditarUsuario" class="wdg-form auto-colon">
          <div class="modal-header">
            <h5 class="modal-title">Editar Usuário</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body row g-2 wdg-form wdg-tight">
            <input type="hidden" name="_id" id="editUserId">
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">E-mail</label>
              <input type="text" id="editUserEmail" class="form-control" disabled>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Nome</label>
              <input type="text" name="nome" id="editUserNome" class="form-control" autocomplete="name">
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">CPF</label>
              <input type="text" name="cpf" id="editUserCpf" class="form-control" maxlength="14" autocomplete="off">
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Nível de acesso</label>
              <select name="role" id="editUserRole" class="form-select">
                <option value="admin">Admin</option>
                <option value="diretor">Diretor</option>
                <option value="user">User</option>
              </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Unidade vinculada</label>
              <select name="unidade_id" id="editUserUnidade" class="form-select">
                <option value="">-- Nenhuma --</option>
                <% if (typeof unidadesFiltradas !== 'undefined') { (unidadesFiltradas||[]).forEach(u2 => { %>
                  <option value="<%= u2._id %>"><%= (u2.codigo && u2.nome) ? u2.codigo + ' - ' + u2.nome : (u2.nome || u2.codigo || u2._id) %></option>
                <% }) } %>
              </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
              <label class="form-label">Funcionário</label>
              <select name="funcionario_id" id="editUserFuncionario" class="form-select">
                <option value="">-- Selecione uma unidade primeiro --</option>
              </select>
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-outline-primary">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

    <!-- Utilitários de máscaras e validações (CPF, CNPJ, etc.) -->
  <script src="<%= _basePath %>/js/core/masks.js" defer></script>

  <style>
    /* Correções específicas para o modal Editar Usuário: evitar overflow e garantir responsividade */
    #modalEditarUsuario .modal-dialog { max-width: 820px; width: calc(100% - 1rem); margin: .75rem auto; }
    #modalEditarUsuario .modal-content { overflow: hidden; }
    #modalEditarUsuario .modal-body { max-height: 72vh; overflow-y: auto; }
    #modalEditarUsuario .form-control, #modalEditarUsuario .form-select, #modalEditarUsuario .input-group { max-width: 100%; min-width: 0; }
  </style>

  <script>
  document.addEventListener('DOMContentLoaded', function(){
    // Base path resolvido no servidor e exposto no window; evitar uso de `${_basePath}` que gera ReferenceError
    const basePath = (window.__perfilBasePath || '<%= _basePath %>').replace(/\/$/, '');

    // =============================================================
    // Modal de confirmação de exclusão
    // =============================================================
    const usrDeleteModalEl = document.getElementById('usrDeleteConfirmModal');
    const usrDeleteNameEl  = document.getElementById('usrDeleteConfirmName');
    const usrDeleteYesBtn  = document.getElementById('usrDeleteConfirmYes');

    function askDeleteUsuarioConfirm(label){
      const labelTxt = (label && String(label).trim()) ? String(label).trim() : 'este usuário';
      const fallbackMsg = `Deseja excluir o usuário "${labelTxt}"?\n\nEsta exclusão é definitiva e não pode ser desfeita.`;

      if (!usrDeleteModalEl || !usrDeleteYesBtn || !(window.bootstrap && window.bootstrap.Modal)) {
        return Promise.resolve(window.confirm(fallbackMsg));
      }

      if (usrDeleteNameEl) usrDeleteNameEl.textContent = labelTxt;
      const modal = window.bootstrap.Modal.getOrCreateInstance(usrDeleteModalEl);

      return new Promise((resolve) => {
        let resolved = false;

        const cleanup = () => {
          usrDeleteModalEl.removeEventListener('hidden.bs.modal', onHidden);
          usrDeleteYesBtn.removeEventListener('click', onConfirm);
        };

        const onHidden = () => {
          if (resolved) return;
          resolved = true;
          cleanup();
          resolve(false);
        };

        const onConfirm = () => {
          if (resolved) return;
          resolved = true;
          cleanup();
          resolve(true);
          modal.hide();
        };

        usrDeleteModalEl.addEventListener('hidden.bs.modal', onHidden);
        usrDeleteYesBtn.addEventListener('click', onConfirm);
        modal.show();
      });
    }
    // =============================================================
    // AÇÕES USUÁRIOS (Toggle / Delete) via AJAX
    // =============================================================
    const tableBody = document.querySelector('.wdg-users-table tbody');
    function flashRow(tr, color){
      if(!tr) return; const orig = tr.style.backgroundColor; tr.style.backgroundColor = color||'#fff3cd';
      setTimeout(()=>{ tr.style.transition='background-color .6s'; tr.style.backgroundColor=orig||''; setTimeout(()=>{ tr.style.transition=''; },700); }, 80);
    }
    async function postJsonOrForm(url){
      const res = await fetch(url, { method:'POST', headers:{ 'X-Requested-With':'XMLHttpRequest' } });
      let data = null; try { data = await res.json(); } catch(_){ }
      return { ok: res.ok, status: res.status, data };
    }
    function updateActiveBadge(tr, ativo){
      const td = tr.querySelector('.col-ativo'); if(!td) return;
      td.innerHTML = ativo ? '<span class="badge bg-success">Sim</span>' : '<span class="badge bg-secondary">Não</span>';
      // Atualiza tooltip/título do botão toggle
      const btn = tr.querySelector('.wdg-btn-toggle');
      if(btn){
        btn.title = ativo ? 'Desativar' : 'Ativar';
        btn.setAttribute('aria-label', btn.title);
      }
    }
    tableBody?.addEventListener('submit', async (e)=>{
      const form = e.target.closest('.wdg-user-action-form');
      if(!form) return; e.preventDefault();
      const action = form.getAttribute('data-action');
      const tr = form.closest('tr');
      const url = form.getAttribute('action');
      if(action === 'delete'){
        const nome = tr?.getAttribute('data-user-nome') || '';
        const email = tr?.getAttribute('data-user-email') || '';
        const label = (nome && String(nome).trim()) ? nome : email;
        const ok = await askDeleteUsuarioConfirm(label);
        if(!ok) return;
      }
      form.classList.add('disabled');
      const { ok, data } = await postJsonOrForm(url);
      form.classList.remove('disabled');
      if(!ok){
        const msg = (data && (data.error||data.message)) || 'Falha na operação';
        if(window.showAlert) window.showAlert(msg, 'error'); else alert(msg);
        return;
      }
      if(action === 'toggle'){
        const ativo = data?.ativo;
        updateActiveBadge(tr, ativo);
        flashRow(tr, ativo ? '#d1f7d6' : '#ececec');
        if(window.showAlert) window.showAlert('Status atualizado', 'success');
      } else if(action === 'delete'){
        tr.remove();
        if(window.showAlert) window.showAlert('Usuário excluído', 'success');
      }
    });

    // =============================================================
    // FIM AÇÕES USUÁRIOS
    // =============================================================
    // =============================================================
    // Paginação (oculta/exibe linhas existentes)
    // =============================================================
    (function initUsersPagination(){
      const tbody = document.querySelector('.wdg-users-table tbody');
      const pager = document.getElementById('uPaginas');
      const pageSizeSel = document.getElementById('uPageSize');
      if (!tbody || !pager || !pageSizeSel) return;
      let allRows = Array.from(tbody.querySelectorAll('tr[data-user-id]'));
      // Scroll-limit e cabeçalho sticky
      const wrapper = document.getElementById('wrapperTabelaUsuarios');
      if(wrapper){ const dataRows = allRows; if(dataRows.length > 4){ wrapper.classList.add('scroll-limit'); } }
      function getPageSize(){ const v=parseInt(pageSizeSel.value,10); return (!isNaN(v)&&v>0)? v : 50; }
      const state = { page: 0 };
      function mkBtn(label, go, dis){ const b=document.createElement('button'); b.type='button'; b.textContent=label; b.disabled=!!dis; b.addEventListener('click', ()=>{ state.page=go; render(); }); return b; }
      function buildPager(totalPages, totalItems){
        pager.innerHTML='';
        if (totalPages <= 1){
          const info=document.createElement('div'); info.className='w-100 text-center mt-1'; info.style.fontSize='.7rem'; info.textContent='Total: '+totalItems+' usuário(s)'; pager.appendChild(info); return;
        }
        const win=5; let start=Math.max(0, state.page-Math.floor(win/2)); let end=Math.min(totalPages-1, start+win-1);
        pager.appendChild(mkBtn('<<',0,state.page===0)); pager.appendChild(mkBtn('<',state.page-1,state.page===0));
        if(start>0){ const b0=mkBtn('1',0,false); if(state.page===0) b0.classList.add('active'); pager.appendChild(b0); const dots=document.createElement('span'); dots.textContent='...'; dots.style.padding='0 .4rem'; pager.appendChild(dots); }
        for(let p=start;p<=end;p++){ const b=mkBtn(String(p+1),p,false); if(p===state.page) b.classList.add('active'); pager.appendChild(b); }
        if(end<totalPages-1){ const dots2=document.createElement('span'); dots2.textContent='...'; dots2.style.padding='0 .4rem'; pager.appendChild(dots2); const blast=mkBtn(String(totalPages), totalPages-1,false); if(state.page===totalPages-1) blast.classList.add('active'); pager.appendChild(blast); }
        pager.appendChild(mkBtn('>', state.page+1, state.page===totalPages-1)); pager.appendChild(mkBtn('>>', totalPages-1, state.page===totalPages-1));
        const info2=document.createElement('div'); info2.className='w-100 text-center mt-1'; info2.style.fontSize='.7rem'; info2.textContent='Total: '+totalItems+' usuário(s)'; pager.appendChild(info2);
      }
      function render(){
        const size = getPageSize();
        const totalPages = Math.ceil(allRows.length / size) || 1;
        if (state.page < 0) state.page = 0; if (state.page >= totalPages) state.page = totalPages - 1;
        const start = state.page * size; const end = Math.min(allRows.length, start + size);
        allRows.forEach((tr, idx)=>{ tr.style.display = (idx>=start && idx<end) ? '' : 'none'; });
        buildPager(totalPages, allRows.length);
      }
      pageSizeSel.addEventListener('change', ()=>{ state.page=0; render(); });
      render();
    })();
      // Máscaras e validações vêm de window.WDMasks (utils/masks.js)

    const gerarSenha = (len=8) => {
      const chars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*';
      if (window.crypto?.getRandomValues) {
        const arr=new Uint32Array(len); crypto.getRandomValues(arr);
        return Array.from(arr,n=>chars[n%chars.length]).join('');
      }
      return Math.random().toString(36).replace(/[^a-zA-Z0-9!@#$%^&*]/gi,'').slice(-len);
    };

    // Novo usuário
    const btnGerar = document.getElementById('btnGerarSenha');
    const submitButton = document.getElementById('btnSubmitUsuario');
    const submitButtonLabel = document.getElementById('btnSubmitUsuarioLabel');
    const roleSelect = document.getElementById('roleSelect');
    const roleHelpText = document.getElementById('roleHelpText');
    const unidadeLabel = document.getElementById('unidadeLabel');
    const unidadeSelect = document.getElementById('unidadeSelect');
    const unidadeHelpText = document.getElementById('unidadeHelpText');
    const emailInput = document.getElementById('emailUsuario');
    const emailHelpText = document.getElementById('emailHelpText');
    const nomeInput = document.getElementById('nomeUsuario');
    const nomeHelpText = document.getElementById('nomeHelpText');
    const cpfNovo = document.getElementById('cpfUsuario');
    const cpfHelpText = document.getElementById('cpfHelpText');
    const senhaEl  = document.getElementById('senhaInicial');
    const senhaHelpText = document.getElementById('senhaHelpText');
    const criarNovoFuncionarioEl = document.getElementById('criarNovoFuncionario');
    const criarNovoFuncionarioHelpText = document.getElementById('criarNovoFuncionarioHelpText');
    const funcionarioSelect = document.getElementById('funcionarioSelect');
    const funcionarioHelpText = document.getElementById('funcionarioHelpText');
    const emailPrecheckCard = document.getElementById('emailPrecheckCard');
    const emailPrecheckTitle = document.getElementById('emailPrecheckTitle');
    const emailPrecheckMessage = document.getElementById('emailPrecheckMessage');
    const emailPrecheckMeta = document.getElementById('emailPrecheckMeta');
    const emailPrecheckUnits = document.getElementById('emailPrecheckUnits');
    const emailPrecheckWarning = document.getElementById('emailPrecheckWarning');
    const usrEmailAlreadyLinkedModalEl = document.getElementById('usrEmailAlreadyLinkedModal');
    const usrEmailAlreadyLinkedMessageEl = document.getElementById('usrEmailAlreadyLinkedMessage');
    const EMAIL_PRECHECK_DEBOUNCE_MS = 350;
    let emailPrecheckTimer = null;
    let emailPrecheckRequestId = 0;
    let emailValidationStatus = 'idle';
    let identityPrefilledFromExistingUser = false;
    let sameUnitDuplicateModalKey = '';
    let emailPrecheckState = {
      checkedEmail: '',
      exists: false,
      user: null,
      membershipsSummary: [],
      blockedUnidadeIds: [],
    };

    Array.from(unidadeSelect?.options || []).forEach((option) => {
      option.dataset.baseLabel = option.textContent;
      option.dataset.baseDisabled = option.disabled ? '1' : '0';
    });

    function normalizeEmailValue(value) {
      return String(value || '').trim().toLowerCase();
    }

    function normalizeIdValue(value) {
      return String(value || '').trim();
    }

    function normalizeCpfDigits(value) {
      return String(value || '').replace(/\D/g, '');
    }

    function normalizeComparableText(value) {
      return String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim()
        .replace(/\s+/g, ' ')
        .toLowerCase();
    }

    function isValidEmailForPrecheck(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value || '').trim());
    }

    function formatCpfForUi(value) {
      const digits = normalizeCpfDigits(value);
      if (!digits) return '';
      return window.WDMasks ? window.WDMasks.formatCPF(digits) : digits;
    }

    function formatVisibleRoleLabel(value) {
      const normalizedValue = String(value || '').trim().toLowerCase();
      if (!normalizedValue) return null;
      if (normalizedValue === 'gestor' || normalizedValue === 'diretor') return 'Diretor';
      if (normalizedValue === 'user') return 'User';
      if (normalizedValue === 'admin') return 'Admin';
      if (normalizedValue === 'master') return 'Master';
      return value;
    }

    function roleRequiresUnit(role = String(roleSelect?.value || '').trim().toLowerCase()) {
      return role === 'user' || role === 'diretor';
    }

    function hasSelectedRole() {
      return !!String(roleSelect?.value || '').trim();
    }

    function canValidateEmailNow() {
      if (!hasSelectedRole()) return false;
      if (!roleRequiresUnit()) return true;
      return !!normalizeIdValue(unidadeSelect?.value);
    }

    function currentRoleAllowsContextualLink() {
      const selectedRole = String(roleSelect?.value || '').toLowerCase();
      return selectedRole === 'user' || selectedRole === 'diretor';
    }

    function hasValidatedEmail() {
      return emailValidationStatus === 'validated' && emailPrecheckState.checkedEmail === normalizeEmailValue(emailInput?.value);
    }

    function hasExistingValidatedEmail() {
      return hasValidatedEmail() && emailPrecheckState.exists === true;
    }

    function getActiveIdentityCpfDigits() {
      return normalizeCpfDigits(cpfNovo?.value);
    }

    function getExistingIdentityCpfDigits() {
      return normalizeCpfDigits(emailPrecheckState.user?.cpf);
    }

    function hasCompleteExistingIdentity() {
      if (!hasExistingValidatedEmail()) return true;
      const nome = String(emailPrecheckState.user?.nome || '').trim();
      const cpf = getExistingIdentityCpfDigits();
      return !!nome && cpf.length === 11;
    }

    function setFieldReadOnly(field, shouldLock) {
      if (!field) return;
      field.readOnly = !!shouldLock;
      field.classList.toggle('bg-light', !!shouldLock);
    }

    function clearPrefilledIdentityFields() {
      if (!identityPrefilledFromExistingUser) return;
      if (nomeInput) nomeInput.value = '';
      if (cpfNovo) cpfNovo.value = '';
      identityPrefilledFromExistingUser = false;
    }

    function prepareFuncionarioOptions() {
      Array.from(funcionarioSelect?.options || []).forEach((option) => {
        option.dataset.baseLabel = option.dataset.baseLabel || option.textContent;
        option.dataset.baseDisabled = option.dataset.baseDisabled || (option.disabled ? '1' : '0');
        option.dataset.cpf = option.dataset.cpf || normalizeCpfDigits(option.textContent);
        option.dataset.nome = option.dataset.nome || '';
        option.dataset.email = option.dataset.email || '';
      });
    }

    function resetFuncionarioOptionState() {
      Array.from(funcionarioSelect?.options || []).forEach((option) => {
        option.textContent = option.dataset.baseLabel || option.textContent;
        option.disabled = option.dataset.baseDisabled === '1';
      });
    }

    function resetUnidadeOptionState() {
      Array.from(unidadeSelect?.options || []).forEach((option) => {
        option.textContent = option.dataset.baseLabel || option.textContent;
        option.disabled = option.dataset.baseDisabled === '1';
      });
    }

    function getAvailableUnitOptionCount() {
      return Array.from(unidadeSelect?.options || []).filter((option) => option.value && !option.disabled).length;
    }

    function resetSameUnitDuplicateModalState() {
      sameUnitDuplicateModalKey = '';
    }

    function isSelectedUnitBlocked(unidadeId = unidadeSelect?.value) {
      const selectedUnitId = normalizeIdValue(unidadeId);
      if (!selectedUnitId) return false;

      return (Array.isArray(emailPrecheckState.blockedUnidadeIds) ? emailPrecheckState.blockedUnidadeIds : [])
        .some((blockedUnidadeId) => normalizeIdValue(blockedUnidadeId) === selectedUnitId);
    }

    function showSameUnitDuplicateModal({ email = emailInput?.value, unidadeId = unidadeSelect?.value, force = false } = {}) {
      const normalizedEmail = normalizeEmailValue(email);
      const normalizedUnidadeId = normalizeIdValue(unidadeId);
      if (!normalizedEmail || !normalizedUnidadeId) return;

      const modalKey = `${normalizedEmail}::${normalizedUnidadeId}`;
      if (!force && sameUnitDuplicateModalKey === modalKey) return;
      sameUnitDuplicateModalKey = modalKey;

      const selectedOption = Array.from(unidadeSelect?.options || []).find((option) => normalizeIdValue(option.value) === normalizedUnidadeId);
      const unidadeLabel = String(selectedOption?.dataset?.baseLabel || selectedOption?.textContent || '').trim();
      const fullMessage = unidadeLabel
        ? `O e-mail ${normalizedEmail} já está vinculado à unidade selecionada (${unidadeLabel}). Nenhum novo vínculo foi criado porque este vínculo já existe.`
        : `O e-mail ${normalizedEmail} já está vinculado à unidade selecionada. Nenhum novo vínculo foi criado porque este vínculo já existe.`;

      if (usrEmailAlreadyLinkedMessageEl) {
        usrEmailAlreadyLinkedMessageEl.textContent = fullMessage;
      }

      if (!usrEmailAlreadyLinkedModalEl || !(window.bootstrap && window.bootstrap.Modal)) {
        showAlert(fullMessage, 'error');
        return;
      }

      const modal = window.bootstrap.Modal.getOrCreateInstance(usrEmailAlreadyLinkedModalEl);
      modal.show();
    }

    function hideEmailPrecheckCard() {
      if (!emailPrecheckCard) return;
      emailPrecheckCard.className = 'wdg-email-precheck-card d-none mt-2';
      emailPrecheckTitle.textContent = '';
      emailPrecheckMessage.textContent = '';
      emailPrecheckMeta.innerHTML = '';
      emailPrecheckUnits.innerHTML = '';
      emailPrecheckWarning.textContent = '';
      emailPrecheckMeta.classList.add('d-none');
      emailPrecheckUnits.classList.add('d-none');
      emailPrecheckWarning.classList.add('d-none');
    }

    function invalidateValidatedEmail({ preserveTypedIdentity = true } = {}) {
      emailValidationStatus = 'idle';
      emailPrecheckState = {
        checkedEmail: '',
        exists: false,
        user: null,
        membershipsSummary: [],
        blockedUnidadeIds: [],
      };
      resetSameUnitDuplicateModalState();
      resetUnidadeOptionState();
      hideEmailPrecheckCard();
      if (!preserveTypedIdentity || identityPrefilledFromExistingUser) {
        clearPrefilledIdentityFields();
      }
      setFieldReadOnly(nomeInput, false);
      setFieldReadOnly(cpfNovo, false);
    }

    function applyExistingIdentityToForm() {
      const user = emailPrecheckState.user || {};
      if (nomeInput) nomeInput.value = String(user.nome || '').trim();
      if (cpfNovo) cpfNovo.value = formatCpfForUi(user.cpf || '');
      identityPrefilledFromExistingUser = true;
      setFieldReadOnly(nomeInput, true);
      setFieldReadOnly(cpfNovo, true);
      nomeHelpText.innerHTML = '<small class="text-warning">Preenchido automaticamente a partir da identidade global existente.</small>';
      cpfHelpText.innerHTML = '<small class="text-warning">Preenchido automaticamente a partir da identidade global existente.</small>';
    }

    function releaseIdentityFieldsForNewUser() {
      if (identityPrefilledFromExistingUser) {
        clearPrefilledIdentityFields();
      }
      setFieldReadOnly(nomeInput, false);
      setFieldReadOnly(cpfNovo, false);
      nomeHelpText.innerHTML = '<small>Preencha o nome da identidade global que será criada.</small>';
      cpfHelpText.innerHTML = '<small>Informe o CPF da mesma pessoa antes de vincular funcionário.</small>';
    }

    function getSubmitBlockedReason() {
      if (!hasSelectedRole()) return 'Selecione o nível de acesso para continuar.';
      if (roleRequiresUnit() && !normalizeIdValue(unidadeSelect?.value)) return 'Selecione a unidade vinculada para continuar.';
      if (!isValidEmailForPrecheck(emailInput?.value)) return 'Informe um e-mail válido e valide a identidade.';
      if (emailValidationStatus === 'pending') return 'Aguarde a validação do e-mail.';
      if (!hasValidatedEmail()) return 'Valide o e-mail para liberar os demais campos.';
      if (hasExistingValidatedEmail()) {
        if (!currentRoleAllowsContextualLink()) return 'Para vincular usuário existente, selecione User ou Diretor.';
        if (!hasCompleteExistingIdentity()) return 'A identidade global existente está incompleta. Corrija nome e CPF fora deste fluxo antes de vincular.';
        if (isSelectedUnitBlocked()) return 'Este e-mail já está vinculado à unidade selecionada.';
        if (getAvailableUnitOptionCount() === 0) return 'Este usuário já está vinculado a todas as unidades disponíveis para este formulário.';
      }
      return '';
    }

    function applyFuncionarioIdentityConstraints() {
      prepareFuncionarioOptions();
      resetFuncionarioOptionState();

      const hasUnitSelected = !!normalizeIdValue(unidadeSelect?.value);
      const emailValidated = hasValidatedEmail();
      const existingUser = hasExistingValidatedEmail();
      const activeCpfDigits = getActiveIdentityCpfDigits();
      const activeEmail = normalizeEmailValue(emailInput?.value);
      const activeName = normalizeComparableText(nomeInput?.value);

      if (!emailValidated) {
        funcionarioSelect.disabled = true;
        funcionarioSelect.value = '';
        criarNovoFuncionarioEl.checked = false;
        criarNovoFuncionarioEl.disabled = true;
        funcionarioHelpText.innerHTML = '<small>Disponível após validar o e-mail e escolher uma unidade.</small>';
        criarNovoFuncionarioHelpText.innerHTML = '<small>Disponível após validar o e-mail.</small>';
        return;
      }

      if (!hasUnitSelected) {
        funcionarioSelect.disabled = true;
        funcionarioSelect.value = '';
        criarNovoFuncionarioEl.checked = false;
        criarNovoFuncionarioEl.disabled = true;
        funcionarioHelpText.innerHTML = '<small>Selecione uma unidade antes de vincular funcionário.</small>';
        criarNovoFuncionarioHelpText.innerHTML = '<small>Selecione uma unidade antes de criar funcionário.</small>';
        return;
      }

      if (activeCpfDigits.length !== 11) {
        funcionarioSelect.disabled = true;
        funcionarioSelect.value = '';
        criarNovoFuncionarioEl.checked = false;
        criarNovoFuncionarioEl.disabled = true;
        funcionarioHelpText.innerHTML = '<small>Informe um CPF válido para cruzar com o Funcionário da mesma pessoa.</small>';
        criarNovoFuncionarioHelpText.innerHTML = '<small>Informe um CPF válido para manter consistência entre User e Funcionário.</small>';
        return;
      }

      funcionarioSelect.disabled = false;
      criarNovoFuncionarioEl.disabled = false;

      let availableCompatibleOptions = 0;
      Array.from(funcionarioSelect?.options || []).forEach((option) => {
        if (!option.value) return;
        const optionCpf = normalizeCpfDigits(option.dataset.cpf || option.textContent);
        const optionEmail = normalizeEmailValue(option.dataset.email || '');
        const optionName = normalizeComparableText(option.dataset.nome || '');
        let incompatibilityReason = '';

        if (optionCpf !== activeCpfDigits) {
          incompatibilityReason = 'CPF divergente da identidade';
        } else if (optionEmail && activeEmail && optionEmail !== activeEmail) {
          incompatibilityReason = 'e-mail divergente da identidade';
        } else if (optionName && activeName && optionName !== activeName) {
          incompatibilityReason = 'nome divergente da identidade';
        }

        if (!incompatibilityReason) {
          availableCompatibleOptions += 1;
          return;
        }
        option.disabled = true;
        option.textContent = `${option.dataset.baseLabel || option.textContent} (${incompatibilityReason})`;
      });

      const selectedOption = funcionarioSelect.options[funcionarioSelect.selectedIndex] || null;
      if (selectedOption?.disabled) {
        funcionarioSelect.value = '';
      }

      if (existingUser) {
        funcionarioHelpText.innerHTML = availableCompatibleOptions > 0
          ? '<small class="text-warning">Somente funcionários compatíveis com o mesmo Nome, CPF e e-mail da identidade global foram mantidos disponíveis.</small>'
          : '<small class="text-warning">Nenhum funcionário compatível com o Nome, CPF e e-mail desta identidade global está disponível na unidade selecionada.</small>';
        criarNovoFuncionarioHelpText.innerHTML = '<small class="text-warning">Se necessário, o novo funcionário será criado com o mesmo Nome/CPF da identidade global.</small>';
      } else {
        funcionarioHelpText.innerHTML = availableCompatibleOptions > 0
          ? '<small>Somente funcionários compatíveis com o Nome, CPF e e-mail informados permanecem disponíveis.</small>'
          : '<small>Nenhum funcionário compatível com o Nome, CPF e e-mail informados está disponível na unidade selecionada.</small>';
        criarNovoFuncionarioHelpText.innerHTML = '<small>Se marcado, o novo funcionário será criado com o mesmo Nome/CPF deste cadastro.</small>';
      }
    }

    function atualizarEstadoSenha() {
      const emailValidated = hasValidatedEmail();
      const existingUser = hasExistingValidatedEmail();
      const criarNovoFuncionario = criarNovoFuncionarioEl.checked;
      const funcionarioSelecionado = funcionarioSelect.value && !criarNovoFuncionario;

      if (!emailValidated) {
        senhaEl.disabled = true;
        btnGerar.disabled = true;
        senhaEl.placeholder = 'Valide o e-mail para continuar';
        senhaEl.value = '';
        senhaHelpText.innerHTML = '<small>Disponível após validar o e-mail.</small>';
        return;
      }

      if (existingUser) {
        senhaEl.disabled = true;
        btnGerar.disabled = true;
        senhaEl.placeholder = 'Não aplicável ao vincular identidade global existente';
        senhaEl.value = '';
        senhaHelpText.innerHTML = '<small class="text-warning">Ao vincular usuário existente, a senha global atual é preservada.</small>';
        return;
      }

      if (funcionarioSelecionado) {
        senhaEl.disabled = true;
        btnGerar.disabled = true;
        senhaEl.placeholder = 'Será gerada automaticamente';
        senhaEl.value = '';
        senhaHelpText.innerHTML = '<small class="text-info">🔐 Senha será gerada automaticamente para funcionário existente.</small>';
        return;
      }

      senhaEl.disabled = false;
      btnGerar.disabled = false;
      senhaEl.placeholder = 'Deixe vazio para gerar automaticamente';
      senhaHelpText.innerHTML = '<small>Se vazio, uma senha provisória será gerada automaticamente.</small>';
    }

    function updateUserFormAvailability() {
      const emailValidated = hasValidatedEmail();
      const roleSelected = hasSelectedRole();
      const selectedRole = String(roleSelect?.value || '').trim().toLowerCase();

      nomeInput.disabled = !emailValidated;
      cpfNovo.disabled = !emailValidated;

      if (!emailValidated) {
        nomeHelpText.innerHTML = '<small>Disponível após validar o e-mail.</small>';
        cpfHelpText.innerHTML = '<small>Disponível após validar o e-mail.</small>';
        setFieldReadOnly(nomeInput, false);
        setFieldReadOnly(cpfNovo, false);
      } else if (hasExistingValidatedEmail()) {
        applyExistingIdentityToForm();
      } else {
        releaseIdentityFieldsForNewUser();
      }

      applyFuncionarioIdentityConstraints();
      atualizarEstadoSenha();

      const submitBlockedReason = getSubmitBlockedReason();
      submitButton.disabled = !!submitBlockedReason;
      submitButton.title = submitBlockedReason || '';
      if (submitButtonLabel) {
        if (hasExistingValidatedEmail()) {
          submitButtonLabel.textContent = 'Adicionar vínculo à unidade';
        } else if (emailValidated) {
          submitButtonLabel.textContent = 'Criar usuário e vincular unidade';
        } else {
          submitButtonLabel.textContent = 'Criar usuário ou adicionar vínculo';
        }
      }

      roleHelpText.innerHTML = roleSelected
        ? '<small>Papel selecionado. O fluxo seguirá com a mesma identidade global do e-mail validado.</small>'
        : '<small>Escolha primeiro o papel visível deste vínculo.</small>';

      if (!roleSelected) {
        emailInput.disabled = true;
        emailInput.placeholder = 'Selecione o nível de acesso primeiro';
      } else if (selectedRole === 'admin') {
        emailInput.disabled = false;
        emailInput.placeholder = 'E-mail';
      } else if (roleRequiresUnit(selectedRole) && !normalizeIdValue(unidadeSelect?.value)) {
        emailInput.disabled = true;
        emailInput.placeholder = 'Selecione a unidade antes do e-mail';
      } else {
        emailInput.disabled = false;
        emailInput.placeholder = 'E-mail';
      }
    }

    function renderEmailPrecheckMeta(user) {
      emailPrecheckMeta.innerHTML = '';
      if (!user) {
        emailPrecheckMeta.classList.add('d-none');
        return;
      }

      const items = [];
      if (user.nome) items.push(`Nome: ${user.nome}`);
      if (user.cpf) items.push(`CPF: ${formatCpfForUi(user.cpf)}`);
      if (user.global_role) items.push(`Acesso global: ${formatVisibleRoleLabel(user.global_role)}`);
      if (user.role) items.push(`Perfil atual: ${formatVisibleRoleLabel(user.role)}`);

      items.forEach((item) => {
        const badge = document.createElement('span');
        badge.className = 'badge text-bg-light border';
        badge.textContent = item;
        emailPrecheckMeta.appendChild(badge);
      });

      emailPrecheckMeta.classList.toggle('d-none', items.length === 0);
    }

    function renderEmailPrecheckUnits(membershipsSummary) {
      emailPrecheckUnits.innerHTML = '';
      if (!Array.isArray(membershipsSummary) || membershipsSummary.length === 0) {
        emailPrecheckUnits.classList.add('d-none');
        return;
      }

      membershipsSummary.forEach((membership) => {
        const chip = document.createElement('span');
        const statusLabel = membership.status === 'inactive'
          ? 'inativo'
          : (membership.status === 'active' ? 'ativo' : (membership.status || 'sem status'));
        const papelVisivel = formatVisibleRoleLabel(membership.papel_contextual);
        chip.className = `wdg-user-membership-chip ${membership.status === 'inactive' ? 'is-inactive' : ''}`.trim();
        chip.textContent = `${membership.unidade_nome || membership.unidade_id}${papelVisivel ? ` · ${papelVisivel}` : ''} · ${statusLabel}${membership.funcionario_id ? ' · func. vinculado' : ''}`;
        emailPrecheckUnits.appendChild(chip);
      });

      emailPrecheckUnits.classList.remove('d-none');
    }

    function applyBlockedUnitOptions() {
      resetUnidadeOptionState();
      const selectedUnitId = normalizeIdValue(unidadeSelect?.value);
      const blockedUnidadeIds = new Set(
        (Array.isArray(emailPrecheckState.blockedUnidadeIds) ? emailPrecheckState.blockedUnidadeIds : [])
          .map((unidadeId) => normalizeIdValue(unidadeId))
          .filter(Boolean)
      );

      Array.from(unidadeSelect?.options || []).forEach((option) => {
        if (!option.value) return;
        if (!blockedUnidadeIds.has(normalizeIdValue(option.value))) return;

        option.disabled = true;
        option.textContent = `${option.dataset.baseLabel || option.textContent} (já vinculada a este usuário)`;
      });

      const selectedUnitIsBlocked = blockedUnidadeIds.has(selectedUnitId);

      return {
        availableUnitCount: getAvailableUnitOptionCount(),
        selectedUnitIsBlocked,
      };
    }

    function renderEmailPrecheckState() {
      const emailValue = normalizeEmailValue(emailInput?.value);
      if (!emailValue || emailValue !== emailPrecheckState.checkedEmail) {
        resetUnidadeOptionState();
        hideEmailPrecheckCard();
        updateUserFormAvailability();
        return;
      }

      const { availableUnitCount, selectedUnitIsBlocked } = applyBlockedUnitOptions();
      const roleAllowsContextualLink = currentRoleAllowsContextualLink();
      const selectedUnitId = normalizeIdValue(unidadeSelect?.value);

      if (!emailPrecheckState.exists) {
        emailPrecheckCard.className = 'wdg-email-precheck-card is-new mt-2';
        emailPrecheckTitle.textContent = 'Novo usuário será criado';
        emailPrecheckMessage.textContent = 'Esta validação liberou a criação de uma nova identidade global. Preencha Nome e CPF antes de vincular um funcionário.';
        emailPrecheckMeta.classList.add('d-none');
        emailPrecheckUnits.classList.add('d-none');
        emailPrecheckWarning.classList.add('d-none');
        updateUserFormAvailability();
        return;
      }

      emailPrecheckCard.className = 'wdg-email-precheck-card is-existing mt-2';
      emailPrecheckTitle.textContent = 'Este e-mail já existe globalmente';

      let message = 'Nome e CPF foram carregados automaticamente para deixar claro que se trata da mesma pessoa.';
      if (!roleAllowsContextualLink) {
        message += ' Para adicionar novo vínculo, selecione User ou Diretor e uma unidade disponível.';
      } else if (!selectedUnitId) {
        message += ' Selecione uma unidade disponível para adicionar o vínculo contextual.';
      } else if (selectedUnitIsBlocked) {
        message += ' Este e-mail já está vinculado à unidade selecionada. Escolha outra unidade apenas se quiser adicionar um vínculo em outro contexto.';
      } else {
        message += ' Ao salvar, o sistema criará apenas o vínculo desta unidade, sem criar nova identidade global.';
      }
      emailPrecheckMessage.textContent = message;

      renderEmailPrecheckMeta(emailPrecheckState.user);
      renderEmailPrecheckUnits(emailPrecheckState.membershipsSummary);

      let warningMessage = '';
      if (!hasCompleteExistingIdentity()) {
        warningMessage = 'A identidade global existente está sem Nome ou CPF completo. Corrija esses dados fora deste fluxo antes de vincular.';
      } else if (selectedUnitIsBlocked) {
        warningMessage = 'Erro: este e-mail já está vinculado à unidade selecionada. Nenhum novo vínculo será criado para a mesma unidade.';
      } else if (availableUnitCount === 0) {
        warningMessage = 'Este usuário já está vinculado a todas as unidades disponíveis para este formulário.';
      }

      if (warningMessage) {
        emailPrecheckWarning.textContent = warningMessage;
        emailPrecheckWarning.classList.remove('d-none');
      } else {
        emailPrecheckWarning.classList.add('d-none');
      }

      if (selectedUnitIsBlocked) {
        showSameUnitDuplicateModal({ email: emailValue, unidadeId: selectedUnitId });
      } else {
        resetSameUnitDuplicateModalState();
      }

      updateUserFormAvailability();
    }

    function renderEmailPrecheckPending() {
      emailValidationStatus = 'pending';
      if (!emailPrecheckCard) return;
      emailPrecheckCard.className = 'wdg-email-precheck-card is-pending mt-2';
      emailPrecheckTitle.textContent = 'Consultando e-mail global';
      emailPrecheckMessage.textContent = 'Verificando se este e-mail já pertence a um usuário existente.';
      emailPrecheckMeta.classList.add('d-none');
      emailPrecheckUnits.classList.add('d-none');
      emailPrecheckWarning.classList.add('d-none');
      updateUserFormAvailability();
    }

    async function runEmailPrecheck(rawEmail) {
      const email = normalizeEmailValue(rawEmail);
      if (!canValidateEmailNow() || !isValidEmailForPrecheck(email)) {
        invalidateValidatedEmail({ preserveTypedIdentity: true });
        updateUserFormAvailability();
        return null;
      }

      if (emailValidationStatus === 'validated' && emailPrecheckState.checkedEmail === email) {
        renderEmailPrecheckState();
        return emailPrecheckState;
      }

      renderEmailPrecheckPending();
      const requestId = ++emailPrecheckRequestId;

      try {
        const response = await fetch(basePath + '/api/usuarios/check-email?email=' + encodeURIComponent(email), {
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          cache: 'no-store'
        });
        const json = await response.json().catch(() => null);
        if (requestId !== emailPrecheckRequestId) return emailPrecheckState;

        if (!response.ok) {
          invalidateValidatedEmail({ preserveTypedIdentity: true });
          updateUserFormAvailability();
          return null;
        }

        const payload = json?.data || {};
        emailValidationStatus = 'validated';
        emailPrecheckState = {
          checkedEmail: email,
          exists: payload.exists === true,
          user: payload.user || null,
          membershipsSummary: Array.isArray(payload.membershipsSummary) ? payload.membershipsSummary : [],
          blockedUnidadeIds: Array.isArray(payload.blockedUnidadeIds) ? payload.blockedUnidadeIds : [],
        };

        renderEmailPrecheckState();
        return emailPrecheckState;
      } catch (error) {
        if (requestId === emailPrecheckRequestId) {
          invalidateValidatedEmail({ preserveTypedIdentity: true });
          console.warn('[usuarios][check-email] falhou:', error);
          updateUserFormAvailability();
        }
        return null;
      }
    }

    function scheduleEmailPrecheck() {
      clearTimeout(emailPrecheckTimer);
      emailPrecheckRequestId += 1;
      invalidateValidatedEmail({ preserveTypedIdentity: true });
      updateUserFormAvailability();

      const email = normalizeEmailValue(emailInput?.value);
      if (!canValidateEmailNow() || !isValidEmailForPrecheck(email)) {
        return;
      }

      emailPrecheckTimer = setTimeout(() => {
        runEmailPrecheck(email);
      }, EMAIL_PRECHECK_DEBOUNCE_MS);
    }

    function atualizarCampoUnidade() {
      const selectedRole = String(roleSelect?.value || '').trim().toLowerCase();

