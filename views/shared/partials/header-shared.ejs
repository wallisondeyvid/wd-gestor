<% /* Header compartilhado. Parâmetros esperados:
    moduleBasePath: string (ex: '/gestor' ou '/escalas') - não usado diretamente aqui mas reservado para futura personalização.
    moduleLabel: string (ex: 'Gestor', 'Escalas') - idem.
*/ %>
<% /* CSS de layout e icons agora vêm da partial head-styles-gestor. Mantemos somente o HTML estrutural aqui. */ %>
<% const __hdrBase = (typeof moduleBasePath === 'string' && moduleBasePath) ? moduleBasePath : '/gestor'; %>
<header class="hero-wd hero-wd-fixed-height" role="banner" aria-label="Cabeçalho WDGestor">
  <img src="<%= __hdrBase %>/images/cabecalho.png?v=4" alt="Cabeçalho WDGestor" class="hero-bg" onerror="this.closest('header').classList.add('hero-noimg'); this.remove();">
</header>
