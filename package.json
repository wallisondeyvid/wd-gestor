{
  "name": "wdgestor",
  "version": "1.0.0",
  "description": "Sistema de gestão modular",
  "main": "src/start.js",
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*",
    "#shared/*": "./src/shared/*",
    "#modules/*": "./src/modules/*",
    "#models/*": "./models/*",
    "#services/*": "./src/services/*",
    "#legacy-services/*": "./services/*",
    "#utils/*": "./src/utils/*",
    "#mail/*": "./src/mail/*",
    "#routes/*": "./routes/*"
  },
  "scripts": {
    "start": "node src/start.js",
    "dev": "nodemon --watch src --watch routes --watch services --watch models --ext js,json,cjs,mjs --signal SIGTERM src/start.js",
    "start:escalas": "set ENABLE_ESCALAS=1 && node src/start.js",
    "dev:escalas": "set ENABLE_ESCALAS=1 && nodemon --watch src --watch routes --watch services --watch models --ext js,json,cjs,mjs --signal SIGTERM src/start.js",
    "start:gestor": "node src/start.js",
    "start:mem": "set MONGO_MEMORY=1 && node src/start.js",
    "start:mem:seed": "set MONGO_MEMORY=1 && set GESTOR_SEEDS=1 && node src/start.js",
    "start:atlas": "node src/start.js",
    "test": "npm run guard:condominios-unidade && node --test tests/*.test.js tests/architecture/*.test.js",
    "test:strict": "npm run guard:condominios-unidade && npm run guard:condominios-no-unidade-import && npm run guard:condominios-no-core-model-import && npm run guard:gestor-no-core-model-import && node --test tests/*.test.js tests/architecture/*.test.js",
    "guard:condominios-unidade": "node scripts/guard-grep.js \"\\bUnidade\\.\" \"src/modules/condominios\" \"Uso direto de Unidade detectado\"",
    "guard:condominios-no-unidade-import": "node scripts/guard-grep.js \"from '#core/models/unidade.js'\" \"src/modules/condominios\" \"Import direto de #core/models/unidade.js detectado\"",
    "guard:condominios-no-core-model-import": "node scripts/guard-grep.js \"from '#core/models/\" \"src/modules/condominios\" \"Import direto de #core/models/* detectado em condominios\"",
    "guard:gestor-no-core-model-import": "node scripts/guard-grep.js \"from '#core/models/\" \"src/modules/gestor\" \"Import direto de #core/models/* detectado em gestor\"",
    "parity": "node scripts/run-parity.js",
    "precommit": "npm run parity",
    "test:smoke": "node --test tests/health-and-session.test.js tests/migration.safety.smoke.test.js",
    "migration:check": "npm run guard:migration && npm run arch:map && npm run test:smoke",
    "test:mem": "set MONGO_MEMORY=1 && node --test tests/*.test.js",
    "test:win": "set NODE_ENV=test && set MONGO_MEMORY=1 && node --test tests/*.test.js",
    "master:set": "node scripts/set-master-password.js",
    "master:set:win": "set MASTER_EMAIL=%MASTER_EMAIL% && set MASTER_PASSWORD=%MASTER_PASSWORD% && node scripts/set-master-password.js",
    "update:cnaes": "node scripts/atualizar_cnaes.js",
    "cnaes:enrich": "node scripts/enriquecer_cnaes.js",
    "cnaes:map": "python gerar_cnaes_por_natureza.py",
    "cnaes:map:all": "python gerar_cnaes_por_natureza.py --all",
    "cbo:build:csvs": "node scripts/montar_cbo_de_multiplos_csv.js 500",
    "bancos:build": "node scripts/atualizar_bancos.js data/bancos.csv",
    "sindicatos:build": "node scripts/atualizar_sindicatos_xlsx.js public/data/sindicatos.xlsx 500",
    "sindicatos:build:xlsx": "node scripts/atualizar_sindicatos_xlsx.js public/data/sindicatos.xlsx 500",
    "municipios:build": "node scripts/atualizar_municipios_ibge.js",
    "migrate:indices": "echo 'Script removido'",
    "migrate:indices:corrigido": "echo 'Script removido'",
    "test:multitenant": "node src/testar-multi-tenant.js",
    "verify:legacy": "node scripts/verify-no-legacy.js",
    "guard:migration": "node scripts/guardrails/verify-migration-safety.js",
    "arch:map": "node scripts/architecture/generate-map.js",
    "flags:print": "node -e \"import('./src/core/config/index.js').then(m=>{const c=m.loadConfig();console.log(JSON.stringify(c.featureFlags,null,2));})\"",
    "lint:paths": "node scripts/lint-paths.js",
    "cleanup:legacy": "node scripts/cleanup-legacy.js",
    "lint:data-json": "node scripts/check-data-fetch.js",
    "migrate:backfill-diretor": "node scripts/migrations/2025-09-18_backfill-diretor-unidades.js",
    "migrate:backfill-habitacao-mailboxes": "node scripts/migrations/2026-01-09_backfill-habitacao-mailboxes.js",
    "backfill:refeicoes": "node scripts/backfill_refeicoes_computavel.js \"%MONGO_URI%\"",
    "backfill:refeicoes:uri": "node scripts/backfill_refeicoes_computavel.js",
    "test:e2e:refeicoes": "node scripts/test_e2e_refeicoes_computavel.js",
    "verify:imports": "node scripts/verify-no-relative-imports.js",
    "prepare": "husky"
  },
  "keywords": [
    "gestao",
    "node",
    "mongodb"
  ],
  "author": "Wallison Deyvid",
  "license": "ISC",
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.0",
    "@vercel/blob": "^0.21.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "inputmask": "^5.0.9",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^7.6.3",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "node-hid": "^2.1.2",
    "nodemailer": "^6.10.1",
    "openai": "^6.15.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
