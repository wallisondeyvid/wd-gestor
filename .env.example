# -----------------------------------------------------------------------------
# WD Gestor - Arquivo de Exemplo de Variáveis de Ambiente (.env)
# Copie para .env e ajuste valores reais. NÃO COMMITAR .env com segredos.
# -----------------------------------------------------------------------------

# Ambiente
NODE_ENV=development
PORT=3000
# Base pública da aplicação para montar links em e-mails (não incluir sufixos de rota)
# Em produção, use o domínio oficial sem barra no final, ex:
# APP_URL=https://wdgestor.vercel.app
APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wdgestor

# Segurança de Login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_FAILED_DELAY_BASE_MS=150
LOGIN_FAILED_DELAY_MAX_MS=3000
BCRYPT_MIN_ROUNDS=12
ENFORCE_MASTER_FIRST_LOGIN=false

# SMTP (Escolha um provedor e configure UM bloco)

## BREVO (ex-Sendinblue) -----------------------------------------------------
# Obter SMTP_USER e SMTP_PASS no painel (SMTP & API)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false          # false para 587 (StartTLS); true apenas se usar 465
SMTP_USER=SEU_LOGIN_SMTP_BREVO
SMTP_PASS=SUA_CHAVE_SMTP_BREVO
MAIL_FROM="WD Gestor <no-reply@seudominio.com>"
# Opcional:
# SMTP_REQUIRE_TLS=true     # força STARTTLS
# SMTP_IGNORE_TLS=false     # não usar em produção

## GMAIL (App Password) ------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=APP_PASSWORD_GERADO
# MAIL_FROM="WD Gestor <seu_email@gmail.com>"

## OUTROS AJUSTES TLS --------------------------------------------------------
# SMTP_SECURE=true          # Usar somente se porta 465
# SMTP_REQUIRE_TLS=true     # Garante STARTTLS
# SMTP_IGNORE_TLS=false     # true desabilita STARTTLS (evitar produção)

# Tokens / Senhas Temporárias
JWT_SECRET=alterar_esta_chave

# Uploads / Caminhos (exemplos)
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Notas:
# 1. Para Brevo: remetente (MAIL_FROM) deve ser domínio verificado.
# 2. Se envio falhar, em desenvolvimento a API devolve debugLink.
# 3. Erros comuns: porta/secure incorretos, credenciais inválidas, domínio não validado.
# -----------------------------------------------------------------------------
